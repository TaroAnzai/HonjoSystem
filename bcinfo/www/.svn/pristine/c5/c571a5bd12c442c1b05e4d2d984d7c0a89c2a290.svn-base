	$arForm[] = $value ;

	// スタイル
	global $arStyle ;

	$value = "" ;
	$form   = $blams -> fetchSelectbox( $alias . "_style" , ${ $alias . "_style" } , $arStyle , $isize ,  "選択してください。" , FALSE , "" ) ;
	$value .= $blams -> fetchTHTD( "スタイル ※" , $form , $tsize , $vsize3 , "col1" , "left" , "middle" , TRUE , 1 , 1 , 3 ) ;
