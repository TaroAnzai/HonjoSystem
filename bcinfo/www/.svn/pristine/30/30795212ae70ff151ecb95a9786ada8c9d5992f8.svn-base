require_once "Services/Twitter.php";
require_once "HTTP/OAuth/Consumer.php" ;
require_once "social.class.php" ;

class PARTS_Social extends PARTS_Social
{
	function	__construct( $dbname = "" , $user = "" , $passwd = "" , $host = "" , $port = "" )
	{
		$tname		= "top_data" ;
		$alias		= "tp" ;
		$primarykey	= "topid" ;

		parent::__construct( $dbname , $user , $passwd , $host , $port , $tname , $alias , $primarykey ) ;

		$this -> per_page		= NUMBER_PER_TOP ;
	}

	function	getData( $arParam , $page = -1 , $per_page = -1 )
	{
		$arParam[ "type" ] = DEF_SOCIALTYPE_TWITTER ;
		return getData( $arParam , $page , $per_page ) ;
	}
}
