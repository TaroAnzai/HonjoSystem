#footer
{
	font-size : 0.8em ;
	color : #efffff ;
	height : 32px ;
	line-height : 30px ;
	text-align : center ;
	vertical-align : middle ;
	background : #303263 ;
	border-top : #AD5963 solid 4px ;
	padding-top : 4px ;
}
* html #footer	{	height : 40px ;	}
