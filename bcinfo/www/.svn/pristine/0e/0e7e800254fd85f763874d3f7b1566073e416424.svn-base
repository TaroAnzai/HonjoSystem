<?php
	ini_set("memory_limit","512M");

	if ( empty( $argv[ 1 ] ) == false )
	{
		$libpath = trim( $argv[ 1 ] , "'" ) ;
		if ( empty( $libpath ) == false )
			define(	"SITE_INCLUDE_DIR" , $libpath ) ;
	}

	require_once( "../../../lib/system.php") ;

	$page = 0 ;
	$maxpage = 0 ;

	$_POS = 2 ;
	$S_LOGINID			= $argv[ $_POS ++ ] ;
	$S_FIRSTNAME		= $argv[ $_POS ++ ] ;
	$S_LASTNAME			= $argv[ $_POS ++ ] ;
	$S_STATE			= $argv[ $_POS ++ ] ;
	$S_TEL1				= $argv[ $_POS ++ ] ;
	$S_TEL2				= $argv[ $_POS ++ ] ;
	$S_TEL3				= $argv[ $_POS ++ ] ;
	$S_EMAIL			= $argv[ $_POS ++ ] ;

	$S_CREATE_DATE_S_y	= $argv[ $_POS ++ ] ;
	$S_CREATE_DATE_S_m	= $argv[ $_POS ++ ] ;
	$S_CREATE_DATE_S_d	= $argv[ $_POS ++ ] ;
	$S_CREATE_DATE_E_y	= $argv[ $_POS ++ ] ;
	$S_CREATE_DATE_E_m	= $argv[ $_POS ++ ] ;
	$S_CREATE_DATE_E_d	= $argv[ $_POS ++ ] ;

	$S_BILLING_COUNT	= $argv[ $_POS ++ ] ;

	$login_level		= $argv[ $_POS ++ ] ;

	$tmpfile			= $argv[ $_POS ++ ] ;
	$xlsfile			= $argv[ $_POS ++ ] ;
/*
	$tmp = $obMember -> alias . "_" . date( Y.m.d ) ;
	$tmp = tempnam( "/tmp" , $tmp . '_' ) ;
	$file = $tmp . ".xls" ;

$tmpfile = $tmp ;
$xlsfile = $file ;
*/
	if ( $tmpfile == "" )
		exit( 0 ) ;

	if ( $xlsfile == "" )
		exit( 0 ) ;

	// 検索用パラメータの保存
	$arParam = array() ;
	$arParam[ "S_LOGINID"			] = $S_LOGINID			;
	$arParam[ "S_FIRSTNAME"			] = $S_FIRSTNAME		;
	$arParam[ "S_LASTNAME"			] = $S_LASTNAME			;
	$arParam[ "S_STATE"				] = $S_STATE			;
	$arParam[ "S_TEL1"				] = $S_TEL1				;
	$arParam[ "S_TEL2"				] = $S_TEL2				;
	$arParam[ "S_TEL3"				] = $S_TEL3				;
	$arParam[ "S_EMAIL"				] = $S_EMAIL			;

	$arParam[ "S_CREATE_DATE_S_y"	] = $S_CREATE_DATE_S_y	;
	$arParam[ "S_CREATE_DATE_S_m"	] = $S_CREATE_DATE_S_m	;
	$arParam[ "S_CREATE_DATE_S_d"	] = $S_CREATE_DATE_S_d	;
	$arParam[ "S_CREATE_DATE_E_y"	] = $S_CREATE_DATE_E_y	;
	$arParam[ "S_CREATE_DATE_E_m"	] = $S_CREATE_DATE_E_m	;
	$arParam[ "S_CREATE_DATE_E_d"	] = $S_CREATE_DATE_E_d	;

	$arParam[ "S_BILLING_COUNT"		] = $S_BILLING_COUNT	;
	
	if ( $S_LOGINID == "" )
		$S_LOGINID = -1 ;

	if ( $S_FIRSTNAME == "" )
		$S_FIRSTNAME = -1 ;

	if ( $S_LASTNAME == "" )
		$S_LASTNAME = -1 ;

	if ( $S_STATE == "" )
		$S_STATE = -1 ;

	if ( $S_TEL1 == "" )
		$S_TEL1 = -1 ;

	if ( $S_TEL2 == "" )
		$S_TEL2 = -1 ;

	if ( $S_TEL3 == "" )
		$S_TEL3 = -1 ;

	if ( $S_EMAIL == "" )
		$S_EMAIL = -1 ;

	$S_CREATE_DATE_S = -1 ;
	if (	( is_numeric( $S_CREATE_DATE_S_y ) == true ) &&
			( is_numeric( $S_CREATE_DATE_S_m ) == true ) &&
			( is_numeric( $S_CREATE_DATE_S_d ) == true ) )
	{
		if ( checkdate( $S_CREATE_DATE_S_m , $S_CREATE_DATE_S_d , $S_CREATE_DATE_S_y ) == TRUE )
			$S_CREATE_DATE_S = sprintf( "%04d-%02d-%02d 00:00:00" , $S_CREATE_DATE_S_y , $S_CREATE_DATE_S_m , $S_CREATE_DATE_S_d ) ;
	}

	$S_CREATE_DATE_E = -1;
	if (	( is_numeric( $S_CREATE_DATE_E_y ) == true ) &&
			( is_numeric( $S_CREATE_DATE_E_m ) == true ) &&
			( is_numeric( $S_CREATE_DATE_E_d ) == true ) )
	{
		if ( checkdate( $S_CREATE_DATE_E_m , $S_CREATE_DATE_E_d , $S_CREATE_DATE_E_y ) == TRUE )
			$S_CREATE_DATE_E = sprintf( "%04d-%02d-%02d 23:59:59" , $S_CREATE_DATE_E_y , $S_CREATE_DATE_E_m , $S_CREATE_DATE_E_d ) ;
	}

	if ( $S_BILLING_COUNT == "" )
		$S_BILLING_COUNT = -1 ;

	$obMember	= new PARTS_Member() ;

	$arWhere = array() ;
	$arWhere[ "loginid"			]	= $S_LOGINID ;
	$arWhere[ "first_name"		]	= $S_FIRSTNAME ;
	$arWhere[ "last_name"		]	= $S_LASTNAME ;
	$arWhere[ "state"			]	= $S_STATE ;
	$arWhere[ "tel1"			]	= $S_TEL1 ;
	$arWhere[ "tel2"			]	= $S_TEL2 ;
	$arWhere[ "tel3"			]	= $S_TEL3 ;
	$arWhere[ "email"			]	= $S_EMAIL ;
	$arWhere[ "s_create_date"	]	= $S_CREATE_DATE_S ;
	$arWhere[ "e_create_date"	]	= $S_CREATE_DATE_E ;
	$arWhere[ "billing_count"	]	= $S_BILLING_COUNT ;
	$arWhere[ "billing_status"	]	= DF_BILLSTATUS_SETTLING ;
	$arWhere[ "where"			]	= sprintf( "AND %s.level != %d " , $obMember -> alias , DEF_MEMBER_LEVEL_NON ) ;

	$order  = "" ;
	$order .= sprintf( "%s.last_kana   , " , $obMember -> alias ) ;
	$order .= sprintf( "%s.first_kana  , " , $obMember -> alias ) ;
	$order .= sprintf( "%s.loginid     , " , $obMember -> alias ) ;
	$order .= sprintf( "%s.create_date   " , $obMember -> alias ) ;
	$arWhere[ "order"		]	= $order ;

	$cnt = $obMember -> getCount( $arWhere , 0 , false ) ;

	// 登録データがある場合
	if ( $cnt != 0 )
	{
		OutputCSV( $arWhere , $login_level , $tmpfile , $xlsfile ) ;
	}
	else
	{
		WriteProc( $tmpfile , 99 ) ;
	}

	exit ;

function	OutputCSV( $arWhere , $login_level , $tmpfile , $xlsfile )
{
	global $obMember ;
	$alias = $obMember -> alias ;

	$blams		= new BLAMS() ;
	$obCorp		= new PARTS_Corp() ;

	$arCorp = $obCorp -> getOwner() ;
	$alias_cp = $obCorp -> alias ;

	$obCategory = new PARTS_Category() ;
	$alias_c = $obCategory -> alias ;

	$menu = FUNC_MEMBER ;
	$funcname = $blams -> GetFuncName( $menu ) ;

	$arHeader = array(
		array( "ログインID"			, 12 ) ,
		array( "パスワード"			, 12 ) ,
		array( "会員レベル"			, 12 ) ,
		array( "ニックネーム"		, 15 ) ,
		array( "名前（姓 名）"		, 15 ) ,
		array( "カナ（姓 名）"		, 22 ) ,
		array( "生年月日"			, 12 ) ,
		array( "性別"				,  8 ) ,
		array( "ｅメール(自宅) "	, 30 ) ,
		array( "ｅメール(携帯) "	, 30 ) ,
		array( "郵便番号"			, 10 ) ,
		array( "住所"				, 80 ) ,
		array( "電話番号(自宅) "	, 16 ) ,
		array( "電話番号(携帯) "	, 16 ) ,
		array( "ＦＡＸ"				, 16 ) ,
		array( "嗜好"				, 90 ) ,
		array( "現在ポイント"		,  8 ) ,
		array( "合計ポイント"		,  8 ) ,
		array( "メールマガジン"		, 25 ) ,
		array( "未収金 "			, 25 ) ,
	) ;

	error_reporting(E_ALL);

	// Create new PHPExcel object
	$objPHPExcel = new PHPExcel();

	// Set properties
	$creator	= excel_string( "BLAMS"								 ) ;
	$lastmodify	= excel_string( "BLAMS"								 ) ;
	$title		= excel_string( $funcname . "一覧"					 ) ;
	$subject	= excel_string( $funcname . "一覧"					 ) ;
	$company	= excel_string( $arCorp[ 0 ][ $alias_cp . "_name" ]	 ) ;
	
	$objPHPExcel -> getProperties()	-> setCreator( $creator )
									-> setLastModifiedBy( $lastmodify )
									-> setTitle( $title )
									-> setSubject( $subject )
									-> setCompany( $company ) ;

	$objSheet = $objPHPExcel -> setActiveSheetIndex( 0 ) ;
	$objSheet -> setTitle( $title ) ;
	$row = 1 ;
	
	$dataCnt = count( $arHeader ) ;
	for ( $i = 0 ; $i < $dataCnt ; $i ++ )
	{
		$objSheet -> getColumnDimensionByColumn( $i ) -> setWidth( $arHeader[ $i ][ 1 ] ) ;
		$objSheet -> setCellValueByColumnAndRow( $i , $row , excel_string( $arHeader[ $i ][ 0 ] ) ) ;
	}

	$start	= sprintf( "%s%d" , PHPExcel_Cell::stringFromColumnIndex( 0 ) , $row ) ;
	$end	= sprintf( "%s%d" , PHPExcel_Cell::stringFromColumnIndex( $dataCnt - 1 ) , $row ) ;
	$range	= sprintf( "%s:%s" , $start , $end ) ;
	$objSheet -> getStyle( $range ) -> applyFromArray(
			array(
				'font'    => array(
					'bold'      => true
				),
				'borders' => array(
					'inside'     => array(
	 					'style' => PHPExcel_Style_Border::BORDER_THIN
	 				) ,
					'outline'     => array(
	 					'style' => PHPExcel_Style_Border::BORDER_THIN
	 				)
				),
				'fill' => array(
		 			'type'       => PHPExcel_Style_Fill::FILL_SOLID,
		 			'startcolor' => array(
		 				'argb' => 'FFCCCCCC'
		 			),
		 		)
			)
	);
	
	$row ++ ;

	$arMember = $obMember -> getData( $arWhere , 0 , false ) ;
	WriteProc( $tmpfile , 1 ) ;

	WriteProc( $tmpfile , 2 ) ;
	$cnt = count( $arMember ) ;
	for ( $index = 0 ; $index < $cnt ; $index ++ )
	{
		$process = sprintf( "%d / %d" , $index + 1 , $cnt ) ;
		WriteProc( $tmpfile , 2 , $process ) ;

		// データの取得
		$arData		= $arMember[ $index ] ;
		
		$loginid		= $arData[ $alias . "_loginid"		] ;
		$passwd			= $arData[ $alias . "_passwd"		] ;
		$level			= $arData[ $alias . "_level"		] ;
		$nickname		= $arData[ $alias . "_nickname"		] ;
		$first_name		= $arData[ $alias . "_first_name"	] ;
		$last_name		= $arData[ $alias . "_last_name"	] ;
		$first_kana		= $arData[ $alias . "_first_kana"	] ;
		$last_kana		= $arData[ $alias . "_last_kana"	] ;
		$birthday		= $arData[ $alias . "_birthday"		] ;
		$gender			= $arData[ $alias . "_gender"		] ;
		$email_home		= $arData[ $alias . "_email_home"	] ;
		$email_port		= $arData[ $alias . "_email_port"	] ;
		$zip			= $arData[ $alias . "_zip"			] ;
		$state			= $arData[ $alias . "_state"		] ;
		$city			= $arData[ $alias . "_city"			] ;
		$addr1			= $arData[ $alias . "_addr1"		] ;
		$addr2			= $arData[ $alias . "_addr2"		] ;
		$tel_home		= $arData[ $alias . "_tel_home"		] ;
		$tel_port		= $arData[ $alias . "_tel_port"		] ;
		$fax			= $arData[ $alias . "_fax"			] ;
		$favorite		= $arData[ $alias . "_favorite"		] ;
		$point			= $arData[ $alias . "_point"		] ;
		$total_point	= $arData[ $alias . "_total_point"	] ;
		$magazine		= $arData[ $alias . "_magazine"		] ;
		$billing_count	= $arData[ "billing_count"			] ;

		$arCell = array() ;

		// ログインID
		if ( $loginid == "" )
			$loginid = "不明" ;
		$arCell[] = array( $loginid , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// パスワード
		if ( $passwd == "" )
			$passwd = "不明" ;
		$arCell[] = array( $passwd , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 会員レベル
		global	$arMemberLevel ;
		$szMemberLevel = $arMemberLevel[ $level ] ;
		if ( $szMemberLevel == "" )
			$szMemberLevel = "不明" ;
		$arCell[] = array( $szMemberLevel , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// ニックネーム
		$arCell[] = array( $nickname , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 名前（姓 名）
		if ( $last_name == "" && $first_name == "" )
			$last_name = "不明" ;
		$szName = sprintf( "%s %s" , $last_name , $first_name ) ;
		$arCell[] = array( $szName , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// カナ（姓 名）
		if ( $last_kana == "" && $first_kana == "" )
			$last_kana = "不明" ;
		$szKana = sprintf( "%s %s" , $last_kana , $first_kana ) ;
		$arCell[] = array( $szKana , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 生年月日
		$arCell[] = array( $birthday , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 性別
		global	$arGender ;
		$szGender = $arGender[ $gender ] ;
		if ( $szGender == "" )
			$szGender = "不明" ;
		$arCell[] = array( $szGender , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// ｅメール(自宅)
		$arCell[] = array( $email_home , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// ｅメール(携帯)
		$arCell[] = array( $email_port , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 郵便番号
		$arCell[] = array( $zip , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 住所
		global	$arState ;
		$szAddress  = $arState[ $state ][ 2 ] ;
		$szAddress .= $city ;
		$szAddress .= $addr1 ;
		$szAddress .= "　" ;
		$szAddress .= $addr2 ;
		$arCell[] = array( $szAddress , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 電話番号(自宅)
		if( $tel_home == "--" )
			$tel_home = "" ;
		$arCell[] = array( $tel_home , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 電話番号(携帯)
		if( $tel_port == "--" )
			$tel_port = "" ;
		$arCell[] = array( $tel_port , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// ＦＡＸ
		$arCell[] = array( $fax , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 嗜好
		$favorite = trim( $favorite , "[" ) ;
		$favorite = trim( $favorite , "]") ;
		$arFavorite = explode( "][" , $favorite ) ;
		$szFavorite = "" ;

		if( is_array( $arFavorite ) )
		{
			for( $i = 0 ; $i < count( $arFavorite ) ; $i ++ )
			{
				$arWhere = array() ;
				$arWhere[ "categoryid" ] = $arFavorite[ $i ] ;
				$arTemp = $obCategory -> getData( $arWhere , 0 , false ) ;
				$szFavorite .= $arTemp[ 0 ][ $alias_c . "_name" ] . "," ;
			}
			$szFavorite = substr( $szFavorite , 0 , -1 ) ;
		}

		$arCell[] = array( $szFavorite , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 現在ポイント
		$arCell[] = array( $point ) ;

		// 合計ポイント
		$arCell[] = array( $total_point ) ;

		// メールマガジン
		if( $magazine == ( DEF_MAILTOHOME + DEF_MAILTOPORT ) )
			$szMagazine = "自宅アドレスと、携帯アドレスへ" ;
		else if( $magazine == DEF_MAILTOHOME )
			$szMagazine = "自宅アドレスのみへ" ;
		else if( $magazine == DEF_MAILTOPORT )
			$szMagazine = "携帯アドレスのみへ" ;
		else
			$szMagazine = "メールマガジン必要なし" ;
		$arCell[] = array( $szMagazine , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		// 未収金
		$szBillingCount = "無し" ;
		if ( $billing_count > 0 )
			$szBillingCount = sprintf( "%d件" , $billing_count ) ;
		$arCell[] = array( $szBillingCount , PHPExcel_Style_NumberFormat::FORMAT_TEXT ) ;

		$dataCnt = count( $arCell ) ;
		for ( $i = 0 ; $i < $dataCnt ; $i ++ )
		{
			if ( isset( $arCell[ $i ][ 1 ] ) == TRUE )
			{
				if ( $arCell[ $i ][ 1 ] != "" )
				{
					$objSheet -> getStyleByColumnAndRow( $i , $row ) -> getNumberFormat() -> setFormatCode( $arCell[ $i ][ 1 ] ) ;
					$objSheet -> setCellValueExplicitByColumnAndRow( $i , $row , excel_string( $arCell[ $i ][ 0 ] ) , PHPExcel_Cell_DataType::TYPE_STRING ) ;
				}
			}
			else
				$objSheet -> setCellValueByColumnAndRow( $i , $row , $arCell[ $i ][ 0 ] ) ;
		}
		
		$row ++ ;
	}

	WriteProc( $tmpfile , 3 ) ;

	$objPHPExcel -> setActiveSheetIndex( 0 ) ;

	$objWriter = PHPExcel_IOFactory::createWriter( $objPHPExcel, "Excel5" ) ;
	$objWriter -> save( $xlsfile ) ;

}

// プロセスのステータスを設定する
function	WriteProc( $file , $status , $process = "" )
{
	$fp = fopen( $file , "w" ) ;
	if ( $fp )
	{
		fwrite( $fp , sprintf( "%d\n" , $status ) ) ;
		fwrite( $fp , sprintf( "%s\n" , $process ) ) ;
	
		fclose( $fp ) ;
	}
}

function	excel_string( $sz )
{
	return mb_convert_encoding( $sz , "utf8" , "sjis-win" ) ;
}

?>
