/*
	Desgin Common Style
*/
* {
    padding: 0 ;
    margin: 0 ;
	font-family :	"ÉÅÉCÉäÉI" , "Meiryo" ,
					"ÉqÉâÉMÉmäpÉS Pro W3" , "Hiragino Kaku Gothic Pro" ,
					"ÇlÇr ÇoÉSÉVÉbÉN" , "MS P Gothic" ,
					"Osaka",
					Verdana , Arial , Helvetica , sans-serif ;
}

img		{ border: none; }

table , tr , td , th
{
	vertical-align : top ;
	border-collapse : collapse ;
	margin : 0px ;
	padding : 0px ;
}
* html table	{	font-size : 0.96em ;	}

input ,
textarea ,
select
{
	outline : none ;
	font-size : 0.96em ;
	padding : 3px 2px 3px ;
	border : 1px solid #666666 ;
	margin-bottom : 4px ;
}
* html input	{	font-size : 0.96em ;	}
* html textarea	{	font-size : 0.96em ;	}

form			{	font-size : 0.96em ;	}
* html form		{	font-size : 0.96em ;	}

input[ type="checkbox" ] ,
input[ type="radiobox" ]
{
	border : none ;
	vertical-align : middle ;
}

a
{
	outline : none ;
	font-size : 0.98em ;
	border : 0px ;
}

a:link				{ color : #666 ; text-decoration : none ; }
a:visited			{ color : #666 ; text-decoration : none ; }
a:hover				{ color : #333 ; text-decoration : underline ; }
a:active			{ color : #666 ; text-decoration : none ; }

a.pdf
{
	width : auto ;
	height : 18px ;
	line-height : 18px ;
	vertical-align : top ;
	background : transparent url("/img/pdf.gif") no-repeat left top ;
	padding : 2px 0px 2px 20px ;
}

/*
-------------------------------------------------------------------------------
	ã§í 
-------------------------------------------------------------------------------
*/
.tiny {
	font-size: 0.8em ;
}

.small {
	font-size: 0.9em ;
}

.left		{	text-align : left ;		margin-left : 0px  ;	margin-right : auto ;	}
.center		{	text-align : center ;	margin-left : auto ;	margin-right : auto ;	}
.right		{	text-align : right ;	margin-left : auto ;	margin-right : 0px  ;	}
.middle		{	vertical-align : middle ;	}
.bottom		{	vertical-align : bottom ;	}
.top		{	vertical-align : top ;		}

.formBlock	{	display : block ;			}
.no-border	{	border : none ;				}
.no-wrap	{	white-space : nowrap ;		}
.wrap-free	{	word-wrap : break-word ;	}
.wrap		{	white-space : normal ;		}
.bold		{	font-weight : bold ;		}

/*
* html .wrap	{	word-break: break-all ;	}
*/

.imeon		{	ime-mode : active !important ;		}
.imeoff		{	ime-mode : disabled !important ;	}

.label		{	color : #333333 ;	font-size : 1em ;	margin : 0px ;	padding : 0px 4px ;	}
.detail		{	color : #333333 ;	font-size : 1em ;	margin : 0px ;	padding : 0px 4px ;	}
.form		{	color : #333333 ;	font-size : 0.9em ;	margin : 0px ;	padding : 0px 4px ;	}
.form
{
	height : 1.5em ;
	background-color : #ffffcc ;
	border : #000 solid 1px ;
}

