<?php
	ini_set( "display_errors" ,1 ) ;
	define( "DEF_INTERNAL_ENCODE"	, "UTF-8" ) ;
	define( "DEF_SHEET_ENCODE"		, "UTF-8" ) ;
	require_once( "server.ini.php" ) ;
	require_once( "conf/user.ini.php" ) ;
	require_once( "class/blams.class.php" ) ;
	require_once( "class/terminal.class.php" ) ;

	// Excel出力
	
	ob_implicit_flush() ;
	
	//print_r( $argv ) ;

	// データを保存するフォルダの作成
	$date	= new DateTime() ;
//	$date -> modify ( "-1 day" ) ;
	$year	= intval( $date -> format( "Y" ) ) ;
	$month	= intval( $date -> format( "m" ) ) ;
	$day	= intval( $date -> format( "d" ) ) ;

	@mkdir( sprintf( "%s/%04d" , NAC_DATA_FOLDER_REPORT , $year ) ) ;
	@mkdir( sprintf( "%s/%04d/%02d" , NAC_DATA_FOLDER_REPORT , $year , $month ) ) ;

	$path = sprintf( "%s/%04d/%02d" , NAC_DATA_FOLDER_REPORT , $year , $month ) ;

	$tmpfile = sprintf( "%s%s.~~~" , NAC_REPORT , $date -> format( "Ymd" ) ) ;
	$orgfile = sprintf( "%s%s.xls" , NAC_REPORT , $date -> format( "Ymd" ) ) ;
	$tmppath = sprintf( "%s/%s" , $path , $tmpfile ) ;
	$orgpath = sprintf( "%s/%s" , $path , $orgfile ) ;

	// 該当する日付のデータを取得する
	$obTerminal = new PARTS_Terminal() ;
	$alias = $obTerminal -> alias ;
	
	$arWhere = array() ;
	$arWhere[ "command"			] = NAC_STORAGE_PRODUCT ;
	$arWhere[ "create_date_d"	] = $date -> format( "Y-m-d 00:00:00" ) ;
	
	$arResult = $obTerminal -> getData( $arWhere ) ;

	// Excelデータの出力
	require_once( "Spreadsheet/Excel/Writer.php" ) ;

	// ワークブックを作成します
	$objBook = new Spreadsheet_Excel_Writer( $orgpath ) ;
	$objBook -> setVersion( 8 ) ;

	$objSheet =& $objBook -> addWorksheet() ;

	$objSheet -> setInputEncoding( DEF_INTERNAL_ENCODE ) ;

	$title = sprintf( "生産ライン入庫データ(%04d年%02d月%02d日)" , $year , $month , $day ) ;

	$arColumn[ 0 ] = array(
		//		TITLE					SIZE	HEADER ALIGN	COLSEP
		array( "時間" ,					10 ,	"center" ,  		1 ) ,
		array( "商品コード" 	,		10 ,	"center" ,  		1 ) ,
		array( "ボトルコンテナID" ,		20 ,	"center"   ,  		1 ) ,
		array( "ボトル情報" ,			45 ,	"center"   ,  		1 ) ,
	) ;
	$arColumn[ 1 ] = array(
		//		FORMAT					SIZE	ALIGN			BORDER
		array( "t" ,					10 ,	"center" , 		"" ) ,
		array( "t" ,					10 ,	"left" ,  		"" ) ,
		array( "t" ,					20 ,	"left" ,  		"" ) ,
		array( "t" ,					45 ,	"left" ,  		"" ) ,
	) ;

//	SetTitle( $objBook , $objSheet , $title , $arColumn ) ;

	putList( $objBook , $objSheet , $obTerminal , $arResult , $arColumn ) ;
	
	// この場合でも、ワークブックを明示的に閉じる必要があります
	$objBook -> close() ;

exit ;

function	SetTitle( $objBook , $objSheet , $title , $arColumn )
{
	// 色指定を作成する
	$def_color		= "black" ;
	$def_bgcolor	= $objBook -> setCustomColor( 8 , 0xCC , 0xCC , 0xCC ) ;
	$even_bgcolor	= $objBook -> setCustomColor( 9 , 0xEF , 0xEF , 0xEF ) ;

	$format =& $objBook -> addFormat() ;
	$format -> setFontFamily( "MS UI Gothic" ) ;
	$format -> setBold( 0 ) ;
	$format -> setTextWrap( 1 ) ;
	$format -> setAlign( "left" ) ;

	$objSheet -> setMerge( 0 , 0 , 0 , 3 ) ;
	$objSheet -> write( 0 , 0 , $title , $format ) ;

	// ヘッダ行の出力
	$row = 2 ;
	$col = 0 ;
	foreach ( $arColumn[ 0 ] as $value )
	{
		$formatHeader =& $objBook -> addFormat() ;
		$formatHeader -> setFontFamily( "MS UI Gothic" ) ;
		$formatHeader -> setTextWrap( 1 ) ;
		$formatHeader -> setBold( 1 ) ;
		$formatHeader -> setSize( 9 ) ;
		$formatHeader -> setBorder( 1 ) ;
		$formatHeader -> setPattern( 1 ) ;

		if ( empty( $value[ 2 ] ) == false )
			$formatHeader -> setAlign( $value[ 2 ] ) ;
		$formatHeader -> setVAlign( "vcenter" ) ;
		
		$formatHeader -> setColor( $def_color ) ;
		$formatHeader -> setFgColor( $def_bgcolor ) ;

		if ( $value[ 3 ] > 1 )
			$objSheet -> setMerge( $row , $col , $row , $row , $col + $value[ 3 ] - 1 ) ;
		$objSheet -> setColumn( $col , $col , $value[ 1 ] ) ;
		$objSheet -> write( $row , $col , $value[ 0 ] , $formatHeader ) ;

		unset( $formatHeader ) ;

		$col ++ ;
		if ( $value[ 3 ] > 1 )
			$col += $value[ 3 ] - 1 ;
	}
}

function	putList( $objBook , $objSheet , $obTerminal , $arResult , $arColumn )
{
	$alias = $obTerminal -> alias ;
	
	$arBCU = array() ;
	$fmt  = sprintf( "%%%dd%%%ds" , SEQ_MAX_LINE , SEQ_MAX_PRODUCTID ) ;
	for ( $bcu = 0 ; $bcu < SEQ_MAX_CNT_BCU ; $bcu ++ )
	{
		$arBCU[ $bcu ] = array() ;
		$arBCU[ $bcu ][ "bottle" ] = array() ;

		$fmt .= sprintf( "%%%ds" , SEQ_MAX_BCUID ) ;
		for ( $btl = 0 ; $btl < SEQ_MAX_CNT_BOTTLE ; $btl ++ )
			$fmt .= sprintf( "%%%ds" , SEQ_MAX_BOTTLECODE ) ;
	}

	// 色指定を作成する
	$def_color		= "black" ;
	$def_bgcolor	= $objBook -> setCustomColor( 8 , 0xCC , 0xCC , 0xCC ) ;
	$even_bgcolor	= $objBook -> setCustomColor( 9 , 0xEF , 0xEF , 0xEF ) ;

	$row = 3 ;
	foreach ( $arResult as $arData )
	{
		$create_date	= $arData[ $alias . "_create_date"	] ;
		$data			= $arData[ $alias . "_data"			] ;
		
		sscanf( $data , $fmt , $line ,	$pid ,
										$arBCU[ 0 ][ "bcu" ] , 
											$arBCU[ 0 ][ "bottle" ][ 0 ] , 
											$arBCU[ 0 ][ "bottle" ][ 1 ] , 
											$arBCU[ 0 ][ "bottle" ][ 2 ] , 
											$arBCU[ 0 ][ "bottle" ][ 3 ] , 
											$arBCU[ 0 ][ "bottle" ][ 4 ] , 
											$arBCU[ 0 ][ "bottle" ][ 5 ] , 
											$arBCU[ 0 ][ "bottle" ][ 6 ] , 
											$arBCU[ 0 ][ "bottle" ][ 7 ] , 
											$arBCU[ 0 ][ "bottle" ][ 8 ] , 
											$arBCU[ 0 ][ "bottle" ][ 9 ] , 
										$arBCU[ 1 ][ "bcu" ] , 
											$arBCU[ 1 ][ "bottle" ][ 0 ] , 
											$arBCU[ 1 ][ "bottle" ][ 1 ] , 
											$arBCU[ 1 ][ "bottle" ][ 2 ] , 
											$arBCU[ 1 ][ "bottle" ][ 3 ] , 
											$arBCU[ 1 ][ "bottle" ][ 4 ] , 
											$arBCU[ 1 ][ "bottle" ][ 5 ] , 
											$arBCU[ 1 ][ "bottle" ][ 6 ] , 
											$arBCU[ 1 ][ "bottle" ][ 7 ] , 
											$arBCU[ 1 ][ "bottle" ][ 8 ] , 
											$arBCU[ 1 ][ "bottle" ][ 9 ] , 
										$arBCU[ 2 ][ "bcu" ] , 
											$arBCU[ 2 ][ "bottle" ][ 0 ] , 
											$arBCU[ 2 ][ "bottle" ][ 1 ] , 
											$arBCU[ 2 ][ "bottle" ][ 2 ] , 
											$arBCU[ 2 ][ "bottle" ][ 3 ] , 
											$arBCU[ 2 ][ "bottle" ][ 4 ] , 
											$arBCU[ 2 ][ "bottle" ][ 5 ] , 
											$arBCU[ 2 ][ "bottle" ][ 6 ] , 
											$arBCU[ 2 ][ "bottle" ][ 7 ] , 
											$arBCU[ 2 ][ "bottle" ][ 8 ] , 
											$arBCU[ 2 ][ "bottle" ][ 9 ] 
				) ;

		$obDate = new DateTime( $create_date ) ;
		$time = $obDate -> format( "H:i:s" ) ;
		unset( $obDate ) ;
		
		$arValue = array() ;
		for ( $bcu = 0 ; $bcu < SEQ_MAX_CNT_BCU ; $bcu ++ )
		{
			for ( $btl = 0 ; $btl < SEQ_MAX_CNT_BOTTLE ; $btl ++ )
			{
				$arValue = array() ;
				if ( $btl == 0 )
				{
					$arValue[ 0 ] = $time ;
					$arValue[ 1 ] = $pid ;
					$arValue[ 2 ] = $arBCU[ $bcu ][ "bcu" ] ;
				}
				else
				{
					$arValue[ 0 ] = "" ;
					$arValue[ 1 ] = "" ;
					$arValue[ 2 ] = "" ;
				}
				$arValue[ 3 ] = $arBCU[ $bcu ][ "bottle" ][ $btl ] ;
				
				$col = 0 ;
				foreach ( $arColumn[ 1 ] as $idx => $column )
				{
					if ( $column[ 3 ] > 1 )
						$objSheet -> setMerge( $row , $col , $row , $row , $col + $column[ 3 ] - 1 ) ;
					$objSheet -> setColumn( $col , $col , $column[ 1 ] ) ;
					$objSheet -> write( $row , $col , $arValue[ $idx ] ) ;

					$col ++ ;
					if ( $column[ 3 ] > 1 )
						$col += $column[ 3 ] - 1 ;
				}
				$row ++ ;
			}
		}
	}
}

?>