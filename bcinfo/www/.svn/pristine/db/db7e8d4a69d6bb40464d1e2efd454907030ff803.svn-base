<?php
//	ini_set( "display_errors" ,1 ) ;
	require_once( "../../../lib/system.php") ;
	require_once( "class/inquiry.class.php") ;

	// 基本パラメータ変換
	if ( empty( $mode ) == true )
		$mode = "update" ;

	if ( empty( $page ) == true )
		$page = 0 ;

	$obSession = new PARTS_Session() ;
	$obSession -> checkLogin( SESSION_ADMIN ) ;

	// セッションからログイン者情報を取得する
	$arr = $obSession -> getUserData( SESSION_ADMIN ) ;
	$login_adminid	= $arr[ $obSession -> obAdmin -> alias . "_adminid" ] ;
	$login_level	= $arr[ $obSession -> obAdmin -> alias . "_level" ] ;

	$blams		= new BLAMS() ;
	$obClass	= new PARTS_Inquiry() ;

	$additional = array() ;
	$additional[] = "page" ;
	$obClass -> assignGlobal( $additional ) ;

	// 検索用パラメータ変換
	if ( empty( $S_KIND ) == true )
		$S_KIND = -1 ;

	// 検索用パラメータ保存
	$arParamFind = array() ;
	$arParamFind = array() ;
	foreach( $obClass -> searchkey as $name )
		$arParamFind[ $name ] = ${ $name } ;
	$arParamFind[ "page"	] = $page			;

	// 「一覧」表示判定
	$draw_list = "  一覧" ;

	// WHERE句の初期化
	$where = sprintf( " WHERE status = 1 " ) ;

	// 日付で検索
	$S_DATE = sprintf( "%04d%02d%02d" , $S_S_Y , $S_S_M , $S_S_D ) ;
	$E_DATE = sprintf( "%04d%02d%02d" , $S_E_Y , $S_E_M , $S_E_D ) ;
	if(
		is_numeric( $S_S_Y ) && 
		is_numeric( $S_S_M ) && 
		is_numeric( $S_S_D ) && 
		is_numeric( $S_E_Y ) && 
		is_numeric( $S_E_M ) && 
		is_numeric( $S_E_D )
	)
	{
		if( checkdate( $S_S_M , $S_S_D , $S_S_Y ) && checkdate( $S_E_M , $S_E_D , $S_E_Y ) )
			$where .= sprintf( "AND ( to_char( create_date , 'YYYYMMDD' ) between '%s' AND '%s' ) " , $S_DATE , $E_DATE ) ;
	}
	else if(
		is_numeric( $S_S_Y ) && 
		is_numeric( $S_S_M ) && 
		is_numeric( $S_S_D ) && 
		$S_E_Y == "" && 
		$S_E_M == "" && 
		$S_E_D == "" 
	)
	{
		if( checkdate( $S_S_M , $S_S_D , $S_S_Y ) )
			$where .= sprintf( "AND ( to_char( create_date , 'YYYYMMDD' ) >= '%s' ) " , $S_DATE ) ;
	}
	else if(
		is_numeric( $S_E_Y ) && 
		is_numeric( $S_E_M ) && 
		is_numeric( $S_E_D ) && 
		$S_S_Y == "" && 
		$S_S_M == "" && 
		$S_S_D == "" 
	)
	{
		if( checkdate( $S_E_M , $S_E_D , $S_E_Y ) )
			$where .= sprintf( "AND ( to_char( create_date , 'YYYYMMDD' ) <= '%s' ) " , $E_DATE ) ;
	}

	if( $S_MEDIA != "" )
		$where .= sprintf( "AND media = '%s' " , $S_MEDIA ) ;

	if( $S_KIND != -1 )
		$where .= sprintf( "AND kind = '%d' " , $S_KIND ) ;

	$menu = FUNC_INQUIRY ;

	$screentype = "default" ;
	$funcname = $blams -> GetFuncName( $menu ) ;
	$header = $blams -> fetchAdminHeader( $screentype , $menu ) ;
	$footer = $blams -> fetchAdminFooter( $screentype , $menu ) ;
	
	// リスト表示
	$data = FetchList( $blams , $funcname , $arParamFind , $where , true ) ;

	// ページ全体の生成
	$contents = $blams -> fetchContents( $data ) ;

	// ナビゲーションメニュー
	$navi = $blams -> fetchSlideMenu( $menu , $login_level ) ;

	$blams -> PrintBody( $header , $footer , $contents , $navi ) ;

exit ;


// 検索フォームの生成
function	FetchSearch( $blams , $arParamFind )
{
	global $obClass ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	$arForm = array() ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( "S_S_Y" , $S_S_Y , 64 - 16  , 4 , IME_OFF ) ;
	$form  .= $blams -> fetchInputbox( "S_S_M" , $S_S_M , 48 - 16  , 2 , IME_OFF ) ;
	$form  .= $blams -> fetchInputbox( "S_S_D" , $S_S_D , 48 - 16  , 2 , IME_OFF ) ;
	$form  .= "　～　" ;
	$form  .= $blams -> fetchInputbox( "S_E_Y" , $S_E_Y , 64 - 16  , 4 , IME_OFF ) ;
	$form  .= $blams -> fetchInputbox( "S_E_M" , $S_E_M , 48 - 16  , 2 , IME_OFF ) ;
	$form  .= $blams -> fetchInputbox( "S_E_D" , $S_E_D , 48 - 16  , 2 , IME_OFF ) ;
	$value .= $blams -> fetchTDTD( "日付" , $form , 128 , 416 , "" , "left" , "middle no-wrap" , BLAMS_FORMAT_NOBORDER ) ;

	$arForm[] = $value ;

	$value = "" ;
	$form	= $blams -> fetchSelectbox( "S_KIND" , $S_KIND , $obClass -> arKind , 200 - 16 , "すべて選択" , FALSE ) ;
	$value .= $blams -> fetchTDTD( "種類" , $form , 128 , 256 , "" , "left" , "middle" , BLAMS_FORMAT_NOBORDER , 1 , 1 , 3 ) ;

	$arForm[] = $value ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, ""				) ;
	$tmpl -> assign( "list_url"			, "list.php"		) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "page"				, $page				) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "append_disable"	, false				) ;
	$data = $tmpl -> fetch( "common/search.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

//
// データの表示
//
function	FetchList( $blams , $funcname , $arParamFind , $where , $list_flg )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	// 該当データ数取得
	$sql  = "" ;
	$sql .= "SELECT count(*) as count FROM inquiry_data " ;
	$sql .= $where ;
	$obDB = new DB_Common() ;
	if ( $obDB -> isOpen() )
	{
		$record = $obDB -> executeSQL( $sql ) ;
		if ( $record )
		{
			if ( $obDB -> getDataCount( $record ) != 0 )
				$cnt = $obDB -> getValue( $record , "count" ) ;
			$obDB -> closeRecord( $record ) ;
		}
		
	}


	// 登録データがある場合
	// ページ番号の修正があるので、検索フォームの表示　は下へ
	$arList = array() ;
	if ( $cnt != 0 )
	{
		// 最大ページ数を計算する
		$maxpage = ceil( $cnt / NUMBER_PER_PAGE ) ;
		if ( $page == "" )
			$page = 0 ;
		else if ( $page >= $maxpage )
			$page = $maxpage - 1;
		$arParamFind[ "page" ] = $page ;

		$nStart = $page * NUMBER_PER_PAGE ;
		$nEnd = $page * NUMBER_PER_PAGE + NUMBER_PER_PAGE ;
		if ( $nEnd >= $cnt )
			$nEnd = $cnt ;

		// ページ移動の表示
		$paging = $blams -> fetchPaging( "list.php" , $arParamFind , $cnt , NUMBER_PER_PAGE ) ;

		// 一覧表示
		$arList = GetList( $blams , $page , $arParamFind , $where ) ;

		// ページジャンプの表示
		$pageJump = $blams -> fetchPagejump( "list.php" , $arParamFind , $maxpage , JUMP_PER_PAGE , NUMBER_PER_PAGE ) ;
	}

	// 一覧表示時のみ検索フォームが有効
	if ( $list_flg != FALSE )
	{
		// 検索フォームの表示
		$search  = FetchSearch( $blams , $arParamFind ) ;
	}
	$arHeader = array(
		array( "caption" => "名前"					, "class" => "w184 left" ) ,
		array( "caption" => "質問内容"				, "class" => "w584 left" ) ,
		array( "caption" => "登録日"				, "class" => "w128 left" ) ,
	) ;

	if( empty( $search ) == true )
		$search = "" ;

	if( empty( $paging ) == true )
		$paging = "" ;

	if( empty( $pageJump ) == true )
		$pageJump = "" ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, "list"			) ;
	$tmpl -> assign( "page"				, $page				) ;
	$tmpl -> assign( "maxline"			, NUMBER_PER_PAGE	) ;
	$tmpl -> assign( "list_flg"			, $list_flg			) ;
	$tmpl -> assign( "search"			, $search			) ;
	$tmpl -> assign( "paging"			, $paging			) ;
	$tmpl -> assign( "page_jump"		, $pageJump			) ;
	$tmpl -> assign( "header_data"		, $arHeader			) ;
	$tmpl -> assign( "list_data"		, $arList			) ;
	$tmpl -> assign( "error"			, ""				) ;
	$tmpl -> assign( "noanchor_flg"		, false				) ;
	$data = $tmpl -> fetch( "common/list.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 一覧の取得
function	GetList( $blams , $page , $arParamFind , $where )
{
	global $obClass ;
	$alias = $obClass -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	// パラメータの設定
	$param = "" ;
	$param .= $blams -> MakeParamLink( $arParamFind , "GET" ) ;

	// 表示に必要な個数だけデータを取得する
	$limit  = sprintf( " LIMIT %d OFFSET %d" , NUMBER_PER_PAGE , ( $page * NUMBER_PER_PAGE ) ) ;

	$sql = sprintf( "SELECT * FROM inquiry_data %s ORDER BY create_date desc %s" , $where ,  $limit ) ;
	$obDB = new DB_Common() ;
	if ( $obDB -> isOpen() )
	{
		$record = $obDB -> executeSQL( $sql ) ;
		if ( $record )
		{
			$cnt = $obDB -> getDataCount( $record ) ;
			for ( $index = 0 ; $index < $cnt ; $index ++ )
			{
				$arData		= $obDB -> getValues( $record , $index ) ;

				// データの取得
				$inquiryid			= $arData[ "inquiryid"			] ;
				$body				= $arData[ "message"			] ;
				$name				= $arData[ "name"				] ;
				$media				= $arData[ "media"				] ;
				$create_date		= $arData[ "create_date"		] ;

				$szBody			= mb_convert_encoding( $body , "UTF-8" , "sjis-win" ) ;
				$szBody			= mb_strimwidth( $szBody , 0 , 80 , "..." , "UTF-8" ) ;
				$szBody			= mb_convert_encoding( $szBody , "sjis-win" , "UTF-8" ) ;


				$arAnchor[ "url" 			] = "edit.php"				;
				$arAnchor[ "idname"			] = $alias . "_inquiryid"	;
				$arAnchor[ "id"				] = $inquiryid				;
				$arAnchor[ "param"			] = $param					;
				$arAnchor[ "anchor"			] = $name					;
				$arAnchor[ "caption"		] = $name					;
				$arAnchor[ "class"			] = "border left"			;
				$arAnchor[ "script"			] = ""						;
				$arAnchor[ "date_format"	] = ""						;

				$arData = array() ;
				$arData[] = $arAnchor ;
				$arData[] = array( "caption" => $szBody ,			"class" => "border left"	, "date_format" => ""			, "anchor" => "" ) ;
				$arData[] = array( "caption" => $create_date ,		"class" => "border left"	, "date_format" => "%Y/%m/%d"	, "anchor" => "" ) ;
				$arList[] = $arData ;
			}
			$obDB -> closeRecord( $record ) ;
		}
		
	}
	
	return $arList ;
}

// 検索フォームの表示
function	PrintSearch( $page , $arParamFind )
{
	$S_S_Y		= $arParamFind[ "S_S_Y"		] ;
	$S_S_M		= $arParamFind[ "S_S_M"		] ;
	$S_S_D		= $arParamFind[ "S_S_D"		] ;
	$S_E_Y		= $arParamFind[ "S_E_Y"		] ;
	$S_E_M		= $arParamFind[ "S_E_M"		] ;
	$S_E_D		= $arParamFind[ "S_E_D"		] ;
	$S_MEDIA	= $arParamFind[ "S_MEDIA"	] ;

	printf( "	<form action=\"list.php\" method=\"post\">\n" ) ;
	printf( "	<table class=\"contents\">\n" ) ;
	printf( "	<tr>\n" ) ;

	// 日付
	printf( "		<td>日付</td>\n" ) ;
	printf( "		<td>\n" ) ;
	PrintInputbox( "S_S_Y" , $S_S_Y , 40 , 4 , IME_OFF , $tab . "		" ) ;
	printf( "				/\n" ) ;
	PrintInputbox( "S_S_M" , $S_S_M , 24 , 2 , IME_OFF , $tab . "		" ) ;
	printf( "				/\n" ) ;
	PrintInputbox( "S_S_D" , $S_S_D , 24 , 2 , IME_OFF , $tab . "		" ) ;
	printf( "				　～　\n" ) ;
	PrintInputbox( "S_E_Y" , $S_E_Y , 40 , 4 , IME_OFF , $tab . "		" ) ;
	printf( "				/\n" ) ;
	PrintInputbox( "S_E_M" , $S_E_M , 24 , 2 , IME_OFF , $tab . "		" ) ;
	printf( "				/\n" ) ;
	PrintInputbox( "S_E_D" , $S_E_D , 24 , 2 , IME_OFF , $tab . "		" ) ;
	printf( "		</td>\n" ) ;

	printf( "		<td>案件名</td>\n" ) ;
	printf( "		<td>\n" ) ;
	PrintInputbox( "S_MEDIA" , $S_MEDIA , 120 , 50 , IME_ON , $tab . "		" ) ;
	printf( "		</td>\n" ) ;

	printf( "	</tr>\n" ) ;
	printf( "	</table>\n" ) ;

	printf( "<script src=\"/cmwadmin/js/inquirylist.js\" type=\"text/javascript\"></script>\n" ) ;
	printf( "	<table class=\"contents\">\n" ) ;
	printf( "	<tr>\n" ) ;
	printf( "		<td>\n" ) ;
	printf( "			<input type=\"submit\" value=\"検索\" class=\"button\">\n" ) ;
	printf( "			<input type=\"button\" value=\"エクセル出力\" class=\"button\" onClick=\"exportCSV();\">\n" ) ;
//	printf( "			<input type=\"button\" value=\"新規作成\" class=\"button\" onClick=\"newrecord.submit();\">\n" ) ;
	printf( "		</td>\n" ) ;
	printf( "	</tr>\n" ) ;
	printf( "	</table>\n" ) ;
	printf( "	</form>\n" ) ;

	printf( "	<form name=\"excel_export\" action=\"excel_export.php\" method=\"post\">\n" ) ;
	printf( "		<input type=\"hidden\" name=\"mode\" value=\"csv\">\n" ) ;
	printf( "		<input type=\"hidden\" name=\"func\" value=\"input\">\n" ) ;
	printf( "		<input type=\"hidden\" name=\"page\" value=\"%d\">\n" , $page ) ;
	printf( "		<input type=\"hidden\" name=\"S_S_Y\" value=\"%s\">\n" , $S_S_Y ) ;
	printf( "		<input type=\"hidden\" name=\"S_S_M\" value=\"%s\">\n" , $S_S_M ) ;
	printf( "		<input type=\"hidden\" name=\"S_S_D\" value=\"%s\">\n" , $S_S_D ) ;
	printf( "		<input type=\"hidden\" name=\"S_E_Y\" value=\"%s\">\n" , $S_E_Y ) ;
	printf( "		<input type=\"hidden\" name=\"S_E_M\" value=\"%s\">\n" , $S_E_M ) ;
	printf( "		<input type=\"hidden\" name=\"S_E_D\" value=\"%s\">\n" , $S_E_D ) ;
	printf( "		<input type=\"hidden\" name=\"S_MEDIA\" value=\"%s\">\n" , $S_MEDIA ) ;
	printf( "	</form>\n" ) ;
	printf( "	<br>\n" ) ;
}

// 一覧表示
function	PrintList( $page , $arParamFind , $where )
{
	// パラメータの設定
	$param = sprintf( "&page=%d" , $page ) ;
	$keys = array_keys( $arParamFind ) ;
	$values = array_values( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
	{
		$param .= sprintf( "&%s=%s" , $keys[ $i ] , $values[ $i ] ) ;
	}

	// 表示に必要な個数だけデータを取得する
	$limit  = sprintf( " LIMIT %d OFFSET %d" , NUMBER_PER_PAGE , ( $page * NUMBER_PER_PAGE ) ) ;

	$sql  = "" ;
	$sql .= sprintf( "SELECT * FROM inquiry_data %s ORDER BY create_date desc %s" , $where ,  $limit ) ;
	$obDB = new DB_Common() ;
	if ( $obDB -> isOpen() )
	{
		$record = $obDB -> executeSQL( $sql ) ;
		if ( $record )
		{
			$cnt = $obDB -> getDataCount( $record ) ;
			if ( $cnt != 0 )
			{
				printf( "	<!-- 表示開始  -->\n" ) ;
				printf( "	<table class=\"contents\">\n" ) ;
				printf( "	<tr class=\"list_title\">\n" ) ;
				printf( "		<td class=\"list_line\"><span class=\"inquiry_id\">No</span></td>\n" ) ;
				printf( "		<td class=\"list_line\"><span class=\"inquiry_name\">名前</span></td>\n" ) ;
				printf( "		<td class=\"list_line\"><span class=\"inquiry_name\">案件名</span></td>\n" ) ;
				printf( "		<td class=\"list_line\"><span class=\"inquiry_body\">質問内容</span></td>\n" ) ;
				printf( "		<td class=\"list_line\"><span class=\"inquiry_cdate\">登録日</span></td>\n" ) ;
				printf( "	</tr>\n" ) ;
			}

			for ( $index = 0 ; $index < $cnt ; $index ++ )
			{
				$clr = $index % 2 ;

				// データの取得
				$inquiryid		= $obDB -> getValue( $record , "inquiryid"		, $index ) ;
				$body			= $obDB -> getValue( $record , "message"			, $index ) ;
				$name			= $obDB -> getValue( $record , "name"			, $index ) ;
				$media			= $obDB -> getValue( $record , "media"			, $index ) ;
				$create_date	= $obDB -> getValue( $record , "create_date"		, $index ) ;

				$szBody			= mb_convert_encoding( $body , "UTF-8" , "sjis-win" ) ;
				$szBody			= mb_strimwidth( $szBody , 0 , 40 , "..." , "UTF-8" ) ;
				$szBody			= mb_convert_encoding( $szBody , "sjis-win" , "UTF-8" ) ;
				$szCreateDate	= date2( "Y/m/d" , $create_date ) ;

				printf( "	<tr class=\"list_line%d\">\n" , $clr ) ;
				printf( "		<td class=\"list_line\">" ) ;
				printf( "<span class=\"inquiry_id\">%s</span>" , $page * NUMBER_PER_PAGE + $index + 1) ;
				printf( "</td>\n" ) ;
				printf( "		<td class=\"list_line\">" ) ;
				printf( "<span class=\"inquiry_name\">" ) ;
				printf( "<a href=\"edit.php?inquiryid=%d%s&mode=update\" class=\"list_line\">" , $inquiryid , $param ) ;
				printf( "%s</a></span></td>\n" , HTMLencode ( $name ) ) ;
				printf( "		<td class=\"list_line\"><span class=\"inquiry_name\">%s</span></td>\n" , HTMLencode( $media ) ) ;
				printf( "		<td class=\"list_line\"><span class=\"inquiry_body\">%s</span></td>\n" , HTMLencode( $szBody ) ) ;
				printf( "		<td class=\"list_line\"><span class=\"inquiry_cdate\">%s</span></td>\n" , HTMLencode( $szCreateDate ) ) ;
				printf( "	</tr>\n" ) ;
			}

			if ( $cnt != 0 )
			{
				printf( "	</table>\n" ) ;
				printf( "	<!-- 表示終了  -->\n" ) ;
			}
			$obDB -> closeRecord( $record ) ;
		}
		
	}
}


?>
