function	downloadCountUpdate( cid , dlcnt , dltotal )
{
	var objParent = window.parent.document ;
	
	if ( objParent )
	{
		var spanid = "dlcnt-" + cid ;
		var objSpan = objParent.getElementById( spanid ) ;
		if ( objSpan )
		{
			objSpan.innerHTML = dlcnt ;
		}

		var spanid = "dltotal" ;
		var objSpan = objParent.getElementById( spanid ) ;
		if ( objSpan )
		{
			objSpan.innerHTML = dltotal ;
		}
	}
	
}
