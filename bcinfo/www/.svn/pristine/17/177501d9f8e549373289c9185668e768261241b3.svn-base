<?php
	ini_set( "display_errors" , 1 ) ;
	require_once( "server.ini.php" ) ;
	require_once( "conf/user.ini.php" ) ;
	require_once( "class/blams.class.php" ) ;
	require_once( "class/terminal.class.php" ) ;
	
	ob_implicit_flush() ;
	
	//print_r( $argv ) ;

	$blams = new BLAMS() ;
	$blams -> WriteSyslog( "NAC SERVER START" ) ;

	if ( empty( $argv[ 1 ] ) == false )
	{
		// コマンド解析
		$cmd = $argv[ 1 ] ;
		$func = "" ;
		if ( empty( $argv[ 2 ] ) == false )
			$func = $argv[ 2 ] ;
	
		if ( $cmd == "CL" )
		{
			$blams -> WriteSyslog( "client mode:" . $func ) ;
		
			NacRecvFile( $func ) ;
		}
		else if ( $cmd == "SV" )
		{
			$blams -> WriteSyslog( "server mode" ) ;
			SeqRecvData( $blams ) ;
		}
	}
exit ;

function	NacRecvFile( $cmd )
{
	$obTerminal = new PARTS_Terminal() ;
	$obTerminal -> skip_check = true ;
	$alias = $obTerminal -> alias ;

	$dir = sprintf( "%s/%s*.txt" , NAC_DATA_FOLDER_RECV , $cmd ) ;
	
	foreach ( glob( $dir ) as $orgpath )
	{
		clearstatcache() ;
		$stat = stat( $orgpath ) ;
		$orgfile = basename( $orgpath ) ;
		$tmpfile = basename( $orgpath , ".txt" ) ;
		$tmpfile = $tmpfile . ".~~~" ;
		$tmppath = sprintf( "%s/%s" , NAC_DATA_FOLDER_SEND , $tmpfile ) ;
		
		// テンポラリファイルへ名前を変更する
		@rename( $orgpath , $tmppath ) ;
		
		// ファイルの中身を取り出し、DBに保存する
		$fp = fopen( $tmppath , "r" ) ;
		if ( $fp )
		{
			while ( feof( $fp ) == false )
			{
				$data = trim( fgets( $fp ) ) ;
				
				if ( empty( $data ) == false )
				{
					$arParam = array() ;
					$arParam[ $alias . "_command"	] = $cmd ;
					$arParam[ $alias . "_filename"	] = $orgfile ;
					$arParam[ $alias . "_data"		] = $data ;
					
					$obTerminal -> insertData( $arParam ) ;
				}
			}
		}	
		// ファイルを削除する
		@unlink( $tmppath ) ;
	}
}

// 電文解析
function	SeqRecvData( $blams )
{
	$result = 20 ;

	// 標準入力からシーケンサーからの電文受信
	$stdin = fopen( 'php://stdin','r' );
	if ( $stdin )
	{
		$recv = trim( fgets( $stdin , 8192 ) , "\r\n" ) ;
		
		// 先頭の10バイトのデータを取り出す
		$cmd = trim( substr( $recv , 0 , 10 ) ) ;
		$data = substr( $recv , 10 ) ;
		
		switch ( $cmd )
		{
		case	NAC_STORAGE_WASH :		// 洗浄ライン入庫
			$result = SeqStorageWash( $cmd , $data ) ;
			break ;
		
		case	NAC_STORAGE_PRODUCT :	// 製品ライン入庫
			$result = SeqStorageProduct( $cmd , $data ) ;
			break ;
		
		case	NAC_SHIPPING_REQ :		// ボトルコンテナ取り出し要求
			$result = SeqShippingReq	( $cmd , $data ) ;
			break ;
		
		case	NAC_BCRDATA :			// ボトルコンテナID読み込み
			$result = SeqBCData( $cmd , $data ) ;
			break ;
		}
		
		// 標準出力へ電文送信
		$blams -> WriteSyslog( $cmd ) ;
		$blams -> WriteSyslog( "Data Length : " . strlen( $data ) ) ;
		$blams -> WriteSyslog( $data ) ;
	}
	
	$res = sprintf( "RES %04d\r\n" , $result ) ;
	echo $res ;
	$blams -> WriteSyslog( trim( $res ) ) ;
}

// 入庫要求（製品ライン）
function	SeqStorageProduct( $cmd , $data )
{
	$result = 20 ;

	if ( strlen( $data ) == SEQ_LEN_STORAGE )
	{
		$obTerminal = new PARTS_Terminal() ;
		$obTerminal -> skip_check = true ;
		$alias = $obTerminal -> alias ;
	
		$date = new DateTime() ;
		$usec = microtime() * 1000 % 1000 ;
		$tmpfile = sprintf( "%s%s%03d.~~~" , NAC_STORAGE_PRODUCT , $date -> format( "ymdHis" ) , $usec ) ;
		$orgfile = sprintf( "%s%s%03d.txt" , NAC_STORAGE_PRODUCT , $date -> format( "ymdHis" ) , $usec ) ;
		$tmppath = sprintf( "%s/%s" , NAC_DATA_FOLDER_SEND , $tmpfile ) ;
		$orgpath = sprintf( "%s/%s" , NAC_DATA_FOLDER_SEND , $orgfile ) ;
		
		$fp = fopen( $tmppath , "w+" ) ;
		if ( $fp )
		{
			$arBCU = array() ;
			$fmt  = sprintf( "%%%dd%%%ds" , SEQ_MAX_LINE , SEQ_MAX_PRODUCTID ) ;
			for ( $bcu = 0 ; $bcu < SEQ_MAX_CNT_BCU ; $bcu ++ )
			{
				$arBCU[ $bcu ] = array() ;
				$arBCU[ $bcu ][ "bottle" ] = array() ;

				$fmt .= sprintf( "%%%ds" , SEQ_MAX_BCUID ) ;
				for ( $btl = 0 ; $btl < SEQ_MAX_CNT_BOTTLE ; $btl ++ )
					$fmt .= sprintf( "%%%ds" , SEQ_MAX_BOTTLECODE ) ;
			}
	
			sscanf( $data , $fmt , $line ,	$pid ,
											$arBCU[ 0 ][ "bcu" ] , 
												$arBCU[ 0 ][ "bottle" ][ 0 ] , 
												$arBCU[ 0 ][ "bottle" ][ 1 ] , 
												$arBCU[ 0 ][ "bottle" ][ 2 ] , 
												$arBCU[ 0 ][ "bottle" ][ 3 ] , 
												$arBCU[ 0 ][ "bottle" ][ 4 ] , 
												$arBCU[ 0 ][ "bottle" ][ 5 ] , 
												$arBCU[ 0 ][ "bottle" ][ 6 ] , 
												$arBCU[ 0 ][ "bottle" ][ 7 ] , 
												$arBCU[ 0 ][ "bottle" ][ 8 ] , 
												$arBCU[ 0 ][ "bottle" ][ 9 ] , 
											$arBCU[ 1 ][ "bcu" ] , 
												$arBCU[ 1 ][ "bottle" ][ 0 ] , 
												$arBCU[ 1 ][ "bottle" ][ 1 ] , 
												$arBCU[ 1 ][ "bottle" ][ 2 ] , 
												$arBCU[ 1 ][ "bottle" ][ 3 ] , 
												$arBCU[ 1 ][ "bottle" ][ 4 ] , 
												$arBCU[ 1 ][ "bottle" ][ 5 ] , 
												$arBCU[ 1 ][ "bottle" ][ 6 ] , 
												$arBCU[ 1 ][ "bottle" ][ 7 ] , 
												$arBCU[ 1 ][ "bottle" ][ 8 ] , 
												$arBCU[ 1 ][ "bottle" ][ 9 ] , 
											$arBCU[ 2 ][ "bcu" ] , 
												$arBCU[ 2 ][ "bottle" ][ 0 ] , 
												$arBCU[ 2 ][ "bottle" ][ 1 ] , 
												$arBCU[ 2 ][ "bottle" ][ 2 ] , 
												$arBCU[ 2 ][ "bottle" ][ 3 ] , 
												$arBCU[ 2 ][ "bottle" ][ 4 ] , 
												$arBCU[ 2 ][ "bottle" ][ 5 ] , 
												$arBCU[ 2 ][ "bottle" ][ 6 ] , 
												$arBCU[ 2 ][ "bottle" ][ 7 ] , 
												$arBCU[ 2 ][ "bottle" ][ 8 ] , 
												$arBCU[ 2 ][ "bottle" ][ 9 ] 
					) ;
			
			$data = "" ;
			// ボトルコードを解析しながら電文を作成する
			for ( $bcu = 0 ; $bcu < SEQ_MAX_CNT_BCU ; $bcu ++ )
			{
				$data .= sprintf( "%d%s%-10s" , $line , $pid , $arBCU[ $bcu ][ "bcu" ] ) ;

				$arCool = array() ;
				for ( $btl = 0 ; $btl < SEQ_MAX_CNT_BOTTLE ; $btl ++ )
				{
					// 全て'0'の場合はボトルリードエラーのデータなので無視する
					$fmt = sprintf( "%%0%dd" , SEQ_MAX_BOTTLECODE ) ;
					if ( $arBCU[ $bcu ][ "bottle" ][ $btl ] != sprintf( $fmt , 0 ) )
					{
						$fmt = sprintf( "%%%ds/UNO.%%%dd-%%%dd" , SEQ_MAX_LIMITDATE , SEQ_MAX_NOCOUNTER , SEQ_MAX_COOL ) ;
						sscanf( $arBCU[ $bcu ][ "bottle" ][ $btl ] , $fmt , $limit , $nocounter , $cool ) ;
	
						$limit = str_replace( "." , "-" , $limit ) ;
	//					$ldate = new DateTime( $limit ) ;
						$ldate = new DateTime() ;
						$limit = $ldate -> format( "Ymd" ) ;
						unset( $ldate ) ;
						$cool = sprintf( "%03d%8s" , $cool , $limit ) ;
	
						if ( isset( $arCool[ $cool ] ) == false )
							$arCool[ $cool ] = 0 ;
						else
							$arCool[ $cool ] ++ ;
					}
				}

				$fmt = sprintf( "%%%ds" , ( NAC_MAX_COOL + NAC_MAX_STORAGE_DATE ) * 3 ) ;
				$dumy = sprintf( $fmt , "" ) ;
				$cool = "" ;
				foreach ( $arCool as $key => $val )
					$cool .= $key ;
				$cool .= $dumy ;
				$cool = substr( $cool , 0 , ( NAC_MAX_COOL + NAC_MAX_STORAGE_DATE ) * 3 ) ;
				
				$data .= $cool ;
				$data .= "\r\n" ;
			}
			
			$result = 40 ;
			if ( fwrite( $fp , $data ) )
			{
				// DBに保存
				$arParam = array() ;
				$arParam[ $alias . "_command"	] = $cmd ;
				$arParam[ $alias . "_filename"	] = $orgfile ;
				$arParam[ $alias . "_data"		] = $data ;
					
				$obTerminal -> insertData( $arParam ) ;
				
//				@rename( $tmppath , $orgpath ) ;
				
				$result = 0 ;
			
			}

			fclose( $fp ) ;
		}
	}
	else
		$result = 10 ;
	
	return $result ;
}

// 入庫要求（洗浄ライン）
function	SeqStorageWash( $cmd , $data )
{
	$result = 20 ;

	if ( strlen( $data ) == SEQ_LEN_WASH )
	{
		$obTerminal = new PARTS_Terminal() ;
		$obTerminal -> skip_check = true ;
		$alias = $obTerminal -> alias ;
	
		$date = new DateTime() ;
		$usec = microtime() * 1000 % 1000 ;
		$tmpfile = sprintf( "%s%s%03d.~~~" , NAC_STORAGE_WASH , $date -> format( "ymdHis" ) , $usec ) ;
		$orgfile = sprintf( "%s%s%03d.txt" , NAC_STORAGE_WASH , $date -> format( "ymdHis" ) , $usec ) ;
		$tmppath = sprintf( "%s/%s" , NAC_DATA_FOLDER_SEND , $tmpfile ) ;
		$orgpath = sprintf( "%s/%s" , NAC_DATA_FOLDER_SEND , $orgfile ) ;
		
		$fp = fopen( $tmppath , "w+" ) ;
		if ( $fp )
		{
			$fmt  = sprintf( "%%%dd" , SEQ_MAX_LINE ) ;
			for ( $bcu = 0 ; $bcu < SEQ_MAX_CNT_BCU ; $bcu ++ )
			{
				$fmt .= sprintf( "%%%ds" , SEQ_MAX_PRODUCTID ) ;
				$fmt .= sprintf( "%%%ds" , SEQ_MAX_BCUID ) ;
			}
			sscanf( $data , $fmt , $line , $pid1 , $bcuid1 , $pid2 , $bcuid2 , $pid3 , $bcuid3 ) ;
			
			$data  = sprintf( "%d%s%-10s%33s\r\n" , $line , $pid1 , $bcuid1 , "" ) ;
			$data .= sprintf( "%d%s%-10s%33s\r\n" , $line , $pid2 , $bcuid2 , "" ) ;
			$data .= sprintf( "%d%s%-10s%33s\r\n" , $line , $pid3 , $bcuid3 , "" ) ;
			$result = 40 ;
			if ( fwrite( $fp , $data ) )
			{
				// DBに保存
				$arParam = array() ;
				$arParam[ $alias . "_command"	] = $cmd ;
				$arParam[ $alias . "_filename"	] = $orgfile ;
				$arParam[ $alias . "_data"		] = $data ;
					
				$obTerminal -> insertData( $arParam ) ;
				
				@rename( $tmppath , $orgpath ) ;
				
				$result = 0 ;
			
			}
			fclose( $fp ) ;
		}
	}
	else
		$result = 10 ;
		
	return $result ;
}

// BCU取り出し
function	SeqShippingReq	( $cmd , $data )
{
	$result = 20 ;

	$obTerminal = new PARTS_Terminal() ;
	$obTerminal -> skip_check = true ;
	$alias = $obTerminal -> alias ;

	$fmt = sprintf( "%%%dd%%%ds" , SEQ_MAX_LINE , SEQ_MAX_PRODUCTID ) ;
	sscanf( $data , $fmt , $kind , $pid ) ;

	$loop = 1 ;
	if ( $kind == NAC_KIND_START )
		$loop = 4 ;

	for ( $i = 0 ; $i < $loop ; $i ++ ) 
	{
		$date = new DateTime() ;
		$usec = microtime() * 1000 % 1000 ;
		$tmpfile = sprintf( "%s%s%03d.~~~" , NAC_BCRDATA , $date -> format( "ymdHis" ) , $usec ) ;
		$orgfile = sprintf( "%s%s%03d.txt" , NAC_BCRDATA , $date -> format( "ymdHis" ) , $usec ) ;
		$tmppath = sprintf( "%s/%s" , NAC_DATA_FOLDER_SEND , $tmpfile ) ;
		$orgpath = sprintf( "%s/%s" , NAC_DATA_FOLDER_SEND , $orgfile ) ;
		
		$fp = fopen( $tmppath , "w+" ) ;
		if ( $fp )
		{
			$data = sprintf( "%d%s\r\n" , $kind , $pid ) ;
			$result = 40 ;
			if ( fwrite( $fp , $data ) )
			{
				// DBに保存
				$arParam = array() ;
				$arParam[ $alias . "_command"	] = $cmd ;
				$arParam[ $alias . "_filename"	] = $orgfile ;
				$arParam[ $alias . "_data"		] = $data ;
					
				$obTerminal -> insertData( $arParam ) ;
				
				@rename( $tmppath , $orgpath ) ;
				
				$result = 0 ;
			
			}
			fclose( $fp ) ;
		}
	}
	
	return $result ;
}

// BCR読み取り
function	SeqBCData( $cmd , $data )
{
	$result = 20 ;

	$obTerminal = new PARTS_Terminal() ;
	$obTerminal -> skip_check = true ;
	$alias = $obTerminal -> alias ;

	$date = new DateTime() ;
	$usec = microtime() * 1000 % 1000 ;
	$tmpfile = sprintf( "%s%s%03d.~~~" , NAC_BCRDATA , $date -> format( "ymdHis" ) , $usec ) ;
	$orgfile = sprintf( "%s%s%03d.txt" , NAC_BCRDATA , $date -> format( "ymdHis" ) , $usec ) ;
	$tmppath = sprintf( "%s/%s" , NAC_DATA_FOLDER_SEND , $tmpfile ) ;
	$orgpath = sprintf( "%s/%s" , NAC_DATA_FOLDER_SEND , $orgfile ) ;
	
	$fp = fopen( $tmppath , "w+" ) ;
	if ( $fp )
	{
		$data = sprintf( "%-10s\r\n" , $data ) ;
		$result = 40 ;
		if ( fwrite( $fp , $data ) )
		{
			// DBに保存
			$arParam = array() ;
			$arParam[ $alias . "_command"	] = $cmd ;
			$arParam[ $alias . "_filename"	] = $orgfile ;
			$arParam[ $alias . "_data"		] = $data ;
				
			$obTerminal -> insertData( $arParam ) ;
			
			@rename( $tmppath , $orgpath ) ;
			
			$result = 0 ;
		
		}
		fclose( $fp ) ;
	}
	
	return $result ;
}

?>
