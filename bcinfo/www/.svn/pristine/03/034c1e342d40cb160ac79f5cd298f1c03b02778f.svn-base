	$tmpl -> assign( "subsidiary_data"	, $arOccupation ) ;
	$tmpl -> assign( "corp_data"	, $arCorp ) ;
	$data = $tmpl -> fetch( $tmplFils ) ;
	unset( $tmpl ) ;

	return $data ;
}

