/*
-------------------------------------------------------------------------------
	Header
-------------------------------------------------------------------------------
*/

#header
{
	height: 60px ;
	text-align : left ;
	padding : 0px ;
	background: #fff url("/admin/img/sys_title/notitle.png") repeat-x top left ;
}
* html #_header	{	height: 60px ;	}

#header h1
{
	display : block ;
	height : 60px ;
	width : 320px ;
	height : 60px ;
	color : #fff ;
	font-size: 1px ;
	text-indent : -9999px ;
	background : transparent url("/admin/img/sys_title/title.png") no-repeat top left ;
}

#header:after
{
	content : "." ;
	display : block ;
	height : 0px ;
	clear : both ;
	visibility : hidden ;
}


/*
-------------------------------------------------------------------------------
	Header Menu
-------------------------------------------------------------------------------
*/
#headerMenu
{
	height : 32px ;
	line-height : 32px ;
	text-align : left ;
	vertical-align : middle ;
	background-color : #000 ;
	border-bottom : #AD5963 solid 2px ;
}

#headerMenu h2
{
	display : block ;
	float : left ;
	color : #fff ;
	font-size : 0.9em ;
	height : 32px ;
	line-height : 32px ;
	text-align : left ;
	vertical-align : middle ;
	padding-left : 16px ;
}

#headerMenu p
{
	display : block ;
	float : right ;
	height : 28px ;
	line-height : 28px ;
	text-align : right ;
	vertical-align : middle ;
}

#headerMenu p a ,
#headerMenu p a.long
{
	display : block ;
	float : left ;
	outline : none ;
	color : #cc0000 ;
	width : 48px ;
	height : 14px ;
	line-height : 14px ;
	font-size: 13px ;
	font-weight : bold ;
	text-align : center;
	text-decoration : none ;
	border : 1px solid #93b ;
	margin : 8px 4px 0px auto ;
}

#headerMenu p a.long	{	width : 128px ;	}

#headerMenu p a:link		{ color : #009 ; background-color:#fff; text-decoration:none; }
#headerMenu p a:visited		{ color : #009 ; background-color:#fff; text-decoration:none; }
#headerMenu p a:hover		{ color : #fff ; background-color:#009; text-decoration:none; }
#headerMenu p a:active		{ color : #009 ; background-color:#fff; text-decoration:none; }

#headerMenu:after
{
	content : "." ;
	display : block ;
	height : 0px ;
	clear : both ;
	visibility : hidden ;
}
