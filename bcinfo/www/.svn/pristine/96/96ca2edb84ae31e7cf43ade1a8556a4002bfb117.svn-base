<?php
	ini_set( "display_errors" , 1 ) ;
	require_once( "server.ini" ) ;
	
	ob_implicit_flush() ;
	
	//print_r( $argv ) ;
	

	if ( empty( $argv[ 1 ] )
	{
		// コマンド解析
		$cmd = $argv[ 1 ] ;
		$func = "" ;
		if ( empty( $argv[ 1 ] )
			$func = $argv[ 2 ] ;
	
		if ( $cmd == "CL" )
		{
			WriteSyslog( "client mode:" . $func ) ;
		
			// 機能種別
			switch ( $func )
			{
			// 在庫情報
			case	NAC_STORAGE_LIST :
				NacStorageList() ;
				break ;
			
			// 空棚情報
			case	NAC_FREE_LOCATION :
				NacFreeLocation() ;
				break ;
			}
		}
		else if ( $cmd == "SV" )
		{
			WriteSyslog( "server mode" ) ;
			SeqRecvData() ;
		}
	}
exit ;

