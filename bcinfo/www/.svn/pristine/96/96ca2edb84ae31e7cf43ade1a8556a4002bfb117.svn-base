// 電文解析
function	SeqRecvData()
{
	// 標準入力からシーケンサーからの電文受信
	$stdin = trim(fgets(STDIN));
			
	// 標準出力へ電文送信
	echo $stdin ;
	echo "\r\n" ;
}

