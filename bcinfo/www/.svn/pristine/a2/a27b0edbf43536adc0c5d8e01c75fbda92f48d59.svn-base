<?php
//	ini_set( "display_errors" , 1 ) ;
	require_once( "../../../lib/system.php") ;

	if ( empty( $page ) == true )
		$page = 0 ;

	$mode = "" ;
	$func = "" ;

	// 登録ボタン名によって処理を分ける
	$arMode = array( "append" , "update" , "delete" ) ;
	GetSystemMode( $mode , $func , $arMode ) ;

	$obSession = new PARTS_Session() ;
	$obSession -> checkLogin( SESSION_ADMIN ) ;

	// セッションからログイン者情報を取得する
	$arr = $obSession -> getUserData( SESSION_ADMIN ) ;
	$login_adminid	= $arr[ $obSession -> obAdmin -> alias . "_adminid" ] ;
	$login_level	= $arr[ $obSession -> obAdmin -> alias . "_level" ] ;

	$blams		= new BLAMS() ;
	$obPrice	= new PARTS_Price() ;

	$alias 		= $obPrice -> alias ;
	$primarykey	= $obPrice -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	// 編集データ保存
	$arParam = array() ;

	$additional = array() ;
	$additional[] = "page" ;
	$obPrice -> assignGlobal( $additional , $arParam ) ;

	// 検索用パラメータ保存
	$arParamFind = array() ;
	foreach( $obPrice -> searchkey as $name )
		$arParamFind[ $name ] = ${ $name } ;
	$arParamFind[ "page"	] = $page			;

	// データ取得時のキー初期化
	$getdatakey = ${ $alias . "_priceid" } ;

	// タイトル取得時のキー初期化
	$menu = FUNC_CARRIAGE ;

	$screentype = "default" ;
	$funcname = $blams -> GetFuncName( $menu ) ;
	$header = $blams -> fetchAdminHeader( $screentype , $menu ) ;
	$footer = $blams -> fetchAdminFooter( $screentype , $menu ) ;

	$error = "" ;
	switch ( $mode )
	{
	// 新規登録モード
	case "append" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 新規入力" , $funcname ) ;

			// 入力フォーム画面への初回遷移時のみ、データを初期化
			if ( $func != "back" )
			{
				$obPrice -> initData( $arParam ) ;
			}

			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;

			break ;

		// 新規確認画面
		case "confrm" :

			// 入力データ検査
			$error = $obPrice -> checkData( $mode , $func , $arParam ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 新規入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			}
			break ;

		// 新規完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 登録処理" , $funcname ) ;

			// 新規登録実施
			if ( $obPrice -> insertData( $arParam ) == TRUE )
			{
				$error = "正常に登録されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・登録に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;
			break ;
		}
		break ;

	// 更新モード
	case "update" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

			// 入力フォーム画面への初回遷移時のみ、データをDBから再取得（初期化）
			if ( $func != "back" )
			{
				// データをDBから再取得（初期化）
				$arParam = GetData( $getdatakey ) ;
				$now_date = new DateTime();
				$now = $now_date -> format( "Y-m-d H:i:s" ) ;
				$arParam[ "update_date" ] = $now ;
			}

			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			break ;

		// 更新確認画面
		case "confrm" :

			// 入力データ検査
			$error = $obPrice -> checkData( $mode , $func , $arParam ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			}
			break ;

		// 更新完了画面
		case "done" :
			// タイトルの表示
			$subfuncname = sprintf( "%s 更新処理" , $funcname ) ;

			// 更新登録実施
			if ( $obPrice -> updateData( $arParam ) == TRUE )
			{
				$error = "正常に更新されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・更新に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;
			break ;

		// 初期画面、もしくはFunctionの指定がない場合
		default :

			// タイトルの表示
			$subfuncname = sprintf( "%s 詳細表示" , $funcname ) ;

			// データをDBから再取得（初期化）
			$arParam = GetData( $getdatakey ) ;

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			break ;
		}
		break ;

	// 削除モード
	case "delete" :

		// 機能分岐
		switch( $func )
		{

		// 削除確認画面
		case "confrm" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 削除確認" , $funcname ) ;

			// 削除確認メッセージ表示
//			$error  = "【重要】\n" ;
//			$error .= "・" . $funcname ;
//			$error .= "を削除すると、該当会員はその後ログインできなくなります。<br>\n" ;

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			break ;

		// 削除完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 削除処理" , $funcname ) ;

			// 削除処理実施
			if ( $obPrice -> deleteData( $arParam ) == TRUE )
			{
				$error = "正常に削除されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・削除に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;
			break ;
		}
		break ;
	}

	// 「一覧に戻る」の表示
	if ( $mode != "append" )
		$pageback = $blams -> fetchPageback( "list.php" , $arParamFind ) ;
	else
		$pageback = "" ;

	// ページ全体の生成
	$contents = $blams -> FetchContents( $pageback . $data ) ;

	// ナビゲーションメニュー
	$navi = $blams -> fetchSlideMenu( $menu , $login_level ) ;

	$blams -> PrintBody( $header , $footer , $contents , $navi ) ;

exit ;

// ボタンの表示
function	FetchButton( $blams , $mode , $func )
{
	$arProcess = array(
		//					ボタン名								MODE							Action
		"list"				=>	array( "value" => "一覧に戻る"		, "name" => "list"				, "action" => "list.php"	, "target" => "" , "org_action" => "" ) ,
		"detail"			=>	array( "value" => "詳細に戻る"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"append_confrm"		=>	array( "value" => "新規確認"		, "name" => "append[confrm]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"append_done"		=>	array( "value" => "登録します"		, "name" => "append[done]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"append_cancel"		=>	array( "value" => "キャンセル"		, "name" => "append[cancel]"	, "action" => "list.php"	, "target" => "" , "org_action" => "" ) ,
		"append_back"		=>	array( "value" => "戻る"			, "name" => "append[back]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"update_input"		=>	array( "value" => "更新"			, "name" => "update[input]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_confrm"		=>	array( "value" => "更新確認"		, "name" => "update[confrm]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_done"		=>	array( "value" => "更新します"		, "name" => "update[done]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_back"		=>	array( "value" => "戻る"			, "name" => "update[back]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"delete_confrm"		=>	array( "value" => "削除"			, "name" => "delete[confrm]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"delete_done"		=>	array( "value" => "削除します"		, "name" => "delete[done]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"delete_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
	) ;

	$arOperation = array() ;
	switch( $mode )
	{
	case "append" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "append_confrm" , "append_cancel" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "append_done" , "append_back" ) ;
			break ;
		case "done" :
			$arOperation = array( "list" ) ;
			break ;
		}
		break ;

	case "update" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "update_confrm" , "update_cancel" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "update_done" , "update_back" ) ;
			break ;
		case "done" :
			$arOperation = array( "detail" ) ;
			break ;
		default :
			$arOperation = array( "update_input" , "delete_confrm" ) ;
			break ;
		}
		break ;

	case "delete" :
		switch( $func )
		{
		case "confrm" :
			$arOperation = array( "delete_done" , "delete_cancel" ) ;
			break ;
		case "done" :
			$arOperation = array( "list" ) ;
			break ;
		}
		break ;
	}

	$arButton = array() ;
	for ( $i = 0 ; $i < count( $arOperation ) ; $i ++ )
		$arButton[] = $arProcess[ $arOperation[ $i ] ] ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "id"				, "edit_form"		) ;
	$tmpl -> assign( "button_data"		, $arButton			) ;
	$data = $tmpl -> fetch( "common/button.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;

}

// データ取得
function	GetData( $getdatakey )
{
	global $obPrice ;
	$alias = $obPrice -> alias ;
	$arWhere = array() ;
	$arWhere[ "priceid" ] = $getdatakey ;
	$arTemp = $obPrice -> getData( $arWhere ) ;

	$arResult = array() ;
	foreach( $arTemp[ 0 ] as $key => $value )
	{
		$arResult[ $alias . "_" . $key ] = $value ;
	}

	return $arResult ;
}

// 詳細表示
function	FetchDetail( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_adminid , $login_level )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	global $obPrice ;
	$alias = $obPrice -> alias ;

	$obCorp	= new PARTS_Corp() ;

	// 社名
	$szCorpName = "" ;
	$arCorp = array() ;
	$arCorp = $obCorp -> getAt( ${ $alias . "_corpid" } ) ;
	$szCorpName = $arCorp[ $obCorp -> alias . "_lname" ] ;

	if( $szCorpName == "" )
		$szCorpName = "不明" ;

	// 住所
	global	$arState ;
	$szState  = $arState[ ${ $alias . "_state" } ][ 2 ] ;

	// 料金種類
	global	$arCarriage ;
	$szCarriage  = $arCarriage[ ${ $alias . "_type" } ] ;
	if ( empty( $szCarriage ) === true )
		$szCarriage = "不明" ;

	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;

	$arForm = array() ;

	$value = "" ;
	$value .= $blams -> FetchTHTD( "社名" , $szCorpName , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> FetchTHTD( "都道府県" , $szState , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$value .= $blams -> FetchTHTD( "市町村" , ${ $alias . "_city" } , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> FetchTHTD( "料金種類" , $szCarriage , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	if ( ${ $alias . "_tax" } == 0 )
		$value .= $blams -> FetchTHTD( "送料（税抜）" , "（内税）" , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	else
		$value .= $blams -> FetchTHTD( "送料（税抜）" , ${ $alias . "_tax" } . "&nbsp;円" , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_NUMBER ) ;
	$value .= $blams -> FetchTHTD( "送料（税込）" , ${ $alias . "_price" } . "&nbsp;円" , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_NUMBER ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> FetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$arForm[] = $value ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "input_data"		, $arParam			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/confrm.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 入力フォームの表示
function	FetchInput( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_level )
{
	global $obPrice ;
	$alias = $obPrice -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	// 都道府県テーブル生成
	global	$arStateName ;
	$arState_local = array() ;
	$arState_local = array( DEF_PRICE_COMMON => "全国一律" ) + $arStateName ;

	$obCorp			= new PARTS_Corp() ;
	$arWhere = array() ;
	$arCorp_local = $obCorp -> getList( $arWhere ) ;

	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$isize	= $vsize - 16 ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;
	$isize3	= $vsize3 - 16 ;

	$arForm = array() ;

	$value = "" ;
	$form   = $blams -> FetchSelectbox( $alias . "_corpid" , ${ $alias . "_corpid" } , $arCorp_local , $isize ,  "選択してください。" , FALSE , "" ) ;
	$value .= $blams -> FetchTHTD( "社名 ※" , $form , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> FetchSelectbox( $alias . "_state" , ${ $alias . "_state" } , $arState_local , $isize ,  "選択してください。" , FALSE , "" ) ;
	$value .= $blams -> FetchTHTD( "都道府県 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$form   = $blams -> FetchInputbox( $alias . "_city" , ${ $alias . "_city" } , $isize  , MAX_CITY , IME_ON ) ;
	$value .= $blams -> FetchTHTD( "市町村" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	global $arCarriage ;
	$value = "" ;
	$form   = $blams -> FetchSelectbox( $alias . "_type" , ${ $alias . "_type" } , $arCarriage , $isize ,  "選択してください。" , FALSE , "" ) ;
	$value .= $blams -> FetchTHTD( "料金種類 ※" , $form , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> FetchInputbox( $alias . "_tax" , ${ $alias . "_tax" } , $vsize - 64  , MAX_MONEY , IME_OFF ) ;
	$form  .= "円<br />※内税は 0 を入力" ;
	$value .= $blams -> FetchTHTD( "送料（税抜）" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$form   = $blams -> FetchInputbox( $alias . "_price" , ${ $alias . "_price" } , $vsize - 64  , MAX_MONEY , IME_OFF ) ;
	$form  .= "円" ;
	$value .= $blams -> FetchTHTD( "送料（税込） ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> FetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$arForm[] = $value ;

	$arParamFind[ $alias . "_create_date" ] = ${ $alias . "_create_date" } ;
	$arParamFind[ $alias . "_update_date" ] = ${ $alias . "_update_date" } ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $alias . "_priceid"		) ;
	$tmpl -> assign( "idvalue"			, ${ $alias . "_priceid" }	) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/input.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 詳細表示
function	FetchDone( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam )
{
	global $obPrice ;
	$alias		= $obPrice -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $alias . "_priceid"		) ;
	$tmpl -> assign( "idvalue"			, ${ $alias . "_priceid" }	) ;
	$data = $tmpl -> fetch( "common/done.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// データの追加
function	InsertData( $arParam )
{
	$result = FALSE ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$conn = ConnectDatabase() ;
	if ( $conn )
	{
		$sql  = sprintf( "INSERT INTO price_data ( " ) ;
		$sql .= sprintf( "corpid , " ) ;
		$sql .= sprintf( "state , " ) ;
		$sql .= sprintf( "city , " ) ;
		$sql .= sprintf( "type , " ) ;
		$sql .= sprintf( "price , " ) ;
		$sql .= sprintf( "tax , " ) ;

		$sql .= sprintf( "status , " ) ;
		$sql .= sprintf( "create_date , " ) ;
		$sql .= sprintf( "update_date   " ) ;
		$sql .= sprintf( " ) VALUES ( " ) ;

		$sql .= sprintf( "'%d' , "		, $corpid ) ;
		$sql .= sprintf( "'%d' , "		, $state ) ;
		$sql .= sprintf( "'%s' , "		, mb_addslashes( $city ) ) ;
		$sql .= sprintf( "'%d' , "		, $type ) ;
		$sql .= sprintf( "'%d' , "		, $price ) ;
		$sql .= sprintf( "'%d' , "		, $tax ) ;

		$sql .= sprintf( " 1   , " ) ;
		$sql .= sprintf( "to_timestamp( '%s' , 'YYYYMMDD HH24MISS' ) , " , date2( "Ymd His" , $create_date ) ) ;
		$sql .= sprintf( "to_timestamp( '%s' , 'YYYYMMDD HH24MISS' ) " , date2( "Ymd His" , $update_date ) ) ;
		$sql .= sprintf( " ) " ) ;
		$record = ExecuteSQL( $conn , $sql ) ;
		if ( $record )
		{
			CloseRecord( $record ) ;
			$result = TRUE ;
		}
		DisconnectDatabase( $conn ) ;
	}
	return $result ;
}

// データの更新
function	UpdateData( $arParam )
{
	$result = FALSE ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$conn = ConnectDatabase() ;
	if ( $conn )
	{
		$sql  = sprintf( "UPDATE price_data SET " ) ;

		$sql .= sprintf( "corpid = '%d' , "			, $corpid ) ;
		$sql .= sprintf( "state = '%d' , "			, $state ) ;
		$sql .= sprintf( "city = '%s' , "			, mb_addslashes( $city ) ) ;
		$sql .= sprintf( "type = '%d' , "			, $type ) ;
		$sql .= sprintf( "price = '%d' , "			, $price ) ;
		$sql .= sprintf( "tax = '%d' , "			, $tax ) ;

		$sql .= sprintf( "update_date = now() " ) ;
		$sql .= sprintf( "WHERE priceid = %d " , $priceid ) ;
		$record = ExecuteSQL( $conn , $sql ) ;
		if ( $record )
		{
			CloseRecord( $record ) ;
			$result = TRUE ;
		}
		DisconnectDatabase( $conn ) ;
	}

	return $result ;
}

// データの削除
function	DeleteData( $arParam )
{
	$result = FALSE ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$conn = ConnectDatabase() ;
	if ( $conn )
	{
		$sql  = sprintf( "UPDATE price_data SET " ) ;
		$sql .= sprintf( "status = -1 , " ) ;
		$sql .= sprintf( "update_date = now() " ) ;
		$sql .= sprintf( "WHERE priceid = %d " , $priceid ) ;
		$record = ExecuteSQL( $conn , $sql ) ;
		if ( $record )
		{
			CloseRecord( $record ) ;
			$result = TRUE ;
		}
		DisconnectDatabase( $conn ) ;
	}
	return $result ;
}

?>