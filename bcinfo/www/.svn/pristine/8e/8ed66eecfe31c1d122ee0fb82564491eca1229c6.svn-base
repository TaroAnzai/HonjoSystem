<?php
//	ini_set( "display_errors" ,1 ) ;
	require_once( "../../../lib/system.php") ;

	// 基本パラメータ変換
	if ( empty( $mode ) == true )
		$mode = "update" ;

	if ( empty( $page ) == true )
		$page = 0 ;

	$obSession = new PARTS_Session() ;
	$obSession -> checkLogin( SESSION_ADMIN ) ;

	// セッションからログイン者情報を取得する
	$arr = $obSession -> getUserData( SESSION_ADMIN ) ;
	$login_adminid	= $arr[ $obSession -> obAdmin -> alias . "_adminid" ] ;
	$login_level	= $arr[ $obSession -> obAdmin -> alias . "_level" ] ;

	$blams		= new BLAMS() ;
	$obCorp		= new PARTS_Corp() ;

	$additional = array() ;
	$additional[] = "page" ;
	$obCorp -> assignGlobal( $additional ) ;

	// 検索用パラメータ変換
	if ( $S_STATE == "" )
		$S_STATE = -1 ;

	if ( $S_LEVEL == "" )
		$S_LEVEL = -1 ;

	if ( $S_GROUPFLG == "" )
		$S_GROUPFLG = DEF_CORP_GROUP_OTHER ;

	if ( $S_GROUPPARENTID == "" )
		$S_GROUPPARENTID = -1 ;

	// 検索用パラメータ保存
	$arParamFind = array() ;
	foreach( $obCorp -> searchkey as $name )
		$arParamFind[ $name ] = ${ $name } ;
	$arParamFind[ "page"	] = $page			;

	if ( $S_GROUPFLG == DEF_CORP_GROUP_OTHER )
		$menu = FUNC_CORP ;
	else if ( $S_GROUPFLG == DEF_CORP_GROUP_SELF )
		$menu = FUNC_SELF ;
	
	$screentype = "default" ;
	$funcname = $blams -> GetFuncName( $menu ) ;
	$header = $blams -> fetchAdminHeader( $screentype , $menu ) ;
	$footer = $blams -> fetchAdminFooter( $screentype , $menu ) ;

	// リスト表示
	$data = fetchList( $blams , $funcname , $arParamFind , true , $obCorp ) ;

	// ページ全体の生成
	$contents = $blams -> fetchContents( $data ) ;

	// ナビゲーションメニュー
	$navi = $blams -> fetchSlideMenu( $menu , $login_level ) ;

	$blams -> PrintBody( $header , $footer , $contents , $navi ) ;

exit ;

//
// データの表示
//
function	fetchList( $blams , $funcname , $arParamFind , $list_flg , $obCorp )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	$arWhere = array() ;
	$arWhere[ "groupflg"		] = $S_GROUPFLG ;
	$arWhere[ "groupparentid"	] = DEF_CORP_GROUPPARENTID_PARENT ;
	$arWhere[ "loginid"			] = $S_LOGINID ;
	$arWhere[ "name"			] = $S_NAME ;
	$arWhere[ "kana"			] = $S_KANA ;
	$arWhere[ "state"			] = $S_STATE ;
	$arWhere[ "level"			] = $S_LEVEL;

	$cnt = 0 ;
	if ( $obCorp -> isOpen() == true )
	{
		$cnt	= $obCorp -> getCount( $arWhere ) ;
		$arCorp	= $obCorp -> getData( $arWhere , $page , NUMBER_PER_PAGE ) ;
	}
	
	$paging		= "" ;
	$pageJump	= "" ;
	
	// 登録データがある場合
	$arList = array() ;
	if ( $cnt != 0 )
	{
		// 最大ページ数を計算する
		$maxpage = ceil( $cnt / NUMBER_PER_PAGE ) ;
		if ( $page == "" )
			$page = 0 ;
		else if ( $page >= $maxpage )
			$page = $maxpage - 1;
		$arParamFind[ "page" ] = $page ;

		$nStart = $page * NUMBER_PER_PAGE ;
		$nEnd = $page * NUMBER_PER_PAGE + NUMBER_PER_PAGE ;
		if ( $nEnd >= $cnt )
			$nEnd = $cnt ;

		// ページ移動の表示
		$paging = $blams -> fetchPaging( "list.php" , $arParamFind , $cnt , NUMBER_PER_PAGE ) ;

		// 一覧表示
		$arList = GetList( $blams , $page , $arParamFind , $obCorp ) ;

		// ページジャンプの表示
		$pageJump = $blams -> fetchPagejump( "list.php" , $arParamFind , $maxpage , JUMP_PER_PAGE , NUMBER_PER_PAGE ) ;
	}

	// 一覧表示時のみ検索フォームが有効
	if ( $list_flg != FALSE )
	{
		// 検索フォームの表示
		$search = fetchSearch( $blams , $arParamFind ) ;
	}
	$arHeader = array(
		array( "caption" => "名前"				, "class" => "w352 left" ) ,
		array( "caption" => "カナ"				, "class" => "w192 left" ) ,
		array( "caption" => "e-mail"			, "class" => "w192 left" ) ,
		array( "caption" => "会員レベル"		, "class" => "w120 left" ) ,
		array( "caption" => "所在地"			, "class" => "w080 left" ) ,
	) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, "list"			) ;
	$tmpl -> assign( "page"				, $page				) ;
	$tmpl -> assign( "maxline"			, NUMBER_PER_PAGE	) ;
	$tmpl -> assign( "list_flg"			, $list_flg			) ;
	$tmpl -> assign( "search"			, $search			) ;
	$tmpl -> assign( "paging"			, $paging			) ;
	$tmpl -> assign( "page_jump"		, $pageJump			) ;
	$tmpl -> assign( "header_data"		, $arHeader			) ;
	$tmpl -> assign( "list_data"		, $arList			) ;
	$tmpl -> assign( "error"			, ""				) ;
	$tmpl -> assign( "noanchor_flg"		, false				) ;
	$data = $tmpl -> fetch( "common/list.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 検索フォームの生成
function	fetchSearch( $blams , $arParamFind )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	global	$arCorpLevel ;

	// 都道府県テーブル生成
	global	$arStateName ;

	$arForm = array() ;

	$value = "" ;

	$form   = $blams -> fetchInputbox( "S_NAME" , $S_NAME , 256 - 16  , 64 , IME_ON ) ;
	$value .= $blams -> fetchTDTD( "社名" , $form , 128 , 256 , "" , "left" , "middle no-wrap" , BLAMS_FORMAT_NOBORDER ) ;

	$form   = $blams -> fetchInputbox( "S_KANA" , $S_KANA , 256 - 16  , 64 , IME_ON ) ;
	$value .= $blams -> fetchTDTD( "社名（カナ）" , $form , 128 , 256 , "" , "left" , "middle no-wrap" , BLAMS_FORMAT_NOBORDER ) ;

	$arForm[] = $value ;

	$value = "" ;
	$form	= $blams -> fetchSelectbox( "S_LEVEL" , $S_LEVEL , $arCorpLevel , 120 - 16 , "すべて選択" , FALSE ) ;
	$value .= $blams -> fetchTDTD( "会員レベル" , $form , 120 , 192 , "" , "left" , "middle" , BLAMS_FORMAT_NOBORDER ) ;

	$form	= $blams -> fetchSelectbox( "S_STATE" , $S_STATE , $arStateName , 120 - 16 , "すべて選択" , FALSE ) ;
	$value .= $blams -> fetchTDTD( "所在地" , $form , 120 , 192 , "" , "left" , "middle" , BLAMS_FORMAT_NOBORDER ) ;

	$arForm[] = $value ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "list_url"			, "list.php"		) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "page"				, $page				) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "append_disable"	, false				) ;
	$data = $tmpl -> fetch( "common/search.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 一覧の取得
function	GetList( $blams , $page , $arParamFind , $obCorp )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	global	$arCorpLevel ;

	// 都道府県テーブル生成
	global	$arStateName ;

	// パラメータの設定
	$param = "" ;
	$param .= $blams -> MakeParamLink( $arParamFind , "GET" ) ;

	$arCorp		= $obCorp -> arData ;
	$alias 		= $obCorp -> alias ;
	$primarykey	= $obCorp -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	$cnt = count( $arCorp ) ;
	for ( $index = 0 ; $index < $cnt ; $index ++ )
	{
		// データの取得
		$arData		= $arCorp[ $index ] ;
		
		$corpid			= $arData[ $keyname					] ;
		$loginid		= $arData[ $alias . "_loginid"		] ;
		$name			= $arData[ $alias . "_name"			] ;
		$kana			= $arData[ $alias . "_kana"			] ;
		$level			= $arData[ $alias . "_level"		] ;
		$agent_email	= $arData[ $alias . "_agent_email"	] ;
		$state			= $arData[ $alias . "_state"		] ;

		if ( $loginid == "" )
			$loginid = "不明" ;

		$szLevel = "不明" ;
		if ( empty( $arCorpLevel[ $level ] ) == false )
			$szLevel = $arCorpLevel[ $level ] ;

		$szEMail = $agent_email ;

		$szState = $arStateName[ $state ] ;
		if ( $szState == "" )
			$szState = "不明" ;

		$arAnchor[ "url" 			] = "edit.php"		;
		$arAnchor[ "idname"			] = $keyname		;
		$arAnchor[ "id"				] = $corpid			;
		$arAnchor[ "param"			] = $param			;
		$arAnchor[ "anchor"			] = $name			;
		$arAnchor[ "caption"		] = $name			;
		$arAnchor[ "class"			] = "border left"	;
		$arAnchor[ "script"			] = ""									;
		$arAnchor[ "date_format"	] = ""									;

		$arData = array() ;
		$arData[] = $arAnchor ;
		$arData[] = array( "caption" => $kana	 ,			"class" => "border left"	, "date_format" => ""	, "anchor" => "" ) ;
		$arData[] = array( "caption" => $szEMail ,			"class" => "border left"	, "date_format" => ""	, "anchor" => "" ) ;
		$arData[] = array( "caption" => $szLevel ,			"class" => "border left"	, "date_format" => ""	, "anchor" => "" ) ;
		$arData[] = array( "caption" => $szState ,			"class" => "border center"	, "date_format" => ""	, "anchor" => "" ) ;
		$arList[] = $arData ;
	}

	return $arList ;
}


?>
