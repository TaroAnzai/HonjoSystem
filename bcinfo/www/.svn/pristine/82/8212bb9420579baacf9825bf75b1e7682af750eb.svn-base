<?php

// お勧め商品の表示
function	fetchFeatureMerchandise( $func )
{
	$memberid = -1 ;
	$level = -1 ;

	$obSession = new PARTS_Session() ;
	$sessionid	= $obSession -> getID() ;
	$memberid = $obSession -> getUserID( $sessionid , SESSION_MEMBER ) ;
	$mon = date( "m" ) ;
	
	$arParam	= array() ;
	$arCart		= array() ;
	$link		= "/merchandise" ;
	$page		= 0 ;
	$mode		= "feature" ;

	CreateParamFromPath( $arParam ) ;
	$where  = MakeSqlMerchandise( $arParam , $link ) ;
	$where .= sprintf( "AND m.monthly_push LIKE '%%[%d]%%' " , $mon ) ;

	$merchandise = "" ;
	$obMerchandise = new PARTS_Merchandise() ;
	if ( $obMerchandise -> isOpen() == true )
	{
		$arWhere = array() ;
		$arWhere[ "monthly_push"	] = $mon ;
		$arWhere[ "edit_flg"		] = DEF_EDITSTATUS_OPENED ;
		$arWhere[ "start_date"		] = sprintf( "<= '%s 00:00:00'" , date( "Y-m-d" ) ) ;
		$arWhere[ "end_date"		] = sprintf( ">= '%s 23:59:59'" , date( "Y-m-d" ) ) ;

		$arMerchandise = $obMerchandise -> getData( $arWhere ) ;
		
		$obCart = new PARTS_Cart() ;
		if ( $obCart -> isOpen() == true )
		{
			$cartid = $obCart -> getID( $sessionid , $memberid , DF_BILLSTATUS_BUYING ) ;
	
			$arCart = array() ;
			if ( $cartid != -1 )
			{
				$arCart	= $obCart -> arData ;
			
				if ( count( $arCart ) > 0 )
					$arCart = $arCart[ 0 ] ;
			
				for ( $m = 0 ; $m < count( $arMerchandise ) ; $m ++ )
					$obCart -> inCart( $arMerchandise[ $m ] ) ;
			}
		}
		
		$tmpl = new HTML_template( DEF_DEFAULT_TEMPLATENAME ) ;

		$tmpl -> assign( "merchandise_data"	, $arMerchandise ) ;
		$tmpl -> assign( "link"				, $link ) ;
		$tmpl -> assign( "mode"				, $mode ) ;
		$tmpl -> assign( "param_data"		, $arParam ) ;
		$merchandise = $tmpl -> fetch( "merchandise/merchandise_feature.tmpl" ) ;
	}
	return $merchandise ;
}

// お勧め商品の表示
function	fetchFeatureMerchandiseTopPriority( $func , $priority , $type = "" )
{
	$file = "merchandise/merchandise_feature_toppriority.tmpl" ;
	if ( $type == "sub" )
		$file = "merchandise/merchandise_feature_sub.tmpl" ;
		
	$corpid = -1 ;
	$memberid = -1 ;
	$level = -1 ;

	$obSession = new PARTS_Session() ;
	$sessionid	= $obSession -> getID() ;
	$memberid = $obSession -> getUserID( $sessionid , SESSION_MEMBER ) ;

	$obCorp = new PARTS_Corp( $obSession -> conn ) ;
	$arCorp = $obCorp -> getSiteOwner() ;
	if ( count( $arCorp ) > 0 )
		$corpid = $arCorp[ 0 ][ $obCorp -> alias . "_corpid" ] ;

	$mon = date( "m" ) ;
	
	$arParam	= array() ;
	$arCart		= array() ;
	$link		= "/merchandise" ;
	$page		= 0 ;
	$mode		= "feature" ;

	CreateParamFromPath( $arParam ) ;

	$merchandise = "" ;
	$obMerchandise = new PARTS_Merchandise( $obSession -> conn ) ;
	if ( $obMerchandise -> isOpen() == true )
	{
		$arWhere = array() ;
		$arWhere[ "corpid"			] = $corpid ;
		$arWhere[ "top_priority"	] = $priority ;
		$arWhere[ "edit_flg"		] = DEF_EDITSTATUS_OPENED ;
		$arWhere[ "start_date"		] = sprintf( "<= '%s 00:00:00'" , date( "Y-m-d" ) ) ;
		$arWhere[ "end_date"		] = sprintf( ">= '%s 23:59:59'" , date( "Y-m-d" ) ) ;

		$arWhere[ "order"			] = sprintf( "random() " ) ;
		$arWhere[ "limit"			] = sprintf( "limit 4 " ) ;
		
		$arMerchandise = $obMerchandise -> getData( $arWhere ) ;
		
		$obCart = new PARTS_Cart( $obSession -> conn ) ;
		if ( $obCart -> isOpen() == true )
		{
			$cartid = $obCart -> getID( $sessionid , $memberid , DF_BILLSTATUS_BUYING ) ;
	
			$arCart = array() ;
			if ( $cartid != -1 )
			{
				$arCart	= $obCart -> arData ;
			
				if ( count( $arCart ) > 0 )
					$arCart = $arCart[ 0 ] ;
			
				for ( $m = 0 ; $m < count( $arMerchandise ) ; $m ++ )
					$obCart -> inCart( $arMerchandise[ $m ] ) ;
			}
		}
		
		$tmpl = new HTML_template( DEF_DEFAULT_TEMPLATENAME ) ;
	
		$tmpl -> assign( "merchandise_data"	, $arMerchandise ) ;
		$tmpl -> assign( "link"				, $link ) ;
		$tmpl -> assign( "mode"				, $mode ) ;
		$tmpl -> assign( "param_data"		, $arParam ) ;
		$merchandise = $tmpl -> fetch( $file ) ;
	}
	return $merchandise ;
}

