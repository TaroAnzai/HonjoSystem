// 自動出庫指示
function	AutoMoveout()
{
	$conn = ConnectDatabase() ;

	$stockid = -1 ;
	if ( $conn )
	{
		$result = FALSE ;
	
		// 生産計画の先頭を取得する。
		$sql  = sprintf( "SELECT * FROM schedule_data WHERE status = %d AND stockid != -1 " , DEF_SCHEDULE_CREATE ) ;
		$sql .= sprintf( "ORDER BY schedule_date , scheduleno " ) ;
//		echo $sql . "\n" ;
		$record = ExecuteSQL( $conn , $sql ) ;
		if ( $record )
		{
			if ( GetDataCount( $record ) > 0 )
			{
				$arData = GetValues( $record ) ;
				
				$stockid	= $arData[ "stockid"		] ;
				$lotno		= $arData[ "lotno"			] ;
				$date		= $arData[ "schedule_date"	] ;
				$scheduleno	= $arData[ "scheduleno"		] ;
				
				$date = date( "Ymd" , strtotime2( $date ) ) ;
				$lotno = str_replace( " " , "" , $lotno ) ;
				if ( $lotno != "" )
					$result = TRUE ;
			}
			CloseRecord( $record ) ;
		}
	
//		echo $stockid . "\n" ;
//		echo $lotno . "\n"  ;
//		echo $date . "\n"  ;
//		echo $scheduleno . "\n"  ;
//		echo $result . "\n"  ;
		
		// 在庫より指定のロットの保存場所を求める
		if ( $result == TRUE )
		{
			$result = FALSE ;

			$sql  = sprintf( "SELECT * FROM stock_data " ) ;
			$sql .= sprintf( "WHERE status = %d " , 1 ) ;
			$sql .= sprintf( "AND stockid = %d " , $stockid ) ;
/*			$sql .= sprintf( "AND ( stock_data.type = %d OR stock_data.type = %d OR stock_data.type = %d ) " , 
							DEF_STOCKTYPE_MATERIAL ,
							DEF_STOCKTYPE_TEMPORARY ,
							DEF_STOCKTYPE_OTHER
							) ;
			$sql .= sprintf( "AND ( storage_status & %d ) != 0 " , DEF_STORAGE_STATUS_IN ) ;
			$sql .= sprintf( "AND ( storage_status & %d ) = 0 " , DEF_STORAGE_STATUS_REQUEST | DEF_STORAGE_STATUS_RESERVE ) ;
			$sql .= sprintf( "AND ( shipped_status & %d ) != 0 " , DEF_SHIPPED_STATUS_REQUEST ) ;
*/
//			echo $sql . "\n" ;
			$record = ExecuteSQL( $conn , $sql ) ;
			if ( $record )
			{
				if ( GetDataCount( $record ) > 0 )
				{
					$paletteid = GetValue( $record , "paletteid" ) ;
					$depositorytype = GetValue( $record , "depositorytype" ) ;
					$depository = GetValue( $record , "depository" ) ;
					$warehouseid = GetValue( $record , "warehouseid" ) ;
					$result = TRUE ;
				}
				CloseRecord( $record ) ;
			}
		}

		if ( $result == TRUE )
		{
//			WriteSyslog( "Hit Stock Data " ) ;
			// パレットの場合
			if ( $depositorytype == DEF_DEPOSITORY_PALETTE )
			{
				WriteSyslog( "DAIFUKU Automove" ) ;
				$arPalatte = GetPaletteInfo( $paletteid , $conn ) ;
				// パレット番号が6桁の場合は、ダイフク倉庫へ
				$paletteno = $arPalatte[ "paletteno" ] ;
				if ( strlen( $paletteno ) == 6 )
				{
					// DAIFUKU自動倉庫の場合
					$cmd = sprintf( "%s client %d '%s' '%s' '%s' %d &" ,
									SELF_FULLCOMMAND ,
									AWC_AUTOMOVE_REQ ,
									$paletteno ,
									$lotno ,
									$date ,
									$scheduleno
								) ;
										
					echo "COMMAND : " . $cmd . "\n" ;
					exec( $cmd ) ;
				}
			}
			// 自動倉庫でかつトヨタL&F倉庫の場合、出庫依頼を行う
			else if ( $depositorytype == DEF_DEPOSITORY_AUTO && strlen( $depository ) == 7 )
			{
				WriteSyslog( "TOYOTA Automove" ) ;
				$cmd = sprintf( "%s toyota '%s' '%s' %d '006' '%s' %d '%s' %d &" ,
								SELF_FULLCOMMAND ,
								date( 'YmdHis' )  ,
								"" ,				// コメント
								1 ,
								$depository ,
								1 ,
								date( 'YmdHis' ) ,
								0 ) ;
									
				echo "COMMAND : " . $cmd . "\n" ;
				exec( $cmd ) ;
			}

			// 指示後に 生産計画状態を変更する
			UpdateSchedule( $lotno , DEF_SCHEDULE_SHIPPING , $conn ) ;
		}
		DisconnectDatabase( $conn ) ;
	}
}

// syslog 登録
function	WriteSyslog( $szMsg )
{
	define_syslog_variables() ;
	
	$szMsg = mb_convert_kana( $szMsg , "KV" , "sjis-win" ) ;
	$szMsg = mb_convert_encoding( $szMsg , "utf8" , "sjis-win" ) ;
	openlog( "MAKITA Uplink", LOG_PID , LOG_LOCAL7 ) ;
	
	syslog( LOG_INFO , $szMsg ) ;
	
	closelog() ;
}

