#!/usr/local/bin/php
<?php
	ini_set( "display_errors" , On ) ;
	require_once( "server.ini" ) ;
	require_once( "system.php" )  ;
	
	ob_implicit_flush() ;
	
	//print_r( $argv ) ;
	

	// コマンド解析
	$cmd = $argv[ 1 ] ;
	$func = $argv[ 2 ] ;

	if ( $cmd == "client" )
	{
		WriteSyslog( "client mode:" . $func ) ;
	
		// 機能種別
		switch ( $func )
		{
		// 入庫要求
		case	AWC_STORAGE_REQ :
			$paletto = $argv[ 3 ] ;
			AwcStorage( $paletto ) ;
			break ;
		
		// 生産計画
		case	AWC_SCHEDULE_REQ :
			$mode		= $argv[  3 ] ;
			$warehouse	= $argv[  4 ] ;
			$date		= $argv[  5 ] ;
			$scheduleno	= $argv[  6 ] ;
			$lotno		= $argv[  7 ] ;
			$productno	= $argv[  8 ] ;
			$paint		= $argv[  9 ] ;
			$lintecname	= $argv[ 10 ] ;
			$width		= $argv[ 11 ] ;
			$length		= $argv[ 12 ] ;
			$joint		= $argv[ 13 ] ;
			$separator	= $argv[ 14 ] ;
			AwcSchedule(	$mode ,
							$warehouse ,
							$date ,
							$scheduleno ,
							$lotno ,
							$productno ,
							$paint ,
							$lintecname , 
							$width ,
							$length ,
							$joint ,
							$separator
						) ;
			break ;
			
		// 在庫更新
		case	AWC_RENEW_REQ :
			$productno	= $argv[  3 ] ;
			$lintecname	= $argv[  4 ] ;
			$makername	= $argv[  5 ] ;
			$lotno		= $argv[  6 ] ;
			$makerlotno	= $argv[  7 ] ;
			$width		= $argv[  8 ] ;
			$length		= $argv[  9 ] ;
			$joint		= $argv[ 10 ] ;
			$separator	= $argv[ 11 ] ;
			$ignore		= $argv[ 12 ] ;
			$reserve	= $argv[ 13 ] ;
			$paletteno	= $argv[ 14 ] ;
			AwcRenew(	$productno ,
						$lintecname ,
						$makername ,
						$lotno ,
						$makerlotno ,
						$width ,
						$length / 1000 ,
						$joint ,
						$separator ,
						$ignore ,
						$reserve ,
						$paletteno
					) ;
			break ;
			
		// 在庫データ取得
		case	AWC_STOCK_REQ :
			AwcStock() ;
			break ;
		
		// 自動出庫指示
		case	AWC_AUTOMOVE_REQ :
			$paletto	= $argv[  3 ] ;
			$lotno		= $argv[  4 ] ;
			$date		= $argv[  5 ] ;
			$scheduleno	= $argv[  6 ] ;
			AwcAutoMove( $paletto , $lotno , $date , $scheduleno ) ;
			break ;
		
		// IHIへの要求
		case	"IHI" :
			$result = IHIAutoRequest( $argv ) ;
			break ;
		}
	}
	
	// 標準入力からシーケンサーからの電文受信
	
	// 標準出力へ電文送信
	
	
	else if ( $cmd == "server" )
	{
		WriteSyslog( "Startup MAKITA Uplink Daemon" ) ;
	
		$port = "" ;
		switch ( $func )
		{
		case	"DAIFUKU" :
			$port = MAKITA_PORT_DAIFUKU ;
			WriteSyslog( "DAIFUKU Mode port : " . $port ) ;
			break ;
		case	"LINTEC" :
			$port = MAKITA_PORT_LINTEC ;
			WriteSyslog( "LINTEC Mode port : " . $port ) ;
			break ;
		case	"LINTEC_RESULT" :
			$port = LINTEC_PORT ;
			WriteSyslog( "LINTEC RESULT Mode port : " . $port ) ;
			break ;
		case	"IHI" :
			$port = IHI_PORT ;
			WriteSyslog( "IHI Mode port : " . $port ) ;
			break ;
		}
		
		// ポート指定がある場合、ソケットを作成する
		if ( $port != "" )
		{
			if ( ( $sock = socket_create( AF_INET, SOCK_STREAM , SOL_TCP ) ) < 0 )
			{
			   echo "socket_create() failed: reason: " . socket_strerror( $sock ) . "\n";
			}
			
			if ( ( $ret = socket_set_option( $sock , SOL_SOCKET , SO_REUSEADDR , 1 ) ) < 0 )
			{
			   echo "socket_set_option() failed: reason: " . socket_strerror( $ret ) . "\n";
			}
			
			// "bind" the socket to the address to global IP on port
			// so this means that all connections on this port are now our resposibility to send/recv data, disconnect, etc..
			if ( ( $ret = socket_bind( $sock , MAKITA_IPADDR , $port ) ) < 0 )
			{
			   echo "socket_bind() failed: reason: " . socket_strerror( $ret ) . "\n";
			}
			
			// start listen for connections
			if ( ( $ret = socket_listen( $sock , 5 ) ) < 0 )
			{
			   echo "socket_listen() failed: reason : " . socket_strerror( $ret ) . "\n";
			}
			
			// create a list of all the clients that will be connected to us..
			// add the listening socket to this list
			$clients = array( $sock ) ;
			
			while ( true )
			{
				usleep( 200000 ) ;
		
				// create a copy, so $clients doesn't get modified by socket_select()
				$read = $clients ;
	
				// get a list of all the clients that have data to be read from
				// if there are no clients with data, go to next iteration
				if ( socket_select( $read , $write = NULL , $except = NULL , 0 ) < 1 )
					continue ;
	
				// check if there is a client trying to connect
				if ( in_array( $sock , $read ) )
				{
					// accept the client, and add him to the $clients array
					$clients[] = $newsock = socket_accept( $sock ) ;
					
					// send the client a welcome message
					// socket_write( $newsock , "no noobs, but ill make an exception :)\n".
					// "There are ".(count($clients) - 1)." client(s) connected to the server\n");
					
					socket_getpeername( $newsock, $ip ) ;
					WriteSyslog( "New client connected: {$ip}" ) ;
					
					// remove the listening socket from the clients-with-data array
					$key = array_search( $sock , $read ) ;
					unset( $read[ $key ] ) ;
				}
	
				// loop through all the clients that have data to read from
				foreach ( $read as $read_sock )
				{
					usleep( 200000 ) ;

					// read until newline or 1 bytes
					// socket_read while show errors when the client is disconnected, so silence the error messages
	
					if ( $func == "DAIFUKU" )
						$data = @socket_read( $read_sock , 1 , PHP_BINARY_READ ) ;
					else if ( $func == "LINTEC" || $func == "LINTEC_RESULT" )
						$data = @socket_read( $read_sock , 1024 , PHP_NORMAL_READ ) ;
					else if ( $func == "IHI" )
						$data = @socket_read( $read_sock , 1024 , PHP_NORMAL_READ ) ;
					
					// check if the client is disconnected
					if ( $data === false )
					{
						// remove client for $clients array
						$key = array_search( $read_sock , $clients ) ;
						unset( $clients[ $key ] ) ;
						WriteSyslog( "client disconnected." ) ;
						// continue to the next client to read from, if any
						continue ;
					}
	
					// trim off the trailing/beginning white spaces
					$data = trim( $data ) ;
					
					// check if there is any data after trimming off the spaces
					if ( !empty( $data ) )
					{
						// send this to all the clients in the $clients array (except the first one, which is a listening socket)
						foreach ( $clients as $send_sock )
						{
							// if its the listening sock or the client that we got the message from, go to the next one in the list
							if ( $send_sock == $sock )
								continue ;
							
							if ( $read_sock == $send_sock )
							{
								echo $data ."\n" ;
								switch ( $func )
								{
								case	"DAIFUKU" :
									// SOHを検査する
									if ( $data == AWC_SOH )
									{
										AwcExec( $send_sock ) ;
										echo "end\n" ;
									}
									break ;
									
								case	"LINTEC" :
									if ( strlen( $data ) == LTCFMT_HEADER_LEN )
									{
										$flag = substr( $data , 0 , 2 ) ;
										
										// 送信フラグを検査する
										if ( $flag == LTC_LINTECID )
										{
											// リンテックからの要求
											LintecExec( $send_sock , $data ) ;
										}
									}
									break ;
									
								case	"LINTEC_RESULT" :
									if ( strlen( $data ) == LTCFMT_HEADER_LEN )
									{
										$flag = substr( $data , 0 , 2 ) ;

										// 送信フラグを検査する
										if ( $flag == LTC_MAKITAID )
										{
											// 真北からの実績送信
											LintecResult( $send_sock , $data ) ;
										}
										
									}
									break ;

								case	"IHI" :
									if ( strlen( $data ) == IHIFMT_HEADER_LEN )
									{
										$flag = substr( $data , 0 , 2 ) ;
										
										// 送信フラグを検査する
										if ( $flag == IHI_CLIENTID )
										{
											// IHIからの要求
											IHIResult( $send_sock , $read_sock , $data ) ;
										}
									}
									break ;
								}
							}
							
						} // end of broadcast foreach
					
					}
					
				} // end of reading foreach
			}
			socket_close( $sock ) ;
			echo "socket close\n" ;
		}
	}
	else if ( $cmd == "toyota" )
	{
		WriteSyslog( "TOYOTA Request" ) ;

		// トヨタ L&F社製 自動倉庫への要求処理
		$no			= $argv[  2 ] ;
		$comment	= $argv[  3 ] ;
		$seq		= $argv[  4 ] ;
		$station	= $argv[  5 ] ;
		$paletteno	= $argv[  6 ] ;
		$num		= $argv[  7 ] ;
		$date		= $argv[  8 ] ;
		$state		= $argv[  9 ] ;
		ToyotaMoveout( $no , $comment , $seq , $station , $paletteno , $num , $date , $state ) ;
		WriteSyslog( "TOYOTA Request Finish" ) ;
	}
	else if ( $cmd == "schedule" )
	{
		WriteSyslog( "TOYOTA schedule out" ) ;
		// 出庫予約 時間監視処理
		// CRONにて 出庫予約にあるものを取り出す
		ToyotaTimer() ;
		WriteSyslog( "TOYOTA schedule out Finish" ) ;
	}
	else if ( $cmd == "result" )
	{
		WriteSyslog( "TOYOTA Result" ) ;
		// TOYOTA L&F社製の自動倉庫管理システムからの実績取得
		// 5分に一回 削除しないと、サーバが遅延するらしい・・・
		ToyotaResult() ;
		WriteSyslog( "TOYOTA Result Finish" ) ;
	}
	else if ( $cmd == "maintenance" )
	{
		// 生産計画からの製品名自動更新
		WriteSyslog( "Manual Maintenance" ) ;
		MaintenanceStockAtSchedule() ;
		WriteSyslog( "Manual Maintenance Finish" ) ;
	}
	else if ( $cmd == "automove" )
	{
		// 生産計画の先頭にある在庫を出庫命令を出す
		WriteSyslog( "Auto Shipping Command" ) ;
		AutoMoveout() ;
		WriteSyslog( "Auto Shipping Command Finish" ) ;
	}
	else if ( $cmd == "storagefee" )
	{
		// 当月入庫 当月出庫になった在庫の保管料を再計算する。
		UpdateStorageFee() ;
	}
	
	$status = 254 ;
	if ( $result == TRUE )
		$status = 0 ;
		
	exit( $status ) ;
	
// ソケットオープン
function	OpenSock( $ipaddr , $port )
{
	for ( $r = 0 ; $r < 10 ; $r ++ )
	{
		$sock = fsockopen( $ipaddr , $port , $errno , $errstr , 30 ) ;
		if ( !$sock )
		{
			echo "$errstr ($errno)<br />\n";
			WriteSyslog( "$errstr ($errno)" ) ;
			usleep( 100000 ) ;
		}
		else
		{
			$r = 10 ;
		}
	}
	return $sock ;
}

// ソケットクローズ
function	CloseSock( $sock )
{
	if ( is_resource( $sock ) )
		fclose( $sock ) ;
}

// AWC用 Socket Open
function	AwcOpenSock()
{
	return OpenSock( AWC_IPADDR , AWC_PORT ) ;
}

// LINTEC用 Socket Open
function	LintecOpenSock()
{
	return OpenSock( LINTEC_IPADDR , LINTEC_PORT ) ;
}

// 電文発行
function	AwcWrite( $sock , $cmd )
{
	// コマンドからヘッダを作成する
	$head = sprintf( AWCFMT_HEADER , strlen( $cmd ) , AWC_MAKITA , AWC_SERVER ) ;
	
	$len  = 1 ;
	$len += AWCFMT_HEADER_LEN ;
	$len += strlen( $cmd ) ;
	
	// SOHを送信
	$data = AWC_SOH . $head . $cmd ;

	WriteSyslog( "HEADER  : " . $head ) ;
	WriteSyslog( "COMMAND : " . $cmd ) ;

	// コマンドを送信
	return fwrite( $sock , $data , $len ) ;
}

// 応答電文発行
function	AwcRewrite( $sock , $cmd )
{
	// コマンドからヘッダを作成する
	$head = sprintf( AWCFMT_HEADER , strlen( $cmd ) , AWC_MAKITA , AWC_SERVER ) ;
	
	$len  = 1 ;
	$len += AWCFMT_HEADER_LEN ;
	$len += strlen( $cmd ) ;
	
	// SOHを送信
	$data = AWC_SOH . $head . $cmd ;

	print $head . "\n" ;
	print $cmd . "\n" ;

	// コマンドを送信
	return socket_write( $sock , $data , $len ) ;
}

// シーケンス番号の取得
function	AwcGetSeqNum()
{
	$seq = 0 ;
	$cnt = 0 ;

	// ファイルのオープン
	if ( file_exists( AWC_SEQ ) )
		$fp = @fopen( AWC_SEQ , "r+" ) ;
	else
		$fp = @fopen( AWC_SEQ , "w+" ) ;
	
	if ( is_resource( $fp ) )
	{
		while ( $cnt < 3 )
		{
			// ファイルのロック
			if ( flock( $fp , LOCK_EX ) )
			{
				// シーケンス番号の取得
				$seq = sprintf( "%d" , fgets( $fp ) ) ;
				$seq ++ ;
				if ( $seq > 9999 )
					$seq = 1 ;
				rewind( $fp ) ;
				
				$dat = sprintf( "%d" , $seq ) ;
				fwrite( $fp , $dat , strlen( $dat ) ) ;
			
				// ファイルのロック解除
				flock( $fp , LOCK_UN ) ;
				break ;
			}
			else
			{
				usleep( 200000 ) ;
			}
			$cnt ++ ;
		}
		fclose( $fp ) ;
	}
	return $seq ;
}

// データ解析
function	AwcExec( $sock )
{
	WriteSyslog( "AWC Request" ) ;

	// 電文の解析
	$head	= @socket_read( $sock , AWCFMT_HEADER_LEN , PHP_BINARY_READ ) ;
	$len	= substr( $head , 0 , 4 ) ;
	
	// コマンドの受信
	$cmd	= @socket_read( $sock , $len , PHP_BINARY_READ ) ;
	
	echo $head . "\n" ;
	echo $cmd . "\n" ;

	$rSeq	= substr( $cmd , 0 , 4 ) ;
	$rFunc	= substr( $cmd , 4 , 2 ) ;
	$rTime	= substr( $cmd , 14 , 6 ) ;

	WriteSyslog( sprintf( "HEADER : %s\n" , $head ) ) ;
	WriteSyslog( sprintf( "FUNC   : %s\n" , $rFunc ) ) ;
	WriteSyslog( sprintf( "REQ    : %s\n" , $rSeq ) ) ;
	WriteSyslog( sprintf( "TIME   : %s\n" , $rTime ) ) ;
	WriteSyslog( sprintf( "DATA   : %s\n" , $cmd ) ) ;

	$boolen = AWCFMT_ERROR ;
	switch ( $rFunc )
	{
	case	AWC_STORAGE_CMP :
		$boolen = AWCFMT_SUCCESS ;
		AwcReqCmp( $sock , AWC_STORAGE_REQCMP , $boolen , $rTime , $rSeq ) ;
	
		$paletteno	= substr( $cmd , 20 , 6 ) ;
		$depository	= substr( $cmd , 26 , 6 ) ;
		$date		= substr( $cmd , 32 , 14 ) ;

		WriteSyslog( sprintf( "PLT-NO : %s\n" , $paletteno ) ) ;
		WriteSyslog( sprintf( "DEPOS  : %s\n" , $depository ) ) ;
		WriteSyslog( sprintf( "DATE   : %s\n" , $date ) ) ;
		
		// 入庫OKなら 該当するパレットのデータを取得する。
		$conn = ConnectDatabase() ;
		if ( $conn )
		{
			$sql  = sprintf( "SELECT stock_data.length as slength , stock_data.width as swidth , * FROM stock_data , palette_data , product_data " ) ;
			$where  = sprintf( "WHERE stock_data.status = 1 " ) ;
			$where .= sprintf( "AND stock_data.productid = product_data.productid " ) ;
			$where .= sprintf( "AND stock_data.paletteid = palette_data.paletteid " ) ;
			$where .= sprintf( "AND ( stock_data.storage_status & %d ) != 0 " , DEF_STORAGE_STATUS_IN ) ;
			$where .= sprintf( "AND ( stock_data.shipped_status & %d ) = 0 " , DEF_SHIPPED_STATUS_IN ) ;
			$where .= sprintf( "AND stock_data.depositorytype = %d " , DEF_DEPOSITORY_PALETTE ) ;
			$where .= sprintf( "AND palette_data.paletteno = '%s' " , $paletteno ) ;
			
			echo "PALETTE:".$paletteno ."\n";
			$stockid = -1 ;
			$record = ExecuteSQL( $conn , $sql . $where ) ;
			if ( $record )
			{
				if ( GetDataCount( $record ) == 1 )
				{
					$arData = GetValues( $record ) ;
					$stockid		= $arData[ "stockid"	] ;
					$productno		= $arData[ "productno"	] ;
					$lintecname		= $arData[ "name"		] ;
					$makername		= $arData[ "makername"	] ;
					$lotno			= $arData[ "lotno"		] ;
					$makerlotno		= $arData[ "makerlotno"	] ;
					$width			= $arData[ "swidth"		] ;
					$length			= $arData[ "slength"	] ;
					$joint			= $arData[ "joint"		] ;
					$separator		= $arData[ "separator"	] ;
					$ignore			= $arData[ "ignore"		] ;
					$reserve		= $arData[ "reserve"	] ;
					$paletteid		= $arData[ "paletteid"	] ;
					$paletteno		= $arData[ "paletteno"	] ;
					$depositorytype	= $arData[ "depositorytype"	] ;

					WriteSyslog( sprintf( "STOCKID   : %d\n" , $stockid ) ) ;
					WriteSyslog( sprintf( "LOTNO     : %s\n" , $lotno ) ) ;
					
					// 在庫更新のコマンドを発行する。
					$cmd = sprintf( "%s client %d '%s' '%s' '%s' '%s' '%s' %d %d %d %d %d %d '%s' &" ,
									SELF_FULLCOMMAND ,
									AWC_RENEW_REQ ,
									$productno	,
									$lintecname	,
									$makername	,
									$lotno		,
									$makerlotno	,
									$width		,
									$length		,
									$joint		,
									$separator	,
									$ignore		,
									$reserve	,
									$paletteno	) ;
					echo "COMMAND : " . $cmd . "\n" ;
					exec( $cmd ) ;
				}
				CloseRecord( $record ) ;
				
				// 該当するパレットを自動倉庫に格納状態にする
				if ( $stockid != -1 )
				{
					$sql	 = sprintf( "UPDATE palette_data SET " ) ;
					$sql	.= sprintf( "depositorytype = %d ," , DEF_DEPOSITORY_AUTO ) ;
					$sql	.= sprintf( "depository = '%s' ," , $depository ) ;
					$sql	.= sprintf( "update_date = now()" ) ;
					$sql	.= sprintf( "WHERE paletteid = %d " , $paletteid ) ;
					$record = ExecuteSQL( $conn , $sql ) ;
					if ( $record )
						CloseRecord( $record ) ;
					
					$sql	 = sprintf( "UPDATE stock_data SET " ) ;
					$sql	.= sprintf( "movepos_date = to_timestamp( '%s' , 'YYYYMMDDHH24MISS' ) , " , $date ) ;
					$sql	.= sprintf( "update_date = now() " ) ;
					$sql	.= sprintf( "WHERE stockid = %d " , $stockid ) ;
					$record = ExecuteSQL( $conn , $sql ) ;
					if ( $record )
						CloseRecord( $record ) ;

					// 保管場所の作成
					$depositorydetail = MakeDepository( $depositorytype , "" , 0 , 0 , $paletteid , TRUE , $conn ) ;

					// 作業日報の入庫データで該当するパレット番号で更新する
					$sql	 = sprintf( "UPDATE history_data SET " ) ;
					$sql	.= sprintf( "depository = '%s' , " , $depositorydetail ) ;
					$sql	.= sprintf( "update_date = now() " ) ;
					$sql	.= sprintf( "WHERE stockid = %d " , $stockid ) ;
					$sql	.= sprintf( "AND ( operations = %d OR operations = %d ) " , DEF_HIS_STORAGE , DEF_HIS_PALETTEMOVE ) ;
					$sql	.= sprintf( "AND depository like '%%(P:%s)' " , $paletteno ) ;
					$record = ExecuteSQL( $conn , $sql ) ;
					if ( $record )
						CloseRecord( $record ) ;
				
					WriteSyslog( "Update History Index" ) ;
				}
			}
			DisconnectDatabase( $conn ) ;
		}
		break ;
	
	// 出庫完了報告
	case	AWC_SHIPPED_CMP :
		$boolen = AWCFMT_SUCCESS ;
		AwcReqCmp( $sock , AWC_SHIPPED_REQCMP , $boolen , $rTime , $rSeq ) ;
		break ;
	
	// 搬送完了報告
	case	AWC_MOVEOUT_CMP :
		$boolen = AWCFMT_SUCCESS ;
		AwcReqCmp( $sock , AWC_MOVEOUT_REQCMP , $boolen , $rTime , $rSeq ) ;
		
		// 生産計画から該当するLotNoを完了にする。
		$paletteno	= substr( $cmd , 20 , 6 ) ;
		$lotno		= trim( substr( $cmd , 48 , 40 ) ) ;
		$date		= trim( substr( $cmd , 88 , 8 ) ) ;
		$scheduleno	= intval( trim( substr( $cmd , 96 , 10 ) ) ) ;
		$conn		= ConnectDatabase() ;
		if ( $conn )
		{
			$sql	 = sprintf( "SELECT * FROM schedule_data " ) ;
			$sql	.= sprintf( "WHERE lotno = '%s' " , $lotno ) ;
			$sql	.= sprintf( "AND SCHEDULE_DATE = to_timestamp( '%s' , 'YYYYMMDD' ) " , $date ) ;
			$sql	.= sprintf( "AND SCHEDULENO = %d " , $scheduleno ) ;
			$sql	.= sprintf( "AND status = %d " , DEF_SCHEDULE_MOVING ) ;
//			WriteSyslog( $sql ) ;
			$record = ExecuteSQL( $conn , $sql ) ;
			if ( $record )
			{
				if ( GetDataCount( $record ) > 0 )
				{
					// 生産計画の状態を変更する
					UpdateSchedule( $lotno , DEF_SCHEDULE_MOVEOUT , $conn ) ;
				}
				
				CloseRecord( $record ) ;
			}
			DisconnectDatabase( $conn ) ;
		}
		
		break ;
		
	case	AWC_STOCK_CMP ;
		$boolen = AWCFMT_SUCCESS ;
		AwcReqCmp( $sock , AWC_STOCK_REQCMP , $boolen , $rTime , $rSeq ) ;
		break ;
		
	default :
		AwcReqCmp( $sock , 99 , $boolen , $rTime , $rSeq ) ;
	}
}

// 応答完了コマンドを送信
function	AwcReqCmp( $sock , $func , $boolen , $time , $parent )
{
	$seq = AwcGetSeqNum() ;
	
	// 応答完了コマンドを作成する
	$cmd = sprintf( AWCFMT_ACK , $seq , $func , date( "His" ) , $time , $parent , $boolen ) ;
	
	// コマンドを送信
	AwcRewrite( $sock , $cmd ) ;
}

// 応答電文の解析
function	AwcCheckStatus( $sock , $func , $seq )
{
	// 電文の解析
	$head	= fread( $sock , AWCFMT_HEADER_LEN ) ;
	$len	= substr( $head , 0 , 4 ) ;
	
	// コマンドの受信
	$cmd	= fread( $sock , $len ) ;
	
	// ステータスの取得
	$status	= substr( $cmd , 24 , 1 ) ;
	$rSeq	= substr( $cmd , 20 , 4 ) ;
	$rFunc	= substr( $cmd , 4 , 2 ) ;

	WriteSyslog( sprintf( "HEADER : %s\n" , $head ) ) ;
	WriteSyslog( sprintf( "FUNC   : %s\n" , $rFunc ) ) ;
	WriteSyslog( sprintf( "REQ    : %s\n" , $rSeq ) ) ;
	WriteSyslog( sprintf( "STATUS : %s\n" , $status ) ) ;
	
	$result = FALSE ;
	if ( ( $rFunc == $func ) && ( $rSeq == $seq ) )
	{
		if ( $status == AWCFMT_ERROR )
			$result = FALSE ;
		else
			$result = TRUE ;
	}
	
	if ( $result == FALSE )
		WriteSyslog( "AWC Result Error" ) ;
	return $result ;
}

// 入庫予定処理
function	AwcStorage( $palette )
{
	// ソケット作成
	$sock = AwcOpenSock() ;
	if ( $sock )
	{
		$seq = AwcGetSeqNum() ;
		
		// パレットNOからコマンドを作成する
		$cmd = sprintf( AWCFMT_STORAGE_REQ , $seq , AWC_STORAGE_REQ , date( "His" ) , date( "Ymd" ) , $palette ) ;
		
		// コマンドの受信
		AwcWrite( $sock , $cmd ) ;
		
		// 応答待ち
		$result = -1 ;
		while ( ( $result === -1 ) )
		{
			$dat = fread( $sock , 1 ) ;
			
			// 応答有の場合、完了を送信
			if ( $dat == AWC_SOH )
			{
				$result = AwcCheckStatus( $sock , AWC_STORAGE_ACK , $seq ) ;
			}
			else
			{
				$result = FALSE ;
			}
		}
		
		// ソケット破棄
		CloseSock( $sock ) ;
	}

	return $result ;
}

// 生産計画
function	AwcSchedule( $mode , $warehouse , $date , $scheduleno , $lotno , $productno , $paint , $lintecname , $width , $length , $joint , $separator )
{
	// リトライ回数
	$retry = 3 ;

	for ( $i = 0 ; $i < $retry ; $i ++ )
	{
		// ソケット作成
		$sock = AwcOpenSock() ;
		if ( $sock )
		{
			$seq = AwcGetSeqNum() ;

			// 在庫データ要求コマンドを作成する
			$cmd = sprintf(	AWCFMT_SCHEDULE_REQ , $seq , AWC_SCHEDULE_REQ , date( "His" ) ,
							$mode ,
							$warehouse ,
							$date ,
							$scheduleno ,
							$lotno ,
							$productno ,
							$paint ,
							$lintecname ,
							$width ,
							$length / 1000 ,
							$joint ,
							$separator
						) ;
	
			// コマンドの受信
			AwcWrite( $sock , $cmd ) ;
			
			// 応答待ち
			$result = -1 ;
			while ( ( $result === -1 ) )
			{
				$dat = fread( $sock , 1 ) ;
				
				// 応答有の場合、完了を送信
				if ( $dat == AWC_SOH )
				{
					$result = AwcCheckStatus( $sock , AWC_SCHEDULE_ACK , $seq ) ;
				}
				else
				{
					$result = FALSE ;
				}
			}
			CloseSock( $sock ) ;
		}
		
		if ( $result == TRUE )
			break ;
	}

	return $result ;
}

// 在庫更新指示
function	AwcRenew( $productno , $lintecname , $makername , $lotno , $makerlotno , $width , $length , $joint , $separator , $ignore , $reserve , $paletto )
{
	// ソケット作成
	$sock = AwcOpenSock() ;
	if ( $sock )
	{
		$seq = AwcGetSeqNum() ;

		$lintecname = mb_convert_kana( $lintecname , "ak" , "SJIS" ) ;

		// 在庫データ要求コマンドを作成する
		$cmd = sprintf(	AWCFMT_RENEW_REQ , $seq , AWC_RENEW_REQ , date( "His" ) ,
						$productno ,
						$lintecname ,
						$makername ,
						$lotno ,
						$makerlotno ,
						$width ,
						$length ,
						$joint ,
						$separator ,
						$ignore ,
						$reserve ,
						$paletto
					) ;

		// コマンドの受信
		AwcWrite( $sock , $cmd ) ;
		
		// 応答待ち
		$result = -1 ;
		while ( ( $result === -1 ) )
		{
			$dat = fread( $sock , 1 ) ;
			
			// 応答有の場合、完了を送信
			if ( $dat == AWC_SOH )
			{
				$result = AwcCheckStatus( $sock , AWC_RENEW_ACK , $seq ) ;
			}
			else
			{
				$result = FALSE ;
			}
		}

		CloseSock( $sock ) ;
	}

	return $result ;
}

