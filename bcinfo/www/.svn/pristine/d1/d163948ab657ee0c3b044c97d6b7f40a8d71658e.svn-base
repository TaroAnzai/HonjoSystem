<?php
	//ini_set( "display_errors" ,1 ) ;
	require_once( "../../../lib/system.ini.php" ) ;
	require_once( "../../../lib/system.php" ) ;


	// 基本パラメータ変換
	if ( empty( $mode ) == true )
		$mode = "update" ;

	if ( empty( $page ) == true )
		$page = 0 ;

	$obSession = new PARTS_Session() ;
	$obSession -> checkLogin( SESSION_ADMIN ) ;

	// セッションからログイン者情報を取得する
	$arr = $obSession -> getUserData( SESSION_ADMIN ) ;
	$login_adminid	= $arr[ $obSession -> obAdmin -> alias . "_adminid" ] ;
	$login_level	= $arr[ $obSession -> obAdmin -> alias . "_level" ] ;

	$blams		= new BLAMS() ;
	$obWebpage	= new PARTS_Webpage() ;

	$alias 		= $obWebpage -> alias ;
	$primarykey	= $obWebpage -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	$obWebpage -> assignGlobal() ;

	// 検索用パラメータ変換
	$S_SUBJECT = $obWebpage -> mb2sb( $S_SUBJECT ) ;

	if ( $S_TYPE == "" )
		$S_TYPE = -1 ;

	if ( $S_EDIT_FLG == "" )
		$S_EDIT_FLG = -1 ;

	// 検索用パラメータ保存
	$arParamFind = array() ;
	$arParamFind = array() ;
	foreach( $obWebpage -> searchkey as $name )
		$arParamFind[ $name ] = ${ $name } ;
	$arParamFind[ "page"	] = $page			;

	// WHERE句の初期化
	$arWhere = array() ;
	$arWhere[ "subject"	] = $S_SUBJECT ;
	if ( $S_TYPE == -1 )
	{
		global	$arWebpageType ;
		foreach ( $arWebpageType as $key => $value )
		{
			if ( $key >= DEF_PAGE_FB_TOP1 )
				$arWhere[ "type" ][] = $key ;
		}
	}
	else
		$arWhere[ "type"	] = $S_TYPE ;
	$arWhere[ "edit_flg"	] = $S_EDIT_FLG ;

	$menu = FUNC_FACEBOOK ;

	$screentype = "default" ;
	$funcname = $blams -> GetFuncName( $menu ) ;
	$header = $blams -> fetchAdminHeader( $screentype , $menu ) ;
	$footer = $blams -> fetchAdminFooter( $screentype , $menu ) ;
	
	// リスト表示
	$data = FetchList( $blams , $funcname , $arParamFind , $arWhere , true , $obWebpage ) ;

	// ページ全体の生成
	$contents = $blams -> fetchContents( $data ) ;

	$blams -> PrintBody( $header , $footer , $contents ) ;

exit ;

//
// データの表示
//
function	fetchList( $blams , $funcname , $arParamFind , $arWhere , $list_flg , $obWebpage )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	// 該当データ数取得
	$cnt = 0 ;
	if ( $obWebpage -> isOpen() == true )
	{
		$cnt		= $obWebpage -> getCount( $arWhere ) ;
		$arWebpage	= $obWebpage -> getData( $arWhere , $page , NUMBER_PER_PAGE ) ;
	}

	// 登録データがある場合
	// ページ番号の修正があるので、検索フォームの表示　は下へ
	$paging = "" ;
	$pageJump = "" ;
	$arList = array() ;
	if ( $cnt != 0 )
	{
		// 最大ページ数を計算する
		$maxpage = ceil( $cnt / NUMBER_PER_PAGE ) ;
		if ( $page == "" )
			$page = 0 ;
		else if ( $page >= $maxpage )
			$page = $maxpage - 1;
		$arParamFind[ "page" ] = $page ;

		$nStart = $page * NUMBER_PER_PAGE ;
		$nEnd = $page * NUMBER_PER_PAGE + NUMBER_PER_PAGE ;
		if ( $nEnd >= $cnt )
			$nEnd = $cnt ;

		// ページ移動の表示
		$paging = $blams -> fetchPaging( "list.php" , $arParamFind , $cnt , NUMBER_PER_PAGE ) ;

		// 一覧表示
		$arList = GetList( $blams , $page , $arParamFind , $obWebpage ) ;

		// ページジャンプの表示
		$pageJump = $blams -> fetchPagejump( "list.php" , $arParamFind , $maxpage , JUMP_PER_PAGE , NUMBER_PER_PAGE ) ;
	}

	// 一覧表示時のみ検索フォームが有効
	if ( $list_flg != FALSE )
	{
		// 検索フォームの表示
		$search = FetchSearch( $blams , $arParamFind ) ;
	}
	$arHeader = array(
		array( "caption" => "タイトル"		, "class" => "w248 left" ) ,
		array( "caption" => "公開開始日"	, "class" => "w112 center" ) ,
		array( "caption" => "公開終了日"	, "class" => "w112 center" ) ,
		array( "caption" => "表示種類"		, "class" => "w176 center" ) ,
		array( "caption" => "編集状態"		, "class" => "w088 center" ) ,
		array( "caption" => "更新日"		, "class" => "w112 center" ) ,
	) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, "list"			) ;
	$tmpl -> assign( "page"				, $page				) ;
	$tmpl -> assign( "maxline"			, NUMBER_PER_PAGE	) ;
	$tmpl -> assign( "list_flg"			, $list_flg			) ;
	$tmpl -> assign( "search"			, $search			) ;
	$tmpl -> assign( "paging"			, $paging			) ;
	$tmpl -> assign( "page_jump"		, $pageJump			) ;
	$tmpl -> assign( "header_data"		, $arHeader			) ;
	$tmpl -> assign( "list_data"		, $arList			) ;
	$data = $tmpl -> fetch( "common/list.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 検索フォームの生成
function	FetchSearch( $blams , $arParamFind )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	// WebpageType
	global	$arWebpageType ;
	$arWebpageType_local[ DEF_PAGE_FB_TOP1		] = $arWebpageType[ DEF_PAGE_FB_TOP1		 ] ;
	$arWebpageType_local[ DEF_PAGE_FB_CONTENTS1	] = $arWebpageType[ DEF_PAGE_FB_CONTENTS1 ] ;

	// 編集状態（「削除」状態は選択不可）
	global	$arEditStatus ;
	$arEditStatus_local = $arEditStatus ;
	unset( $arEditStatus_local[ DEF_EDITSTATUS_DELETED ] ) ;

	$arForm = array() ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( "S_SUBJECT" , $S_SUBJECT , 248 - 16  , 64 , IME_ON ) ;
	$value .= $blams -> fetchTDTD( "タイトル" , $form , 96 , 248 , "" , "left" , "middle" , BLAMS_FORMAT_NOBORDER ) ;

	$form	= $blams -> fetchSelectbox( "S_TYPE" , $S_TYPE , $arWebpageType_local , 192 - 16 , "すべて選択" , FALSE ) ;
	$value .= $blams -> fetchTDTD( "表示種類" , $form , 96 , 192 , "" , "left" , "middle" , BLAMS_FORMAT_NOBORDER ) ;

	$form	= $blams -> fetchSelectbox( "S_EDIT_FLG" , $S_EDIT_FLG , $arEditStatus_local , 112 - 16 , "すべて選択" , FALSE ) ;
	$value .= $blams -> fetchTDTD( "編集状態" , $form , 96 , 112 , "" , "left" , "middle" , BLAMS_FORMAT_NOBORDER ) ;

	$arForm[] = $value ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "list_url"			, "list.php"		) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "page"				, $page				) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$data = $tmpl -> fetch( "common/search.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 一覧の取得
function	getList( $blams , $page , $arParamFind , $obWebpage )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	// パラメータの設定
	$param = "" ;
	$param .= $blams -> makeParamLink( $arParamFind , "GET" ) ;

	$arWebpage	= $obWebpage -> arData ;
	$alias 		= $obWebpage -> alias ;
	$primarykey	= $obWebpage -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	foreach ( $arWebpage as $arData )
	{
		// データの取得
		${ $primarykey }	= $arData[ $keyname					] ;
		$subject			= $arData[ $alias . "_subject"		] ;
		$start_date			= $arData[ $alias . "_start_date"	] ;
		$end_date			= $arData[ $alias . "_end_date"		] ;
		$type				= $arData[ $alias . "_type"			] ;
		$edit_flg			= $arData[ $alias . "_edit_flg"		] ;
		$update_date		= $arData[ $alias . "_update_date"	] ;

		$date = new DateTime( $start_date ) ;
		$szStartDate = "指定無し" ;
		if ( $start_date != DEF_DATE_MIN )
			$szStartDate = $date -> format( "Y/m/d" ) ;
		unset( $date ) ;
		
		$date = new DateTime( $end_date ) ;
		$szEndDate = "指定無し" ;
		if ( $end_date != DEF_DATE_MAX )
			$szEndDate = $date -> format( "Y/m/d" ) ;
		unset( $date ) ;

		global	$arWebpageType ;
		$szWebpageType = $arWebpageType[ $type ] ;

		global	$arEditStatus ;
		$szEditStatus = $arEditStatus[ $edit_flg ] ;

		$date = new DateTime( $update_date ) ;
		$szUpdateDate = $date -> format( "Y/m/d" ) ;
		unset( $date ) ;
		
		$arAnchor = array() ;
		$arAnchor[ "url" 		] = "edit.php"			;
		$arAnchor[ "idname"		] = $keyname			;
		$arAnchor[ "id"			] = ${ $primarykey }	;
		$arAnchor[ "param"		] = $param				;
		$arAnchor[ "anchor"		] = $subject			;
		$arAnchor[ "caption"	] = $subject			;
		$arAnchor[ "class"		] = "border left"		;

		$arData = array() ;
		$arData[] = $arAnchor ;
		$arData[] = array( "caption" => $szStartDate ,		"class" => "border center" ) ;
		$arData[] = array( "caption" => $szEndDate	 ,		"class" => "border center" ) ;
		$arData[] = array( "caption" => $szWebpageType ,	"class" => "border center" ) ;
		$arData[] = array( "caption" => $szEditStatus ,		"class" => "border center" ) ;
		$arData[] = array( "caption" => $szUpdateDate ,		"class" => "border center" ) ;
		$arList[] = $arData ;
	}
	
	return $arList ;
}

?>
