<?php
//	ini_set( "display_errors" ,1 ) ;
	require_once( "../../../../lib/system.php") ;

	if ( empty( $page ) == true )
		$page = 0 ;

	$mode = "" ;
	$func = "" ;

	// 登録ボタン名によって処理を分ける
	$arMode = array( "append" , "update" , "delete" , "delete_image" ) ;
	GetSystemMode( $mode , $func , $arMode ) ;

	$obSession = new PARTS_Session() ;
	$obSession -> checkLogin( SESSION_ADMIN ) ;

	// セッションからログイン者情報を取得する
	$arr = $obSession -> getUserData( SESSION_ADMIN ) ;
	$login_adminid	= $arr[ $obSession -> obAdmin -> alias . "_adminid" ] ;
	$login_level	= $arr[ $obSession -> obAdmin -> alias . "_level" ] ;

	$blams		= new BLAMS() ;
	$obMM		= new PARTS_MerchandiseMaster() ;
	$obPhoto	= $obMM -> obPhoto ;

	$alias 		= $obMM -> alias ;
	$primarykey	= $obMM -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	// 編集データ保存
	$arParam = array() ;

	$additional = array() ;
	$additional[] = "page" ;
	$obMM -> assignGlobal( $additional , $arParam ) ;

	// 検索用パラメータ保存
	$arParamFind = array() ;
	foreach( $obMM -> searchkey as $name )
		$arParamFind[ $name ] = ${ $name } ;
	$arParamFind[ "page"	] = $page			;

	// データ取得時のキー初期化
	$getdatakey = ${ $keyname } ;

	// タイトル取得時のキー初期化
	$menu = FUNC_MERCHANDISE_MASTER ;

	$screentype = "default" ;
	$funcname = $blams -> GetFuncName( $menu ) ;
	$header = $blams -> fetchAdminHeader( $screentype , $menu ) ;
	$footer = $blams -> fetchAdminFooter( $screentype , $menu ) ;

	$error = "" ;
	switch ( $mode )
	{
	// 新規登録モード
	case "append" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 新規入力" , $funcname ) ;

			// 入力フォーム画面への初回遷移時のみ、データを初期化
			if ( $func != "back" )
			{
				$obMM -> initData( $arParam ) ;
			}

			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level , $obMM ) ;

			break ;

		// 新規確認画面
		case "confrm" :

			// 入力データ検査
			$error = $obMM -> checkData( $mode , $func , $arParam ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $obMM ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 新規入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level , $obMM ) ;
			}
			break ;

		// 新規完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 登録処理" , $funcname ) ;

			// 新規登録実施
			if ( $obMM -> insertData( $arParam ) == TRUE )
			{
				$error = "正常に登録されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・登録に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $obMM ) ;
			break ;
		}
		break ;

	// 更新モード
	case "update" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

			// 入力フォーム画面への初回遷移時のみ、データをDBから再取得（初期化）
			if ( $func != "back" )
			{
				// データをDBから再取得（初期化）
				$arParam = $obMM -> getAt( $getdatakey ) ;

				$now_date = new DateTime();
				$now = $now_date -> format( "Y-m-d H:i:s" ) ;
				$arParam[ "update_date" ] = $now ;
			}
			else if( $func == "back" )
			{
				$obPhoto -> deleteWhenBack( $arParam , $obMM ) ;
			}

			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level , $obMM ) ;
			break ;

		// 更新確認画面
		case "confrm" :

			// 入力データ検査
			$error = $obMM -> checkData( $mode , $func , $arParam ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $obMM ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level , $obMM ) ;
			}
			break ;

		// 更新完了画面
		case "done" :
			// タイトルの表示
			$subfuncname = sprintf( "%s 更新処理" , $funcname ) ;

			// 更新登録実施
			if ( $obMM -> updateData( $arParam ) == TRUE )
			{
				$error = "正常に更新されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・更新に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $obMM ) ;
			break ;

		// 初期画面、もしくはFunctionの指定がない場合
		default :

			// タイトルの表示
			$subfuncname = sprintf( "%s 詳細表示" , $funcname ) ;

			// データをDBから再取得（初期化）
			$arParam = $obMM -> getAt( $getdatakey ) ;

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $obMM ) ;
			break ;
		}
		break ;

	// 削除モード
	case "delete" :

		// 機能分岐
		switch( $func )
		{

		// 削除確認画面
		case "confrm" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 削除確認" , $funcname ) ;

			// 削除確認メッセージ表示
			if ( $obMM -> issetImage( $arParam ) )
			{
				$error  = "【重要】\n" ;
				$error .= "・画像ファイルも同時に破棄されます。\n" ;
			}

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $obMM ) ;
			break ;

		// 削除完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 削除処理" , $funcname ) ;

			// 削除処理実施
			if ( $obMM -> deleteData( $arParam ) == TRUE )
			{
				$error = "正常に削除されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・削除に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $obMM ) ;
			break ;
		}
		break ;

	case "delete_image" :

		$arParam[ "del_column"	] = $func ;
//		$arParam[ "del_photoid"	] = ${ $func . "_org" } ;
		$arParam[ "del_photoid"	] = $arParam[ $func . "_org" ] ;

		// タイトルの表示
		$subfuncname = sprintf( "%s 画像削除処理" , $funcname ) ;

		// 削除実行
		if ( $obPhoto -> deleteEach( $arParam , $obMM ) == TRUE )
		{
			$error = "正常に画像を削除しました。\n" ;
		}
		else
		{
			$error  = "【エラーがあります】\n" ;
			$error .= "・画像の削除に失敗しました。\n" ;
		}
		$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $obMM ) ;
		break ;
	}

	// 「一覧に戻る」の表示
	if ( $mode != "append" )
		$pageback = $blams -> fetchPageback( "list.php" , $arParamFind ) ;
	else
		$pageback = "" ;

	// ページ全体の生成
	$contents = $blams -> fetchContents( $pageback . $data ) ;

	// ナビゲーションメニュー
	$navi = $blams -> fetchSlideMenu( $menu , $login_level ) ;

	$blams -> PrintBody( $header , $footer , $contents , $navi ) ;

	exit ;

// ボタンの表示
function	FetchButton( $blams , $mode , $func )
{
	$arProcess = array(
		//					ボタン名								MODE							Action
		"list"				=>	array( "value" => "一覧に戻る"		, "name" => "list"				, "action" => "list.php"		, "target" => "" , "org_action" => "" ) ,
		"detail"			=>	array( "value" => "詳細に戻る"		, "name" => "update[default]"	, "action" => ""				, "target" => "" , "org_action" => "" ) ,

		"append_confrm"		=>	array( "value" => "新規確認"		, "name" => "append[confrm]"	, "action" => ""				, "target" => "" , "org_action" => "" ) ,
		"append_done"		=>	array( "value" => "登録します"		, "name" => "append[done]"		, "action" => ""				, "target" => "" , "org_action" => "" ) ,
		"append_cancel"		=>	array( "value" => "キャンセル"		, "name" => "append[cancel]"	, "action" => "list.php"		, "target" => "" , "org_action" => "" ) ,
		"append_back"		=>	array( "value" => "戻る"			, "name" => "append[back]"		, "action" => ""				, "target" => "" , "org_action" => "" ) ,

		"update_input"		=>	array( "value" => "更新"			, "name" => "update[input]"		, "action" => ""				, "target" => "" , "org_action" => "" ) ,
		"update_confrm"		=>	array( "value" => "更新確認"		, "name" => "update[confrm]"	, "action" => ""				, "target" => "" , "org_action" => "" ) ,
		"update_done"		=>	array( "value" => "更新します"		, "name" => "update[done]"		, "action" => ""				, "target" => "" , "org_action" => "" ) ,
		"update_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"	, "action" => ""				, "target" => "" , "org_action" => "" ) ,
		"update_back"		=>	array( "value" => "戻る"			, "name" => "update[back]"		, "action" => ""				, "target" => "" , "org_action" => "" ) ,

		"delete_confrm"		=>	array( "value" => "削除"			, "name" => "delete[confrm]"	, "action" => ""				, "target" => "" , "org_action" => "" ) ,
		"delete_done"		=>	array( "value" => "削除します"		, "name" => "delete[done]"		, "action" => ""				, "target" => "" , "org_action" => "" ) ,
		"delete_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"	, "action" => ""				, "target" => "" , "org_action" => "" ) ,
	) ;

	$arOperation = array() ;
	switch( $mode )
	{
	case "append" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "append_confrm" , "append_cancel" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "append_done" , "append_back" ) ;
			break ;
		case "done" :
			$arOperation = array( "list" ) ;
			break ;
		}
		break ;

	case "update" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "update_confrm" , "update_cancel" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "update_done" , "update_back" ) ;
			break ;
		case "done" :
			$arOperation = array( "detail" ) ;
			break ;
		default :
			$arOperation = array( "update_input" , "delete_confrm" ) ;
			break ;
		}
		break ;

	case "delete" :
		switch( $func )
		{
		case "confrm" :
			$arOperation = array( "delete_done" , "delete_cancel" ) ;
			break ;
		case "done" :
			$arOperation = array( "list" ) ;
			break ;
		}
		break ;

	case "delete_image" :
		$arOperation = array( "detail" ) ;
		break ;
	}

	$arButton = array() ;
	for ( $i = 0 ; $i < count( $arOperation ) ; $i ++ )
		$arButton[] = $arProcess[ $arOperation[ $i ] ] ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "id"				, "edit_form"		) ;
	$tmpl -> assign( "button_data"		, $arButton			) ;
	$data = $tmpl -> fetch( "common/button.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;

}

// データ検査
function	CheckData( $mode , $func , &$arParam )
{
	$error = "" ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$obDB = new DB_Common() ;
	if ( $obDB -> isOpen() )
	{
		// 商品コードの入力検査
		if ( $merchandisecode == "" )
		{
			$error .= "・商品コードが入力されていません。\n" ;
		}
		else
		{
			$sql = sprintf( "SELECT * FROM merchandise_master_data WHERE status = 1 AND merchandisecode = '%s'" , $merchandisecode ) ;

			// 修正の場合、異なるIDで指定の商品コードが存在する際は、重複エラーとする。
			if ( $mode == "update" )
				$sql .= sprintf( " AND merchandise_masterid <> %d " , $merchandise_masterid ) ;

			// 重複ID検査
			$record = $obDB -> executeSQL( $sql ) ;
			if ( $record )
			{
				if ( $obDB -> getDataCount( $record ) > 0 )
					$error .= "・同じ商品コードが存在しています。\n" ;
				$obDB -> closeRecord( $record ) ;
			}
		}

		// JANコードの入力検査
		if( $jancode != "" )
		{
			$sql = sprintf( "SELECT * FROM merchandise_master_data WHERE status = 1 AND jancode = '%s'" , $jancode ) ;

			// 修正の場合、異なるIDで指定のJANコードが存在する際は、重複エラーとする。
			if ( $mode == "update" )
				$sql .= sprintf( " AND merchandise_masterid <> %d " , $merchandise_masterid ) ;

			// 重複ID検査
			$record = $obDB -> executeSQL( $sql ) ;
			if ( $record )
			{
				if ( $obDB -> getDataCount( $record ) > 0 )
					$error .= "・同じJANコードが存在しています。\n" ;
				$obDB -> closeRecord( $record ) ;
			}
		}

		// 商品名の入力検査
		if ( $name == "" )
			$error .= "・商品名が入力されていません。\n" ;

		// 製造元・蔵元

		// 商品カテゴリ
		if ( $categoryid == -1 )
			$error .= "・商品カテゴリが選択されていません。\n" ;

		// 定価
		if ( is_numeric( $fixed_price ) == FALSE )
			$error .= "・定価が正しく入力されていません。\n" ;

		// 規格(サイズ)

		// 容量
		if ( is_numeric( $net ) == FALSE )
			$error .= "・容量が正しく入力されていません。\n" ;

		// 単位

		// 内容数
		if ( is_numeric( $unit ) == FALSE )
			$error .= "・内容数が正しく入力されていません。\n" ;

		// 画像
		$error .= CheckDataPhoto( "iconid_img"	, "iconid_tmp"	, $arParam , "画像"	, $conn ) ;
		
	}
	else
	{
		$error .= "・データベースに接続できませんでした。\n" ;
	}

	return $error ;
}

// 詳細表示
function	FetchDetail( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $obMM )
{
	$alias 		= $obMM -> alias ;
	$primarykey	= $obMM -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	$alias_cp 	= $obMM -> obCorp -> alias ;
	$alias_c 	= $obMM -> obCategory -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;

	// delete時はcheckDataを通らないので、$obMMのデータしか飛んでこない
	// 製造元
	$szCorpName = "不明" ;
	if( ${ $alias . "_corpid" } != -1 )
	{
		$arWhere = array() ;
		$arCorp = $obMM -> obCorp -> getAt( ${ $alias . "_corpid" } ) ;
		$szCorpName = $arCorp[ $alias_cp . "_name" ] ;
	}

	// 商品カテゴリ
	$szCategoryName = "不明" ;
	if( ${ $alias . "_categoryid" } != -1 )
	{
		$arCategory = $obMM -> obCategory -> getAt( ${ $alias . "_categoryid" } ) ;
		$szCategoryName = $arCategory[ $alias_c . "_name" ] ;
	}

	$arForm = array() ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "商品コード" , ${ $alias . "_merchandisecode" } , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$value .= $blams -> fetchTHTD( "JANコード" , ${ $alias . "_jancode" } , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "商品名" , ${ $alias . "_name" } , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "製造元" , $szCorpName , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$value .= $blams -> fetchTHTD( "商品カテゴリ" , $szCategoryName , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "定価" , ${ $alias . "_fixed_price" } , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$value .= $blams -> fetchTHTD( "規格(サイズ)" , ${ $alias . "_standard" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_WORDWRAP | 40 | BLAMS_FORMAT_NL2BR ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "容量" , ${ $alias . "_net" } , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$value .= $blams -> fetchTHTD( "単位" , ${ $alias . "_tag" } , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "内容数" , ${ $alias . "_unit" } , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchDetailImageTHTD(	${ $alias . "_iconid_tmp" } ,
												${ $alias . "_iconid_org" } ,
												$alias . "_iconid_img" ,
												${ $alias . "_iconid_img" } ,
												DEF_ICON_WID , DEF_ICON_HGT ,
												"画像" ,
												$tsize , $vsize3 , "col1" , "left" , "top" , BLAMS_FORMAT_NONE , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$arForm[] = $value ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$pageback = "" ;
	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, $pageback			) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "input_data"		, $arParam			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/confrm.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 入力フォームの表示
function	FetchInput( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_level , $obMM )
{
	$alias 		= $obMM -> alias ;
	$primarykey	= $obMM -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$arWhere = array() ;
	$arCorp = $obMM -> obCorp -> getList( $arWhere ) ;

	$arCategory = array() ;
	$arCategory_local = array() ;
	$arCategory_local = $obMM -> obCategory -> createCategoryArray( 0 , 0 , 0 , false , DEF_CATEGORY_ITEM ) ;

	for( $i = 0 ; $i < count( $arCategory_local ) ; $i ++ )
	{
		$key = key( $arCategory_local[ $i ] ) ;
		$value = $arCategory_local[ $i ][ $key ] ;
		$arCategory[ $key ] = $value ;
	}

	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$isize	= $vsize - 16 ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;
	$isize3	= $vsize3 - 16 ;

	$arForm = array() ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_merchandisecode" , ${ $alias . "_merchandisecode" } , $isize  , MAX_JANCODE , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "商品コード ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$form   = $blams -> fetchInputbox( $alias . "_jancode" , ${ $alias . "_jancode" } , $isize  , MAX_JANCODE , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "JANコード" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_name" , ${ $alias . "_name" } , $isize3  , MAX_PRODUCTNAME , IME_ON ) ;
	$value .= $blams -> fetchTHTD( "商品名 ※" , $form , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchSelectbox( $alias . "_corpid" , ${ $alias . "_corpid" } , $arCorp , $isize ,  "選択してください。" , FALSE , "" ) ;
	$value .= $blams -> fetchTHTD( "製造元" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$form   = $blams -> fetchSelectbox( $alias . "_categoryid" , ${ $alias . "_categoryid" } , $arCategory , $isize ,  "選択してください。" , FALSE , "" ) ;
	$value .= $blams -> fetchTHTD( "商品カテゴリ ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_fixed_price" , ${ $alias . "_fixed_price" } , $isize  , MAX_PRICE , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "定価" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	
	$form   = $blams -> fetchTextarea( $alias . "_standard" , ${ $alias . "_standard" } , $isize ) ;
	$value .= $blams -> fetchTHTD( "規格(サイズ)" , $form , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_NOTAB , 1 , 1 , 3 ) ;

	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_net" , ${ $alias . "_net" } , $isize  , MAX_NET , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "容量" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$form   = $blams -> fetchInputbox( $alias . "_tag" , ${ $alias . "_tag" } , $isize  , MAX_TAG , IME_ON ) ;
	$value .= $blams -> fetchTHTD( "単位" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_unit" , ${ $alias . "_unit" } , $isize  , MAX_UNIT , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "内容数" , $form , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchInputImageTHTD(	${ $alias . "_iconid_tmp" } ,
												${ $alias . "_iconid_org" } ,
												$alias . "_iconid" ,
												${ $alias . "_iconid_img" } ,
												DEF_ICON_WID , DEF_ICON_HGT ,
												"画像" ,
												$tsize , $isize3 ,
												"col1" , "left" , "top" , TRUE , 1 , 1 , 3 ) ;
												
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$arForm[] = $value ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$arParamFind[ $alias . "_create_date" ] = ${ $alias . "_create_date" } ;
	$arParamFind[ $alias . "_update_date" ] = ${ $alias . "_update_date" } ;

	$pageback = "" ;
	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, $pageback			) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $keyname			) ;
	$tmpl -> assign( "idvalue"			, ${ $keyname }		) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/input.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 詳細表示
function	FetchDone( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $obMM )
{
	$alias 		= $obMM -> alias ;
	$primarykey	= $obMM -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $keyname			) ;
	$tmpl -> assign( "idvalue"			, ${ $keyname }		) ;
	$data = $tmpl -> fetch( "common/done.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

?>