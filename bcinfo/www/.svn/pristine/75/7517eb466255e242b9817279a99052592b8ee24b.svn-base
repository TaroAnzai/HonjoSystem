session_name( "SSID" ) ;

class BLAMS
{
	var	$tmpl ;			// テンプレートクラス
	var $commonPath ;	// 共通テンプレートパス

	var	$arMenu ;
	var	$arSubMenu ;
	var	$funcAnchor ;
	var	$arNavi ;

	var	$obSession ;
	var	$conn ;

	// Constractor
	function	__construct( $template = "" , $commonPath = "common/" )
	{
		$this -> init( $template , $commonPath ) ;

		$this -> conn = "" ;
	}

	function	init( $template = "" , $commonPath = "common/" )
	{
		global	$arMenu ;
		global	$arSubMenu ;
		global	$funcAnchor ;
		global	$arNavi ;

		$this -> arMenu		= $arMenu ;
		$this -> arSubMenu	= $arSubMenu ;
		$this -> funcAnchor	= $funcAnchor ;
		$this -> arNavi		= $arNavi ;
	}

	function	setPath( $name = "default" )
	{
		$smarty_template = $this -> tmpl -> setPath( $name ) ;
		$this -> tmpl -> template_dir	= $smarty_template . "/" . $name . "/" ;
	}
	
	// ファンクション名の取得
	function	getFuncName( $funcno )
	{
		$funcname = $this -> arNavi[ $funcno ][ "anchor" ] ;

		return $funcname ;
	}

	// URLから機能番号を取得する
	function	getFuncNumber()
	{
		global	$PHP_SELF ;
	
		$this -> arMenu		= array() ;
		$this -> arSubMenu	= array() ;
		$this -> funcAnchor	= "" ;
	
		$func = -1 ;
	
		// URLが機能クラス名となっている
		$obDB = new PARTS_Menu( $this -> conn ) ;
	
		if ( $obDB -> isOpen() )
		{
			$url	= $_SERVER[ "REQUEST_URI" ] ;
			$self	= $_SERVER[ "SCRIPT_NAME" ] ;
			$ext = array( ".php" => "/" , "index.html" => "" ) ;
	
			$keys = array_keys( $ext ) ;
			for ( $f = 0 ; $f < count( $ext ) ; $f ++ )
			{
				$url = str_replace( $keys[ $f ] , $ext[ $keys[ $f ] ] , $url ) ;
				$self = str_replace( $keys[ $f ] , $ext[ $keys[ $f ] ] , $self ) ;
			}
			
			$alias = $obDB -> alias ;
			
			$self = trim( $self , "/" ) ;
			$arSelf = explode( "/" , $self ) ;
			
			$where  = "" ;
			$where .= sprintf( "AND ( %s.url = '%s' " , $alias , $url ) ;
			
			$self = "/" ;
			for ( $i = 0 ; $i < count( $arSelf ) ; $i ++ )
			{
				$self = sprintf( "%s%s/" , $self , $arSelf[ $i ] ) ;
				$where .= sprintf( "OR %s.url = '%s' " , $alias , $self ) ;
			}
			$where .= sprintf( ") " ) ;

			$arWhere = array() ;
			$arWhere[ "where" ] = $where ;
			$arWhere[ "order" ] = sprintf( "length( %s.url ) DESC " , $alias ) ;

			$arResult = $obDB -> getData( $arWhere ) ;
			if ( count( $arResult ) > 0 )
			{
				$arData = $arResult[ 0 ] ;
				
				$func	= $arData[ $alias . "_standard"			] ;
				$mid	= $arData[ $alias . "_menucategoryid"	] ;
				$c1		= $arData[ $alias . "_category1"		] ;
				$c2		= $arData[ $alias . "_category2"		] ;

				$this -> funcAnchor	= $arData[ $alias . "_anchor"		] ;
		
				$this -> arMenu = GetMenu( $mid , $c1 , 0 , $obDB -> conn ) ;
				if ( $c2 != 0 )
					$this -> arSubMenu = GetMenu( $mid , $c1 , $c2 , $obDB -> conn ) ;
			}
		}

		global	$arMenu ;
		global	$arSubMenu ;
		global	$funcAnchor ;

		$arMenu		= $this -> arMenu		;
		$arSubMenu	= $this -> arSubMenu	;
		$funcAnchor	= $this -> funcAnchor	;

		return $func ;
	}

	// ヘッダ情報の表示
	function	printHeader( $screentype , $funcno = -1 )
	{
		$data = $this -> fetchHeader( $screentype , $funcno ) ;
		printf( "%s" , $data ) ;
	}
	
	// ヘッダ情報の生成
	function	fetchAdminHeader( $screentype , $funcno , $script = "" , $name = "" , $title = "" )
	{
		$obCorp = new PARTS_Corp( $this -> conn ) ;
		$arCorp = $obCorp -> getOwner() ;
		if ( count( $arCorp ) > 0 )
			$arCorp = $arCorp[ 0 ] ;

		$arNavi = $this -> arNavi ;

		$tmpl = $this -> tmpl ;
		$ua = $tmpl -> getBrowserInfo() ;
		$tmpl -> assign( "ua"				, $ua					) ;
		$tmpl -> assign( "charaset"			, DEF_INTERNAL_ENCODE	) ;
		$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH		) ;
		$tmpl -> assign( "screentype"		, $screentype			) ;
		$tmpl -> assign( "func_data"		, $arNavi[ $funcno ]	) ;
		$tmpl -> assign( "corp_data"		, $arCorp				) ;
		$tmpl -> assign( "script"			, $script				) ;
		$tmpl -> assign( "name"				, $name					) ;
		$tmpl -> assign( "title"			, $title				) ;
		
		$data = $tmpl -> fetch( $this -> commonPath . "header.tmpl"	) ;
		$tmpl -> clearAllAssign() ;

		// IE6の場合、xml宣言を削除する。
		$data = $tmpl -> makeXhtmlString( $data ) ;
		unset( $tmpl ) ;

		if ( $screentype != "popup" )
		{
			$tmpl = new HTML_template( "default" ) ;
			$ua = $tmpl -> getBrowserInfo() ;
			$tmpl -> assign( "ua" , $ua ) ;
			$tmpl -> assign( "func" , $funcno ) ;
			$copyright = $tmpl -> fetch( "header.tmpl" ) ;
			$tmpl -> clearAllAssign() ;
	
			$data = str_replace( "</HEAD>" , "</head>" , $data ) ;
			$data = str_replace( "</head>" , $copyright . "</head>" , $data ) ;
		}
		
		return	$data ;
	}
	
	// フッター情報の表示
	function	printFooter( $funcno )
	{
		$data = $this -> fetchFooter( $funcno ) ;
		printf( "%s" , $data ) ;
	}

	// フッター情報の生成
	function	fetchAdminFooter( $screentype , $funcno , $script = "" )
	{
		$data = "" ;
		$obCorp = new PARTS_Corp( $this -> conn ) ;
		$arCorp = $obCorp -> getOwner() ;
		if ( count( $arCorp ) > 0 )
			$arCorp = $arCorp[ 0 ] ;
		$now_year = date( "Y" ) ;

		$arNavi = $this -> arNavi ;

		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "year"				, $now_year				) ;
		$tmpl -> assign( "func_data"		, $arNavi[ $funcno ]	) ;
		$tmpl -> assign( "screentype"		, $screentype			) ;
		$tmpl -> assign( "script"			, $script				) ;
		if ( count( $arCorp ) == 0 )
		{
			$arCorp[ sprintf( "%s_name"				, $obCorp -> alias )	] = TITLE_CORPORATION ;
			$arCorp[ sprintf( "%s_name_en"			, $obCorp -> alias )	] = TITLE_CORPORATION_EN ;
			$arCorp[ sprintf( "%s_sname"			, $obCorp -> alias )	] = TITLE_CORPORATION_EN ;
			$arCorp[ sprintf( "%s_foundation_date"	, $obCorp -> alias )	] = sprintf( "%d-01-01" , TITLE_FOUNDATION ) ;
		}
		$tmpl -> assign( "corp_data"			, $arCorp ) ;
		$data = $tmpl -> fetch( $this -> commonPath . "footer.tmpl" ) ;
		$tmpl -> clearAllAssign() ;

		$gacode = "" ;
		if ( defined( "DEF_GACODE" ) == TRUE )
			$gacode = DEF_GACODE ;

		$root_path = "" ;
		if ( defined( "DEF_SITE_ROOTPATH" ) == TRUE )
			$root_path = DEF_SITE_ROOTPATH ;

		if ( $screentype != "popup" )
		{
			$tmpl = new HTML_template( "default" ) ;
			$tmpl -> assign( "root_path"		, $root_path ) ;
			$tmpl -> assign( "gacode"			, $gacode ) ;
			$copyright = $tmpl -> fetch( "footer.tmpl" ) ;
			$tmpl -> clearAllAssign() ;
	
			$data = str_replace( "</BODY>" , "</body>" , $data ) ;
			$data = str_replace( "</body>" , $copyright . "</body>" , $data ) ;
		}
		
		return $data ;
	}
	
	// 機能名の表示
	function	printTitle( $funcname )
	{
		$data = $this -> fetchTitle( $funcname ) ;
		
		printf( "%s" , $data ) ;
	}
	
	function	fetchTitle( $funcname )
	{
		$data = "" ;
		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "funname"		, $funcname ) ;
		$data = $tmpl -> fetch( $this -> commonPath . "function.tmpl" ) ;
		$tmpl -> clearAllAssign() ;
		return $data ;
	}

	function	fetchContents( $contents )
	{
		$data = "" ;
		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "contents"		, $contents ) ;
		$data = $tmpl -> fetch( $this -> commonPath . "contents.tmpl" ) ;
		$tmpl -> clearAllAssign() ;
		return $data ;
	}

	function	printBody( $header , $footer , $contents , $navi = "" )
	{
		$data = $this -> fetchBody( $header , $footer , $contents , $navi ) ;
		
		printf( "%s" , $data ) ;
	}

	function	fetchBody( $header , $footer , $contents , $navi = "" )
	{
		$data = "" ;
		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "header"		, $header	) ;
		$tmpl -> assign( "footer"		, $footer	) ;
		$tmpl -> assign( "contents"		, $contents	) ;
		$tmpl -> assign( "navi"			, $navi		) ;
		$data = $tmpl -> fetch( $this -> commonPath . "body.tmpl" ) ;
		$tmpl -> clearAllAssign() ;
		return $data ;
	}

	// メニュー表示
	function	fetchNavi( $func )
	{
		global	$arFunction ;
		$funcName = array_search( $func , $arFunction) ;
	
		// 標準のメニューデータの取得
		$arMenu = GetMenu( DEF_MENU_STANDARD ) ;
	
		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "func"				, $func ) ;
		$tmpl -> assign( "funcName"			, $funcName ) ;
		$tmpl -> assign( "function_data"	, $arFunction ) ;
		$tmpl -> assign( "menu_data"		, $arMenu ) ;
		$data = $tmpl -> fetch( $this -> commonPath . "navi.tmpl" ) ;
		$tmpl -> clearAllAssign() ;
		
		return $data ;
	}

	function	fetchSlideMenu( $func , $level )
	{
		global $arPermission ;
		global $arMenuTitle ;
		global $arFunction ;
		global $arFunctionTitle ;
		global $arNavi ;
	
		$arMenu = array() ;
		$menucnt = 0 ;
		for( $menu = 1 ; $menu < count( $arMenuTitle ) ; $menu ++ )
		{
			// メニューの項目を計算する。
			$cnt = 0 ;
			$keys = array_keys( $arNavi ) ;
			for ( $i = 0 ; $i < count( $arNavi ) ; $i ++ )
			{
				// メニュー項目の番号が同じものを検索
				if ( $arNavi[ $keys[ $i ] ][ 0 ] == $menu )
				{
					// メニューの表示が許可されているか
					if ( empty( $arPermission[ $keys[ $i ] ] ) == false &&
						empty( $arPermission[ $keys[ $i ] ][ $level ] ) == false )
					{
						if ( $arPermission[ $keys[ $i ] ][ $level ] > 0 )
						{
							$cnt ++ ;
						}
					}
				}
			}
	
			if ( $cnt > 0 )
			{
				$arData = array() ;
				
				// メニュー項目を表示
				if ( $arMenuTitle[ $menu ] != "" )
				{
					$arData[ "title" ] = $arMenuTitle[ $menu ] ;
				}
	
				// メニューリストの表示
				$keys = array_keys( $arNavi ) ;
				$vals = array_values( $arNavi ) ;
				for ( $list = 0 ; $list < count( $arNavi ) ; $list ++ )
				{
					$funcno   = $keys[ $list ] ;
					$menuid   = $vals[ $list ][ 0			] ;
	
					// メニュー項目の番号が同じものを検索
					if ( $menuid == $menu )
					{
						// メニューの表示が許可されているか
						if ( empty( $arPermission[ $funcno ] ) == false &&
							empty( $arPermission[ $funcno ][ $level ] ) == false )
						{
							if ( $arPermission[ $funcno ][ $level ] > 0 )
							{
								// URLがある場合、リンクを表示する
								$arData[ "item" ][$funcno] = $vals[ $list ] ;
							}
						}
					}
				}
				
				$arMenu[] = $arData ;
				$menucnt ++ ;
			}
		}

		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "func" , $func ) ;
		$tmpl -> assign( "menu_data" , $arMenu ) ;
		$data = $tmpl -> fetch( $this -> commonPath . "slidemenu.tmpl" ) ;
		$tmpl -> clearAllAssign() ;

		return $data ;
	}

	// ページングの表示
	function	fetchPaging( $url , $arParamFind , $max , $limit , $var = "page" )
	{
		$page = $arParamFind[ $var ] ;

		// パラメータの設定
		unset( $arParamFind[ $var ] ) ;
		$param = "" ;
		$param .= $this -> makeParamLink( $arParamFind , "GET" ) ;

		$paging = "" ;
		
		if ( $max > 0 )
		{
			$maxpage = ceil( $max / $limit ) ;
			if ( $page >= $maxpage )
				$page = $maxpage - 1;
		
			$start = $page * $limit ;
			$end = $page * $limit + $limit ;
			if ( $end >= $max )
				$end = $max ;
				
			$tmpl = $this -> tmpl ;
			$tmpl -> assign( "limit"	, $limit ) ;
			$tmpl -> assign( "start"	, $start ) ;
			$tmpl -> assign( "end"		, $end ) ;
			$tmpl -> assign( "var"		, $var ) ;
			$tmpl -> assign( "page"		, $page ) ;
			$tmpl -> assign( "max"		, $max ) ;
			$tmpl -> assign( "maxpage"	, $maxpage ) ;
			$tmpl -> assign( "url"		, $url ) ;
			$tmpl -> assign( "param"	, $param ) ;
			$tmpl -> assign( "class"	, "" ) ;
			$paging = $tmpl -> fetch( $this -> commonPath . "paging.tmpl" ) ;
	
			$tmpl -> clearAllAssign() ;
		}
		
		return $paging ;
	}

	// ページングの表示
	function	fetchPagejump( $url , $arParamFind , $maxpage , $jump , $limit , $var = "page" , $class = "" )
	{
		$page = $arParamFind[ $var ] ;

		// パラメータの設定
		unset( $arParamFind[ $var ] ) ;
		$param = "" ;
		$param .= $this -> makeParamLink( $arParamFind , "GET" ) ;

		$pagejump = "" ;
	
		if ( $maxpage > 0 )
		{
			if ( $page >= $maxpage )
				$page = $maxpage - 1;
	
			$start = floor( $page / $jump ) * $jump ;
			$end = $start + $jump ;
			if ( $maxpage < $end )
				$end = $maxpage ;
			
			$tmpl = $this -> tmpl ;
			$tmpl -> assign( "class"	, $class ) ;
			$tmpl -> assign( "start"	, $start ) ;
			$tmpl -> assign( "end"		, $end ) ;
			$tmpl -> assign( "var"		, $var ) ;
			$tmpl -> assign( "page"		, $page ) ;
			$tmpl -> assign( "maxpage"	, $maxpage ) ;
			$tmpl -> assign( "url"		, $url ) ;
			$tmpl -> assign( "param"	, $param ) ;
			$pagejump = $tmpl -> fetch( $this -> commonPath . "pagejump.tmpl" ) ;
	
			$tmpl -> clearAllAssign() ;
		}
		return $pagejump ;
	}
	
	// ページングの表示
	function	fetchPageback( $url , $arParamFind , $caption = "" , $parent = "" )
	{
		// パラメータの設定
		$param = "" ;
		$param = $this -> makeParamLink( $arParamFind , "GET" ) ;
		
		$pageback = "" ;

		if( !isset( $class ) )
			$class = "" ;

		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "parent"	, $parent ) ;
		$tmpl -> assign( "class"	, $class ) ;
		$tmpl -> assign( "url"		, $url ) ;
		$tmpl -> assign( "param"	, $param ) ;
		$tmpl -> assign( "caption"	, $caption ) ;
		$pageback = $tmpl -> fetch( $this -> commonPath . "pageback.tmpl" ) ;
		$tmpl -> clearAllAssign() ;
		
		return $pageback ;
	}

	// データ行の出力
	function	fetchTR( $value , $class = "" )
	{
		$data = "" ;
		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "item"			, "tr" ) ;
		$tmpl -> assign( "value"		, $value ) ;
		$tmpl -> assign( "class"		, $class ) ;
		$data = $tmpl -> fetch( $this -> commonPath . "formItem.tmpl" ) ;
		$tmpl -> clearAllAssign() ;
		return $data ;
	}
	
	// データテーブルの出力
	function	fetchTHTD(
			$label ,
			$value ,
			$lsize = 0 ,
			$vsize = 0 ,
			$color = "" ,
			$lalign = "" ,
			$valign = "" ,
			$option = 0 ,
			$lcolspan = 1 ,
			$lrowspan = 1 ,
			$vcolspan = 1 ,
			$vrowspan = 1 ,
			$cryptname = "" ,
			$cryptvalue = ""
		)
	{
		$data  = "" ;
		$data .= $this -> fetchTH( $label , $lsize , $color , $lalign , $option & BLAMS_FORMAT_BORDER , $lcolspan , $lrowspan ) ;
		$data .= $this -> fetchTD( $value , $vsize , $color , $valign , $option , $vcolspan , $vrowspan , $cryptname , $cryptvalue ) ;

		return $data ;
	}

	// データテーブルの出力
	function	fetchTDTD(
			$label ,
			$value ,
			$lsize = 0 ,
			$vsize = 0 ,
			$color = "" ,
			$lalign = "" ,
			$valign = "" ,
			$option = 0 ,
			$lcolspan = 1 ,
			$lrowspan = 1 ,
			$vcolspan = 1 ,
			$vrowspan = 1
		)
	{
		$data  = "" ;
		$data .= $this -> fetchTD( $label , $lsize , $color , $lalign , $option , $lcolspan , $lrowspan ) ;
		$data .= $this -> fetchTD( $value , $vsize , $color , $valign , $option , $vcolspan , $vrowspan ) ;
		return $data ;
	}
	
	// テーブルヘッダの出力
	function	fetchTH(
			$value ,
			$size = 0 ,
			$color = "" ,
			$align = "" ,
			$option = 0 ,
			$colspan = 1 ,
			$rowspan = 1
		)
	{
		return $this -> fetchTHorTD( "th" , $value , $size , $color , $align , $option , $colspan , $rowspan ) ;
	}

	// テーブルデータの出力
	function	fetchTD(
			$value ,
			$size = 0 ,
			$color = "" ,
			$align = "" ,
			$option = 0 ,
			$colspan = 1 ,
			$rowspan = 1 ,
			$cryptname = "" ,
			$cryptvalue = ""
		)
	{
		return $this -> fetchTHorTD( "td" , $value , $size , $color , $align , $option , $colspan , $rowspan , $cryptname , $cryptvalue ) ;
	}

	// テーブルデータのWrapper関数
	function	fetchTHorTD(
			$item ,
			$value ,
			$size = 0 ,
			$color = "" ,
			$align = "" ,
			$option = 0 ,
			$colspan = 1 ,
			$rowspan = 1 ,
			$cryptname = "" ,
			$cryptvalue = ""
		)
	{
		$class = "" ;
		if ( $color != "" )
			$class .= sprintf( "%s " , $color ) ;

		// ディフォルトでボーダーをつける
		$option |= BLAMS_FORMAT_BORDER ;

		// NO BORDER
		if ( ( $option & BLAMS_FORMAT_NOBORDER ) != 0 )
			$option &= ~BLAMS_FORMAT_BORDER ;

		// BORDER
		if ( ( $option & BLAMS_FORMAT_BORDER ) != 0 )
			$class .= sprintf( "border " ) ;

		// TEXT ALIGN
		if ( $align != "" )
			$class .= sprintf( "%s " , $align ) ;

		// BOX WIDTH
		if ( $size != 0 )
			$class .= sprintf( "w%03d " , $size ) ;

		$arModifiers = array() ;

		// DATE FORMAT
		if ( ( $option & BLAMS_FORMAT_DATE ) != 0 )
		{
			$value = trim( $value , "'" ) ;
			if ( $value == DEF_DATE_MIN || $value == DEF_DATE_MAX )
				$value = "" ;
			else
				$arModifiers[] = "date_format:%Y/%m/%d" ;
		}
		// DATE+TIME FORMAT
		if ( ( $option & BLAMS_FORMAT_DATETIME ) != 0 )
		{
			$value = trim( $value , "'" ) ;
			if ( $value == DEF_DATE_MIN || $value == DEF_DATE_MAX )
				$value = "" ;
			else
				$arModifiers[] = "date_format:%Y/%m/%d %T" ;
		}
		// NUMBER FORMAT
		if ( ( $option & BLAMS_FORMAT_NUMBER ) != 0 )
			$arModifiers[] = "number_format" ;

		// ESCAPE STRING
		if ( ( $option & BLAMS_FORMAT_ESCAPE ) != 0 )
			$arModifiers[] = "escape:html" ;

		// WORDWRAP
		if ( ( $option & BLAMS_FORMAT_WORDWRAP ) != 0 )
		{
			$num = $option & 0x0000ffff ;
			if ( $num != 0 )
				$arModifiers[] = sprintf( "wordwrap:%d:\n:true" , $num ) ;
		}
		
		// NewLine to BR Tag
		if ( ( $option & BLAMS_FORMAT_NL2BR ) != 0 )
			$arModifiers[] = "nl2br" ;

		// non TabStop FORMAT
		if ( ( $option & BLAMS_FORMAT_NOTAB ) == 0 )
			$arModifiers[] = "indent:2:\t" ;

		// PLANE output
		if ( ( $option & BLAMS_FORMAT_PLANE ) != 0 )
			$arModifiers = array() ;

		$data = "" ;
		$tmpl = $this -> tmpl ;

		$password = "" ;
		if ( empty( $cryptname ) == false && empty( $cryptvalue ) == false )
			$password = $this -> fetchHidden( $cryptname , $cryptvalue ) ;

		if( empty( $id ) == true )
			$id = "" ;

		$tmpl -> assign( "item"			, $item			) ;
		$tmpl -> assign( "colspan"		, $colspan		) ;
		$tmpl -> assign( "rowspan"		, $rowspan		) ;
		$tmpl -> assign( "value"		, $value		) ;
		$tmpl -> assign( "password"		, $password		) ;
		$tmpl -> assign( "class"		, $class		) ;
		$tmpl -> assign( "innerWidth"	, $size			) ;
		$tmpl -> assign( "modifiers"	, $arModifiers	) ;
		$tmpl -> assign( "id"			, $id			) ;
		$data = $tmpl -> fetch( $this -> commonPath . "formItem.tmpl" ) ;
		$tmpl -> clearAllAssign() ;
		return $data ;
	}

	// 入力BOXの表示
	function fetchInputbox( $name , $value , $size = 0 , $max = 0 , $mode = IME_ON , $funcname = "" , $id = "" , $plane_flg = false , $add_class = "" )
	{
		$class = "" ;
		if ( $size != 0 )
			$class .= sprintf( "w%03d " , $size ) ;

		if ( $mode == IME_OFF )
			$class .= sprintf( "imeoff " ) ;

		$ext = "" ;
		if ( ( $mode & BLAMS_FORMAT_READONLY ) != 0 )
		{
			$class	.= "readonly " ;
			$ext	.= "readonly=\"readonly\" tabindex=\"-1\"" ;
		}
		if ( ( $mode & BLAMS_FORMAT_DISABLED ) != 0 )
		{
			$class	.= "disabled " ;
			$ext	.= "disabled=\"disabled\" " ;
		}

		if( $add_class != "" )
			$class .= " " . $add_class ;

		$data = "" ;
		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "item"			, "text"		) ;
		$tmpl -> assign( "name"			, $name			) ;
		$tmpl -> assign( "value"		, $value		) ;
		$tmpl -> assign( "class"		, $class		) ;
		$tmpl -> assign( "max"			, $max			) ;
		$tmpl -> assign( "funcname"		, $funcname		) ;
		$tmpl -> assign( "id"			, $id			) ;
		$tmpl -> assign( "ext"			, $ext			) ;
		$tmpl -> assign( "plane_flg"	, $plane_flg	) ;
		$data = $tmpl -> fetch( $this -> commonPath . "formItem.tmpl" ) ;
		$tmpl -> clearAllAssign() ;
		return $data ;
	}
	
	// パスワードBOXの表示
	function fetchPasswordbox( $name , $value , $cryptname , $cryptvalue , $size = 0 , $max = 0 , $mode = IME_ON )
	{
		$class = "" ;

		if ( $size != 0 )
