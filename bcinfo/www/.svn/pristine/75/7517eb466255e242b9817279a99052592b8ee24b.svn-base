	// 画像ファイル表示（写真情報IDから）
	function fetchImageFromID( $id , $width , $height , $subject = "" , $url = "" , $item = "img" )
	{
		if ( $item == "img" )
		{
			$obPhoto = new PARTS_Photo( $this -> conn ) ;
			$arResult = $obPhoto -> getAt( $id ) ;
			
			if ( count( $arResult ) > 0 )
			{
				$alias	= $obPhoto -> alias ;
				$type	= $arResult[ $alias . "_type" ] ;
				$fname	= $arResult[ $alias . "_name" ] ;
				
				$subject = $fname . $subject ;
				switch ( $type )
				{
				case	DEF_IMAGETYPE_GIF	:
				case	DEF_IMAGETYPE_PNG	:
				case	DEF_IMAGETYPE_JPEG	:
					$item = "img" ;
					break ;
				case	DEF_IMAGETYPE_PSD	:
					$item = "psd" ;
					break ;
				case	DEF_IMAGETYPE_AI	:
					$item = "ai" ;
					break ;
				case	DEF_IMAGETYPE_AVI	:
					$item = "avi" ;
					break ;
				case	DEF_IMAGETYPE_WMV	:
					$item = "wmv" ;
					break ;
				case	DEF_IMAGETYPE_MPEG4	:
					$item = "mpg" ;
					break ;
				case	DEF_IMAGETYPE_FLV	:
					$item = "flv" ;
					break ;
				case	DEF_IMAGETYPE_PDF	:
					$item = "pdf" ;
					break ;
				case	DEF_IMAGETYPE_ZIP	:
					$item = "zip" ;
					break ;
				}
			}
		}
		
		$data = "" ;
		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "item"			, $item			) ;
		$tmpl -> assign( "id"			, $id			) ;
		$tmpl -> assign( "width"		, $width		) ;
		$tmpl -> assign( "height"		, $height		) ;
		$tmpl -> assign( "subject"		, $subject		) ;
		$tmpl -> assign( "url"			, $url			) ;
		$data = $tmpl -> fetch( $this -> commonPath . "imageItem.tmpl" ) ;
		$tmpl -> clearAllAssign() ;
		return $data ;
	}

	// 画像の表示
	function fetchDetailImageTHTD(
			$tmpid ,
			$orgid ,
			$name ,
			$filename ,
			$width = 0 ,
			$height = 0 ,
			$label ,
			$lsize = 0 ,
			$vsize = 0 ,
			$color = "" ,
			$lalign = "" ,
			$valign = "" ,
			$border = FALSE ,
			$lcolspan = 1 ,
			$lrowspan = 1 ,
			$vcolspan = 1 ,
			$vrowspan = 1 ,
			$mode = "img"
		)
	{
		$image = $this -> fetchInputImage( $tmpid , $orgid , $name , $filename , $width , $height , FALSE , $mode ) ;
	
		$data = $this -> fetchTHTD( $label , $image , $lsize , $vsize , $color , $lalign , $valign , $border , $lcolspan , $lrowspan , $vcolspan , $vrowspan ) ;
		return $data ;
	}

	// 画像入力Boxの表示
	function fetchInputImageTHTD(
			$tmpid ,
			$orgid ,
			$name ,
			$filename ,
			$width = 0 ,
			$height = 0 ,
			$label ,
			$lsize = 0 ,
			$vsize = 0 ,
			$color = "" ,
			$lalign = "" ,
			$valign = "" ,
			$border = FALSE ,
			$lcolspan = 1 ,
			$lrowspan = 1 ,
			$vcolspan = 1 ,
			$vrowspan = 1 ,
			$mode = "img"
		)
	{
		$image = $this -> fetchInputImage( $tmpid , $orgid , $name , $filename , $width , $height , TRUE , $mode ) ;
	
		$data = $this -> fetchTHTD( $label , $image , $lsize , $vsize , $color , $lalign , $valign , $border , $lcolspan , $lrowspan , $vcolspan , $vrowspan ) ;
		return $data ;
	}

	// 画像入力Boxの表示
	function fetchInputImage( $tmpid , $orgid , $name , $filename , $width , $height , $input_flg = FALSE , $mode = "img" )
	{
		$tmpimage = "" ;
		if ( $tmpid != -1 )
			$tmpimage = $this -> fetchImageFromID( $tmpid , $width , $height , $filename . "(一時)" , "" , $mode ) ;
		
		$orgimage = "" ;
		if ( $orgid != -1 && $tmpid == -1 )
			$orgimage = $this -> fetchImageFromID( $orgid , $width , $height , $filename . "(オリジナル)" , "" , $mode ) ;
	
		$deleteid = $orgid ;
	
		$data = "" ;
		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "item"			, "imageForm"	) ;
		$tmpl -> assign( "input_flg"	, $input_flg	) ;
		$tmpl -> assign( "tmpid"		, $tmpid		) ;
		$tmpl -> assign( "orgid"		, $orgid		) ;
		$tmpl -> assign( "deleteid"		, $deleteid		) ;
		$tmpl -> assign( "name"			, $name			) ;
		$tmpl -> assign( "width"		, $width		) ;
		$tmpl -> assign( "height"		, $height		) ;
		$tmpl -> assign( "tmpimage"		, $tmpimage		) ;
		$tmpl -> assign( "orgimage"		, $orgimage		) ;
		$tmpl -> assign( "filename"		, $filename		) ;
		$data = $tmpl -> fetch( $this -> commonPath . "imageItem.tmpl" ) ;
		$tmpl -> clearAllAssign() ;
		return $data ;
	}

