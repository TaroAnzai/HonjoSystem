define( "BLAMS_FORMAT_DATE"				,	0x00040000	) ;
define( "BLAMS_FORMAT_DATETIME"			,	0x00080000	) ;
define( "BLAMS_FORMAT_NUMBER"			,	0x00100000	) ;
define( "BLAMS_FORMAT_NOTAB"			,	0x00200000	) ;
