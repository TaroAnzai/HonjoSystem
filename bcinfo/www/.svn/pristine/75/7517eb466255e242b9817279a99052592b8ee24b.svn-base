	//
	// 目的別 入力フォーム関数
	// 
	// 年月日入力BOXの表示
	function fetchInputDateTime(	$name ,
									$year , $month , $day ,
									$hour , $min   , $sec ,
									$year_flg , $month_flg , $day_flg ,
									$hour_flg , $min_flg   , $sec_flg ,
									$mode = IME_OFF ,
									$time_mode = "input" , $separate = array()
								)
	{
		$data = "" ;
		
		$data .= $this -> fetchInputDate( $name , $year , $month , $day , $year_flg , $month_flg , $day_flg , $mode ) ;
		if( $time_mode == "input" )
			$data .= $this -> fetchInputTime( $name , $hour , $min   , $sec , $hour_flg , $min_flg   , $sec_flg , $mode ) ;
		else if( $time_mode == "select" )
			$data .= $this -> fetchSelectTime( $name , $hour , $min   , $sec , $hour_flg , $min_flg   , $sec_flg , $separate ) ;
		return $data ;
	}

	// 年月日入力BOXの表示
	function fetchInputDate( $name , $year , $month , $day , $year_flg , $month_flg , $day_flg , $mode = IME_OFF , $year_func = "" , $month_func = "" , $day_func = "" )
	{
		$data = "" ;
		if ( $year_flg == TRUE )
		{
			$data .= $this -> fetchInputbox( $name . "_y" , $year , 40 , 4 , IME_OFF , $year_func ) ;
			$data .= "&nbsp;年&nbsp;" ;
		}
		if ( $month_flg == TRUE )
		{
			$data .= $this -> fetchInputbox( $name . "_m" , $month , 24 , 2 , IME_OFF , $month_func ) ;
			$data .= "&nbsp;月&nbsp;" ;
		}
		
		if ( $day_flg == TRUE )
		{
			$data .= $this -> fetchInputbox( $name . "_d" , $day , 24 , 2 , IME_OFF , $day_func ) ;
			$data .= "&nbsp;日&nbsp;" ;
		}
		return $data ;
	}

	// 時分秒BOXの表示
	function fetchInputTime( $name , $hour , $min , $sec , $hour_flg , $min_flg , $sec_flg , $mode = IME_OFF )
	{
		$data = "" ;
		if ( $hour_flg == TRUE )
		{
			$data .= $this -> fetchInputbox( $name . "_h" , $hour , 24 , 2 , IME_OFF ) ;
			$data .= "&nbsp;時&nbsp;" ;
		}
		if ( $min_flg == TRUE )
		{
			$data .= $this -> fetchInputbox( $name . "_i" , $min , 24 , 2 , IME_OFF ) ;
			$data .= "&nbsp;分&nbsp;" ;
		}
		
		if ( $sec_flg == TRUE )
		{
			$data .= $this -> fetchInputbox( $name . "_s" , $sec , 24 , 2 , IME_OFF ) ;
			$data .= "&nbsp;秒&nbsp;" ;
		}
		return $data ;
	}

	// 時分秒SELECTの表示
	// $separate[ "hour"	] = num : 時区切り
	// $separate[ "min"		] = num : 分区切り
	// $separate[ "sec"		] = num : 秒区切り
	function fetchSelectTime( $name , $hour , $min , $sec , $hour_flg , $min_flg , $sec_flg , $separate = array() )
	{
		$data = "" ;
		if ( $hour_flg == TRUE )
		{
			$arHour = array() ;
			$arHour[ -1 ] = "--" ;
			$hour_count = sprintf( "%d" , $separate[ "hour" ] ) ;
			if( $hour_count == 0 )
				$hour_count = 1 ;
			for( $i = 0 ; $i < 24 ; $i = $i + $hour_count )
				$arHour[ $i ] = $i ;
			$data .= $this -> fetchSelectbox( $name . "_h" , $hour , $arHour , 24 , "" ) ;
			$data .= "&nbsp;時&nbsp;" ;
		}
		if ( $min_flg == TRUE )
		{
			$arMin = array() ;
			$arMin[ -1 ] = "--" ;
			$min_count = sprintf( "%d" , $separate[ "min" ] ) ;
			if( $min_count == 0 )
				$min_count = 1 ;
			for( $i = 0 ; $i < 60 ; $i = $i + $min_count )
				$arMin[ $i ] = $i ;
			$data .= $this -> fetchSelectbox( $name . "_i" , $min , $arMin , 24 , "" ) ;
			$data .= "&nbsp;分&nbsp;" ;
		}
		
		if ( $sec_flg == TRUE )
		{
			$arSec = array() ;
			$arSec[ -1 ] = "--" ;
			$sec_count = sprintf( "%d" , $separate[ "sec" ] ) ;
			if( $sec_count == 0 )
				$sec_count = 1 ;
			for( $i = 0 ; $i < 60 ; $i = $i + $sec_count )
				$arSec[ $i ] = $i ;
			$data .= $this -> fetchSelectbox( $name . "_s" , $sec , $arSec , 24 , "" ) ;
			$data .= "&nbsp;秒&nbsp;" ;
		}
		return $data ;
	}
	
	// 電話番号 入力BOXの表示
	function fetchInputPhone( $name , $tel1 , $tel2 , $tel3 , $mode = IME_OFF )
	{
		$data = "" ;
		$data .= $this -> fetchInputbox( $name . "1" , $tel1 , 48 , 5 , IME_OFF ) ;
		$data .= "&nbsp;-&nbsp;" ;
		$data .= $this -> fetchInputbox( $name . "2" , $tel2 , 48 , 5 , IME_OFF ) ;
		$data .= "&nbsp;-&nbsp;" ;
		$data .= $this -> fetchInputbox( $name . "3" , $tel3 , 48 , 4 , IME_OFF ) ;
		
		return $data ;
	}
	
	// 郵便番号入力BOXの表示
	function fetchInputZip( $name , $zip1 , $zip2 , $anchor = "" , $class = "" , $script = "" , $title = "" , $zipcode = false )
	{
		$data = "" ;
		$data .= $this -> fetchInputbox( $name . "1" , $zip1 , 32 , 3 , IME_OFF ) ;
		$data .= "&nbsp;-&nbsp;" ;
		$data .= $this -> fetchInputbox( $name . "2" , $zip2 , 48 , 4 , IME_OFF ) ;

		if ( $anchor != "" )
		{
			if ( $script != "" )
				$script = sprintf( "ZipcodeSelectPopup( this , '%s' ) ;" , $script ) ;
		
			$data .= "&emsp;" ;
			$data .= $this -> fetchButton( "button" , $name , $anchor , $class , $script , $title , $zipcode ) ;
		}

		return $data ;
	}

	// 名前入力BOXの表示
	function fetchInputName( $name_last_name , $last_name , $name_first_name , $first_name , $size , $length )
	{
		$data  = "" ;
		$data .= $this -> fetchInputbox( $name_last_name , $last_name , $size , $length , IME_ON ) ;
		$data .= "&nbsp;" ;
		$data .= $this -> fetchInputbox( $name_first_name , $first_name , $size  , $length , IME_ON ) ;

		return $data ;
	}

	// 誕生日入力BOXの表示
	function fetchInputBirthday( $name , $type , $year , $month , $day , $mode = IME_OFF )
	{
		$data = "" ;

		$data .= $this -> fetchSelectbox( $name . "_type" , $type , $arWareki , 40 , "西暦" ) ;

		$date .= $this -> fetchInputDate( $name , $year , $month , $day , true , true , true , $mode ) ;

		return $data ;
	}

	// Hiddenエレメントの表示
	function fetchHidden( $name , $value )
	{
		$data = "" ;
		$tmpl = $this -> tmpl ;
		$tmpl -> assign( "item"			, "hidden"		) ;
		$tmpl -> assign( "name"			, $name			) ;
		$tmpl -> assign( "value"		, $value		) ;
		$tmpl -> assign( "id"			, ""			) ;
		$tmpl -> assign( "max"			, ""			) ;
		$tmpl -> assign( "class"		, ""			) ;
		$tmpl -> assign( "funcname"		, ""			) ;
		$tmpl -> assign( "ext"			, ""			) ;
		$data = $tmpl -> fetch( $this -> commonPath . "formItem.tmpl" ) ;
		$tmpl -> clearAllAssign() ;

		return $data ;
	}

	// POST/GET用のパラメータを作成する
	function makeParamLink( $arParam , $mode = "POST" )
	{
		$link = "" ;
		$arLink = array() ;
	
		$this -> makeParamLinkSub( "" , $arParam , $arLink ) ;
		
		if ( is_array( $arLink ) == TRUE )
		{
			$keys = array_keys( $arLink ) ;
			$values = array_values( $arLink ) ;
			for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
			{
				if ( $mode == "POST" )
					$link .= $this -> fetchHidden( $keys[ $i ] , $values[ $i ] ) ;
				else if ( $mode == "GET" )
					$link .= sprintf( "&%s=%s" , $keys[ $i ] , rawurlencode( $values[ $i ] ) ) ;
			}
		}
		return $link ;
	}
	
	// パラメータ作成用の再帰処理
	function makeParamLinkSub( $parent , $arParam , &$arLink )
	{
		if ( is_array( $arParam ) == TRUE )
		{
			$keys	= array_keys( $arParam ) ;
			$values	= array_values( $arParam ) ;
		
			for ( $i = 0 ; $i < count( $arParam ) ; $i ++ )
			{
				if ( $parent != "" )
				{
					$newparent = sprintf( "%s[%s]" , $parent , $keys[ $i ] ) ;
				}
				else
				{
					$newparent = $keys[ $i ] ;
				}
				
				// 取り出したデータが配列の場合、再帰処理を行う
				if ( is_array( $values[ $i ] ) == TRUE )
				{
					$this -> makeParamLinkSub( $newparent , $values[ $i ] , $arLink ) ;
				}
				else
				{
					$arLink[ $newparent ] = $values[ $i ] ;
				}
			}
		}
	}

	// カテゴリーチェック項目を配列に戻す
	function makeCategoryArray( $category )
	{
		$checkcategory = array() ;
		
		$category = trim( $category , "[" ) ;
		$category = trim( $category , "]") ;
		
		if ( $category != "" )
			$checkcategory = explode( "][" , $category ) ;
	
		return $checkcategory ;
	}
	
	function makeCategoryList( $conn , $dat_subject , $mode = -1 )
	{
		$arCategory = array() ;
	
		$checkcategory = $this -> makeCategoryArray( $dat_subject ) ;
		$cnt = count( $checkcategory ) ;
		for ( $i = 0 ; $i < $cnt ; $i ++ )
		{
			$arCategory[] = $this -> GetCategoryNameFromID( $conn , $checkcategory[ $i ] , $mode ) ;
		}
		
		return $arCategory ;
	}
	
	function makeCategoryListWithKind( $conn , $dat_subject , $mode = -1 , $kind = -1 )
	{
		$arCategory = array() ;
	
		$checkcategory = $this -> makeCategoryArray( $dat_subject ) ;
		$cnt = count( $checkcategory ) ;
		for ( $i = 0 ; $i < $cnt ; $i ++ )
		{
			$arCategory[] = $this -> GetCategoryNameFromIDWithKind( $conn , $checkcategory[ $i ] , $mode , $kind ) ;
		}
		
		return $arCategory ;
	}
	
	function getCategoryNameFromIDWithKind( $conn , $categoryid , $mode , $kind )
	{
		$szCategoryName = "" ;
	
		$new = FALSE ;
		if ( $conn == -1 )
		{
			$new = TRUE ;
			$conn = ConnectDatabase();
		}

		if ( $conn )
		{
			$sql = sprintf( "SELECT * FROM category_data WHERE status = 1 AND categoryid = %d " , $categoryid ) ;
			$record = ExecuteSQL( $conn , $sql ) ;

			if ( $record )
			{
				if ( GetDataCount( $record ) > 0 )
				{
					$category_name	= GetValue( $record , "name" ) ;
					$category_1		= GetValue( $record , "category1" ) ;
					$category_2		= GetValue( $record , "category2" ) ;
					$category_3		= GetValue( $record , "category3" ) ;
					$kind			= GetValue( $record , "kind" ) ;

					if ( $mode == 0 || $category_2 == 0 )
					{
						// 該当カテゴリのみモード指定、或いは当該カテゴリが大項目なので中項目以下は無視
						$szCategoryName = $category_name ;
					}
					else
					{
						// 大項目カテゴリ名取得
						$category1_name = GetCategoryName( $conn , $category_1 , 0 , 0 , $kind ) ;
	
						if ( $mode == 1 )
						{
							// 該当カテゴリ大項目のみモード指定なので中項目以下は無視
							$szCategoryName = $category1_name ;
						}
						else
						{
							if ( $category_3 == 0 )
							{
								// 当該カテゴリが中項目なので小項目以下は無視
								$szCategoryName = $category1_name . "－" . $category_name ;
							}
							else
							{
								// 中項目カテゴリ名取得
								$category2_name = GetCategoryName( $conn , $category_1 , $category_2 , 0 , $kind ) ;
	
								// 当該カテゴリは小項目
								$szCategoryName = $category1_name . "－" . $category2_name . "－" . $category_name ;
							}
						}
					}
				}
				CloseRecord( $record ) ;
			}
	
			if ( $new == TRUE )
				DisconnectDatabase( $conn ) ;
		}
	
		if ( $szCategoryName == "" )
			$szCategoryName = "不明" ;
	
		return $szCategoryName ;
	}

	// 引数にURLが期待される場合に、
	// 先頭文字列にhttp(s)プロトコルがなければ付加する
	// ftpなどは非対応
	function addHTTPProtocol( $url )
	{
		if( !preg_match( "/^(https?)(:\/\/)/" , $url ) )
		{
			$url = sprintf( "http://%s" , $url ) ;
		}
		return $url ;
	}

	// URL文字列が正しければ true
	// 間違っていれば false
	function is_url( $url )
	{
		if( preg_match( "/^(https?)(:\/\/[-_.!~*\'()a-zA-Z0-9;\/?:\@&=+\$,%#]+)$/" , $url ) )
			return true ;
		else
			return false ;
	}

	// 管理画面の機能番号の取得
	function getMode( &$mode , &$func , $arMode )
	{
		$mode = "" ;
		$func = "" ;

		$arForm  = $_GET ;
		$arForm += $_POST ;

		if ( isset( $_SESSION ) )
			$arForm += $_SESSION ;
		
		for ( $m = 0 ; $m < count( $arMode ) ; $m ++ )
		{
			if ( isset( $arForm[ $arMode[ $m ] ] ) == TRUE )
			{
				$mode = $arMode[ $m ] ;
				$postMode = $arForm[ $mode ] ;
				if ( is_array( $postMode ) == TRUE )
				{
					$keys = array_keys( $postMode ) ;
					$func = $keys[ 0 ] ;
				}
				break ;
			}
		}
	}

	// RGB to WebColor
	function	rgb2web( $r , $g , $b )
	{
		$color = sprintf( "%02x%02x%02x" , $r , $g , $b ) ;
		return $color ;
	}
	
	// syslog 登録
	function	writeSyslog( $szMsg )
	{
		define_syslog_variables() ;
		
		$szMsg = mb_convert_kana( $szMsg , "KV" , "sjis-win" ) ;
		$szMsg = mb_convert_encoding( $szMsg , "utf8" , "sjis-win" ) ;
		openlog( "MAKITA Uplink", LOG_PID , LOG_LOCAL7 ) ;
		
		syslog( LOG_INFO , $szMsg ) ;
		
		closelog() ;
	}
	
	function	diff( &$stime , &$step , $bPrint = true )
	{
		$etime = microtime( true ) ;
		
		$step ++ ;
		
		$time = $etime - $stime ;

		$msg = sprintf( "%d : %.3f  ( %.3f )  <br />\n" , $step , $time , $etime ) ;
		if ( $bPrint == true )
			printf( "%s" , $msg ) ;
		
		$stime = $etime ;
	}
}
?>
