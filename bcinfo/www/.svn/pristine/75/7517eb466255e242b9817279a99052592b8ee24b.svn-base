define( "BLAMS_FORMAT_ESCAPE"			,	0x01000000	) ;
define( "BLAMS_FORMAT_READONLY"			,	0x02000000	) ;
define( "BLAMS_FORMAT_DISABLED"			,	0x04000000	) ;
define( "BLAMS_FORMAT_PLANE"			,	0x80000000	) ;
define( "BLAMS_FORMAT_MULTILINE_OUTPUT"	,	BLAMS_FORMAT_ESCAPE | BLAMS_FORMAT_WORDWRAP | 100 | BLAMS_FORMAT_NL2BR	) ;
define( "BLAMS_FORMAT_MULTILINE_INPUT"	,	BLAMS_FORMAT_NOTAB														) ;

