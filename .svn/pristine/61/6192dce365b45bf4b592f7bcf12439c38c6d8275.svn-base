<?php
//	ini_set( "display_errors" ,1 ) ;
	require_once( "../../../lib/system.php" ) ;

	$mode = "" ;
	$func = "" ;

	// 登録ボタン名によって処理を分ける
	$arMode = array( "update" ) ;
	GetSystemMode( $mode , $func , $arMode ) ;
	
	$obSession = new PARTS_Session() ;
	$obSession -> checkLogin( SESSION_ADMIN ) ;

	// セッションからログイン者情報を取得する
	$arr = $obSession -> getUserData( SESSION_ADMIN ) ;
	$login_adminid	= $arr[ $obSession -> obAdmin -> alias . "_adminid" ] ;
	$login_level	= $arr[ $obSession -> obAdmin -> alias . "_level" ] ;

	// DB
	$obCorp 	= new PARTS_Corp ;
	$alias		= $obCorp -> alias ;
	$primarykey	= $obCorp -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;
	
//debug( $_POST ) ;

	// 編集データ保存
	$arParam = array() ;
	$additional = array() ;
	$obCorp -> assignGlobal( $additional , $arParam ) ;

//	$keys = array_keys( $arParam ) ;
//	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
//		$arParam[ $keys[ $i ] ] = ${ $keys[ $i ] } ;

	// 検索用パラメータ保存
	$arParamFind = array() ;
	
	// データ取得時のキー初期化
	$getdatakey = ${ $keyname } ;

	// タイトル取得時のキー初期化
	$menu = FUNC_MAILADDRESS ;
	
	$blams = new BLAMS() ;

	$screentype = "default" ;
	$funcname = $blams -> GetFuncName( $menu ) ;
	$header = $blams -> fetchAdminHeader( $screentype , $menu ) ;
	$footer = $blams -> fetchAdminFooter( $screentype , $menu ) ;
	
	$error = "" ;
	switch ( $mode )
	{
	// 更新モード
	case "update" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;
			
			// 入力フォーム画面への初回遷移時のみ、データをDBから再取得（初期化）
			if ( $func != "back" )
			{
				// データをDBから再取得（初期化）
				$arParam = GetData( $getdatakey ) ;
//				$now = date( "Y-m-d H:i:s" ) ;
				$now_date = new DateTime();
				$now = $now_date -> format( "Y-m-d H:i:s" ) ;
				$arParam[ $obCorp -> alias . "_update_date" ] = $now ;
			}

			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			break ;

		// 更新確認画面
		case "confrm" :

			// 入力データ検査
			$error = CheckData( $mode , $func , $arParam ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			}
			break ;

		// 更新完了画面
		case "done" :
			// タイトルの表示
			$subfuncname = sprintf( "%s 更新処理" , $funcname ) ;

			// 更新登録実施
			$arParam[ $obCorp -> alias . "_corpid" ] = $getdatakey ;
			if ( UpdateData( $arParam ) == TRUE )
			{
				$error = "正常に更新されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・更新に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;
			break ;

		// 初期画面、もしくはFunctionの指定がない場合
		default :

			// タイトルの表示
			$subfuncname = sprintf( "%s 詳細表示" , $funcname ) ;

			// データをDBから再取得（初期化）
			$arParam = GetData( $getdatakey ) ;

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			break ;
		}
		break ;
	}

	// 「一覧に戻る」の表示
	$pageback = $blams -> fetchPageback( "list.php" , $arParamFind ) ;
		
	// ページ全体の生成
	$contents = $blams -> fetchContents( $pageback . $data ) ;

	// ナビゲーションメニュー
	$navi = $blams -> fetchSlideMenu( $menu , $login_level ) ;

	$blams -> PrintBody( $header , $footer , $contents , $navi ) ;

	exit ;

// ボタンの表示
function	FetchButton( $blams , $mode , $func )
{
	$arProcess = array(
		//					ボタン名								MODE							Action
		"list"				=>	array( "value" => "メニューに戻る"	, "name" => "list"				, "action" => "../menu.php"	, "target" => "" , "org_action" => "" ) ,
		"detail"			=>	array( "value" => "詳細に戻る"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"update_input"		=>	array( "value" => "更新"			, "name" => "update[input]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_confrm"		=>	array( "value" => "更新確認"		, "name" => "update[confrm]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_done"		=>	array( "value" => "更新します"		, "name" => "update[done]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_back"		=>	array( "value" => "戻る"			, "name" => "update[back]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
	) ;

	$arOperation = array() ;
	switch( $mode )
	{
	case "update" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "update_confrm" , "update_cancel" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "update_done" , "update_back" ) ;
			break ;
		case "done" :
			$arOperation = array( "detail" ) ;
			break ;
		default :
			$arOperation = array( "update_input" /*, "delete_confrm"*/ ) ;
			break ;
		}
		break ;

	}

	$arButton = array() ;
	for ( $i = 0 ; $i < count( $arOperation ) ; $i ++ )
		$arButton[] = $arProcess[ $arOperation[ $i ] ] ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "id"				, "edit_form"		) ;
	$tmpl -> assign( "button_data"		, $arButton			) ;
	$data = $tmpl -> fetch( "common/button.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	
	return $data ;
}

// データ取得
function	GetData( $getdatakey )
{
	global $obCorp ;

	$arResult = array() ;
	$arResult = $obCorp -> getAt( $getdatakey ) ;

	return $arResult ;
}

// データ検査
function	CheckData( $mode , $func , &$arParam )
{
	global $obCorp ;
	$alias = $obCorp -> alias ;

	$error = "" ;
	$error = $obCorp -> checkMailAddress( $arParam ) ;

	return $error ;
}

// 詳細表示
function	FetchDetail( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_adminid , $login_level )
{
	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;

	global $obCorp ;
	$alias = $obCorp -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$arForm = array() ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "代表用メールアドレス" , 		${ $alias . "_agent_email" } , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_ESCAPE , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "リマインダ用メールアドレス" , 	${ $alias . "_remainder_email" } , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_ESCAPE , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "問い合わせ用メールアドレス" , 	${ $alias . "_inquire_email" } , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_ESCAPE , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "完了通知用メールアドレス" , 	${ $alias . "_registered_email" } , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_ESCAPE , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "システム連絡用メールアドレス" , ${ $alias . "_feedback_email" } , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_ESCAPE , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$arForm[] = $value ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "input_data"		, $arParam			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/confrm.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 入力フォームの表示
function	FetchInput( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_level )
{
	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$isize	= $vsize - 16 ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;
	$isize3	= $vsize3 - 16 ;

	global $obCorp ;
	$alias = $obCorp -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$arForm = array() ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_agent_email" ,	${ $alias . "_agent_email" } , $isize3  , MAX_EMAIL , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "代表用メールアドレス" , 		$form , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_remainder_email" , ${ $alias . "_remainder_email" } , $isize3  , MAX_EMAIL , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "リマインダ用メールアドレス" , 	$form , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias. "_inquire_email" , 	${ $alias . "_inquire_email" } , $isize3  , MAX_EMAIL , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "問い合わせ用メールアドレス" , 	$form , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_registered_email" , 	${ $alias . "_registered_email" } , $isize3  , MAX_EMAIL , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "完了通知用メールアドレス" , 		$form , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_feedback_email" , ${ $alias . "_feedback_email" } , $isize3  , MAX_EMAIL , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "システム連絡用メールアドレス" , $form , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$arForm[] = $value ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$arParamFind[ $alias . "_create_date"	] = ${ $alias . "_create_date" } ;
	$arParamFind[ $alias . "_update_date"	] = ${ $alias . "_update_date" } ;


	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $alias . "_corpid"		) ;
	$tmpl -> assign( "idvalue"			, ${ $alias . "_corpid" }	) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/input.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 詳細表示
function	FetchDone( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam )
{
	global $obCorp ;
	$alias = $obCorp -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $alias . "corpid"	) ;
	$tmpl -> assign( "idvalue"			, ${ $alias . "_corpid" }	) ;
	$data = $tmpl -> fetch( "common/done.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// データの更新
function	UpdateData( $arParam )
{
	global $obCorp ;
	$alias = $obCorp -> alias ;
	
	$result = FALSE ;
	$result = $obCorp -> updateMail( $arParam ) ;

	return $result ;
}

?>