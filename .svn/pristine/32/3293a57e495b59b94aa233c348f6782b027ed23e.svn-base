function	MakeMailBody( $arCart )
{
	$arLocal = $arCart ;

	// ローカル変数へ展開する
	$keys = array_keys( $arLocal ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arLocal[ $keys[ $i ] ] ;

	$keys = array_keys( $arLocal[ "cart_order" ] ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arLocal[ "cart_order" ][ $keys[ $i ] ] ;

	global	$arState ;

	global	$obCart ;
	global	$obCartItem ;
	global	$obMember ;
	global	$obMerchandise ;

	$obMerchandiseMaster	= $obMerchandise -> obMaster ;
	$obCategory				= $obMerchandise -> obCategory ;

	$obCorp					= new PARTS_Corp() ;
	$obPrice				= new PARTS_Price() ;

	$ct_alias	= $obCart -> alias ;
	$ci_alias	= $obCartItem -> alias ;
	$mb_alias	= $obMember -> alias ;
	$m_alias	= $obMerchandise -> alias ;
	$c_alias	= $obCategory -> alias ;

	global	$_SERVER ;
	$SERVER_NAME = $_SERVER[ 'SERVER_NAME' ] ;
	$NRML = sprintf( "http://%s" , $SERVER_NAME ) ;
	$SSL = sprintf( "https://%s" , $SERVER_NAME ) ;

	// ご注文者
	$szGuestName = sprintf( "%s" , ${ sprintf( "%s_name" , $mb_alias ) } ) ;

	$szAddress0  = sprintf( "〒%s" , ${ sprintf( "%s_zip" , $mb_alias ) } ) ;
	$szAddress1  = $arState[ ${ sprintf( "%s_state" , $mb_alias ) } ][ 2 ] ;
	$szAddress1 .= ${ sprintf( "%s_city" , $mb_alias ) } ;
	$szAddress1 .= ${ sprintf( "%s_addr1" , $mb_alias ) } ;
	$szAddress2  = ${ sprintf( "%s_addr2" , $mb_alias ) } ;

	$arTelH			= explode( '-' , ${ sprintf( "%s_tel" , $mb_alias ) } ) ;
	if ( $arTelH[ 0 ] != "" && $arTelH[ 1 ] != "" && $arTelH[ 2 ] != "" )
	{
		$tel_h1 = $arTelH[ 0 ] ;
		$tel_h2 = $arTelH[ 1 ] ;
		$tel_h3 = $arTelH[ 2 ] ;
	}

	if ( $tel_h1 != "" && $tel_h2 != "" && $tel_h3 != "" )
		$szTel .= sprintf( "%s-%s-%s" , $tel_h1 , $tel_h2 , $tel_h3 ) ;
	else
		$szTel = "不明" ;

	// 配送先
	if ( ${ sprintf( "%s_shipping" , $ct_alias ) } == 0 )
	{
		// 配送先住所
		$szDstAddress0  = $szAddress0 ;
		$szDstAddress1  = $szAddress1 ;
		$szDstAddress2  = $szAddress2 ;

		// 配送先名
		$szDstName = $szGuestName . " 様宛" ;

		// 配送先電話番号
		$szDstTel = $szTel ;
	}
	else
	{
		// 配送先住所
		$szDstAddress0  = sprintf( "〒%s" , ${ sprintf( "%s_zip" , $ct_alias ) } ) ;
		$szDstAddress1  = $arState[ ${ sprintf( "%s_state" , $ct_alias ) } ][ 2 ] ;
		$szDstAddress1 .= ${ sprintf( "%s_city" , $ct_alias ) } ;
		$szDstAddress1 .= ${ sprintf( "%s_addr1" , $ct_alias ) } ;
		$szDstAddress2  = ${ sprintf( "%s_addr2" , $ct_alias ) } ;

		// 配送先名
		$szDstName = ${ sprintf( "%s_name" , $ct_alias ) } . " 様宛" ;

		// 配送先電話番号
		$szDstTel = ${ sprintf( "%s_tel" , $ct_alias ) } ;
	}

	// 配送指定日
	if( ${ sprintf( "%s_delivery_date" , $ct_alias ) } != DEF_DATE_MIN )
	{
		$obDelivery_date = new DateTime( ${ sprintf( "%s_delivery_date" , $ct_alias ) } ) ;
		$szDelivery_date = $obDelivery_date -> format( "Y/m/d" ) ;
	}
	else
	{
		$szDelivery_date = "" ;
	}

	// 配送指定時間
	global	$arDeliveryTime ;
	$szDelivery_time = $arDeliveryTime[ ${ sprintf( "%s_delivery_time" , $ct_alias ) } ] ;
	if ( $szDelivery_time == "" )
		$szDelivery_time = "指定なし" ;

	// 決済方法
	global	$arSettlement ;
	$szSettlement = $arSettlement[ ${ sprintf( "%s_settlement" , $ct_alias ) } ] ;

	// 請求金額
	$minus_yen = ${ sprintf( "%s_used_point" , $ct_alias ) } * YEN_PER_POINT ;
	$purchase_yen = $total_price - $minus_yen ;
	if( $purchase_yen < 0 )
		$purchase_yen = 0 ;
	if ( ${ sprintf( "%s_used_point" , $ct_alias ) } == 0 )
	{
		if ( ${ sprintf( "%s_member_flg" , $ct_alias ) } == 1 )
			$szTotalPrice = sprintf( "%8s 円（税込） （ ポイント使用なし ）" , number_format( $purchase_yen ) ) ;
		else
			$szTotalPrice = sprintf( "%8s 円（税込）" , number_format( $purchase_yen ) ) ;
	}
	else
	{
		$szTotalPrice = sprintf( "%8s 円（税込） （ %dポイント使用 ： ＝ %s 円 － %s 円 ）"
			, number_format( $purchase_yen ) , ${ sprintf( "%s_used_point" , $ct_alias ) } , number_format( $total_price ) , number_format( $minus_yen ) ) ;
	}

	// 専用BOXの指定がある場合は、詳細を表示する
	$szPackageInfo = "" ;
	if ( is_array( $package ) == TRUE )
	{
		$szPackage	= "" ;
		$keys		= array_keys( $package ) ;
		$values		= array_values( $package ) ;
		for ( $pkg = 0 ; $pkg < count( $keys ) ; $pkg ++ )
		{
			if ( $szPackage != "" )
				$szPackage .= " ＋ " ;
				
			$szPackage .= sprintf( "%d円 × %d個" , number_format( $keys[ $pkg ] ) , number_format( $values[ $pkg ] ) ) ;
		}
		$szPackageInfo  = sprintf( "\n　　　　　　　　：（" ) ;
		$szPackageInfo .= sprintf( "商品代 %s円" , number_format( $total_item - $minus_yen ) ) ;
		$szPackageInfo .= sprintf( " ＋ 専用BOX代 %s円［" , number_format( $total_package ) ) ;
		$szPackageInfo .= sprintf( "%s" , $szPackage ) ;
		$szPackageInfo .= sprintf( "］" ) ;
		$szPackageInfo .= sprintf( "）" ) ;
	}

	// 代引手数料
	$szPriceCharge = sprintf( "%8s 円" , number_format( $price_charge ) ) ;
	
	// 送料
	$szPriceTransport = sprintf( "%8s 円 （%s 円/個）" , number_format( $price_transport * $package_count ) , number_format( $price_transport ) ) ;

	// 梱包数
	$szPackageCount = sprintf( "%s 個口" , number_format( $package_count ) ) ;

	// クール便
	if ( $coolpack > 0 )
	{
		$szPackageCount .= sprintf( " （内クール便 %s 個口）" , number_format( $coolpack ) ) ;
		$szPriceCoolpack = sprintf( "%8s 円 （%s 円/個）" , number_format( $coolpack * PRICE_COOLPACK ) , number_format( PRICE_COOLPACK ) ) ;
	}
	else
	{
		$szPriceCoolpack = sprintf( "なし" ) ;
	}

	// 包装
	global	$arWrapStatus ;
	$szWrapStatus = $arWrapStatus[ $wrapping_flg ] ;

	// のし
	global	$arDecorStatus ;
	$szDecorStatus = $arDecorStatus[ $decoration_flg ] ;
	if( $decoration_flg == DF_DECORSTATUS_TRUE && $deco_used != -1 )
	{
		$szDecorName = GetCategoryNameFromID( -1 , $deco_used , -1 , DEF_CATEGORY_DECORATION ) ;
		$szDecorStatus .= sprintf( "（%s）" , $szDecorName ) ;
	}

	// 請求金額
	$szTotalCharge = sprintf( "%8s 円（税込）" ,
												number_format(
																$purchase_yen
																+ ( $price_transport * $package_count )
																+ $price_charge
																+ ( $coolpack * PRICE_COOLPACK )
															)
							) ;

	$sessionid = ${ sprintf( "%s_sessionid" , $ct_alias ) } ;
	
	// 会社情報取得
	$arCorp = $obCorp -> getOwner() ;
	if ( count( $arCorp ) > 0 )
		$arCorp = $arCorp[ 0 ] ;

	// 送信パラメータ設定
	$from_email	= EMAILADDR_INQUIRE ;
	$from_name	= $arCorp[ sprintf( "%s_name" , $obCorp -> alias ) ] ;
	$to_email	= ${ sprintf( "%s_agent_email" , $mb_alias ) } ;
	$to_name	= $szGuestName ;

	$body3  = "" ;
	$body3 .= sprintf( "// 配送情報とご請求金額\n" ) ;
	$body3 .= sprintf( "=============================================================\n" ) ;
	$body3 .= sprintf( "ｅメールアドレス：%s\n" , $to_email ) ;
	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "請求先住所：\n" ) ;
	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "　%s\n" , $szAddress0 ) ;
	$body3 .= sprintf( "　%s\n" , $szAddress1 ) ;
	$body3 .= sprintf( "　%s\n" , $szAddress2 ) ;
	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "　%s 様\n" , $szGuestName ) ;
	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "請求先電話番号：\n" ) ;
	$body3 .= sprintf( "　%s\n" , $szTel ) ;
	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "注文合計（税込）：\n" ) ;
	$body3 .= sprintf( "　%8s\n" , $szTotalCharge ) ;
	$body3 .= sprintf( "\n" ) ;
//	$body3 .= sprintf( "お届け先：\n" ) ;
//	$body3 .= sprintf( "\n" ) ;
//	$body3 .= sprintf( "　%s\n" , $szDstAddress0 ) ;
//	$body3 .= sprintf( "　%s\n" , $szDstAddress1 ) ;
//	$body3 .= sprintf( "　%s\n" , $szDstAddress2 ) ;
//	$body3 .= sprintf( "\n" ) ;
//	$body3 .= sprintf( "　%s\n" , $szDstName ) ;
//	$body3 .= sprintf( "\n" ) ;
//	$body3 .= sprintf( "お届け先電話番号：\n" ) ;
//	$body3 .= sprintf( "　%s\n" , $szDstTel ) ;
//	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "その他ご連絡事項：\n%s\n" , ${ sprintf( "%s_comment" , $ct_alias ) } ) ;
	$body3 .= sprintf( "\n" ) ;
//	$body3 .= sprintf( "配送予定日時：%s %s\n" , $szDelivery_date , $szDelivery_time ) ;
//	$body3 .= sprintf( "\n" ) ;
//	$body3 .= sprintf( "※天候、交通事情、当社都合等により、ご指定の配送日時に配達で\n" ) ;
//	$body3 .= sprintf( "　きない場合があります。予めご了承ください。\n" ) ;
//	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "// 注文内容\n" ) ;
	$body3 .= sprintf( "=============================================================\n" ) ;

	$body3 .= sprintf( "伝票番号：%s\n" , ${ sprintf( "%s_sheetno" , $ct_alias ) } ) ;
	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "注文内容は以下のリンクからご確認ください：\n" ) ;
	$body3 .= sprintf( "%s/member/status.php?sheetno=%s\n" , $NRML , ${ sprintf( "%s_sheetno" , $ct_alias ) } ) ;
	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "-------------------------------------------------------------\n" ) ;
	$body3 .= sprintf( "\n" ) ;

	$cnt = count( $cartitem_data ) ;
	for ( $i = 0 ; $i < $cnt ; $i ++ )
	{
		$name			= $cartitem_data[ $i ][ sprintf( "%s_name"		, $obMerchandiseMaster -> alias )	] ;
		$number			= $cartitem_data[ $i ][ sprintf( "%s_number"	, $ci_alias )			] ;
		$price			= $cartitem_data[ $i ][ sprintf( "%s_price"		, $obMerchandise -> alias )			] ;
		$tax			= $cartitem_data[ $i ][ sprintf( "%s_tax"		, $obMerchandise -> alias )			] ;
		$package		= $cartitem_data[ $i ][ sprintf( "%s_package"	, $ci_alias )			] ;
		$package_price	= $cartitem_data[ $i ][ "package_price"	] ;
		$coolpack		= $cartitem_data[ $i ][ sprintf( "%s_coolpack"	, $ci_alias )			] ;
		$net			= $cartitem_data[ $i ][ sprintf( "%s_net"		, $obMerchandiseMaster -> alias )	] ;
		$unit			= $cartitem_data[ $i ][ sprintf( "%s_unit"		, $obMerchandiseMaster -> alias )	] ;
		$tag			= $cartitem_data[ $i ][ sprintf( "%s_tag"		, $obMerchandiseMaster -> alias )	] ;

		$szPackage		= ( $package == 1 ? "有り" : "無し" ) ;

		if ( $price == 0 )
			$szPrice = sprintf( "　　%7s円（内税）" , number_format( $tax + $package_price ) ) ;
		else
			$szPrice = sprintf( "　　%7s円（税込）" , number_format( $tax + $package_price ) ) ;

		$szPriceSum = sprintf( "　　%7s円（税込）" , number_format( ( $tax + $package_price ) * $number ) ) ;

		if ( $unit != 1 )
			$szUnit = sprintf( "%s%s x %d" , $net , $tag , $unit ) ;
		else
			$szUnit = sprintf( "%s%s" , $net , $tag ) ;

		$szCoolpack = "" ;
//		if ( $coolpack == 1 )
//			$szCoolpack = sprintf( "※この商品はクール便にて配送いたします。" ) ;

		$body3 .= sprintf( "No.%2d ： 【%s】　内容量： %s\n" , $i + 1 , $name , $szUnit ) ;
//		$body3 .= sprintf( "%s×%3d個　　　%s\n　　専用BOX [%s]\n　　%s\n" ,
//							$szPrice , $number ,
//							$szPriceSum ,
//							$szPackage ,
//							$szCoolpack
//						) ;
		$body3 .= sprintf( "%s×%3d個　　　%s\n" ,
							$szPrice , $number ,
							$szPriceSum 
							) ;
		$body3 .= sprintf( "\n" ) ;
	}

	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "梱包数　　　　　：%s\n" , $szPackageCount ) ;
	$body3 .= sprintf( "\n" ) ;
//	$body3 .= sprintf( "包装　　　　　　：%s\n" , $szWrapStatus ) ;
//	$body3 .= sprintf( "のし　　　　　　：%s\n" , $szDecorStatus ) ;
//	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "商品金額合計　　：%s\n" , $szTotalPrice . $szPackageInfo ) ;
//	$body3 .= sprintf( "送料　　　　　　：%s\n" , $szPriceTransport ) ;
//	$body3 .= sprintf( "クール便指定　　：%s\n" , $szPriceCoolpack ) ;

	if( ${ sprintf( "%s_settlement" , $ct_alias ) } == DF_SETTLEMENT_COD )
	{
		$body3 .= sprintf( "決済方法　　　　：%s\n" , $szSettlement ) ;
		$body3 .= sprintf( "代金引換手数料　：%s\n" , $szPriceCharge ) ;
	}
	else
	{
		$body3 .= sprintf( "決済方法　　　　：%s\n" , $szSettlement ) ;
	}
	$body3 .= sprintf( "ご請求金額　　　：%s\n" , $szTotalCharge ) ;
	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "ポイント分の減額に関しては別途ご連絡差し上げます。\n" ) ;
	$body3 .= sprintf( "\n" ) ;
	$body3 .= sprintf( "=============================================================\n" ) ;
	$body3 .= sprintf( "\n" ) ;

	return $body3 ;
}

// 商品発送通知メールを送信
function	SendDeliveredMail( $arParam )
{
	$error  = "【エラーがあります】\n" ;
	$error .= "・商品発送通知メールの送信に失敗しました。\n" ;

	global	$obCart ;
	global	$obMember ;

	$ct_alias	= $obCart -> alias ;
	$mb_alias	= $obMember -> alias ;
	
	$obCorp		= new PARTS_Corp() ;

	$arParam = GetData( $arParam[ sprintf( "%s_cartid" , $ct_alias ) ] ) ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$keys = array_keys( $arParam[ "cart_order" ] ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ "cart_order" ][ $keys[ $i ] ] ;

	// 商品発送通知メール送信
	global	$_SERVER ;
	$SERVER_NAME = $_SERVER[ 'SERVER_NAME' ] ;
	$NRML = sprintf( "http://%s" , $SERVER_NAME ) ;
	$SSL = sprintf( "https://%s" , $SERVER_NAME ) ;

	// ご注文者
	$szGuestName = sprintf( "%s" , ${ sprintf( "%s_name" , $mb_alias ) } ) ;

	// 会社情報取得
	$arCorp = $obCorp -> getOwner() ;
	if ( count( $arCorp ) > 0 )
		$arCorp = $arCorp[ 0 ] ;

	// 送信パラメータ設定
	$email = "" ;
	if ( ${ sprintf( "%s_agent_email" , $mb_alias ) } != "" )
		$email = ${ sprintf( "%s_agent_email" , $mb_alias ) } ;

	$from_email	= EMAILADDR_INQUIRE ;
	$from_name	= $arCorp[ sprintf( "%s_name" , $obCorp -> alias ) ] ;
	$to_email	= $email ;
	$to_name	= $szGuestName ;

	// タイトル
	$subject1 = sprintf( "[%s] 商品発送のお知らせ" , $from_name ) ;
	$subject2 = sprintf( "商品発送通知 [ %s ]" , ${ sprintf( "%s_sheetno" , $ct_alias ) } ) ;

	// ヘッダー
	$header  = sprintf( "%sから 商品発送のお知らせ\n" , $from_name ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "お客様からご注文頂いた商品を、本日発送させて頂きました。\n" ) ;
	$header .= sprintf( "ご注文の処理が完了しましたのでお知らせ致します。\n" ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "ご利用頂き誠にありがとうございました。\n" ) ;
	$header .= sprintf( "またのご利用をお待ちしております。\n" ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "今回発送する商品は以下の通りです。\n" ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "=============================================================\n" ) ;

	$header .= sprintf( "伝票番号：%s\n" , ${ sprintf( "%s_sheetno" , $ct_alias ) } ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "注文内容は以下のリンクからご確認ください：\n" ) ;
	$header .= sprintf( "%s/member/status.php?sheetno=%s\n" , $NRML , ${ sprintf( "%s_sheetno" , $ct_alias ) } ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "-------------------------------------------------------------\n" ) ;
	$header .= sprintf( "\n" ) ;

	$body = MakeMailBody( $arParam ) ;

	// フッター
	$footer  = sprintf( "" ) ;
	$footer .= sprintf( "\n" ) ;
	$footer .= sprintf( "=============================================================\n" ) ;
//	$footer .= sprintf( "お問い合わせは伝票番号を添えて、こちらからお願い致します。\n" ) ;
//	$footer .= sprintf( "%s/cart/inquary.php\n" , $NRML ) ;
//	$footer .= sprintf( "\n" ) ;
//	$footer .= sprintf( "ご利用いただき、ありがとうございました。\n" ) ;
//	$footer .= sprintf( "今後とも%sをよろしくお願い致します。\n" , $from_name ) ;
//	$footer .= sprintf( "\n" ) ;
//	$footer .= sprintf( "-------------------------------------------------------------\n" ) ;
	$footer .= sprintf( "%s－%s\n" , $arCorp[ sprintf( "%s_catch" , $obCorp -> alias ) ] , $arCorp[ sprintf( "%s_name" , $obCorp -> alias ) ] ) ;
	$footer .= sprintf( "%s\n" , $NRML ) ;
	$footer .= sprintf( "\n" ) ;
	$footer .= sprintf( "\n" ) ;
	$footer .= sprintf( "-------------------------------------------------------------\n" ) ;

	$all = $header . $body . $footer ;

	// メール送信
	if( $to_email != "" )
	{
		// 注文者へ
		SendMailPlane( $from_email , $from_name , $to_email , $to_name , $subject1 , $all ) ;
		$error = "・正常に商品発送通知メールを送信しました。\n" ;

		// 運営へ
		$to_email	= EMAILADDR_ORDERED_FOR_SYSTEM ;
		$to_name	= "システム運営者" ;
		$all = "下記内容で商品発送通知のメールを送信しました。\n\n" . $all ;
		SendMailPlane( $from_email , $from_name , $to_email , $to_name , $subject2 , $all ) ;
	}
	else
	{
		$error = "・メールアドレスが不明の為、商品発送通知メールを送信しませんでした。\n" ;
	}

	return $error ;
}

// キャンセル通知メールを送信
function	SendCancelMail( $arParam , $conn )
{
	$error  = "【エラーがあります】\n" ;
	$error .= "・キャンセル通知メールの送信に失敗しました。\n" ;

	global	$obCart ;
	global	$obMember ;

	$ct_alias	= $obCart -> alias ;
	$mb_alias	= $obMember -> alias ;

	$obCorp		= new PARTS_Corp() ;

	$arParam = GetData( $arParam[ sprintf( "%s_cartid" , $ct_alias ) ] ) ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$keys = array_keys( $arParam[ "cart_order" ] ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ "cart_order" ][ $keys[ $i ] ] ;

	// 商品発送通知メール送信
	global	$_SERVER ;
	$SERVER_NAME = $_SERVER[ 'SERVER_NAME' ] ;
	$NRML = sprintf( "http://%s" , $SERVER_NAME ) ;
	$SSL = sprintf( "https://%s" , $SERVER_NAME ) ;

	// ご注文者
	$szGuestName = sprintf( "%s" , ${ sprintf( "%s_name" , $mb_alias ) } ) ;

	// 会社情報取得
	$arCorp = $obCorp -> getOwner() ;
	if ( count( $arCorp ) > 0 )
		$arCorp = $arCorp[ 0 ] ;

	// 送信パラメータ設定
	$email = "" ;
	if ( ${ sprintf( "%s_agent_email" , $mb_alias ) } != "" )
		$email = ${ sprintf( "%s_agent_email" , $mb_alias ) } ;

	$from_email	= EMAILADDR_INQUIRE ;
	$from_name	= $arCorp[ sprintf( "%s_name" , $obCorp -> alias ) ] ;
	$to_email	= $email ;
	$to_name	= $szGuestName ;

	// タイトル
	$subject1 = sprintf( "[%s] ご注文のキャンセル" , $from_name ) ;
	$subject2 = sprintf( "注文キャンセル通知 [ %s ]" , ${ sprintf( "%s_sheetno" , $ct_alias ) } ) ;

	// ヘッダー
	$header  = sprintf( "以下のご注文をキャンセルしました。\n" ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "ご利用頂き誠にありがとうございました。\n" ) ;
	$header .= sprintf( "またのご利用をお待ちしております。\n" ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "=============================================================\n" ) ;
	$header .= sprintf( "伝票番号：%s\n" , ${ sprintf( "%s_sheetno" , $ct_alias ) } ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "注文内容は以下のリンクからご確認ください：\n" ) ;
	$header .= sprintf( "%s/member/status.php?sheetno=%s\n" , $NRML , ${ sprintf( "%s_sheetno" , $ct_alias ) } ) ;
	$header .= sprintf( "\n" ) ;
	$header .= sprintf( "-------------------------------------------------------------\n" ) ;
	$header .= sprintf( "\n" ) ;

	$body = MakeMailBody( $arParam ) ;

	// フッター
	$footer  = sprintf( "" ) ;
	$footer .= sprintf( "\n" ) ;
	$footer .= sprintf( "=============================================================\n" ) ;
	$footer .= sprintf( "%s－%s\n" , $arCorp[ sprintf( "%s_catch" , $obCorp -> alias ) ] , $arCorp[ sprintf( "%s_name" , $obCorp -> alias ) ] ) ;
	$footer .= sprintf( "%s\n" , $NRML ) ;
	$footer .= sprintf( "\n" ) ;
	$footer .= sprintf( "\n" ) ;
	$footer .= sprintf( "-------------------------------------------------------------\n" ) ;

	$all = $header . $body . $footer ;

	// メール送信
	if( $to_email != "" )
	{
		// 注文者へ
		SendMailPlane( $from_email , $from_name , $to_email , $to_name , $subject1 , $all ) ;
		$error = "・正常にキャンセル通知メールを送信しました。\n" ;

		// 運営へ
		$to_email	= EMAILADDR_ORDERED_FOR_SYSTEM ;
		$to_name	= "システム運営者" ;
		$all = "下記内容でキャンセル通知のメールを送信しました。\n\n" . $all ;
		SendMailPlane( $from_email , $from_name , $to_email , $to_name , $subject2 , $all ) ;
	}
	else
	{
		$error = "・メールアドレスが不明の為、キャンセル通知メールを送信しませんでした。\n" ;
	}

	return $error ;
}

// member_data を更新する
function UpdateMember( $arParam )
{
	global	$obCart ;
	global	$obMember ;

	$ct_alias	= $obCart -> alias ;
	$mb_alias	= $obMember -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	// 非会員
	if( ${ sprintf( "%s_memberid" , $mb_alias ) } == -1 )
	{
		// カートIDからメンバーIDを取得
		$arWhere = array() ;
		$arWhere[ "cartid" ] = ${ sprintf( "%s_cartid" , $ct_alias ) } ;
		$arCart = $obCart -> getData( $arWhere ) ;

		$memberid		= $arCart[ 0 ][ sprintf( "%s_memberid" , $mb_alias ) ] ;
		$passwd			= $arCart[ 0 ][ sprintf( "%s_passwd" , $mb_alias ) ] ;

		if( $memberid )
		{
			$szZip = sprintf( "%s-%s" , ${ sprintf( "%s_zip1" , $mb_alias ) } , ${ sprintf( "%s_zip2" , $mb_alias ) } ) ;
			$szTel = sprintf( "%s-%s-%s" , 
					${ sprintf( "%s_tel1" , $mb_alias ) } , 
					${ sprintf( "%s_tel2" , $mb_alias ) } , 
					${ sprintf( "%s_tel3" , $mb_alias ) } ) ;

			// 必要な情報を上書き
			$arMember[ $mb_alias . "_memberid"		] = $memberid ;
			$arMember[ $mb_alias . "_passwd"		] = $passwd ;
			$arMember[ $mb_alias . "_state"			] = ${ sprintf( "%s_state"			, $mb_alias ) } ;
			$arMember[ $mb_alias . "_city"			] = ${ sprintf( "%s_city"			, $mb_alias ) } ;
			$arMember[ $mb_alias . "_addr1"			] = ${ sprintf( "%s_addr1"			, $mb_alias ) } ;
			$arMember[ $mb_alias . "_addr2"			] = ${ sprintf( "%s_addr2"			, $mb_alias ) } ;
			$arMember[ $mb_alias . "_zip"			] = $szZip ;
			$arMember[ $mb_alias . "_tel"			] = $szTel ;
			$arMember[ $mb_alias . "_name"			] = ${ sprintf( "%s_name"			, $mb_alias ) } ;
			$arMember[ $mb_alias . "_kana"			] = ${ sprintf( "%s_kana"			, $mb_alias ) } ;
			$arMember[ $mb_alias . "_agent_email"	] = ${ sprintf( "%s_agent_email"	, $mb_alias ) } ;

			$obMember -> skip_check = true ;
			$obMember -> updateData( $arMember ) ;
			$obMember -> skip_check = false ;
		}
	}
}

// カートのmemberid を更新する
// 会員から非会員への更新は member_data へ insert する
function	UpdateCartMember( $arParam )
{
	global	$obCart ;
	global	$obMember ;

	$ct_alias	= $obCart -> alias ;
	$mb_alias	= $obMember -> alias ;

	$obSerialno	= new PARTS_Serialno() ;
	$change_flg	= false ;
	$result		= false ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	// 非会員選択
	if( ${ sprintf( "%s_memberid" , $mb_alias ) } == -1 )
	{
		// ct_memberid で 正規会員か否かを調べる
		if( $obMember -> inTrueMember( ${ sprintf( "%s_memberid" , $ct_alias ) } ) == TRUE )
		{
			// 正規会員であれば、非正規会員への変更なので member_data へ insert
			$change_flg	= true ;

			$new_id = $obSerialno -> createSerialNo( SERIALNO_TYPE_MEMBER ) ;
			if ( $new_id == "" )
			{
				$memberid = -1 ;
			}
			else
			{
				$szZip = sprintf( "%s-%s" , ${ sprintf( "%s_zip1" , $mb_alias ) } , ${ sprintf( "%s_zip2" , $mb_alias ) } ) ;
				$szTel = sprintf( "%s-%s-%s" , 
						${ sprintf( "%s_tel1" , $mb_alias ) } , 
						${ sprintf( "%s_tel2" , $mb_alias ) } , 
						${ sprintf( "%s_tel3" , $mb_alias ) } ) ;
	
				$arData = array() ;
				$arData[ $mb_alias . "_loginid"			] = $new_id ;
				$arData[ $mb_alias . "_passwd"			] = $new_id ;
				$arData[ $mb_alias . "_level"			] = DEF_MEMBER_LEVEL_NON ;
				$arData[ $mb_alias . "_name"			] = ${ sprintf( "%s_name"			, $mb_alias ) } ;
				$arData[ $mb_alias . "_name_en"			] = "temptemp" ;
				$arData[ $mb_alias . "_kana"			] = "カリカイイン" ;
				$arData[ $mb_alias . "_agent_email"		] = ${ sprintf( "%s_agent_email"	, $mb_alias ) } ;
				$arData[ $mb_alias . "_email_port"		] = "" ;
				$arData[ $mb_alias . "_state"			] = ${ sprintf( "%s_state"			, $mb_alias ) } ;
				$arData[ $mb_alias . "_city"			] = ${ sprintf( "%s_city"			, $mb_alias ) } ;
				$arData[ $mb_alias . "_addr1"			] = ${ sprintf( "%s_addr1"			, $mb_alias ) } ;
				$arData[ $mb_alias . "_addr2"			] = ${ sprintf( "%s_addr2"			, $mb_alias ) } ;
				$arData[ $mb_alias . "_zip"				] = $szZip ;
				$arData[ $mb_alias . "_tel"				] = $szTel ;
				$arData[ $mb_alias . "_fax"				] = "" ;
				$arData[ $mb_alias . "_point"			] = 0 ;
				$arData[ $mb_alias . "_total_point"		] = 0 ;
				$arData[ $mb_alias . "_magazine"		] = 0 ;

				$result = $obMember -> insertData( $arData ) ;
				if( $result )
					$memberid = $arData[ $mb_alias . "_memberid"		] ;
			}
		}
		else
		{
			// 非正規会員であれば、member_data を update

			$szZip = sprintf( "%s-%s" , ${ sprintf( "%s_zip1" , $mb_alias ) } , ${ sprintf( "%s_zip2" , $mb_alias ) } ) ;
			$szTel = sprintf( "%s-%s-%s" , 
					${ sprintf( "%s_tel1" , $mb_alias ) } , 
					${ sprintf( "%s_tel2" , $mb_alias ) } , 
					${ sprintf( "%s_tel3" , $mb_alias ) } ) ;

			$arData = array() ;
			$arData[ $mb_alias . "_name"		] = ${ sprintf( "%s_name"			, $mb_alias ) } ;
			$arData[ $mb_alias . "_kana"		] = ${ sprintf( "%s_kana"			, $mb_alias ) } ;
			$arData[ $mb_alias . "_agent_email"	] = ${ sprintf( "%s_agent_email"	, $mb_alias ) } ;
			$arData[ $mb_alias . "_state"		] = ${ sprintf( "%s_state"			, $mb_alias ) } ;
			$arData[ $mb_alias . "_city"		] = ${ sprintf( "%s_city"			, $mb_alias ) } ;
			$arData[ $mb_alias . "_addr1"		] = ${ sprintf( "%s_addr1"			, $mb_alias ) } ;
			$arData[ $mb_alias . "_addr2"		] = ${ sprintf( "%s_addr2"			, $mb_alias ) } ;
			$arData[ $mb_alias . "_zip"			] = $szZip ;
			$arData[ $mb_alias . "_tel"			] = $szTel ;

			$memberid = ${ sprintf( "%s_memberid" , $ct_alias ) } ;
			if( $memberid )
			{
				$arData[ $mb_alias . "_memberid"			] = $memberid ;

				$arMember = array() ;
				$arMember = $obMember -> getAt( $memberid ) ;

				$arData[ $mb_alias . "_passwd"				] = $arMember[ $mb_alias . "_passwd"		] ;
				$arData[ $mb_alias . "_clear_passwd"		] = $arMember[ $mb_alias . "_clear_passwd"	] ;
				$arData[ $mb_alias . "_name_en"				] = $arMember[ $mb_alias . "_name_en"		] ;

				$obMember -> skip_check = true ;
				$obMember -> updateData( $arData ) ;
				$obMember -> skip_check = false ;
			}
		}

		if( $memberid && ${ sprintf( "%s_cartid" , $ct_alias ) } != -1 )
		{
			$arData = array() ;
			$arData[ $ct_alias . "_memberid"	] = $memberid ;
			$arData[ $ct_alias . "_member_flg"	] = 0 ;
			$arData[ $ct_alias . "_used_point"	] = 0 ;
			$arData[ $ct_alias . "_cartid"		] = ${ sprintf( "%s_cartid"	, $ct_alias ) } ;
			$result = $obCart -> updateData( $arData ) ;

			// 正規会員から非正規会員への変更の場合は、決済前なら使用ポイントを戻す
			if( $change_flg == true )
			{
				if( ${ sprintf( "%s_billing_status" , $ct_alias ) } == DF_BILLSTATUS_SETTLING )
				{
					$arMember = array() ;
					$arMember = $obMember -> getAt( ${ sprintf( "%s_memberid" , $ct_alias ) } ) ;
				
					$point = $arMember[ sprintf( "%s_point" , $mb_alias ) ] ;
					$total_point = $arMember[ sprintf( "%s_total_point" , $mb_alias ) ] ;

					$arData = array() ;
					$arData[ $mb_alias . "_point"		] = $point + ${ sprintf( "%s_used_point" , $ct_alias ) } ;
					$arData[ $mb_alias . "_total_point"	] = $total_point + ${ sprintf( "%s_used_point" , $ct_alias ) } ;
					$arData[ $mb_alias . "_memberid"	] = ${ sprintf( "%s_memberid" , $ct_alias ) } ;
					$obMember -> skip_check = true ;
					$obMember -> updateData( $arData ) ;
					$obMember -> skip_check = false ;
				}
			}
		}
	}
	else
	{
		if( ${ sprintf( "%s_cartid" , $ct_alias ) } != -1 )
		{
			$arData = array() ;
			$arData[ $ct_alias . "_memberid"		] = ${ sprintf( "%s_memberid"	, $mb_alias ) } ;
			$arData[ $ct_alias . "_member_flg"		] = 1 ;
			$arData[ $ct_alias . "_cartid"			] = ${ sprintf( "%s_cartid"	, $ct_alias ) } ;
			$result = $obCart -> updateData( $arData ) ;

			// 決済前が前提
			// 非会員から正規会員への変更		使用ポイント減算
			// 正規会員から正規会員への変更		元：使用ポイント戻す　新：使用ポイント減算
			// 元：ct_memberid　新：mb_memberid
			if( ${ sprintf( "%s_billing_status" , $ct_alias ) } == DF_BILLSTATUS_SETTLING )
			{
				// ct_memberid で 元が正規会員か否かを調べる
				if( $obMember -> inTrueMember( ${ sprintf( "%s_memberid" , $ct_alias ) } ) == TRUE )
				{
					// 正規会員
					$arOrgMember = $obMember -> getAt( ${ sprintf( "%s_memberid" , $ct_alias ) } ) ;

					$arData = array() ;
					$arData = $arOrgMember ;
					$arData[ $mb_alias . "_point"		] = $arOrgMember[ sprintf( "%s_point" , $mb_alias ) ] 
												+ ${ sprintf( "%s_used_point" , $ct_alias ) } ;
					$arData[ $mb_alias . "_total_point"	] = $arOrgMember[ sprintf( "%s_total_point" , $mb_alias ) ] 
												+ ${ sprintf( "%s_used_point" , $ct_alias ) } ;
					$arData[ $mb_alias . "_memberid"	] = ${ sprintf( "%s_memberid" , $ct_alias ) } ;

					$arData[ $mb_alias . "_monitorid"	] = trim( $arData[ $mb_alias . "_monitorid"	] , "{}" ) ;
					$arData[ $mb_alias . "_serverid"	] = trim( $arData[ $mb_alias . "_serverid"	] , "{}" ) ;
					$arData[ $mb_alias . "_monitorno"	] = trim( $arData[ $mb_alias . "_monitorno"	] , "{}" ) ;
					$arData[ $mb_alias . "_serverno"	] = trim( $arData[ $mb_alias . "_serverno"	] , "{}" ) ;

					$obMember -> skip_check = true ;
					$obMember -> updateData( $arData ) ;
					$obMember -> skip_check = false ;

					$arNewMember = $obMember -> getAt( ${ sprintf( "%s_memberid" , $mb_alias ) } ) ;

					$arData = array() ;
					$arData = $arNewMember ;
					$arData[ $mb_alias . "_point"		] = $arNewMember[ sprintf( "%s_point" , $mb_alias ) ] 
												- ${ sprintf( "%s_used_point" , $ct_alias ) } ;
					$arData[ $mb_alias . "_total_point"	] = $arNewMember[ sprintf( "%s_total_point" , $mb_alias ) ] 
												- ${ sprintf( "%s_used_point" , $ct_alias ) } ;
					$arData[ $mb_alias . "_memberid"	] = ${ sprintf( "%s_memberid" , $mb_alias ) } ;

					$arData[ $mb_alias . "_monitorid"	] = trim( $arData[ $mb_alias . "_monitorid"	] , "{}" ) ;
					$arData[ $mb_alias . "_serverid"	] = trim( $arData[ $mb_alias . "_serverid"	] , "{}" ) ;
					$arData[ $mb_alias . "_monitorno"	] = trim( $arData[ $mb_alias . "_monitorno"	] , "{}" ) ;
					$arData[ $mb_alias . "_serverno"	] = trim( $arData[ $mb_alias . "_serverno"	] , "{}" ) ;

					$obMember -> skip_check = true ;
					$obMember -> updateData( $arData ) ;
					$obMember -> skip_check = false ;
				}
				else
				{
					// 非正規会員
					$arNewMember = $obMember -> getAt( ${ sprintf( "%s_memberid" , $mb_alias ) } ) ;

					$arData = array() ;
					$arData = $arNewMember ;
					$arData[ $mb_alias . "_point"		] = $arNewMember[ sprintf( "%s_point" , $mb_alias ) ] 
												- ${ sprintf( "%s_used_point" , $ct_alias ) } ;
					$arData[ $mb_alias . "_total_point"	] = $arNewMember[ sprintf( "%s_total_point" , $mb_alias ) ] 
												- ${ sprintf( "%s_used_point" , $ct_alias ) } ;
					$arData[ $mb_alias . "_memberid"	] = ${ sprintf( "%s_memberid" , $mb_alias ) } ;

					$obMember -> skip_check = true ;
					$obMember -> updateData( $arData ) ;
					$obMember -> skip_check = false ;
				}
			}
		}
	}

	return $result ;
}

function	InsertData( $arParam )
{
	global	$obCart ;
	global	$obCartItem ;
	global	$obMember ;
	global	$obMerchandise ;

	$ct_alias	= $obCart -> alias ;
	$ci_alias	= $obCartItem -> alias ;
	$mb_alias	= $obMember -> alias ;
	$m_alias	= $obMerchandise -> alias ;

	$obSerialno		= new PARTS_Serialno() ;
	$result = TRUE ;
	$arData = array() ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	// 既に伝票番号が決定している場合、2重オーダー
	if ( $result )
	{
		$arWhere = array() ;
		$arWhere[ "cartid" ] = ${ sprintf( "%s_cartid" , $ct_alias ) } ;
		$arCart = $obCart -> getData( $arWhere ) ;

		if( $arCart[ 0 ][ sprintf( "%s_sheetno" , $ct_alias ) ] != "9999999999" )
			$result = FALSE ;
	}

	// この時点で既に掲載終了商品が、カート内商品に含まれている場合を想定して、それらを削除し、とりあえずエラー終了する
	if ( $result )
	{
		$obNow = new DateTime() ;
		$now = $obNow -> format( "Ymd" ) ;
		$arWhere = array() ;
		$arWhere[ "cartid"	] = ${ sprintf( "%s_cartid" , $ct_alias ) } ;
		$arWhere[ "where"	]  = sprintf( "AND ( %s.start_date > to_timestamp( '%s 235959' , 'YYYYMMDD HH24MISS' ) " 
				, $obMerchandise -> alias , $now ) ;
		$arWhere[ "where"	] .= sprintf( "OR %s.end_date < to_timestamp( '%s 000000' , 'YYYYMMDD HH24MISS' ) ) " 
				, $obMerchandise -> alias , $now ) ;

		$arCartItem = $obCartItem -> getData( $arWhere ) ;
		$cnt = count( $arCartItem ) ;

		// 一つでもあったら、エラー終了して買えなくする
		if( $cnt != 0 )
		{
			for ( $i = 0 ; $i < $cnt ; $i ++ )
			{
				$cartitemid = $arCartItem[ $i ][ sprintf( "%s_cartitemid" , $ci_alias ) ] ;
				$obCartItem -> deleteData( $cartitemid ) ;
			}
			$result = FALSE ;
		}

	}

	if ( $result && ${ sprintf( "%s_used_point" , $ct_alias ) } != 0 && ${ sprintf( "%s_member_flg" , $ct_alias ) } == 1 )
	{
		$arWhere = array() ;
		$arWhere[ "memberid" ] = ${ sprintf( "%s_memberid" , $mb_alias ) } ;
		$arMember = $obMember -> getData( $arWhere ) ;

		if( ${ sprintf( "%s_used_point" , $ct_alias ) } > $arMember[ 0 ][ sprintf( "%s_point" , $mb_alias ) ] )
		{
			// 使用ポイント超過は、エラー
			$result = FALSE ;
		}
		else
		{
			// オンラインの場合のみ減算、FAXの場合はここでは減算しない
			if( ${ sprintf( "%s_orderway" , $ct_alias ) } == DEF_ORDER_ONLINE )
			{
				// ポイントを減算する
				$arWhere = array() ;
				$arWhere[ "memberid" ] = ${ sprintf( "%s_memberid" , $mb_alias ) } ;
				$arMemberData = array() ;
				$arMemberData[ "point"			] = $arMember[ 0 ][ sprintf( "%s_point" , $mb_alias ) ] - ${ sprintf( "%s_used_point" , $ct_alias ) } ;
				$arMemberData[ "total_point"	] = $arMember[ 0 ][ sprintf( "%s_total_point" , $mb_alias ) ] - ${ sprintf( "%s_used_point" , $ct_alias ) } ;
				$obMember -> updateData( $arMemberData , $arWhere ) ;
			}
		}
	}

	// 伝票番号取得
	if ( $result )
	{
		$sheetno = $obSerialno -> createSerialNo( SERIALNO_TYPE_SHEETNO ) ;
		if ( $sheetno == "" )
			$result = FALSE ;
		else
			$arData[ $ct_alias . "_sheetno" ] = $sheetno ;
	}

	// カート管理情報更新（不足情報追加＆入金待ち状態へ）
	if ( $result )
	{
		// ポイントの有効期限（一年後）算出
		$obOrder_date = new DateTime( ${ sprintf( "%s_order_date" , $ct_alias ) } ) ;
		$date_y = $obOrder_date -> format( "Y" ) ;
		$date_m = $obOrder_date -> format( "n" ) ;
		$date_d = $obOrder_date -> format( "j" ) ;
		$temp_date = mktime( 0 , 0 , 0 , $date_m , $date_d , $date_y ) ;
		$temp_date += ( 86400 * 365 ) ;
		$limit_date = date( "Y-m-d H:i:s" , $temp_date ) ;

		// 郵便番号、電話を整形
		$zip	= sprintf( "%s-%s" , ${ sprintf( "%s_zip1" , $ct_alias ) } , ${ sprintf( "%s_zip2" , $ct_alias ) } ) ;
		$tel	= sprintf( "%s-%s-%s" , 
					${ sprintf( "%s_tel1" , $ct_alias ) } , 
					${ sprintf( "%s_tel2" , $ct_alias ) } , 
					${ sprintf( "%s_tel3" , $ct_alias ) } ) ;

		if( ${ sprintf( "%s_member_flg"	, $ct_alias ) } == 1 )
			$arData[ $ct_alias . "_memberid"		] = ${ sprintf( "%s_memberid"	, $mb_alias ) } ;
		$arData[ $ct_alias . "_member_flg"	] = ${ sprintf( "%s_member_flg"	, $ct_alias ) } ;
		$arData[ $ct_alias . "_settlement"	] = ${ sprintf( "%s_settlement"	, $ct_alias ) } ;
		$arData[ $ct_alias . "_orderway"	] = ${ sprintf( "%s_orderway"	, $ct_alias ) } ;
		$arData[ $ct_alias . "_order_date"	] = sprintf( "'%s'" , ${ sprintf( "%s_order_date"	, $ct_alias ) } ) ;
		$arData[ $ct_alias . "_used_point"	] = ${ sprintf( "%s_used_point"	, $ct_alias ) } ;

		// 購入ポイント
		$arTempCart = array() ;
		$arTempCart[ sprintf( "%s_shipping"		, $ct_alias ) ] = ${ sprintf( "%s_shipping"		, $ct_alias ) } ;
		$arTempCart[ sprintf( "%s_order_date"	, $ct_alias ) ] = ${ sprintf( "%s_order_date"	, $ct_alias ) } ;
		$arTempCart[ sprintf( "%s_settlement"	, $ct_alias ) ] = ${ sprintf( "%s_settlement"	, $ct_alias ) } ;
		$arTempCart[ sprintf( "%s_state"		, $ct_alias ) ] = ${ sprintf( "%s_state"		, $ct_alias ) } ;
		$arTempCart[ sprintf( "%s_state"		, $mb_alias ) ] = ${ sprintf( "%s_state"		, $mb_alias ) } ;
		$arTempItem = array() ;
		$arWhere = array() ;
		$arWhere[ "cartid" ] = ${ sprintf( "%s_cartid" , $ct_alias ) } ;
		$arTempItem = $obCartItem -> getData( $arWhere ) ;
		$arTempOrder = $obCart -> createOtherParam( $arTempCart , $arTempItem ) ;

		$minus_yen = ${ sprintf( "%s_used_point"	, $ct_alias ) } * YEN_PER_POINT ;
		$purchase_yen = $arTempOrder[ "total_price" ] - $minus_yen ;
		if( $purchase_yen < 0 )
			$purchase_yen = 0 ;
		${ sprintf( "%s_append_point"	, $ct_alias ) } = $purchase_yen / POINT_PER_YEN ;
		$arData[ $ct_alias . "_append_point"	] = ${ sprintf( "%s_append_point"	, $ct_alias ) } ;
		$arData[ $ct_alias . "_limit_point"		] = ${ sprintf( "%s_append_point"	, $ct_alias ) } ;
		$arData[ $ct_alias . "_limit_date"		] = sprintf( "'%s'" , $limit_date ) ;

//		$arData[ $ct_alias . "_delivery_date"	] = sprintf( "'%s'" , ${ sprintf( "%s_delivery_date"	, $ct_alias ) } ) ;
		$arData[ $ct_alias . "_delivery_time"	] = ${ sprintf( "%s_delivery_time"	, $ct_alias ) } ;

		$arData[ $ct_alias . "_shipping"		] = ${ sprintf( "%s_shipping"		, $ct_alias ) } ;
		if( ${ sprintf( "%s_shipping"	, $ct_alias ) } == 1 )
		{
			$arData[ $ct_alias . "_state"			] = ${ sprintf( "%s_state"		, $ct_alias ) } ;
			$arData[ $ct_alias . "_city"			] = ${ sprintf( "%s_city"		, $ct_alias ) } ;
			$arData[ $ct_alias . "_addr1"			] = ${ sprintf( "%s_addr1"		, $ct_alias ) } ;
			$arData[ $ct_alias . "_addr2"			] = ${ sprintf( "%s_addr2"		, $ct_alias ) } ;
			$arData[ $ct_alias . "_zip"				] = $zip ;
			$arData[ $ct_alias . "_tel"				] = $tel ;
			$arData[ $ct_alias . "_name"			] = ${ sprintf( "%s_name"		, $ct_alias ) } ;
			$arData[ $ct_alias . "_comment"			] = ${ sprintf( "%s_comment"	, $ct_alias ) } ;
		}

		if( ${ sprintf( "%s_orderway"	, $ct_alias ) } == DEF_ORDER_FAX )
			$arData[ $ct_alias . "_shipped_status"	] = DF_STATETRANS_FAX ;
		$arData[ $ct_alias . "_billing_status"		] = DF_BILLSTATUS_SETTLING ;

		$arData[ $ct_alias . "_cartid"		] = ${ sprintf( "%s_cartid" , $ct_alias ) } ;
		$obCart -> updateData( $arData , $arWhere ) ;
	}

	return $result ;
}

function	UpdateCartShipinfo( $arParam )
{
	global	$obCart ;
	global	$obCartItem ;
	global	$obMember ;

	$ct_alias	= $obCart -> alias ;
	$ci_alias	= $obCartItem -> alias ;
	$mb_alias	= $obMember -> alias ;

	$result		= false ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	// ポイントの更新（差額をmember_dataに更新する）
	if( $result )
	{
		$arWhere = array() ;
		$arWhere[ "cartid" ] = ${ sprintf( "%s_cartid" , $ct_alias ) } ;
		$arTempCart = $obCart -> getData( $arWhere ) ;
		$tempmemberid = $arTempCart[ 0 ][ sprintf( "%s_memberid" , $ct_alias ) ] ;
		if( $tempmemberid != -1 )
		{
			$arWhere = array() ;
			$arWhere[ "memberid" ] = $tempmemberid ;
			$arMember = $obMember -> getData( $arWhere ) ;

			// 今現在のユーザの使用可能ポイント
			$mem_used_point = $arMember[ 0 ][ sprintf( "%s_point" , $mb_alias ) ] ;

			// 元の使用ポイント
			$org_used_point = $arTempCart[ 0 ][ sprintf( "%s_used_point" , $ct_alias ) ] ;

			// 更新画面からの使用ポイント
			$new_used_point = ${ sprintf( "%s_used_point" , $ct_alias ) } ;

			$arData = array() ;
			$arData[ "point"		] = $mem_used_point + ( $org_used_point - $new_used_point ) ;
			$arData[ "total_point"	] = $mem_used_point + ( $org_used_point - $new_used_point ) ;

			$result = $obMember -> updateData( $arData , $arWhere ) ;
		}
	}

	if( $result )
	{
		$szZip = sprintf( "%s-%s" , ${ sprintf( "%s_zip1" , $ct_alias ) } , ${ sprintf( "%s_zip2" , $ct_alias ) } ) ;
		$szTel = sprintf( "%s-%s-%s" , ${ sprintf( "%s_tel1" , $ct_alias ) }
									 , ${ sprintf( "%s_tel2" , $ct_alias ) }
									 , ${ sprintf( "%s_tel3" , $ct_alias ) } ) ;
		$arWhere = array() ;
		$arWhere[ "cartid" ] = ${ sprintf( "%s_cartid" , $ct_alias ) } ;
		$arData = array() ;
		$arData[ "settlement"		] = ${ sprintf( "%s_settlement"		, $ct_alias ) } ;
		$arData[ "used_point"		] = ${ sprintf( "%s_used_point"		, $ct_alias ) } ;
		$arData[ "delivery_date"	] = ${ sprintf( "%s_delivery_date"	, $ct_alias ) } ;
		$arData[ "delivery_time"	] = ${ sprintf( "%s_delivery_time"	, $ct_alias ) } ;
		$arData[ "shipping"			] = ${ sprintf( "%s_shipping"		, $ct_alias ) } ;
		$arData[ "comment"			] = ${ sprintf( "%s_comment"		, $ct_alias ) } ;
		$arData[ "name"				] = ${ sprintf( "%s_name"			, $ct_alias ) } ;
		$arData[ "state"			] = ${ sprintf( "%s_state"			, $ct_alias ) } ;
		$arData[ "city"				] = ${ sprintf( "%s_city"			, $ct_alias ) } ;
		$arData[ "addr1"			] = ${ sprintf( "%s_addr1"			, $ct_alias ) } ;
		$arData[ "addr2"			] = ${ sprintf( "%s_addr2"			, $ct_alias ) } ;
		$arData[ "zip"				] = $szZip ;
		$arData[ "tel"				] = $szTel ;
		
		$result = $obCart -> updateData( $arData , $arWhere ) ;
	}

	return $result ;
}

?>