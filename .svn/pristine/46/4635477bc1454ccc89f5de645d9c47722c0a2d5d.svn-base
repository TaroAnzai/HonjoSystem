function GetStandardMenu( $category1 = DEF_CATEGORY_STANDARD )
{
	$arNavi = array() ;

	$obDB = new DB_Common() ;
	if ( $obDB -> isOpen() )
	{
		$sql  = sprintf( "SELECT * , " ) ;
		$sql .= sprintf( "category_data.category1 AS c_c1     , " ) ;
		$sql .= sprintf( "category_data.category2 AS c_c2     , " ) ;
		$sql .= sprintf( "category_data.category3 AS c_c3     , " ) ;
		$sql .= sprintf( "category_data.status    AS c_status , " ) ;
		$sql .= sprintf( "menu_data.category1     AS m_c1     , " ) ;
		$sql .= sprintf( "menu_data.category2     AS m_c2     , " ) ;
		$sql .= sprintf( "menu_data.category3     AS m_c3     , " ) ;
		$sql .= sprintf( "menu_data.status        AS m_status   " ) ;
		$sql .= sprintf( "FROM category_data " ) ;
		$sql .= sprintf( "LEFT JOIN menu_data ON category_data.categoryid = menu_data.menucategoryid " ) ;
		$sql .= sprintf( "WHERE category_data.status = 1 " ) ;
		$sql .= sprintf( "AND category_data.kind = %d " , DEF_CATEGORY_MENU ) ;
		$sql .= sprintf( "AND category_data.category1 = %d " , $category1 ) ;
		$sql .= sprintf( "AND menu_data.menuid IS NOT NULL " ) ;
		$sql .= sprintf( "AND menu_data.status = 1 " ) ;
		$sql .= sprintf( "AND menu_data.category1 > 0 " ) ;
		$sql .= sprintf( "AND menu_data.category2 = 0 " ) ;
		$sql .= sprintf( "AND menu_data.category3 = 0 " ) ;
		$sql .= sprintf( "ORDER BY category_data.category1 , menu_data.category1 , menu_data.category2 , menu_data.category3 " ) ;
	
		$result = $obDB -> executeSQL( $sql ) ;
		if ( $result )
		{
			$cnt = $obDB -> getDataCount( $result ) ;
			for ( $i = 0 ; $i < $cnt ; $i ++ )
			{
				$arData = $obDB -> getValues( $result , $i ) ;
				$anchor			= $arData[ "anchor"		] ;
				$url			= $arData[ "url"		] ;
				$class			= $arData[ "class"		] ;
				$subject		= $arData[ "subject"	] ;
				$standard		= $arData[ "standard"	] ;

				$arDetail[ "anchor"		] = $anchor		;
				$arDetail[ "url"		] = $url		;
				$arDetail[ "class"		] = $class		;
				$arDetail[ "subject"	] = $subject	;
				$arDetail[ "standard"	] = $standard	;
				$arNavi[] = $arDetail ;
			}
			$obDB -> closeRecord( $result ) ;
		}
		
	}
	
	return $arNavi ;
}

// 管理画面の機能番号の取得
function GetSystemMode( &$mode , &$func , $arMode )
{
	$mode = "" ;
	$func = "" ;

	$arForm  = $_GET ;
	$arForm += $_POST ;

	if ( isset( $_SESSION ) )
		$arForm += $_SESSION ;
	
	for ( $m = 0 ; $m < count( $arMode ) ; $m ++ )
	{
		if ( isset( $arForm[ $arMode[ $m ] ] ) == TRUE )
		{
			$mode = $arMode[ $m ] ;
			$postMode = $arForm[ $mode ] ;
			if ( is_array( $postMode ) == TRUE )
			{
				$keys = array_keys( $postMode ) ;
				$func = $keys[ 0 ] ;
			}
			break ;
		}
	}
}

// サイト管理者情報の取得
// 一般会員レベル
// 企業会員レベル
function GetAdminCategory()
{
	global	$arAdminLevel ;
	global	$arMemberLevel ;
	global	$arCorpLevel ;

	$arAdminLevel	= array() ;
	$arCorpLevel	= array() ;

	if ( empty( $arMemberLevel ) != true )
		if ( is_array( $arMemberLevel ) != true )
			$arMemberLevel	= array() ;

	$obDB = new DB_Common() ;
	if ( $obDB -> isOpen() )
	{
		if ( $obDB -> tableExists( "permission_data" ) == true )
		{
			$sql  = sprintf( "SELECT * FROM permission_data " ) ;
			$sql .= sprintf( "WHERE status = 1 " ) ;
			$sql .= sprintf( "AND kind = %d " , DEF_CATEGORY_SITEADMIN ) ;
			$sql .= sprintf( "ORDER BY category1 , category2 , category3 " ) ;
		
			$result = $obDB -> executeSQL( $sql ) ;
			if ( $result )
			{
				$cnt = $obDB -> getDataCount( $result ) ;
				for ( $i = 0 ; $i < $cnt ; $i ++ )
				{
					$arData = $obDB -> getValues( $result , $i ) ;
					$category1	= $arData[ "category1" ] ;
					$name		= $arData[ "name" ] ;
					
					$arAdminLevel[ $category1 ] = $name ;
				}
				$obDB -> closeRecord( $result ) ;
			}

			$sql  = sprintf( "SELECT * FROM permission_data " ) ;
			$sql .= sprintf( "WHERE status = 1 " ) ;
			$sql .= sprintf( "AND kind = %d " , DEF_CATEGORY_MEMBER ) ;
			$sql .= sprintf( "ORDER BY category1 , category2 , category3 " ) ;
		
			$arMemberLevel[ DEF_MEMBER_LEVEL_NON ] = DEF_MEMBER_LEVEL_NON_LABEL ;
			$result = $obDB -> executeSQL( $sql ) ;
			if ( $result )
			{
				$cnt = $obDB -> getDataCount( $result ) ;
				for ( $i = 0 ; $i < $cnt ; $i ++ )
				{
					$arData = $obDB -> getValues( $result , $i ) ;
					$category1	= $arData[ "category1" ] ;
					$name		= $arData[ "name" ] ;
					
					$arMemberLevel[ $category1 ] = $name ;
				}
				$obDB -> closeRecord( $result ) ;
			}

			$sql  = sprintf( "SELECT * FROM permission_data " ) ;
			$sql .= sprintf( "WHERE status = 1 " ) ;
			$sql .= sprintf( "AND kind = %d " , DEF_CATEGORY_CORP ) ;
			$sql .= sprintf( "ORDER BY category1 , category2 , category3 " ) ;
		
			$arCorpLevel[ DEF_MEMBER_LEVEL_NON ] = DEF_MEMBER_LEVEL_NON_LABEL ;
			$result = $obDB -> executeSQL( $sql ) ;
			if ( $result )
			{
				$cnt = $obDB -> getDataCount( $result ) ;
				for ( $i = 0 ; $i < $cnt ; $i ++ )
				{
					$arData = $obDB -> getValues( $result , $i ) ;
					$category1	= $arData[ "category1" ] ;
					$name		= $arData[ "name" ] ;
					
					$arCorpLevel[ $category1 ] = $name ;
				}
				$obDB -> closeRecord( $result ) ;
			}
		}
		
	}
}

