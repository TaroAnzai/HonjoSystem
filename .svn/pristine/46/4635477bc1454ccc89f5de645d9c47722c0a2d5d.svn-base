	}
	
	// 小のケースの数を計算
	if ( $small > 0 )
	{
		$count += ceil( $small / PRICE_PACKAGE_MAX_S ) ;
	}
*/
	return $packing_count ;
}

// 送料の計算
function	CalcPriceTransport( $conn , $state , $order_date = "" , $city = "" )
{
	$price = 0 ;
	$campaign_flg = false ;

	// 注文日が取得できたら送料キャンペーン中か調べ、キャンペーン中ならその送料を取得する
	if( $order_date != "" )
	{
		$sql  = sprintf( "SELECT * FROM campaign_data WHERE status = 1 " ) ;
		$sql .= sprintf( "AND edit_flg = %d " , DEF_EDITSTATUS_OPENED ) ;
		$sql .= sprintf( "AND kind = %d " , DEF_CAMPAIGN_TRANSPORT ) ;
		$sql .= sprintf( "AND start_date <= '%s' " , $order_date ) ;
		$sql .= sprintf( "AND end_date >= '%s' " , $order_date ) ;
		$sql .= sprintf( "order by update_date desc " ) ;
		$record = $obDB -> executeSQL( $sql ) ;
		if ( $record )
		{
			if ( $obDB -> getDataCount( $record ) > 0 )
			{
				$arData			= $obDB -> getValues( $record , 0 ) ;
				$price			= $arData[ "carriage" ] ;
				$campaign_flg	= true ;
			}
			$obDB -> closeRecord( $record ) ;
		}
	}

	// キャンペーン送料が0円（無料）もありえるから、price では分岐させない
	if( $campaign_flg == false )
	{
		$sql = sprintf( "SELECT * FROM price_data WHERE status = 1 AND state = %d AND city = '%s' AND type = 1" , $state , $city ) ;
		$record = $obDB -> executeSQL( $sql ) ;
		if ( $record )
		{
			if ( $obDB -> getDataCount( $record ) > 0 )
				$price = $obDB -> getValue( $record , "price" ) ;
			$obDB -> closeRecord( $record ) ;
		}
	}
	return $price ;
}

