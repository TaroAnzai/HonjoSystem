// カテゴリーチェック項目を配列に戻す
function	MakeCategoryArray( $category )
{
	$checkcategory = array() ;
	
	$category = trim( $category , "[" ) ;
	$category = trim( $category , "]") ;
	
	$checkcategory = explode( "][" , $category ) ;

	return $checkcategory ;
}

function	debug( $data , $color = 0 )
{
	if ( $color != 0 )
		printf( "<font color=white>\n" ) ;
	printf( "<pre><code>\n" ) ;
	
	if ( is_array( $data ) == TRUE )
		print_r( $data ) ;
	else
		printf( "data : %s\n" , $data ) ;
	
	printf( "</code></pre>\n" ) ;

	if ( $color != 0 )
		printf( "</font>\n" ) ;
}

