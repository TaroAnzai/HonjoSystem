<?php
//	ini_set( "display_errors" ,1 ) ;
	require_once( "../../../lib/system.php") ;

	// 基本パラメータ変換
	if ( empty( $mode ) == true )
		$mode = "update" ;

	if ( empty( $page ) == true )
		$page = 0 ;

	$obSession = new PARTS_Session() ;
	$obSession -> checkLogin( SESSION_ADMIN ) ;

	// セッションからログイン者情報を取得する
	$arr = $obSession -> getUserData( SESSION_ADMIN ) ;
	$login_adminid	= $arr[ $obSession -> obAdmin -> alias . "_adminid" ] ;
	$login_level	= $arr[ $obSession -> obAdmin -> alias . "_level" ] ;

	// DB
	$blams		= new BLAMS() ;
	$obConfig	= new PARTS_Config() ;
	$obCorp		= new PARTS_Corp() ;

	$additional = array() ;
	$additional[] = "page" ;
	$obConfig -> assignGlobal( $additional ) ;
	
	// 検索用パラメータ変換
	if ( $S_CORPID == "" )
		$S_CORPID = -1 ;

	// 検索用パラメータ保存
	$arParamFind = array() ;
	foreach( $obConfig -> searchkey as $name )
		$arParamFind[ $name ] = ${ $name } ;
	$arParamFind[ "page"	] = $page			;

	$menu = FUNC_CONFIG ;

	$screentype = "default" ;
	$funcname = $blams -> GetFuncName( $menu ) ;
	$header = $blams -> fetchAdminHeader( $screentype , $menu ) ;
	$footer = $blams -> fetchAdminFooter( $screentype , $menu ) ;

	// リスト表示
	$data = FetchList( $blams , $funcname , $arParamFind , $obConfig , $obCorp ) ;

	// ページ全体の生成
	$contents = $blams -> fetchContents( $data ) ;

	// ナビゲーションメニュー
	$navi = $blams -> fetchSlideMenu( $menu , $login_level ) ;

	$blams -> PrintBody( $header , $footer , $contents , $navi ) ;

exit ;

//
// データの表示
//
function	FetchList( $blams , $funcname , $arParamFind , $obConfig , $obCorp )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	$list_flg = TRUE ;
	$arWhere = array() ;
	$arWhere[ "corpid"	] = $S_CORPID ;
	
	// 該当データ数取得
	$cnt = 0 ;
	if ( $obConfig -> isOpen() == true )
	{
		$cnt		= $obConfig -> getCount( $arWhere ) ;
		$arConfig	= $obConfig -> getData( $arWhere , $page , NUMBER_PER_PAGE ) ;
	}

	$paging = "" ;
	$pageJump = "" ;
	
	// 登録データがある場合
	// ページ番号の修正があるので、検索フォームの表示　は下へ
	$arList = array() ;
	if ( $cnt != 0 )
	{
		// 最大ページ数を計算する
		$maxpage = ceil( $cnt / NUMBER_PER_PAGE ) ;
		if ( $page == "" )
			$page = 0 ;
		else if ( $page >= $maxpage )
			$page = $maxpage - 1;
		$arParamFind[ "page" ] = $page ;

		$nStart = $page * NUMBER_PER_PAGE ;
		$nEnd = $page * NUMBER_PER_PAGE + NUMBER_PER_PAGE ;
		if ( $nEnd >= $cnt )
			$nEnd = $cnt ;

		// ページ移動の表示
		$paging = $blams -> fetchPaging( "list.php" , $arParamFind , $cnt , NUMBER_PER_PAGE ) ;

		// 一覧表示
		$arList = GetList( $blams , $page , $arParamFind , $obConfig , $obCorp ) ;

		// ページジャンプの表示
		$pageJump = $blams -> fetchPagejump( "list.php" , $arParamFind , $maxpage , JUMP_PER_PAGE , NUMBER_PER_PAGE ) ;
	}

	// 検索フォームの表示
	$search = FetchSearch( $blams , $arParamFind , $obCorp ) ;

	$arHeader = array(
		array( "caption" => "社名"				, "class" => "w256 left" ) ,
		array( "caption" => "ポイント還元率"	, "class" => "w128 left" ) ,
		array( "caption" => "ポイント加算率"	, "class" => "w128 left" ) ,
		array( "caption" => "包装料金"			, "class" => "w128 left" ) ,
		array( "caption" => "のし料金"			, "class" => "w128 left" ) ,
		array( "caption" => "クール便料金"		, "class" => "w128 left" ) ,
	) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, "list"			) ;
	$tmpl -> assign( "page"				, $page				) ;
	$tmpl -> assign( "maxline"			, NUMBER_PER_PAGE	) ;
	$tmpl -> assign( "list_flg"			, $list_flg			) ;
	$tmpl -> assign( "search"			, $search			) ;
	$tmpl -> assign( "paging"			, $paging			) ;
	$tmpl -> assign( "page_jump"		, $pageJump			) ;
	$tmpl -> assign( "header_data"		, $arHeader			) ;
	$tmpl -> assign( "list_data"		, $arList			) ;
	$tmpl -> assign( "error"			, ""				) ;
	$tmpl -> assign( "noanchor_flg"		, false				) ;
	$data = $tmpl -> fetch( "common/list.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 検索フォームの生成
function	FetchSearch( $blams , $arParamFind , $obCorp )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	// 製造元・蔵元名取得
	$arCorp_local 	= array() ;
	$cpAlias 		= $obCorp -> alias ;
	$arWhere 		= array() ;

	$arWhere[ "groupflg"	] = 99 ;
	$arWhere[ "order"		] = sprintf( "%s.name" , $cpAlias ) ;
	$arResults = array() ;
	$arResults = $obCorp -> getData( $arWhere ) ;

	foreach ( $arResults as $arResult )
	{
		$corp_corpid = $arResult[ $cpAlias . "_corpid"	] ;
		$arCorp_local[ $corp_corpid ] = $arResult[ $cpAlias . "_lname"	] ;
	}

	$arForm[] = array() ;

	$value = "" ;
	$form	= $blams -> fetchSelectbox( "S_CORPID" , $S_CORPID , $arCorp_local , 256 - 16 , "すべて選択" , FALSE ) ;
	$value .= $blams -> fetchTDTD( "社名" , $form , 128 , 256 , "" , "left" , "middle" , BLAMS_FORMAT_NOBORDER ) ;

	$arForm[] = $value ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "list_url"			, "list.php"		) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "page"				, $page				) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "append_disable"	, false				) ;
	$data = $tmpl -> fetch( "common/search.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 一覧の取得
function	GetList( $blams , $page , $arParamFind , $obConfig , $obCorp )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParamFind ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParamFind[ $keys[ $i ] ] ;

	// パラメータの設定
	$param = "" ;
	$param .= $blams -> MakeParamLink( $arParamFind , "GET" ) ;

	$arConfigs	= $obConfig -> arData ;
	$alias		= $obConfig -> alias ;
	$primarykey	= $obConfig -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	foreach ( $arConfigs as $arConfig )
	{
		// データの取得
		$configid			= $arConfig[ $alias . "_configid"			] ;
		$corpid				= $arConfig[ $alias . "_corpid"				] ;
		$yen_per_point		= $arConfig[ $alias . "_yen_per_point"		] ;
		$point_per_yen		= $arConfig[ $alias . "_point_per_yen"		] ;
		$price_wrapping		= $arConfig[ $alias . "_price_wrapping"		] ;
		$price_decoration	= $arConfig[ $alias . "_price_decoration"	] ;
		$price_coolpack		= $arConfig[ $alias . "_price_coolpack"		] ;

		// 製造元・蔵元名取得
		$arCorp = array() ;
		$cpAlias 	= $obCorp -> alias ;
		$arResult = array() ;
		$arResult = $obCorp -> getAt( $corpid ) ;
		$szCorp = "" ;
		
		if ( count( $arResult ) > 0 )
			$szCorp = $arResult[ $cpAlias . "_lname"	] ;

		if ( $szCorp == "" )
				$szCorp = "不明" ;

		$arAnchor[ "url" 			] = "edit.php"				;
		$arAnchor[ "idname"			] = $alias . "_configid"	;
		$arAnchor[ "id"				] = $configid				;
		$arAnchor[ "param"			] = $param					;
		$arAnchor[ "anchor"			] = $szCorp					;
		$arAnchor[ "caption"		] = $szCorp					;
		$arAnchor[ "class"			] = "border left"			;
		$arAnchor[ "script"			] = ""						;
		$arAnchor[ "date_format"	] = ""						;

		$arData = array() ;
		$arData[] = $arAnchor ;
		$arData[] = array( "caption" => $yen_per_point ,		"class" => "border right" , "number_format" => "number_format"	, "date_format" => ""	, "anchor" => "" ) ;
		$arData[] = array( "caption" => $point_per_yen ,		"class" => "border right" , "number_format" => "number_format"	, "date_format" => ""	, "anchor" => "" ) ;
		$arData[] = array( "caption" => $price_wrapping ,		"class" => "border right" , "number_format" => "number_format"	, "date_format" => ""	, "anchor" => "" ) ;
		$arData[] = array( "caption" => $price_decoration ,		"class" => "border right" , "number_format" => "number_format"	, "date_format" => ""	, "anchor" => "" ) ;
		$arData[] = array( "caption" => $price_coolpack ,		"class" => "border right" , "number_format" => "number_format"	, "date_format" => ""	, "anchor" => "" ) ;
		$arList[] = $arData ;
	}

	return $arList ;
}


?>
