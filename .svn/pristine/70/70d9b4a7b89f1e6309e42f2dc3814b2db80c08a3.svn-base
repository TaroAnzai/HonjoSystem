function	GetProductCorpName( $prod_corpid )
{
	if( $prod_corpid == -2 )
	{
		$szCorpName = "Žw’è‚È‚µ" ;
	}
	else
	{
		$obCorp = new PARTS_Corp() ;
		
		$arWhere = array() ;
		$arWhere[ $obCorp -> primarykey ] = $prod_corpid ;
		$arResult = $obCorp -> getData( $arWhere , 0 , false ) ;

		if ( count( $arResult ) > 0 )
		{
			$szCorpName = $arResult[ 0 ][ $obCorp -> alias . "_name" ] ;
		}
	}
	return $szCorpName ;
}

