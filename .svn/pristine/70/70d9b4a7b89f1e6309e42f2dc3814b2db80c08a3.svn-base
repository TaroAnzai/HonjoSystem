function	PrintHeader( $screentype , $func = -1 )
{
	$blams = new BLAMS() ;
	$blams -> init() ;
	$blams -> PrintHeader( $screentype , $func ) ;
}

function	PrintFooter( $func )
{
	$blams = new BLAMS() ;
	$blams -> init() ;
	$blams -> PrintFooter( $func ) ;
}

// Š¿ŽšƒR[ƒh‚Ì•ÏŠ·
function ConvertLineID( $id )
{
	// SJIS ‚©‚ç EUC ‚Ö
	$id = mb_convert_encoding( $id , "EUC-JP" , "SJIS" ) ;

	// ‘SŠp ‚©‚ç ”¼Šp‚Ö
	$id = mb_convert_kana( $id , "a" , "EUC-JP" ) ;

	// ¬•¶Žš‚©‚ç ‘å•¶Žš‚Ö
	$id = mb_strtoupper( $id , "EUC-JP" ) ;

	// EUC ‚©‚ç SJIS‚Ö
	$id = mb_convert_encoding( $id , "SJIS" , "EUC-JP" ) ;

	return $id ;
}

// ‚s‚n‚oî•ñ‚ÌŽæ“¾
function GetTop( $topid )
{
	$sql = "SELECT * FROM top_data WHERE topid = '" . $topid . "'" ;

	$arr = array() ;
	$conn = ConnectDatabase() ;
	if ( $conn )
	{
		$result = ExecuteSQL( $conn , $sql ) ;
		if ( $result )
		{
			if ( GetDataCount( $result ) )
				$arr = pg_fetch_array( $result , 0 , PGSQL_ASSOC ) ;
			CloseRecord( $result ) ;
		}
		DisconnectDatabase( $conn ) ;
	}

	return $arr;
}

