	{
		$result = false ;
	
		$alias		= $this -> alias ;
		$primarykey	= $this -> primarykey ;
		$keyname	= sprintf( "%s_%s" , $alias , $primarykey ) ;
	
		$result = parent::insertData( $arParam ) ;

		return $result ;
	}

	function	updateData( $arParam )
	{
