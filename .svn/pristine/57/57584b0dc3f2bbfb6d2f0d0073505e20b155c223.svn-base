<?php
//	ini_set( "display_errors" ,1 ) ;
	require_once( "../../../lib/system.php") ;
	require_once( "class/member_corp.class.php" ) ;
	require_once( "class/member_id.class.php" ) ;

	if ( empty( $page ) == true )
		$page = 0 ;

	if ( empty( $order ) == true )
		$order = "" ;

	$mode = "" ;
	$func = "" ;

	// 登録ボタン名によって処理を分ける
	$arMode = array( "append" , "update" , "delete" ) ;
	GetSystemMode( $mode , $func , $arMode ) ;

	$blams		= new BLAMS() ;
	$obMember	= new PARTS_Member() ;
	$obMemberI	= new PARTS_MemberId() ;
	$obCorp		= new PARTS_Corp() ;
	$obCategory	= new PARTS_Category() ;

	$alias 		= $obMemberI -> alias ;
	$primarykey	= $obMemberI -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	// 編集データ保存
	$arParam = array() ;
	
	$additional = array() ;
	$additional[] = "from" ;
	$additional[] = "sid" ;
	$additional[] = "page" ;
	$obMemberI -> assignGlobal( $additional , $arParam ) ;

	if ( empty( $from ) == true )
		$from = "admin" ;

	if( $from == "admin" )
	{
		$obSession = new PARTS_Session() ;
		$obSession -> checkLogin( SESSION_ADMIN ) ;

		// セッションからログイン者情報を取得する
		$arr = $obSession -> getUserData( SESSION_ADMIN ) ;
		$login_adminid	= $arr[ $obSession -> obAdmin -> alias . "_adminid" ] ;
		$login_level	= $arr[ $obSession -> obAdmin -> alias . "_level" ] ;
	}
	else if( $from == "member" )
	{
		// 仮登録からの流れではシステム的にログインしていないので
		if( $sid == "true_regist" )
		{
			$arTemp = $obMember -> getAt( ${ $keyname } ) ;
			$login_adminid	= ${ $keyname } ;
			$login_level	= $arTemp[ $obMember -> alias . "_level" ] ;
			unset( $arTemp ) ;
		}
		else
		{
			$obSession = new PARTS_Session() ;
			$sessionid	= $sid ;
			${ $keyname } = $obSession -> getUserID( $sessionid , SESSION_MEMBER ) ;
			if( ${ $keyname } == -1 )
			{
				exit ;
			}
			else
			{
				$arTemp = $obMember -> getAt( ${ $keyname } ) ;
				$login_adminid	= ${ $keyname } ;
				$login_level	= $arTemp[ $obMember -> alias . "_level" ] ;
				unset( $arTemp ) ;
			}
		}
	}

	// 検索用パラメータ保存
	$arParamFind = array() ;
	foreach( $obMemberI -> searchkey as $name )
		$arParamFind[ $name ] = ${ $name } ;
	$arParamFind[ "page"			] = $page			;
	$arParamFind[ "order"			] = $order			;
	$arParamFind[ "from"			] = $from			;
	$arParamFind[ "sid"				] = $sid			;

	// データ取得時のキー初期化
	$getdatakey = ${ $keyname } ;

	// タイトル取得時のキー初期化
	$menu = FUNC_MEMBER ;

	$screentype = "popup" ;
	$funcname = "シリアル/PID" ;
	$header = $blams -> fetchAdminHeader( $screentype , $menu , "/js/member.js" ) ;
	$footer = $blams -> fetchAdminFooter( $screentype , $menu ) ;

	$error = "" ;
	switch ( $mode )
	{
	// 新規登録モード
	case "append" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 新規入力" , $funcname ) ;

			// 入力フォーム画面への初回遷移時のみ、データを初期化
			if ( $func != "back" )
			{
				$obMemberI -> initData( $arParam ) ;
			}

			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;

			break ;

		// 新規確認画面
		case "confrm" :
			// 入力データ検査
			$error = $obMemberI -> checkData( $mode , $func , $arParam ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 新規入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			}
			break ;

		// 新規完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 登録処理" , $funcname ) ;

			// 新規登録実施
			if ( setData( $arParam ) == TRUE )
			{
				$error = "正常に登録されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・登録に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;
			break ;
		}
		break ;

	// 更新モード
	case "update" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

			// 入力フォーム画面への初回遷移時のみ、データをDBから再取得（初期化）
			if ( $func != "back" )
			{
				// データをDBから再取得（初期化）
				$arParam = GetData( $getdatakey ) ;
				$now_date = new DateTime();
				$now = $now_date -> format( "Y-m-d H:i:s" ) ;
				$arParam[ ${ $alias . "_update_date" } ] = $now ;
			}

			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			break ;

		// 更新確認画面
		case "confrm" :

			// 入力データ検査
			$error = $obMemberI -> checkData( $mode , $func , $arParam , $from , $sid ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			}
			break ;

		// 更新完了画面
		case "done" :
			// タイトルの表示
			$subfuncname = sprintf( "%s 更新処理" , $funcname ) ;

			// 更新登録実施
			if ( $obMemberI -> updateData( $arParam ) == TRUE )
			{
				$error = "正常に更新されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・更新に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;
			break ;

		// 初期画面、もしくはFunctionの指定がない場合
		default :
			// タイトルの表示
			$subfuncname = sprintf( "%s 詳細表示" , $funcname ) ;

			$arNextPrev = $obMember -> getNextPrevMemberID( $getdatakey , $arParamFind ) ;

			// データをDBから再取得（初期化）
			$arParam = GetData( $getdatakey ) ;

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $arNextPrev ) ;
			break ;
		}
		break ;

	// 削除モード
	case "delete" :

		// 機能分岐
		switch( $func )
		{

		// 削除確認画面
		case "confrm" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 削除確認" , $funcname ) ;

			// 削除確認メッセージ表示
			$error  = "【重要】\n" ;
			$error .= "・" . $funcname ;
			$error .= "を削除すると、該当会員はその後ログインできなくなります。\n" ;

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			break ;

		// 削除完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 削除処理" , $funcname ) ;

			// 削除処理実施
			if ( $obMemberI -> deleteData( $arParam ) == TRUE )
			{
				$error = "正常に削除されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・削除に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;
			break ;
		}
		break ;
	}

	// ページ全体の生成
	if( !isset( $pageback ) )
		$pageback = "" ;

	$contents = $blams -> fetchContents( $pageback . $data ) ;

	$blams -> PrintBody( $header , $footer , $contents ) ;

	exit ;

// ボタンの表示
function	FetchButton( $blams , $mode , $func , $memberid = -1 , $arNextPrev = array() )
{
	global $obMemberI ;
	$arProcess = array(
		//					ボタン名								MODE								Action
		"list"				=>	array( "value" => "一覧に戻る"		, "name" => "list"					, "action" => "list.php"	, "target" => "" , "org_action" => "" ) ,
		"detail"			=>	array( "value" => "詳細に戻る"		, "name" => "update[default]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"append_confrm"		=>	array( "value" => "新規確認"		, "name" => "append[confrm]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"append_done"		=>	array( "value" => "登録します"		, "name" => "append[done]"			, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"append_cancel"		=>	array( "value" => "キャンセル"		, "name" => "append[cancel]"		, "action" => "list.php"	, "target" => "" , "org_action" => "" ) ,
		"append_back"		=>	array( "value" => "戻る"			, "name" => "append[back]"			, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"update_input"		=>	array( "value" => "更新"			, "name" => "update[input]"			, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_confrm"		=>	array( "value" => "更新確認"		, "name" => "update[confrm]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_done"		=>	array( "value" => "更新します"		, "name" => "update[done]"			, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_back"		=>	array( "value" => "戻る"			, "name" => "update[back]"			, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"delete_confrm"		=>	array( "value" => "削除"			, "name" => "delete[confrm]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"delete_done"		=>	array( "value" => "削除します"		, "name" => "delete[done]"			, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"delete_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"StartNewLine"		=>	array( "value" => ""				, "name" => "StartNewLine"			, "action" => ""			, "target" => "" , "org_action" => "" ) ,
	) ;

	$arOperation = array() ;
	switch( $mode )
	{
	case "append" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "append_confrm" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "append_done" , "append_back" ) ;
			break ;
		case "done" :
			$arOperation = array() ;
			break ;
		}
		break ;

	case "update" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "update_confrm" , "update_cancel" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "update_done" , "update_back" ) ;
			break ;
		case "done" :
			$arOperation = array( "detail" ) ;
			break ;
		default :
			$arOperation = array( "update_input" ) ;
			break ;
		}
		break ;

	case "delete" :
		switch( $func )
		{
		case "confrm" :
			$arOperation = array( "delete_done" , "delete_cancel" ) ;
			break ;
		case "done" :
			$arOperation = array( "list" ) ;
			break ;
		}
		break ;
	}

	$arButton = array() ;
	if( is_array( $arOperation ) )
	{
		foreach( $arOperation as $value )
			$arButton[] = $arProcess[ $value ] ;
	}

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "id"				, "edit_form"		) ;
	$tmpl -> assign( "button_data"		, $arButton			) ;
	$data = $tmpl -> fetch( "common/button.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;

}

function	GetData( $memberid )
{
	global $obMember ;
	$alias = $obMember -> alias ;

	$arParam = $obMember -> getAt( $memberid ) ;

	// ローカル変数へ展開する
	foreach ( $arParam as $keys => $values )
		${ $keys } = $values ;

	unset( $arParam[ $alias . "_serverid" ] ) ;
	$arServerid = array() ;
	$serverid	= trim( ${ $alias . "_serverid" } , "'{}'" ) ;
	$arTmpSid	= explode( "," , $serverid ) ;
	for( $i = 0 ; $i < 3 ; $i ++ )
	{
		if( isset( $arTmpSid[ $i ] ) )
		{
			$arParam[ $alias . "_serverid0" ][] = substr( trim( $arTmpSid[ $i ] , "\"" ) , 0 , 8 ) ;
			$arParam[ $alias . "_serverid1" ][] = substr( trim( $arTmpSid[ $i ] , "\"" ) , 8 , 8 ) ;
		}
		else
		{
			$arParam[ $alias . "_serverid0" ][] = "" ;
			$arParam[ $alias . "_serverid1" ][] = "" ;
		}
	}

	unset( $arParam[ $alias . "_serverno" ] ) ;
	$arServerno = array() ;
	$serverno	= trim( ${ $alias . "_serverno" } , "'{}'" ) ;
	$arTmpSno	= explode( "," , $serverno ) ;
	for( $i = 0 ; $i < 3 ; $i ++ )
	{
		if( isset( $arTmpSno[ $i ] ) )
		{
			$arParam[ $alias . "_serverno0" ][] = substr( trim( $arTmpSno[ $i ] , "\"" ) , 0 , 5 ) ;
			$arParam[ $alias . "_serverno1" ][] = substr( trim( $arTmpSno[ $i ] , "\"" ) , 5 , 5 ) ;
			$arParam[ $alias . "_serverno2" ][] = substr( trim( $arTmpSno[ $i ] , "\"" ) , 10 , 5 ) ;
			$arParam[ $alias . "_serverno3" ][] = substr( trim( $arTmpSno[ $i ] , "\"" ) , 15 , 5 ) ;
			$arParam[ $alias . "_serverno4" ][] = substr( trim( $arTmpSno[ $i ] , "\"" ) , 20 , 5 ) ;
		}
		else
		{
			$arParam[ $alias . "_serverno0" ][] = "" ;
			$arParam[ $alias . "_serverno1" ][] = "" ;
			$arParam[ $alias . "_serverno2" ][] = "" ;
			$arParam[ $alias . "_serverno3" ][] = "" ;
			$arParam[ $alias . "_serverno4" ][] = "" ;
		}
	}

	unset( $arParam[ $alias . "_monitorid" ] ) ;
	$arMonitorid = array() ;
	$monitorid	= trim( ${ $alias . "_monitorid" } , "'{}'" ) ;
	$arTmpMid	= explode( "," , $monitorid ) ;
	for( $i = 0 ; $i < 20 ; $i ++ )
	{
		if( isset( $arTmpMid[ $i ] ) )
		{
			$arParam[ $alias . "_monitorid0" ][] = substr( trim( $arTmpMid[ $i ] , "\"" ) , 0 , 8 ) ;
			$arParam[ $alias . "_monitorid1" ][] = substr( trim( $arTmpMid[ $i ] , "\"" ) , 8 , 8 ) ;
		}
		else
		{
			$arParam[ $alias . "_monitorid0" ][] = "" ;
			$arParam[ $alias . "_monitorid1" ][] = "" ;
		}
	}

	unset( $arParam[ $alias . "_monitorno" ] ) ;
	$arMonitorno = array() ;
	$monitorno	= trim( ${ $alias . "_monitorno" } , "'{}'" ) ;
	$arTmpMno	= explode( "," , $monitorno ) ;
	for( $i = 0 ; $i < 20 ; $i ++ )
	{
		if( isset( $arTmpMno[ $i ] ) )
		{
			$arParam[ $alias . "_monitorno0" ][] = substr( trim( $arTmpMno[ $i ] , "\"" ) , 0 , 5 ) ;
			$arParam[ $alias . "_monitorno1" ][] = substr( trim( $arTmpMno[ $i ] , "\"" ) , 5 , 5 ) ;
			$arParam[ $alias . "_monitorno2" ][] = substr( trim( $arTmpMno[ $i ] , "\"" ) , 10 , 5 ) ;
			$arParam[ $alias . "_monitorno3" ][] = substr( trim( $arTmpMno[ $i ] , "\"" ) , 15 , 5 ) ;
			$arParam[ $alias . "_monitorno4" ][] = substr( trim( $arTmpMno[ $i ] , "\"" ) , 20 , 5 ) ;
		}
		else
		{
			$arParam[ $alias . "_monitorno0" ][] = "" ;
			$arParam[ $alias . "_monitorno1" ][] = "" ;
			$arParam[ $alias . "_monitorno2" ][] = "" ;
			$arParam[ $alias . "_monitorno3" ][] = "" ;
			$arParam[ $alias . "_monitorno4" ][] = "" ;
		}
	}
	return $arParam ;
}

// 詳細表示
function	FetchDetail( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $arNextPrev = array() )
{
	global $obMemberI ;
	$alias = $obMemberI -> alias ;

	// ローカル変数へ展開する
	foreach ( $arParam as $keys => $values )
		${ $keys } = $values ;

	foreach ( $arParamFind as $keys => $values )
		${ $keys } = $values ;

	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;

	for( $i = 0 ; $i < 3 ; $i ++ )
	{
		for( $j = 0 ; $j < 2 ; $j ++ )
		{
			if( !isset( ${ $alias . "_serverid" . $j }[ $i ] ) )
				${ $alias . "_serverid" . $j }[ $i ] = "" ;
		}

		for( $j = 0 ; $j < 5 ; $j ++ )
		{
			if( !isset( ${ $alias . "_serverno" . $j }[ $i ] ) )
				${ $alias . "_serverno" . $j }[ $i ] = "" ;
		}
	}

	for( $i = 0 ; $i < 20 ; $i ++ )
	{
		for( $j = 0 ; $j < 2 ; $j ++ )
		{
			if( !isset( ${ $alias . "_monitorid" . $j }[ $i ] ) )
				${ $alias . "_monitorid" . $j }[ $i ] = "" ;
		}

		for( $j = 0 ; $j < 5 ; $j ++ )
		{
			if( !isset( ${ $alias . "_monitorno" . $j }[ $i ] ) )
				${ $alias . "_monitorno" . $j }[ $i ] = "" ;
		}
	}

	$arForm = array() ;

	for( $i = 0 ; $i < 3 ; $i ++ )
	{
		$szServerid = "" ;
		for( $j = 0 ; $j < 2 ; $j ++ )
		{
			if( ${ $alias . "_serverid" . $j }[ $i ] != "" )
			{
				$szServerid .= ${ $alias . "_serverid" . $j }[ $i ] ;
				if( $j != 1 )
					$szServerid .= "-" ;
			}
		}

		$szServerno = "" ;
		for( $j = 0 ; $j < 5 ; $j ++ )
		{
			if( ${ $alias . "_serverno" . $j }[ $i ] != "" )
			{
				$szServerno .= ${ $alias . "_serverno" . $j }[ $i ] ;
				if( $j != 4 )
					$szServerno .= "-" ;
			}
		}

		$value = "" ;
		$value .= $blams -> fetchTHTD( "サーバーPID " . ($i+1) , $szServerid , $tsize , $vsize , "col1" , "left" , "middle" , "" ) ;
		$value .= $blams -> fetchTHTD( "サーバーS/N " . ($i+1) , $szServerno , $tsize , $vsize , "col1" , "left" , "middle" , "" ) ;
		$arForm[] = $value ;
	}

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	for( $i = 0 ; $i < 20 ; $i ++ )
	{
		$szMonitorid = "" ;
		for( $j = 0 ; $j < 2 ; $j ++ )
		{
			if( ${ $alias . "_monitorid" . $j }[ $i ] != "" )
			{
				$szMonitorid .= ${ $alias . "_monitorid" . $j }[ $i ] ;
				if( $j != 1 )
					$szMonitorid .= "-" ;
			}
		}

		$szMonitorno = "" ;
		for( $j = 0 ; $j < 5 ; $j ++ )
		{
			if( ${ $alias . "_monitorno" . $j }[ $i ] != "" )
			{
				$szMonitorno .= ${ $alias . "_monitorno" . $j }[ $i ] ;
				if( $j != 4 )
					$szMonitorno .= "-" ;
			}
		}

		$value = "" ;
		$value .= $blams -> fetchTHTD( "モニタPID " . ($i+1) , $szMonitorid , $tsize , $vsize , "col1" , "left" , "middle" , "" ) ;
		$value .= $blams -> fetchTHTD( "モニタS/N " . ($i+1) , $szMonitorno , $tsize , $vsize , "col1" , "left" , "middle" , "" ) ;
		$arForm[] = $value ;
	}

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$arForm[] = $value ;

	$button = FetchButton( $blams , $mode , $func , ${ $alias . "_memberid" } , $arNextPrev ) ;

	$arParamFind[ $alias . "_create_date" ] = ${ $alias . "_create_date" } ;
	$arParamFind[ $alias . "_update_date" ] = ${ $alias . "_update_date" } ;

	if( !isset( $pageback ) )
		$pageback = "" ;
	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "input_data"		, $arParam			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit_id.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/confrm.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 入力フォームの表示
function	FetchInput( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_level )
{
	global $obMemberI ;
	$alias = $obMemberI -> alias ;

	// ローカル変数へ展開する
	foreach ( $arParam as $keys => $values )
		${ $keys } = $values ;

	foreach ( $arParamFind as $keys => $values )
		${ $keys } = $values ;

	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$isize	= $vsize - 16 ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;
	$isize3	= $vsize3 - 16 ;

	for( $i = 0 ; $i < 3 ; $i ++ )
	{
		for( $j = 0 ; $j < 2 ; $j ++ )
		{
			if( !isset( ${ $alias . "_serverid" . $j }[ $i ] ) )
				${ $alias . "_serverid" . $j }[ $i ] = "" ;
		}

		for( $j = 0 ; $j < 5 ; $j ++ )
		{
			if( !isset( ${ $alias . "_serverno" . $j }[ $i ] ) )
				${ $alias . "_serverno" . $j }[ $i ] = "" ;
		}
	}

	for( $i = 0 ; $i < 20 ; $i ++ )
	{
		for( $j = 0 ; $j < 2 ; $j ++ )
		{
			if( !isset( ${ $alias . "_monitorid" . $j }[ $i ] ) )
				${ $alias . "_monitorid" . $j }[ $i ] = "" ;
		}

		for( $j = 0 ; $j < 5 ; $j ++ )
		{
			if( !isset( ${ $alias . "_monitorno" . $j }[ $i ] ) )
				${ $alias . "_monitorno" . $j }[ $i ] = "" ;
		}
	}

	$arForm = array() ;

	$tabindex = 1 ;
	for( $i = 0 ; $i < 3 ; $i ++ )
	{
		$value = "" ;
		if( $mode == "append" )
		{
			for( $j = 0 ; $j < 2 ; $j ++ )
				$value .= $blams -> fetchHidden( $alias . "_serverid" . $j . "[]" , "" ) ;

			$value .= $blams -> fetchTHTD( "サーバーPID " . ($i+1) , "" , $tsize , $vsize , "col1" , "left" , "middle" , TRUE ) ;
		}
		else
		{
			$form = "" ;
			for( $j = 0 ; $j < 2 ; $j ++ )
			{
				$form .= $blams -> fetchInputbox( $alias . "_serverid" . $j . "[]" , ${ $alias . "_serverid" . $j }[ $i ] , 64  , 8 , IME_OFF , "tabindex='" . $tabindex++ . "'" ) ;
				if( $j != 1 )
					$form .= "- " ;
			}
			$value .= $blams -> fetchTHTD( "サーバーPID " . ($i+1) , $form , $tsize , $vsize , "col1" , "left" , "middle" , TRUE ) ;
		}

		$form = "" ;
		for( $j = 0 ; $j < 5 ; $j ++ )
		{
			$form .= $blams -> fetchInputbox( $alias . "_serverno" . $j . "[]" , ${ $alias . "_serverno" . $j }[ $i ] , 40  , 5 , IME_OFF , "tabindex='" . $tabindex++ . "'" ) ;
			if( $j != 4 )
				$form .= "-" ;
		}
		$value .= $blams -> fetchTHTD( "サーバーS/N " . ($i+1) , $form , $tsize , $vsize , "col1" , "left" , "middle" , TRUE ) ;
		$arForm[] = $value ;
	}

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	// モニターIDとS/Nの入力BOX
	$flags = 0 ;
	if ( $from == "member" )
		$flags = BLAMS_FORMAT_READONLY ;
		
	for( $i = 0 ; $i < 20 ; $i ++ )
	{
		$value = "" ;

		$form = "" ;
		for( $j = 0 ; $j < 2 ; $j ++ )
		{
			$form .= $blams -> fetchInputbox( $alias . "_monitorid" . $j . "[]" , ${ $alias . "_monitorid" . $j }[ $i ] , 64  , 8 , IME_OFF | $flags , "tabindex='" . $tabindex++ . "'" ) ;
			if( $j != 1 )
				$form .= "- " ;
		}
		$value .= $blams -> fetchTHTD( "モニタPID " . ($i+1) , $form , $tsize , $vsize , "col1" , "left" , "middle" , TRUE ) ;

		$form = "" ;
		for( $j = 0 ; $j < 5 ; $j ++ )
		{
			$form .= $blams -> fetchInputbox( $alias . "_monitorno" . $j . "[]" , ${ $alias . "_monitorno" . $j }[ $i ] , 40  , 5 , IME_OFF | $flags , "tabindex='" . $tabindex++ . "'" ) ;
			if( $j != 4 )
				$form .= "-" ;
		}
		$value .= $blams -> fetchTHTD( "モニタS/N " . ($i+1) , $form , $tsize , $vsize , "col1" , "left" , "middle" , TRUE ) ;
		$arForm[] = $value ;
	}

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$arForm[] = $value ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$arParamFind[ $alias . "_create_date" ] = ${ $alias . "_create_date" } ;
	$arParamFind[ $alias . "_update_date" ] = ${ $alias . "_update_date" } ;

	if( !isset( $pageback ) )
		$pageback = "" ;
	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit_id.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $alias . "_memberid"		) ;
	$tmpl -> assign( "idvalue"			, ${ $alias . "_memberid" }	) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/input.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 詳細表示
function	FetchDone( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam )
{
	global $obMemberI ;
	$alias = $obMemberI -> alias ;

	// ローカル変数へ展開する
	foreach ( $arParam as $keys => $values )
		${ $keys } = $values ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$arParamFind = $arParamFind + $arParam ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit_id.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $alias . "_memberid"		) ;
	$tmpl -> assign( "idvalue"			, ${ $alias . "_memberid" }	) ;
	$data = $tmpl -> fetch( "common/done.tmpl" ) ;

	if( $mode == "append" )
	{
		$script = "<script type=\"text/javascript\">setIDData();</script>" ;
		$data .= $script ;
	}
	$tmpl -> clearAllAssign() ;
	return $data ;
}

function	setData( $arParam )
{
	return true ;
}

