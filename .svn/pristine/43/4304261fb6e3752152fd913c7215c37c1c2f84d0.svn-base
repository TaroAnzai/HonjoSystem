/*
-------------------------------------------------------------------------------
	Design CSS
-------------------------------------------------------------------------------
*/

/*
-------------------------------------------------------------------------------
	Layout
-------------------------------------------------------------------------------
*/

body
{
	font-size: 83% ;
	color: #333 ;
	text-align : center ;
	background: #cccccc ;
}

#body
{
	width : 1024px ;
	text-align : center ;
	font-size: 1em ;
	margin-left : auto ;
	margin-right : auto ;
	background: #fff ;
	border : #333 solid 1px ;
}
* html #body {	font-size : 0.96em ;	}

#main
{
	min-height : 700px ;
	background: #fff ;
}
* html #main {	height : 700px ;	}

#contents
{
	text-align : left ;
	padding : 16px 24px 8px ;
}

#contents h3
{
	height : 20px ;
	line-height : 20px ;
	color : #333 ;
	font-size : 1.0em ;
	font-weight : normal ;
	text-align : left ;
	text-shadow : #999 1px 1px 1px ;
	vertical-align : middle ;
	background : url("/admin/img/label.gif") no-repeat left top ;
	padding-left : 4px ;
	margin : auto ;
	margin-bottom : 8px ;
	border-bottom : 3px double #009 ;
}

#mainContents
{
	width : 560px ;
	float : left ;
	text-align : center ;
}

#subContents
{
	width : 240px ;
	float : right ;
	text-align : center ;
}


#body:after ,
#main:after ,
#contents:after ,
#mainContents:after ,
#subContents:after
{
	content : "." ;
	display : block ;
	height : 0px ;
	clear : both ;
	visibility : hidden ;
}

#sep
{
	width : 100% ;
	height : 4px ;
	color : black ;
	background : #7FFF00 ;
}

#expire p
{
	color : #669900 ;
}

#open p
{
	color : #ff3300 ;
	font-weight : bold ;
}

.error
{
	color : #900 ;
}
