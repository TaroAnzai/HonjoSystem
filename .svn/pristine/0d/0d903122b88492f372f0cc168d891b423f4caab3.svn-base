<?php
//	ini_set( "display_errors" ,1 ) ;
	require_once( "../../../lib/system.php") ;

	$obSession = new PARTS_Session() ;
	$obSession -> checkLogin( SESSION_ADMIN ) ;

	// セッションからログイン者情報を取得する
	$arr = $obSession -> getUserData( SESSION_ADMIN ) ;
	$login_adminid	= $arr[ $obSession -> obAdmin -> alias . "_adminid" ] ;
	$login_level	= $arr[ $obSession -> obAdmin -> alias . "_level" ] ;

	$mode = "" ;
	$func = "" ;

	// 登録ボタン名によって処理を分ける
	$arMode = array( "append" , "update" , "delete" ) ;
	GetSystemMode( $mode , $func , $arMode ) ;

	// DB
	$obConfig	= new PARTS_Config() ;
	$obCorp		= new PARTS_Corp() ;

	$alias 		= $obConfig -> alias ;
	$primarykey	= $obConfig -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;
	
	// データが存在するか？
	if ( $mode == "" )
	{
		${ $keyname } = -1 ;
		if ( $obConfig -> isOpen() )
		{
			$arConfig = $obConfig -> getConfig() ;
			
			if ( $arConfig[ "configid" ] != "" )
				${ $keyname } = $arConfig[ "configid" ] ;
		}

		if ( ${ $keyname } == -1 )
		{
			$mode = "append" ;
			$func = "input" ;
		}
		else
		{
			$mode = "update" ;
			$func = "default" ;
		}
	}

	$arParam = array() ;

	$additional = array() ;
	$additional[] = "page" ;
	$obConfig -> assignGlobal( $additional , $arParam ) ;
	
	if ( ${ $alias . "_corpid" } == "" )
		$arParam[ ${ $alias . "_corpid" } ] = -1 ;

	if ( ${ $alias . "_deliver_limittime" } == "" )
		$arParam[ ${ $alias . "_deliver_limittime" } ] = -1 ;
	
	// 検索用パラメータ保存
	$arParamFind = array() ;
	
	// データ取得時のキー初期化
	$getdatakey = ${ $keyname } ;

	// タイトル取得時のキー初期化
	$menu = FUNC_CONFIG ;

	$blams = new BLAMS() ;

	$screentype = "default" ;
	$funcname = $blams -> GetFuncName( $menu ) ;
	$header = $blams -> fetchAdminHeader( $screentype , $menu ) ;
	$footer = $blams -> fetchAdminFooter( $screentype , $menu ) ;

	$error = "" ;

	switch ( $mode )
	{
	// 新規登録モード
	case "append" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 新規入力" , $funcname ) ;

			// 入力フォーム画面への初回遷移時のみ、データを初期化
			if ( $func != "back" )
			{
				$obConfig -> initData( $arParam ) ;
			}

			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level , $obConfig , $obCorp ) ;

			break ;

		// 新規確認画面
		case "confrm" :

			// 入力データ検査
			$error = CheckData( $mode , $func , $arParam , $obConfig ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $obConfig , $obCorp ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 新規入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level , $obConfig , $obCorp ) ;
			}

			break ;

		// 新規完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 登録処理" , $funcname ) ;

			// 新規登録実施
			if ( InsertData( $arParam , $obConfig ) == TRUE )
			{
				$error = "正常に登録されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・登録に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $obConfig ) ;
			break ;

		}

		break ;

	// 更新モード
	case "update" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

			// 入力フォーム画面への初回遷移時のみ、データをDBから再取得（初期化）
			if ( $func != "back" )
			{
				// データをDBから再取得（初期化）
				$arParam = GetData( $getdatakey , $obConfig ) ;
//				$now = date( "Y-m-d H:i:s" ) ;
				$now_date = new DateTime();
				$now = $now_date -> format( "Y-m-d H:i:s" ) ;
				$arParam[ $alias . "_update_date" ] = $now ;
			}
/*			
			else if( $func == "back" )
			{
				DeleteImageWhenBack( $arParam , $arPhoto ) ;
			}
*/
			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level , $obConfig , $obCorp ) ;
			break ;

		// 更新確認画面
		case "confrm" :

			// 入力データ検査
			$error = CheckData( $mode , $func , $arParam , $obConfig ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $obConfig , $obCorp ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level , $obConfig , $obCorp ) ;
			}
			break ;

		// 更新完了画面
		case "done" :
			// タイトルの表示
			$subfuncname = sprintf( "%s 更新処理" , $funcname ) ;

			// 更新登録実施
			if ( UpdateData( $arParam , $obConfig ) == TRUE )
			{
				$error = "正常に更新されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・更新に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $obConfig ) ;
			break ;

		// 初期画面、もしくはFunctionの指定がない場合
		default :

			// タイトルの表示
			$subfuncname = sprintf( "%s 詳細表示" , $funcname ) ;

			// データをDBから再取得（初期化）
			$arParam = GetData( $getdatakey , $obConfig ) ;

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $obConfig , $obCorp ) ;
			break ;
		}

		break ;

	// 削除モード
	case "delete" :

		// 機能分岐
		switch( $func )
		{

		// 削除確認画面
		case "confrm" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 削除確認" , $funcname ) ;

			// 削除確認メッセージ表示
//			$error  = "【重要】\n" ;
//			$error .= "・" . $arMenuList[ $functionkey ][ 2 ] ;
//			$error .= "を削除すると、該当会員はその後ログインできなくなります。<br>\n" ;

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $obConfig , $obCorp ) ;
			break ;

		// 削除完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 削除処理" , $funcname ) ;

			// 削除処理実施
			if ( $obConfig -> deleteData( $arParam ) == TRUE )
			{
				$error = "正常に削除されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・削除に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $obConfig ) ;
			break ;
		}

		break ;
/*
	// 削除モード
	case "delete_image" :

		// タイトルの表示
		$subfuncname = sprintf( "%s 画像削除処理" , $funcname ) ;

		$arParam[ "del_column"	] = $func ;
		$arParam[ "del_photoid"	] = ${ $func . "_org" } ;

		// 削除実行
		if ( DeleteImageEach( "merchandise" , $arParam ) == TRUE )
		{
			$error = "正常に画像を削除しました。\n" ;
		}
		else
		{
			$error  = "【エラーがあります】\n" ;
			$error .= "・画像の削除に失敗しました。\n" ;
		}
		$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;

		break ;
*/
	}

	// 「一覧に戻る」の表示
	$pageback = "" ;
	if ( $mode != "append" )
		$pageback = $blams -> fetchPageback( "list.php" , $arParamFind ) ;

	// ページ全体の生成
	$contents = $blams -> fetchContents( $pageback . $data ) ;

	// ナビゲーションメニュー
	$navi = $blams -> fetchSlideMenu( $menu , $login_level ) ;

	$blams -> PrintBody( $header , $footer , $contents , $navi ) ;

exit ;

// ボタンの表示
function	FetchButton( $blams , $mode , $func )
{
	$arProcess = array(
		//					ボタン名								MODE							Action
		"list"				=>	array( "value" => "一覧に戻る"		, "name" => "list"				, "action" => "list.php"	, "target" => "" , "org_action" => "" ) ,
		"detail"			=>	array( "value" => "詳細に戻る"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"append_confrm"		=>	array( "value" => "新規確認"		, "name" => "append[confrm]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"append_done"		=>	array( "value" => "登録します"		, "name" => "append[done]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"append_cancel"		=>	array( "value" => "キャンセル"		, "name" => "append[cancel]"	, "action" => "list.php"	, "target" => "" , "org_action" => "" ) ,
		"append_back"		=>	array( "value" => "戻る"			, "name" => "append[back]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"update_input"		=>	array( "value" => "更新"			, "name" => "update[input]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_confrm"		=>	array( "value" => "更新確認"		, "name" => "update[confrm]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_done"		=>	array( "value" => "更新します"		, "name" => "update[done]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_back"		=>	array( "value" => "戻る"			, "name" => "update[back]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"delete_confrm"		=>	array( "value" => "削除"			, "name" => "delete[confrm]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"delete_done"		=>	array( "value" => "削除します"		, "name" => "delete[done]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"delete_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
	) ;

	$arOperation = array() ;
	switch( $mode )
	{
	case "append" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "append_confrm" , "append_cancel" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "append_done" , "append_back" ) ;
			break ;
		case "done" :
			$arOperation = array( "list" ) ;
			break ;
		}
		break ;

	case "update" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "update_confrm" , "update_cancel" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "update_done" , "update_back" ) ;
			break ;
		case "done" :
			$arOperation = array( "detail" ) ;
			break ;
		default :
			$arOperation = array( "update_input" , "delete_confrm" ) ;
			break ;
		}
		break ;

	case "delete" :
		switch( $func )
		{
		case "confrm" :
			$arOperation = array( "delete_done" , "delete_cancel" ) ;
			break ;
		case "done" :
			$arOperation = array( "list" ) ;
			break ;
		}
		break ;

	case "delete_image" :
		$arOperation = array( "detail" ) ;
		break ;
	}

	$arButton = array() ;
	for ( $i = 0 ; $i < count( $arOperation ) ; $i ++ )
		$arButton[] = $arProcess[ $arOperation[ $i ] ] ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "id"				, "edit_form"		) ;
	$tmpl -> assign( "button_data"		, $arButton			) ;
	$data = $tmpl -> fetch( "common/button.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;

}

// データ取得
function	GetData( $getdatakey , $obConfig )
{
	$alias = $obConfig -> alias ;
	$arResult = array() ;
	$arResult = $obConfig -> getAt( $getdatakey ) ;

	// メールタイミングを配列に戻す
	if( $arResult[ $alias . "_mail_timing" ] != "" )
		$arResult[ $alias . "_mail_timing"	] = MakeCategoryArray( $arResult[ $alias . "_mail_timing" ] ) ;

	return $arResult ;
}

// データ検査
function	CheckData( $mode , $func , &$arParam , $obConfig )
{
	$error = "" ;
	$error = $obConfig -> checkData( $mode , $func , $arParam ) ;

	return $error ;
}

// 詳細表示
function	FetchDetail( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_adminid , $login_level , $obConfig , $obCorp )
{
	$alias = $obConfig -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;

	// 製造元・蔵元名取得
	$arCorp = array() ;
	$cpAlias 	= $obCorp -> alias ;

	$arResult = array() ;
	$arResult = $obCorp -> getAt( ${ $alias . "_corpid" } ) ;
	$szCorpName = "" ;
	
	if ( count( $arResult ) > 0 )
		$szCorpName = $arResult[ $cpAlias . "_lname"	] ;

	if( ${ $alias . "_deliver_limittime" } == -1 )
		$szDeliver_limittime = "指定なし" ;
	else
		$szDeliver_limittime = ${ $alias . "_deliver_limittime" } . " 時以降" ;

	global $arMailTiming ;
	$szMailTiming = "" ;
	if( is_array( ${ $alias . "_mail_timing" } ) )
	{
		for( $i = 0 ; $i < count( ${ $alias . "_mail_timing" } ) ; $i++ )
		{
			$szMailTiming .= sprintf( "%s , " , $arMailTiming[ ${ $alias . "_mail_timing" }[ $i ] ] ) ;
		}
		$szMailTiming = substr( $szMailTiming , 0 , -2 ) ;
	}

	$value = "" ;
	$value .= $blams -> fetchTHTD( "社名" , $szCorpName , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "ポイント還元率" , ${ $alias . "_yen_per_point" } . " 円/pt" , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$value .= $blams -> fetchTHTD( "ポイント加算率" , ${ $alias . "_point_per_yen" } . " 円/pt" , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "ポイント使用単位" , ${ $alias . "_point_unit" } . " pt" , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$value .= $blams -> fetchTHTD( "最低ポイント使用数" , ${ $alias . "_under_limit" } . " pt" , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "包装料金" , ${ $alias . "_price_wrapping" } . " 円" , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$value .= $blams -> fetchTHTD( "のし料金" , ${ $alias . "_price_decoration" } . " 円" , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "クール便料金" , ${ $alias . "_price_coolpack" } . " 円" , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$value .= $blams -> fetchTHTD( "1箱あたりの内容数" , ${ $alias . "_unit_per_box" } . " 個/1箱" , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "配送指定日開始期間" , "+ " . ${ $alias . "_deliver_start" } . " 日" , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$value .= $blams -> fetchTHTD( "繰越時間" , $szDeliver_limittime , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "メール送信タイミング" , $szMailTiming , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$arForm[] = $value ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "input_data"		, $arParam			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/confrm.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 入力フォームの表示
function	FetchInput( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_level , $obConfig , $obCorp )
{
	$alias = $obConfig -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	// 製造元・蔵元名取得
	$arCorp = array() ;
	$cpAlias 	= $obCorp -> alias ;
	$arWhere 	= array() ;

	$arWhere[ "groupflg"	] = 99 ;
	$arWhere[ "order"		] = sprintf( "%s.name" , $cpAlias ) ;
	$arResults = array() ;
	$arResults = $obCorp -> getData( $arWhere ) ;

	foreach ( $arResults as $arResult )
	{
		$corp_corpid = $arResult[ $cpAlias . "_corpid"	] ;
		$arCorp[ $corp_corpid ] = $arResult[ $cpAlias . "_lname"	] ;
	}

	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$isize	= $vsize - 16 ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;
	$isize3	= $vsize3 - 16 ;

	$arForm = array() ;

	$value = "" ;
	$form   = $blams -> fetchSelectbox( $alias . "_corpid" , ${ $alias . "_corpid" } , $arCorp , $isize ,  "選択してください。" , FALSE , "" ) ;
	$value .= $blams -> fetchTHTD( "社名" , $form , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_yen_per_point" , ${ $alias . "_yen_per_point" } , $isize - 64 , 10 , IME_OFF ) ;
	$form  .= " 円/pt<br />500円＝1ptなど" ;
	$value .= $blams -> fetchTHTD( "ポイント還元率 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$form   = $blams -> fetchInputbox( $alias . "_point_per_yen" , ${ $alias . "_point_per_yen" } , $isize - 64 , 10 , IME_OFF ) ;
	$form  .= " pt/円<br />1000円で1pt加算など" ;
	$value .= $blams -> fetchTHTD( "ポイント加算率 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_point_unit" , ${ $alias . "_point_unit" } , $isize - 64 , 10 , IME_OFF ) ;
	$form  .= " pt" ;
	$value .= $blams -> fetchTHTD( "ポイント使用単位 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$form   = $blams -> fetchInputbox( $alias . "_under_limit" , ${ $alias . "_under_limit" } , $isize - 64 , 10 , IME_OFF ) ;
	$form  .= " pt" ;
	$value .= $blams -> fetchTHTD( "最低ポイント使用数 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_price_wrapping" , ${ $alias . "_price_wrapping" } , $isize - 64 , 10 , IME_OFF ) ;
	$form  .= " 円" ;
	$value .= $blams -> fetchTHTD( "包装料金 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$form   = $blams -> fetchInputbox( $alias . "_price_decoration" , ${ $alias . "_price_decoration" } , $isize - 64 , 10 , IME_OFF ) ;
	$form  .= " 円" ;
	$value .= $blams -> fetchTHTD( "のし料金 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_price_coolpack" , ${ $alias . "_price_coolpack" } , $isize - 80 , 10 , IME_OFF ) ;
	$form  .= " 円" ;
	$value .= $blams -> fetchTHTD( "クール便料金 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$form   = $blams -> fetchInputbox( $alias . "_unit_per_box" , ${ $alias . "_unit_per_box" } , $isize - 64 , 10 , IME_OFF ) ;
	$form  .= " 個/1箱" ;
	$value .= $blams -> fetchTHTD( "1箱あたりの内容数 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	$arTime = array() ;
	for( $i = 0 ; $i < 24 ; $i++ )
		$arTime[ $i ] = $i ;
	$value = "" ;
	$form   = "+ " ;
	$form  .= $blams -> fetchInputbox( $alias . "_deliver_start" , ${ $alias . "_deliver_start" } , 48 , 10 , IME_OFF ) ;
	$form  .= " 日<br />" ;
	$form  .= "注文日から＋～日後から配送指定日が可能になる" ;
	$value .= $blams -> fetchTHTD( "配送指定日開始期間 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$form   = $blams -> fetchSelectbox( $alias . "_deliver_limittime" , ${ $alias . "_deliver_limittime" } , $arTime , 80 ,  "指定なし" , FALSE , "" ) ;
	$form  .= " 時<br />～時以降の注文は配送指定日開始期間を+1する" ;
	$value .= $blams -> fetchTHTD( "繰越時間 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" ) ;
	$arForm[] = $value ;

	global $arMailTiming ;
	$value = "" ;
	$form   = $blams -> fetchCheckbox( $alias . "_mail_timing" , $arMailTiming , ${ $alias . "_mail_timing" } , $isize3 ) ;
	$value .= $blams -> fetchTHTD( "メール送信タイミング" , $form , $tsize , $vsize3 , "col1" , "left" , "middle" , "" , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATETIME ) ;
	$arForm[] = $value ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$arParamFind[ $alias . "_create_date" ] = ${ $alias . "_create_date" } ;
	$arParamFind[ $alias . "_update_date" ] = ${ $alias . "_update_date" } ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $alias . "_configid"	) ;
	$tmpl -> assign( "idvalue"			, ${ $alias . "_configid" }	) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/input.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// 詳細表示
function	FetchDone( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $obConfig )
{
	$alias = $obConfig -> alias ;
	
	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $alias . "_configid"	) ;
	$tmpl -> assign( "idvalue"			, ${ $alias . "_configid" }	) ;
	$data = $tmpl -> fetch( "common/done.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;
}

// データの追加
function	InsertData( $arParam , $obConfig )
{
	$result = FALSE ;
	$alias = $obConfig -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$szMailTiming = "" ;
	if( is_array( ${ $alias . "_mail_timing" } ) )
	{
		for( $i = 0 ; $i < count( ${ $alias . "_mail_timing" } ) ; $i++ )
			$szMailTiming .= sprintf( "[%s]" , ${ $alias . "_mail_timing" }[ $i ] ) ;
	}
	$arParam[ $alias . "_mail_timing" ] = $szMailTiming ;
	
	$result = $obConfig -> insertData( $arParam ) ;

	return $result ;
}

// データの更新
function	UpdateData( $arParam , $obConfig )
{
	$result = FALSE ;
	$alias = $obConfig -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$szMailTiming = "" ;
	if( is_array( ${ $alias . "_mail_timing" } ) )
	{
		for( $i = 0 ; $i < count( ${ $alias . "_mail_timing" } ) ; $i++ )
			$szMailTiming .= sprintf( "[%s]" , ${ $alias . "_mail_timing" }[ $i ] ) ;
	}

	$arParam[ $alias . "_mail_timing" ] = $szMailTiming ;
	$result = $obConfig -> updateData( $arParam ) ;

	return $result ;
}

?>