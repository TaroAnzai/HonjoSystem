<?php
//	ini_set( "display_errors" ,1 ) ;
	require_once( "../../../lib/system.php") ;

	if ( empty( $page ) == true )
		$page = 0 ;

	$mode = "" ;
	$func = "" ;

	// 登録ボタン名によって処理を分ける
	$arMode = array( "append" , "update" , "delete" , "delete_image" ) ;
	GetSystemMode( $mode , $func , $arMode ) ;

	$obSession = new PARTS_Session() ;
	$obSession -> checkLogin( SESSION_ADMIN ) ;

	// セッションからログイン者情報を取得する
	$arr = $obSession -> getUserData( SESSION_ADMIN ) ;
	$login_adminid	= $arr[ $obSession -> obAdmin -> alias . "_adminid" ] ;
	$login_level	= $arr[ $obSession -> obAdmin -> alias . "_level" ] ;

	$blams = new BLAMS() ;
	$obTopics = new PARTS_Topics() ;

	$alias 		= $obTopics -> alias ;
	$primarykey	= $obTopics -> primarykey ;
	$keyname	= $alias . "_" . $primarykey ;

	// 編集データ保存
	$arParam = array() ;

	$additional = array() ;
	$additional[] = "page" ;
	$obTopics -> assignGlobal( $additional , $arParam ) ;

	// 検索用パラメータ保存
	$arParamFind = array() ;
	foreach( $obTopics -> searchkey as $name )
		$arParamFind[ $name ] = ${ $name } ;
	$arParamFind[ "page"	] = $page			;

	// データ取得時のキー初期化
	$getdatakey = ${ $keyname } ;

	// タイトル取得時のキー初期化
	$menu = FUNC_TOPICS ;

	$screentype = "default" ;
	$funcname = $blams -> GetFuncName( $menu ) ;
	$header = $blams -> fetchAdminHeader( $screentype , $menu ) ;
	$footer = $blams -> fetchAdminFooter( $screentype , $menu ) ;

	$error = "" ;
	switch ( $mode )
	{
	// 新規登録モード
	case "append" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 新規入力" , $funcname ) ;

			// 入力フォーム画面への初回遷移時のみ、データを初期化
			if ( $func != "back" )
			{
				$obTopics -> initData( $arParam ) ;
			}

			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;

			break ;

		// 新規確認画面
		case "confrm" :

			// 入力データ検査
			$error = $obTopics -> checkData( $mode , $func , $arParam ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 新規入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			}
			break ;

		// 新規完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 登録処理" , $funcname ) ;

			// 新規登録実施
			if ( $obTopics -> insertData( $arParam ) == TRUE )
			{
				$error = "正常に登録されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・登録に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;
			break ;
		}
		break ;

	// 更新モード
	case "update" :

		// 機能分岐
		switch( $func )
		{
		// 入力フォーム画面
		case "input" :
		case "back" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

			// 入力フォーム画面への初回遷移時のみ、データをDBから再取得（初期化）
			if ( $func != "back" )
			{
				// データをDBから再取得（初期化）
				$arParam = GetData( $getdatakey ) ;
//				$now = date( "Y-m-d H:i:s" ) ;
				$now_date = new DateTime();
				$now = $now_date -> format( "Y-m-d H:i:s" ) ;
				$arParam[ "update_date" ] = $now ;
			}

			// 入力フォーム画面表示
			$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			break ;

		// 更新確認画面
		case "confrm" :

			// 入力データ検査
			$error = $obTopics -> checkData( $mode , $func , $arParam ) ;
			if ( $error == "" )
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 入力確認" , $funcname ) ;

				// 詳細表示画面表示
				$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			}
			else
			{
				// タイトルの表示
				$subfuncname = sprintf( "%s 更新入力" , $funcname ) ;

				// エラー表示
				$error = "【エラーがあります】\n" . $error ;

				// 機能を「入力」に戻す
				$func = "input" ;

				// 入力フォーム画面表示へ戻る
				$data = FetchInput( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_level ) ;
			}
			break ;

		// 更新完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 更新処理" , $funcname ) ;

			// 更新登録実施
			if ( $obTopics -> updateData( $arParam ) == TRUE )
			{
				$error = "正常に更新されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・更新に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;
			break ;

		// 初期画面、もしくはFunctionの指定がない場合
		default :

			// タイトルの表示
			$subfuncname = sprintf( "%s 詳細表示" , $funcname ) ;

			// データをDBから再取得（初期化）
			$arParam = GetData( $getdatakey ) ;

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			break ;
		}
		break ;

	// 削除モード
	case "delete" :

		// 機能分岐
		switch( $func )
		{

		// 削除確認画面
		case "confrm" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 削除確認" , $funcname ) ;

			// 詳細表示画面表示
			$data = FetchDetail( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam , $login_adminid , $login_level ) ;
			break ;

		// 削除完了画面
		case "done" :

			// タイトルの表示
			$subfuncname = sprintf( "%s 削除処理" , $funcname ) ;

			// 削除処理実施
			if ( $obTopics -> deleteData( $arParam ) == TRUE )
			{
				$error = "正常に削除されました。\n" ;
			}
			else
			{
				$error  = "【エラーがあります】\n" ;
				$error .= "・削除に失敗しました。\n" ;
			}
			$data = FetchDone( $blams , $mode , $func , $subfuncname , $error , $arParamFind , $arParam ) ;
			break ;
		}
		break ;
	}

	// 「一覧に戻る」の表示
	if ( $mode != "append" )
		$pageback = $blams -> fetchPageback( "list.php" , $arParamFind ) ;
	else
		$pageback = "" ;

	// ページ全体の生成
	$contents = $blams -> fetchContents( $pageback . $data ) ;

	// ナビゲーションメニュー
	$navi = $blams -> fetchSlideMenu( $menu , $login_level ) ;

	$blams -> PrintBody( $header , $footer , $contents , $navi ) ;

	exit ;



// ボタンの表示
function	FetchButton( $blams , $mode , $func )
{
	$arProcess = array(
		//					ボタン名								MODE							Action
		"list"				=>	array( "value" => "一覧に戻る"		, "name" => "list"				, "action" => "list.php"	, "target" => "" , "org_action" => "" ) ,
		"detail"			=>	array( "value" => "詳細に戻る"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,


		"append_confrm"		=>	array( "value" => "新規確認"		, "name" => "append[confrm]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"append_done"		=>	array( "value" => "登録します"		, "name" => "append[done]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"append_cancel"		=>	array( "value" => "キャンセル"		, "name" => "append[cancel]"	, "action" => "list.php"	, "target" => "" , "org_action" => "" ) ,
		"append_back"		=>	array( "value" => "戻る"			, "name" => "append[back]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"update_input"		=>	array( "value" => "更新"			, "name" => "update[input]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_confrm"		=>	array( "value" => "更新確認"		, "name" => "update[confrm]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_done"		=>	array( "value" => "更新します"		, "name" => "update[done]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"update_back"		=>	array( "value" => "戻る"			, "name" => "update[back]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,

		"delete_confrm"		=>	array( "value" => "削除"			, "name" => "delete[confrm]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"delete_done"		=>	array( "value" => "削除します"		, "name" => "delete[done]"		, "action" => ""			, "target" => "" , "org_action" => "" ) ,
		"delete_cancel"		=>	array( "value" => "キャンセル"		, "name" => "update[default]"	, "action" => ""			, "target" => "" , "org_action" => "" ) ,
	) ;

	$arOperation = array() ;
	switch( $mode )
	{
	case "append" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "append_confrm" , "append_cancel" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "append_done" , "append_back" ) ;
			break ;
		case "done" :
			$arOperation = array( "list" ) ;
			break ;
		}
		break ;

	case "update" :
		switch( $func )
		{
		case "input" :
		case "back" :
			$arOperation = array( "update_confrm" , "update_cancel" ) ;
			break ;
		case "confrm" :
			$arOperation = array( "update_done" , "update_back" ) ;
			break ;
		case "done" :
			$arOperation = array( "detail" ) ;
			break ;
		default :
			$arOperation = array( "update_input" , "delete_confrm" ) ;
			break ;
		}
		break ;

	case "delete" :
		switch( $func )
		{
		case "confrm" :
			$arOperation = array( "delete_done" , "delete_cancel" ) ;
			break ;
		case "done" :
		case "del_photo" :
			$arOperation = array( "list" ) ;
			break ;
		}
		break ;

	case "delete_image" :
		$arOperation = array( "detail" ) ;
		break ;

	}

	$arButton = array() ;
	for ( $i = 0 ; $i < count( $arOperation ) ; $i ++ )
		$arButton[] = $arProcess[ $arOperation[ $i ] ] ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, ""				) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "id"				, "edit_form"		) ;
	$tmpl -> assign( "button_data"		, $arButton			) ;
	$data = $tmpl -> fetch( "common/button.tmpl" ) ;
	$tmpl -> clearAllAssign() ;
	return $data ;

}

// データ取得
function	GetData( $getdatakey )
{
	global $obTopics ;
	$alias = $obTopics -> alias ;
	$arResult = $obTopics -> getAt( $getdatakey ) ;

	$obStart_date = new DateTime( $arResult[ $alias . "_start_date" ] );
	$arResult[ $alias . "_start_date_y"	] = $obStart_date -> format( "Y" ) ;
	$arResult[ $alias . "_start_date_m"	] = $obStart_date -> format( "n" ) ;
	$arResult[ $alias . "_start_date_d"	] = $obStart_date -> format( "j" ) ;

	return $arResult ;
}

// データ検査
function	CheckData( $mode , $func , &$arParam )
{
	$error = "" ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	// データ検査
	$obDB = new DB_Common() ;
	if ( $obDB -> isOpen() )
	{
		// タイトル
		if ( $subject == "" )
			$error .= "・タイトルが入力されていません。\n" ;

		// 公開開始日
		$arParam[ "start_date" ] = "" ;
		if ( ( is_numeric( $start_date_y ) ) &&
			 ( is_numeric( $start_date_m ) ) &&
			 ( is_numeric( $start_date_d ) ) )
		{
			if ( checkdate( $start_date_m , $start_date_d , $start_date_y ) )
			{
				// 公開開始日の更新
				$obStart_date = new DateTime();
				$obStart_date -> setDate( $start_date_y , $start_date_m , $start_date_d ) ;
				$obStart_date -> setTime( 0 , 0 , 0 ) ;
//				$start_date_new = sprintf( "%04d-%02d-%02d 00:00:00" , $start_date_y , $start_date_m , $start_date_d ) ;
				$start_date_new = $obStart_date -> format( "Y-m-d H:i:s" ) ;
				$arParam[ "start_date" ] = $start_date_new ;
			}
			else
			{
				$error .= "・指定された公開開始日は正しくありません。\n" ;
			}
		}
		else
		{
			$error .= "・公開開始日が正しく入力されていません。\n" ;
		}

		// 表示先
		if ( $topicssort == -1 )
			$error .= "・表示先が選択されていません。\n" ;

		// 種類
		if ( $topicstype == -1 )
			$error .= "・種類が選択されていません。\n" ;

		// 優先度
		if ( $status == -1 )
			$error .= "・優先度が選択されていません。\n" ;

		// 編集状態
		if ( $edit_flg == -1 )
			$error .= "・編集状態が選択されていません。\n" ;

		
	}
	else
	{
		$error .= "・データベースに接続できませんでした。\n" ;
	}

	return $error ;
}

// 詳細表示
function	FetchDetail( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_adminid , $login_level )
{
	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	global $obTopics ;
	$alias = $obTopics -> alias ;

	// 優先度
	global	$arEventPriority ;
	$szEventPriority = $arEventPriority[ ${ $alias . "_status" } ] ;
	if ( $szEventPriority == "" )
		$szEventPriority = "不明" ;

	// 編集状態
	global	$arEditStatus ;
	$szEditStatus = $arEditStatus[ ${ $alias . "_edit_flg" } ] ;
	if ( $szEditStatus == "" )
		$szEditStatus = "不明" ;

	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;

	$arForm = array() ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "タイトル ※" , ${ $alias . "_subject" } , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	global	$arTopicsTitle ;
	$value = "" ;
	$value .= $blams -> fetchTHTD( "表示種類 ※" , $arTopicsTitle[ ${ $alias . "_topicstype" } ] , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "公開開始日 ※" , ${ $alias . "_start_date" } , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER | BLAMS_FORMAT_DATE , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "優先度 ※" , $szEventPriority , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER ) ;
	$value .= $blams -> fetchTHTD( "編集状態 ※" , $szEditStatus , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$arForm[] = $value ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "input_data"		, $arParam			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/confrm.tmpl" ) ;
	$tmpl -> clearAllAssign() ;


	return $data ;
}

// 入力フォームの表示
function	FetchInput( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam , $login_level )
{
	global $obTopics ;
	$alias = $obTopics -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	// 優先度
	global	$arEventPriority ;
	$arEventPriority_local = $arEventPriority ;

	// 編集状態（「削除」状態は選択不可）
	global	$arEditStatus ;
	$arEditStatus_local = $arEditStatus ;
	unset( $arEditStatus_local[ DEF_EDITSTATUS_DELETED ] ) ;

	$tsize	= DEF_BASE_TSIZE ;
	$vsize	= DEF_BASE_VSIZE ;
	$isize	= $vsize - 16 ;
	$vsize3	= $tsize + ( $vsize * 2 ) ;
	$isize3	= $vsize3 - 16 ;

	$arForm = array() ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_subject" , ${ $alias . "_subject" } , $isize3  , MAX_TOPICS_SUBJECT , IME_ON ) ;
	$form  .= "\n※50文字まで" ;
	$value .= $blams -> fetchTHTD( "タイトル ※" , $form , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	global	$arTopicsTitle ;
	$value = "" ;
	$form   = $blams -> fetchSelectbox( $alias . "_topicstype" , ${ $alias . "_topicstype" } , $arTopicsTitle , $isize3 ,  "選択してください。" , FALSE , "" ) ;
	$value .= $blams -> fetchTHTD( "表示種類 ※" , $form , $tsize , $vsize3 , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchInputbox( $alias . "_start_date_y" , ${ $alias . "_start_date_y" } , 40  , MAX_YEAR , IME_OFF ) ;
	$form  .= "/\n" ;
	$form  .= $blams -> fetchInputbox( $alias . "_start_date_m" , ${ $alias . "_start_date_m" } , 40  , MAX_MONTH , IME_OFF ) ;
	$form  .= "/\n" ;
	$form  .= $blams -> fetchInputbox( $alias . "_start_date_d" , ${ $alias . "_start_date_d" } , 40  , MAX_DAY , IME_OFF ) ;
	$value .= $blams -> fetchTHTD( "公開開始日 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER , 1 , 1 , 3 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$form   = $blams -> fetchSelectbox( $alias . "_status" , ${ $alias . "_status" } , $arEventPriority_local , $isize ,  "選択してください。" , FALSE , "" ) ;
	$value .= $blams -> fetchTHTD( "優先度 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER ) ;
	$form   = $blams -> fetchSelectbox( $alias . "_edit_flg" , ${ $alias . "_edit_flg" } , $arEditStatus_local , $isize ,  "選択してください。" , FALSE , "" ) ;
	$value .= $blams -> fetchTHTD( "編集状態 ※" , $form , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_BORDER ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTD( "&nbsp;" , $vsize , "" , "" , BLAMS_FORMAT_NOBORDER , 4 , 1 ) ;
	$arForm[] = $value ;

	$value = "" ;
	$value .= $blams -> fetchTHTD( "更新日" , ${ $alias . "_update_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$value .= $blams -> fetchTHTD( "登録日" , ${ $alias . "_create_date" } , $tsize , $vsize , "col1" , "left" , "middle" , BLAMS_FORMAT_DATE ) ;
	$arForm[] = $value ;

	$arParamFind[ $alias . "_create_date" ] = ${ $alias . "_create_date" } ;
	$arParamFind[ $alias . "_update_date" ] = ${ $alias . "_update_date" } ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "form_data"		, $arForm			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $alias . "_topicsid"			) ;
	$tmpl -> assign( "idvalue"			, ${ $alias . "_topicsid" }		) ;
	$tmpl -> assign( "add_script"		, ""				) ;
	$data = $tmpl -> fetch( "common/input.tmpl" ) ;
	$tmpl -> clearAllAssign() ;


	return $data ;
}

// 詳細表示
function	FetchDone( $blams , $mode , $func , $funcname , $error , $arParamFind , $arParam )
{
	global $obTopics ;
	$alias		= $obTopics -> alias ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$button = FetchButton( $blams , $mode , $func ) ;

	$tmpl = $blams -> tmpl ;
	$tmpl -> assign( "rootpath"			, DEF_SITE_ROOTPATH	) ;
	$tmpl -> assign( "funcname"			, $funcname			) ;
	$tmpl -> assign( "mode"				, $mode				) ;
	$tmpl -> assign( "func"				, $func				) ;
	$tmpl -> assign( "pageback"			, ""				) ;
	$tmpl -> assign( "error"			, $error			) ;
	$tmpl -> assign( "search_data"		, $arParamFind		) ;
	$tmpl -> assign( "edit_url"			, "edit.php"		) ;
	$tmpl -> assign( "button"			, $button			) ;
	$tmpl -> assign( "idname"			, $alias . "_topicsid"			) ;
	$tmpl -> assign( "idvalue"			, ${ $alias . "_topicsid" }		) ;
	$data = $tmpl -> fetch( "common/done.tmpl" ) ;
	$tmpl -> clearAllAssign() ;


	return $data ;
}

// データの追加
function	InsertData( $arParam )
{
	$result = FALSE ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$obDB = new DB_Common() ;
	if ( $obDB -> isOpen() )
	{
		// 次のシーケンスID取得
		$sql = "SELECT NEXTVAL( 'topics_data_topicsid_seq' ) " ;
		$record = $obDB -> executeSQL( $sql ) ;
		if ( $record )
		{
			$topicsid = $obDB -> getValue( $record , "nextval" ) ;
			$obDB -> closeRecord( $record ) ;
		}

		// データ登録
		if ( $topicsid != -1 )
		{
			$sql  = sprintf( "INSERT INTO topics_data ( " ) ;
			$sql .= sprintf( "topicsid , " ) ;
			$sql .= sprintf( "subject , " ) ;
			$sql .= sprintf( "topicstype , " ) ;
			$sql .= sprintf( "linkid , " ) ;
			$sql .= sprintf( "start_date , " ) ;
			$sql .= sprintf( "edit_flg , " ) ;

			$sql .= sprintf( "status , " ) ;
			$sql .= sprintf( "create_date , " ) ;
			$sql .= sprintf( "update_date   " ) ;
			$sql .= sprintf( " ) VALUES ( " ) ;

			$sql .= sprintf( "'%d' , "		, $topicsid ) ;
			$sql .= sprintf( "'%s' , "		, mb_addslashes( $subject ) ) ;
			$sql .= sprintf( "'%d' , "		, $topicstype ) ;
			$sql .= sprintf( "'%d' , "		, $linkid ) ;
			$sql .= sprintf( "to_timestamp( '%s 000000' , 'YYYYMMDD HH24MISS' ) , " , date2( "Ymd" , $start_date ) ) ;
			$sql .= sprintf( "'%d' , "		, $edit_flg ) ;

			$sql .= sprintf( "'%d'  , "		, $status ) ;
			$sql .= sprintf( "to_timestamp( '%s' , 'YYYYMMDD HH24MISS' ) , " , date2( "Ymd His" , $create_date ) ) ;
			$sql .= sprintf( "to_timestamp( '%s' , 'YYYYMMDD HH24MISS' ) " , date2( "Ymd His" , $update_date ) ) ;
			$sql .= sprintf( " ) " ) ;
			$record = $obDB -> executeSQL( $sql ) ;
			if ( $record )
			{
				$obDB -> closeRecord( $record ) ;
				$result = TRUE ;
			}
		}

		
	}

	return $result ;
}

// データの更新
function	UpdateData( $arParam )
{
	$result = FALSE ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$obDB = new DB_Common() ;
	if ( $obDB -> isOpen() )
	{
		// データ更新
		$sql  = sprintf( "UPDATE topics_data SET " ) ;
		$sql .= sprintf( "subject = '%s', "			, mb_addslashes( $subject ) ) ;
		$sql .= sprintf( "topicstype = '%d', "		, $topicstype ) ;
		$sql .= sprintf( "linkid = '%d', "			, $linkid ) ;
		$sql .= sprintf( "start_date = to_timestamp( '%s 000000' , 'YYYYMMDD HH24MISS' ) , " , date2( "Ymd" , $start_date ) ) ;
		$sql .= sprintf( "edit_flg = '%d', "		, $edit_flg	) ;
		$sql .= sprintf( "status = '%d', "			, $status	) ;

		$sql .= sprintf( "update_date = to_timestamp( '%s' , 'YYYYMMDD HH24MISS' ) " , date2( "Ymd His" , $update_date ) ) ;
		$sql .= sprintf( "WHERE topicsid = %d "		, $topicsid ) ;
		$record = $obDB -> executeSQL( $sql ) ;
		if ( $record )
		{
			$obDB -> closeRecord( $record ) ;
			$result = TRUE ;
		}
		
	}

	return $result ;
}

// データの削除
function	DeleteData( $arParam )
{
	$result = FALSE ;

	// ローカル変数へ展開する
	$keys = array_keys( $arParam ) ;
	for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
		${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

	$obDB = new DB_Common() ;
	if ( $obDB -> isOpen() )
	{
		// データ更新
		$sql  = sprintf( "UPDATE topics_data SET " ) ;
		$sql .= sprintf( "status = -1 , " ) ;
//		$sql .= sprintf( "edit_flg = '%d', "		, DEF_EDITSTATUS_DELETED ) ;
		$sql .= sprintf( "update_date = LOCALTIMESTAMP(0) " ) ;
		$sql .= sprintf( "WHERE topicsid = %d "		, $topicsid ) ;
		$record = $obDB -> executeSQL( $sql ) ;
		if ( $record )
		{
			$obDB -> closeRecord( $record ) ;
			$result = TRUE ;
		}
		
	}

	return $result ;
}



?>
