	// 過去の決済済みお届け先を取得（一覧）
	function	getDst( $memberid )
	{
		$arDelivery = array() ;
		$arDelivery[ 0 ] = "ご注文者と同じ" ;
		if( $memberid != -1 )
		{
			$arWhere = array() ;
			$arWhere[ "memberid" ] = $memberid ;

			// 決済済み
			$arWhere[ "billing_status" ] = DF_BILLSTATUS_SETTLED ;
			
			// 御届先指定があったもの
			$arWhere[ "shipping" ] = DEF_SHIPPING_ON ;

			// 3ヶ月以内に入金があったもの
			$obThreeMonthAgo = new DateTime() ;
			$obThreeMonthAgo -> modify( "-3 month" ) ;
			$arWhere[ "where" ] = sprintf( "AND %s.income_date >= '%s' " , $this -> alias , $obThreeMonthAgo -> format( "Y-m-d H:i:s" ) ) ;
	
			$arSettledCart = $this -> getData( $arWhere ) ;
			if( count( $arSettledCart ) )
			{
				for( $i = 0 ; $i < count( $arSettledCart ) ; $i ++ )
				{
					$cartid	= $arSettledCart[ $i ][ sprintf( "%s_cartid"	, $this -> alias ) ] ;
					$name	= $arSettledCart[ $i ][ sprintf( "%s_name"		, $this -> alias ) ] ;
					$arDelivery[ $cartid ] = $name ;
				}
			}
		}
		$arDelivery[ -1 ] = "新規登録" ;
		return $arDelivery ;
	}
	
	// お届け先の cartid を取得する
	// 更新の初期画面で必要
	// 現状では、ct_name で管理している為
	function	getDstId( $memberid , $name )
	{
		$targetid = -1 ;
		$arWhere = array() ;
		$arWhere[ "memberid" ] = $memberid ;

		// 決済済み
		$arWhere[ "billing_status" ] = DF_BILLSTATUS_SETTLED ;
		
		// 御届先指定があったもの
		$arWhere[ "shipping" ] = DEF_SHIPPING_ON ;

		// 御届先の名前
		$arWhere[ "name" ] = $name ;

		// 3ヶ月以内に入金があったもの
		$obThreeMonthAgo = new DateTime() ;
		$obThreeMonthAgo -> modify( "-3 month" ) ;
		$arWhere[ "where" ] = sprintf( "AND %s.income_date >= '%s' " , $this -> alias , $obThreeMonthAgo -> format( "Y-m-d H:i:s" ) ) ;

		$arSettledCart = $this -> getData( $arWhere ) ;
		if( count( $arSettledCart ) )
		{
			$targetid = $arSettledCart[ 0 ][ sprintf( "%s_cartid"	, $this -> alias ) ] ;
		}
		return $targetid ;
	}
	
	// 書類印刷済みフラグをONにする
	function	changePrintStatus( $cartid )
	{
		$result = false ;
		if( $cartid != "" )
		{
			$arWhere = array() ;
			$arWhere[ "cartid" ] = $cartid ;
			$arUpdate = array() ;
			$arUpdate[ "print_status" ] = 1 ;
		
			$result = $this -> updateData( $arUpdate , $arWhere ) ;
		}
		return $result ;
	}

	// パラメータのグローバル変数への登録
	function assignGlobal( $additional = array() , &$arParam = array() )
	{
		parent::assignGlobal( $additional ) ;

		$alias		= $this -> alias ;
		$fields		= $this -> fields ;
		
		foreach( $fields as $name )
			global	${ $alias . "_" . $name } ;

		// 配列に読み込んだデータを保存する。
		$this -> makeParam( $arParam ) ;
	}

}

