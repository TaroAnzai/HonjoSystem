require_once( 'class/db.class.php' ) ;
require_once( 'class/cart.class.php' ) ;
require_once( 'class/cartitem.class.php' ) ;
require_once( 'class/member.class.php' ) ;
require_once( 'class/member_corp.class.php' ) ;
require_once( 'class/serialno.class.php' )  ;
require_once( 'class/merchandise.class.php' )  ;
require_once( 'class/price.class.php' )  ;
require_once( 'class/category.class.php' )  ;

class PARTS_Sale extends PARTS_Cart
{
	var	$obMember ;
	var	$obCartItem ;
	var	$obMerchandise ;
	
	function	__construct( $dbname = "" , $user = "" , $passwd = "" , $host = "" , $port = "" )
	{
		$tname		= "cart_data" ;
		$alias		= "ct" ;
		$primarykey	= "cartid" ;

		parent::__construct( $dbname , $user , $passwd , $host , $port , $tname , $alias , $primarykey ) ;

		$this -> per_page		= NUMBER_PER_CART ;

		$this -> obMember		= new PARTS_Member( $this -> conn ) ;
		$this -> obCartItem		= new PARTS_CartItem( $this -> conn ) ;
		$this -> obMerchandise	= new PARTS_Merchandise( $this -> conn ) ;

		$this -> searchkey = array(
				"S_DATE"			,
				"S_DATE_Y"			,
				"S_DATE_M"			,
				"S_MEMBER_FLG"		,
			) ;
	}

	// セッションIDとメンバーIDから カートIDを取得する
	// 引数に請求状態を追加
	function	getID( $sessionid , $memberid , $billing_status = -1 )
	{
		$id = -1 ;
		
		$arWhere = array() ;
		if ( $memberid != -1 )
		{
			$arWhere[ "member_flg"	]	= 1 ;
			$arWhere[ "memberid"	]	= $memberid ;
		}
		else
		{
			// 非会員ならセッションIDで検索する
			$arWhere[ "member_flg"	]	= 0 ;
			$arWhere[ "sessionid"	]	= $sessionid ;
		}
		
		if( $billing_status != -1 )
			$arWhere[ "billing_status"	]	= $billing_status ;
		
		$arWhere[ "order"	]	=	sprintf( "%s.update_date DESC " , $this -> alias ) ;
		
		$arData = $this -> getData( $arWhere ) ;
		if ( count( $arData ) > 0 )
		{
			$id = $arData[ 0 ][ sprintf( "%s_%s" , $this -> alias , $this -> primarykey ) ] ;
			
			$this -> arData = $arData ;
		}
		return $id ;
	}

	// $item_flg
	// カートアイテムを含む全件取得は重いので、暫定で不必要な場合は切れるように
	function	getData( $arParam , $page = -1 , $per_page = -1 , $item_flg = true )
	{
		$obCartItem = $this -> obCartItem ;
	
		$this -> arData = array() ;

		$arData = array() ;
		if ( $this -> isOpen() == true )
		{
			$fields  = "" ;
			$fields .= sprintf( "%s , " , $this -> makeAliaseFields() ) ;
			$fields .= sprintf( "%s   " , $this -> obMember -> makeAliaseFields() ) ;

			$sql = $this -> makeSQL( $arParam , $fields , $page , $per_page ) ;
			$arData = parent::getData( $sql ) ;

			$cnt = count( $arData ) ;
			for ( $i = 0 ; $i < $cnt ; $i ++ )
			{
				$arCartItem = array() ;
				$arOrder = array() ;
				if( $item_flg == true )
				{
					$arWhere = array() ;
					$arWhere[ $this -> primarykey ] = $arData[ $i ][ sprintf( "%s_%s" , $this -> alias , $this -> primarykey ) ] ;
					if ( isset( $arParam[ "merchandiseid" ] ) == true )
						$arWhere[ "merchandiseid" ] = $arParam[ "merchandiseid" ] ;
					if ( isset( $arParam[ "where_item" ] ) == true )
						$arWhere[ "where" ] = $arParam[ "where_item" ] ;

					$arCartItem = $obCartItem -> getData( $arWhere ) ;
	
					$arOrder = $this -> createOtherParam( $arData[ $i ] , $arCartItem ) ;
				}
				$arData[ $i ][ "cartitem_data"	] = $arCartItem ;
				$arData[ $i ][ "cart_order"		] = $arOrder ;
			}

			$this -> arData = $arData ;
		}
		
		return $arData ;
	}

	function	makeSQL( $arParam , $fields , $page = -1 , $per_page = -1 )
	{
		$arParamList = $this -> fields ;
		$arParamList[] = "mb_tel" ;
		$arParamList[] = "tp_tel" ;
		$arParamList[] = "where" ;
		$arParamList[] = "order" ;

		for ( $i = 0 ; $i < count( $arParamList ) ; $i ++ )
		{
			if ( isset( $arParam[ $arParamList[ $i ] ] ) != true )
				$arParam[ $arParamList[ $i ] ] = -1 ;
		}
	
		// ローカル変数へ展開する
		$keys = array_keys( $arParam ) ;
		for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
			${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

		if ( $per_page == -1 )
			$per_page = $this -> per_page ;

		$sql  = "" ;
		$sql .= sprintf( "SELECT " ) ;
		$sql .= sprintf( "%s " , $fields ) ;
		$sql .= sprintf( "FROM %s %s " , $this -> tname , $this -> alias ) ;
		$sql .= sprintf( "LEFT JOIN %s %s ON %s.memberid = %s.memberid " , 
							$this -> obMember -> tname , 
							$this -> obMember -> alias , 
							$this -> alias , 
							$this -> obMember -> alias 
						) ;
		$sql .= sprintf( "WHERE %s.status = 1 " , $this -> alias ) ;

		$limit = "" ;
		if ( ${ $this -> primarykey } != -1 )
			$sql .= sprintf( "AND %s.%s = %d " , $this -> alias , $this -> primarykey , ${ $this -> primarykey } ) ;
		else
			if ( $page != -1 )
				$limit = sprintf( "LIMIT %d OFFSET %d " , $per_page , ( $page * $per_page ) ) ;

		if ( $sessionid != -1 )
			$sql .= sprintf( "AND %s.sessionid = '%s' " , $this -> alias , $this -> mb_addslashes( $sessionid ) ) ;

		if ( $memberid != -1 )
			$sql .= sprintf( "AND %s.memberid = %d " , $this -> alias , $memberid ) ;

		if ( $member_flg != -1 )
			$sql .= sprintf( "AND %s.member_flg = %d " , $this -> alias , $member_flg ) ;

		if ( $shipping != -1 )
			$sql .= sprintf( "AND %s.shipping = %d " , $this -> alias , $shipping ) ;

//		if ( $name != -1 )
//			$sql .= sprintf( "AND %s.name = '%s' " , $this -> alias , $this -> mb_addslashes( $name ) ) ;

		if ( $billing_status != -1 )
			$sql .= sprintf( "AND %s.billing_status = %d " , $this -> alias , $billing_status ) ;

		if ( $shipped_status == DF_STATETRANS_OTHER )
		{
			$sql .= sprintf( "AND ( " ) ;
			$sql .= sprintf( "%s.shipped_status != %d " , $this -> alias , DF_STATETRANS_DELIVERED ) ;
			$sql .= sprintf( "AND " ) ;
			$sql .= sprintf( "%s.shipped_status != %d " , $this -> alias , DF_STATETRANS_ENDSTATE ) ;
			$sql .= sprintf( ") " ) ;
		}
		else if ( $shipped_status != -1 )
		{
			$sql .= sprintf( "AND %s.shipped_status = %d " , $this -> alias , $shipped_status ) ;
		}
		
		if ( $sheetno != -1 )
			$sql .= sprintf( "AND %s.sheetno = '%s' " , $this -> alias , $this -> mb_addslashes( $sheetno ) ) ;

		if ( $mb_tel != -1 )
			$sql .= sprintf( "AND ( %s.tel_home = '%s' OR %s.tel_port = '%s' ) " ,	$this -> obMember -> alias ,
																					$this -> mb_addslashes( $mb_tel ) ,
																					$this -> obMember -> alias ,
																					$this -> mb_addslashes( $mb_tel ) ) ;
		
		if ( $where != -1 )
			$sql .= sprintf( "%s " , $where ) ;
		
		if ( $order != "" )
		{
			if ( $order != -1 )
				$sql .= sprintf( "ORDER BY %s " , $order ) ;
			else
				$sql .= sprintf( "ORDER BY %s.order_date " , $this -> alias ) ;
		}
		$sql .= $limit ;
		
		return $sql ;
	}

	function	checkData( $mode , $func , &$arParam )
	{
		$alias		= $this -> alias ;
		$primarykey	= $this -> primarykey ;
		$keyname	= $alias . "_" . $this -> primarykey ;

		$error = "" ;
		return $error ;
	}

	// カートアイテムを削除(status = -1)する
	function	deleteData( $cartid = -1 )
	{
		$result = false ;

		$sql  = sprintf( "UPDATE cart_data SET " ) ;
		$sql .= sprintf( "status = -1 , " ) ;
		$sql .= sprintf( "update_date = LOCALTIMESTAMP(0) " ) ;
		$sql .= sprintf( "WHERE %s = %d "	, $this -> primarykey , ${ $this -> primarykey } ) ;
		$record = $this -> executeSQL( $sql ) ;
		if ( $record )
		{
			$result = true ;
			$this -> closeRecord( $record ) ;
		}
	
		return $result ;
	}

	// DBのフィールド名＝変数名
	// 異なる場合は事前に設定必要
	function	insertData( &$arParam )
	{
		// ローカル変数へ展開する
		$keys = array_keys( $arParam ) ;
