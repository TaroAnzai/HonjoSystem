			for( $i = 0 ; $i < count( $arParamList ) ; $i ++ )
			{
				$key = $arParamList[ $i ] ;
				if( !( $key == $this -> primarykey || $key == "update_date" || $key == "create_date" || $key == "status" ) )
				{
					$value = $arParam[ $key ] ;
					$sql_field .= sprintf( "%s , " , $key ) ;
		
					// 型による切り分け
					switch( $key )
					{
						// text
						case "sessionid" :
