	// カート内に指定の商品データあるかどうか検索する
	function	inCart( &$arMerchandise )
	{
		$obMerchandise	= $this -> obMerchandise ;
		$merchandiseid	= sprintf( "%s_merchandiseid" , $obMerchandise -> alias ) ;
		$cartid			= sprintf( "%s_%s" , $this -> alias , $this -> primarykey ) ;

		$arCart = $this -> arData ;
		if ( count( $arCart ) > 0 )
			$arCart = $arCart[ 0 ] ;

		if ( isset( $arCart[ $cartid ] ) == true )
		{
			$arItem = $arCart[ "cartitem_data" ] ;
			for ( $i = 0 ; $i < count( $arItem ) ; $i ++ )
			{
				$arMerchandise[ "registered" ] = false ;
				if ( isset( $arMerchandise[ $merchandiseid ] ) == true )
				{
					if ( $arItem[ $i ][ $merchandiseid ] == $arMerchandise[ $merchandiseid ] )
					{
						$arMerchandise[ "registered" ] = true ;
						break ;
					}
				}
			}
		}
		
		return $arMerchandise ;
	}

	// セッションIDのみを更新する
	// （エラー処理なし）
	function	updateSessionid( $cartid , $sessionid )
	{
		$arParam[ "sessionid"	] = $sessionid ;
		$arWhere[ "cartid"		] = $cartid ;
		$this -> updateData( $arParam , $arWhere ) ;
	}

	// DBからは取得でない情報（総料金など）や送料などを取得する
	function	createOtherParam( $arCart , $arCartItem )
	{
		$obCartItem				= $this -> obCartItem ;
		$obMerchandise			= $this -> obMerchandise ;
		$obMerchandiseMaster	= $this -> obMerchandise -> obMaster ;
		$obCategory				= $this -> obMerchandise -> obCategory ;
		$obPrice				= new PARTS_Price( $this -> conn ) ;

		$total_price = 0 ;
		$large = 0 ;
		$small = 0 ;
		$large_cool = 0 ;
		$small_cool = 0 ;
		$total_number = 0 ;
		$wrapping_flg = 0 ;
		$decoration_flg = 0 ;
		$deco_used = "" ;

		$arOrder = array() ;

		$arTotal = array() ;
		$arTotal[ "total"			] = "" ;
		$arTotal[ "total_item"		] = "" ;
		$arTotal[ "total_package"	] = "" ;
		$arTotal[ "package"			] = "" ;

		$arPackage = array() ;
		$arPackage[ "large"			] = "" ;
		$arPackage[ "small"			] = "" ;
		$arPackage[ "large_cool"	] = "" ;
		$arPackage[ "small_cool"	] = "" ;

		for( $i = 0 ; $i < count( $arCartItem ) ; $i ++ )
		{
			$arItem = $arCartItem[ $i ] ;
		
			$cartitemid		= $arItem[ sprintf( "%s_cartitemid"		, $obCartItem -> alias ) ] ;
			$merchandiseid	= $arItem[ sprintf( "%s_merchandiseid"	, $obCartItem -> alias ) ] ;
			$number			= $arItem[ sprintf( "%s_number"			, $obCartItem -> alias ) ] ;
			$wrapping		= $arItem[ sprintf( "%s_wrapping"		, $obCartItem -> alias ) ] ;
			$decoration		= $arItem[ sprintf( "%s_decoration"		, $obCartItem -> alias ) ] ;
			$package		= $arItem[ sprintf( "%s_package"		, $obCartItem -> alias ) ] ;
			$coolpack		= $arItem[ sprintf( "%s_coolpack"		, $obCartItem -> alias ) ] ;
			$deco_used		= $arItem[ sprintf( "%s_deco_used"		, $obCartItem -> alias ) ] ;
			$wrapping_flg	= $wrapping ;
			$decoration_flg	= $decoration ;

			$price			= $arItem[ sprintf( "%s_price"			, $obMerchandise -> alias ) ] ;
			$tax			= $arItem[ sprintf( "%s_tax"			, $obMerchandise -> alias ) ] ;
			$net			= $arItem[ sprintf( "%s_net"			, $obMerchandiseMaster -> alias ) ] ;
			$categoryid		= $arItem[ sprintf( "%s_categoryid"		, $obCategory -> alias ) ] ;

			if ( $package == 0 )
				$arItem[ "package_price" ] = 0 ;

			$packageprice	= $this -> calcPackagePrice( $categoryid ) ;
			$total_number	= $total_number + $number ;

			$arTotal	= $this -> sumPriceTotal( $number , $price , $tax , $packageprice , $package , $arTotal ) ;
			$arPackage	= $this -> sumPackageCount( $number , $net , $coolpack , $arPackage ) ;
		}

		$large				= $arPackage[ "large" ] ;
		$small				= $arPackage[ "small" ] ;
		$large_cool			= $arPackage[ "large_cool" ] ;
		$small_cool			= $arPackage[ "small_cool" ] ;
		$package_count		= $this -> calcPackageCount( $large , $small ) ;
		$package_count_cool	= $this -> calcPackageCount( $large_cool , $small_cool ) ;

		$arOrder[ "total_number"		] = $total_number ;
		$arOrder[ "total_price"			] = $arTotal[ "total" ] ;
		$arOrder[ "total_item"			] = $arTotal[ "total_item" ] ;
		$arOrder[ "total_package"		] = $arTotal[ "total_package" ] ;
		$arOrder[ "coolpack"			] = $package_count_cool ;
		$arOrder[ "package_count"		] = $package_count + $package_count_cool ;
		$arOrder[ "data_count"			] = count( $arCartItem ) ;
		$arOrder[ "package"				] = $arTotal[ "package" ] ;
		$arOrder[ "wrapping_flg"		] = $wrapping_flg ;
		$arOrder[ "decoration_flg"		] = $decoration_flg ;
		$arOrder[ "deco_used"			] = $deco_used ;
		
		if( $deco_used != "" )
		{
			$arWhere = array() ;
			$arWhere[ "categoryid" ] = $deco_used ;
			$arDeco_used_string = $obCategory -> getData( $arWhere ) ;
			$arOrder[ "deco_used_string"	] = $arDeco_used_string[ 0 ][ sprintf( "%s_name" , $obCategory -> alias ) ] ;
		}
		else
		{
			$arOrder[ "deco_used_string"	] = "" ;
		}

		$state = -1 ;
		if( $arCart[ sprintf( "%s_shipping" , $this -> alias ) ] == DEF_SHIPPING_ON )
			$state = $arCart[ sprintf( "%s_state" , $this -> alias ) ] ;
		else
			$state = $arCart[ sprintf( "%s_state" , $this -> obMember -> alias ) ] ;

//		$arOrder[ "price_transport"	] = $obPrice -> calcPriceTransport( $state , $arCart[ sprintf( "%s_order_date" , $this -> alias ) ] ) ;
		$arOrder[ "price_transport"	] = 0 ;

		// 決算方法が代金引換の場合、手数料を計算する。
		$arOrder[ "price_charge" ] = 0 ;
		if ( $arCart[ sprintf( "%s_settlement" , $this -> alias ) ] == DF_SETTLEMENT_COD )
		{
			global	$arPriceCharge ;
			for ( $pc = 0 ; $pc < count( $arPriceCharge ) ; $pc ++ )
			{
				if ( $arTotal[ "total" ] < $arPriceCharge[ $pc ][ 0 ] )
				{
					$arOrder[ "price_charge" ] = $arPriceCharge[ $pc ][ 1 ] ;
					break ;
				}
			}
		}
		
		return $arOrder ;
	}

	// 合計金額の集計
	function	sumPriceTotal( $number , $price , $tax , $packageprice , $package , $arTotal )
	{
		$arTotal[ "total" ]			+=	$tax * $number ;
		$arTotal[ "total" ]			+=	$packageprice * $number * $package ;
		$arTotal[ "total_item" ]	+=	$tax * $number ;
		$arTotal[ "total_package" ]	+=	$packageprice * $number * $package ;
		
		if( $packageprice != 0 && $number * $package != 0 )
			$arTotal[ "package" ][ $packageprice ] += $number * $package ;
		
		return $arTotal ;
	}

	// 梱包数の累計の計算
	function	sumPackageCount( $number , $net , $coolpack , $arPackage )
	{
		if ( $coolpack != TRUE )
		{
			if ( $net > PRICE_PACKAGE_EDGE )
				$arPackage[ "large" ]	+= $number ;
			else
				$arPackage[ "small" ]	+= $number ;
		}
		else
		{
			if ( $net > PRICE_PACKAGE_EDGE )
				$arPackage[ "large_cool" ]	+= $number ;
			else
				$arPackage[ "small_cool" ] += $number ;
		}
	
		return $arPackage ;
	}

	// 荷物数の計算
	function	calcPackageCount( $large , $small )
	{
		$count = 0 ;
		$packing_count		= ceil( ( $large + $small ) / UNIT_PER_BOX ) ;
/*
		// 大のケースの数を計算
		if ( $large > 0 )
		{
			$count = ceil( $large / PRICE_PACKAGE_MAX_L ) ;
			
			// 大のケースの空きスペースを使用する
			$small = $small - ( $count * PRICE_PACKAGE_MAX_L - $large ) ;
		}
		
		// 小のケースの数を計算
		if ( $small > 0 )
		{
			$count += ceil( $small / PRICE_PACKAGE_MAX_S ) ;
		}
*/
		return $packing_count ;
	}

