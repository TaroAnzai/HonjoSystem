*/
	}

	// カートに商品を入れる
	// 管理画面からはcartidを引数にしないと取得できないので追加
	function	appendOrder( $merchandiseid , $number = 1 , $wrapping = 0 , $decoration = 0 , $package = 0 , $billstatus = DF_BILLSTATUS_BUYING , $cartid = -1 )
	{
		$cartitemid = -1 ;
		$obCartItem		= $this -> obCartItem ;
		$obMerchandise	= $this -> obMerchandise ;
		$obSerialno		= new PARTS_Serialno( $this -> conn ) ;

		$alias			= $this -> alias ;
		$alias_mb		= $this -> obMember -> alias ;
		$alias_ci		= $obCartItem -> alias ;

		// ログイン情報の取得
		$memberid	= -1 ;

		$obSession = new PARTS_Session( $this -> conn ) ;
		$sessionid	= $obSession -> getID() ;
		$memberid = $obSession -> getUserID( $sessionid , SESSION_MEMBER ) ;

		// カート管理情報を検索
		if( ${ $this -> primarykey } == -1 )
			${ $this -> primarykey } = $this -> getID( $sessionid , $memberid , $billstatus ) ;

		if ( ${ $this -> primarykey } != -1 )
		{
			// カートが既に存在していれば、セッションIDを更新する（エラー処理なし）
			$this -> updateSessionid( ${ $this -> primarykey } , $sessionid ) ;
		}
		else
		{
			// カートが存在していなかったら、カート管理情報を新規作成する
			if ( $memberid != -1 )
			{
				// 会員なら会員判定フラグ更新（会員）
				$member_flg = 1 ;
			}
			else
			{
				// 非会員なら会員判定フラグ更新（非会員）と共に、仮会員情報を新規作成する
				$member_flg = 0 ;
	
				// 仮会員ログインID（パスワード）新規作成
				$new_id = $obSerialno -> createSerialNo( SERIALNO_TYPE_MEMBER ) ;
				if ( $new_id == 0 )
				{
					$memberid = -1 ;
				}
				else
				{
					$arMember = array() ;
					$arMember[ $alias_mb . "_loginid"		] = $new_id ;
					$arMember[ $alias_mb . "_passwd"		] = "temptemptemp" ;
					$arMember[ $alias_mb . "_level"			] = DEF_MEMBER_LEVEL_NON ;
					$arMember[ $alias_mb . "_name"			] = "仮会員" ;
					$arMember[ $alias_mb . "_name_en"		] = "tempmember" ;
					$arMember[ $alias_mb . "_kana"			] = "カリカイイン" ;
					$arMember[ $alias_mb . "_point"			] = 0 ;
					$arMember[ $alias_mb . "_total_point"	] = 0 ;

					$this -> obMember -> checkPassword( $arMember[ $alias_mb . "_passwd" ] , $arMember[ $alias_mb . "_crypt_passwd" ] ) ;
					$arMember[ $alias_mb . "_clear_passwd"		] = $this -> obMember -> decrypt( $arMember[ $alias_mb . "_crypt_passwd" ] ) ;

					// 仮のため必要最低限(notnull)の情報のみ登録する
					// checkDataを回避する
					$result = $this -> tempMemberInsert( $arMember ) ;
					if( $result )
						$memberid = $arMember[ $alias_mb . "_memberid" ] ;
					else
						$memberid = -1 ;
				}
			}

			// 会員ID指定、もしくは正常に新規作成できた場合のみ、カート管理情報を新規作成する
			// 必要最低限の情報のみ
			if ( $memberid != -1 )
			{
				$arNewCart = array() ;
				$arNewCart[ $alias . "_sessionid"		] = $sessionid ;
				$arNewCart[ $alias . "_memberid"		] = $memberid ;
				$arNewCart[ $alias . "_member_flg"		] = $member_flg ;
				$arNewCart[ $alias . "_sheetno"			] = "9999999999" ;
				$arNewCart[ $alias . "_settlement"		] = -1 ;
				$arNewCart[ $alias . "_orderway"		] = 1 ;
				$arNewCart[ $alias . "_used_point"		] = 0 ;
				$arNewCart[ $alias . "_append_point"	] = 0 ;
				$arNewCart[ $alias . "_limit_point"		] = 0 ;
				$arNewCart[ $alias . "_delivery_time"	] = -1 ;
				$arNewCart[ $alias . "_shipping"		] = 0 ;
				$arNewCart[ $alias . "_state_trans"		] = 0 ;
				$arNewCart[ $alias . "_billing_status"	] = $billstatus ;
				$arNewCart[ $alias . "_shipped_status"	] = DF_STATETRANS_STOCKCHK ;
				$arNewCart[ $alias . "_print_status"	] = 0 ;

				$result = $this -> tempCartInsert( $arNewCart ) ;
				if( $result )
					${ $this -> primarykey } = $arNewCart[ $alias . "_" . $this -> primarykey ] ;
				else
					${ $this -> primarykey } = -1 ;
			}
		}
	
		// カート管理ID検索、もしくは正常に新規作成できた場合のみ、カート商品情報へ追加する
		// 必要最低限の情報のみ
		if ( ${ $this -> primarykey } != -1 )
		{
			$arWhere[ "merchandiseid" ] = $merchandiseid ;
			$arMerchandise = $obMerchandise -> getData( $arWhere ) ;
	
			if( count( $arMerchandise ) )
			{
				$key = sprintf( "%s_coolpack" , $obMerchandise -> alias ) ;
				$coolpack = $arMerchandise[ 0 ][ $key ] ;
			}
	
			$arNewCartItem = array() ;
			$arNewCartItem[ $alias_ci . "_cartid"			] = ${ $this -> primarykey } ;
			$arNewCartItem[ $alias_ci . "_merchandiseid"	] = $merchandiseid ;
			$arNewCartItem[ $alias_ci . "_number"			] = $number ;
			$arNewCartItem[ $alias_ci . "_wrapping"			] = $wrapping ;
			$arNewCartItem[ $alias_ci . "_decoration"		] = $decoration ;
			$arNewCartItem[ $alias_ci . "_package"			] = $package ;
			$arNewCartItem[ $alias_ci . "_coolpack"			] = $coolpack ;
			$arNewCartItem[ $alias_ci . "_deco_used"		] = -1 ;

			$result = $this -> tempCartItemInsert( $arNewCartItem ) ;
			if( $result )
				$cartitemid = $arNewCartItem[ $alias_ci . "_cartitemid" ] ;
			else
				$cartitemid = -1 ;
		}
		return $cartitemid ;
	}

	// 仮メンバー登録
	function	tempMemberInsert( &$arParam )
	{
		// ローカル変数へ展開する
		$keys = array_keys( $arParam ) ;
		for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
			${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

		$alias_mb		= $this -> obMember -> alias ;
		$result			= false ;

		$sql  = "" ;
		$sql .= sprintf( "INSERT INTO member_data ( " ) ;
		$sql .= sprintf( "loginid , " ) ;
		$sql .= sprintf( "passwd , " ) ;
		$sql .= sprintf( "clear_passwd , " ) ;
		$sql .= sprintf( "level , " ) ;
		$sql .= sprintf( "name , " ) ;
		$sql .= sprintf( "name_en , " ) ;
		$sql .= sprintf( "kana , " ) ;
		$sql .= sprintf( "point , " ) ;
		$sql .= sprintf( "total_point , " ) ;
		$sql .= sprintf( "status " ) ;
		$sql .= sprintf( " ) VALUES ( " ) ;
		$sql .= sprintf( "'%s' , " , ${ $alias_mb . "_loginid" } ) ;
		$sql .= sprintf( "'%s' , " , ${ $alias_mb . "_passwd" } ) ;
		$sql .= sprintf( "'%s' , " , ${ $alias_mb . "_clear_passwd" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_mb . "_level" } ) ;
		$sql .= sprintf( "'%s' , " , ${ $alias_mb . "_name" } ) ;
		$sql .= sprintf( "'%s' , " , ${ $alias_mb . "_name_en" } ) ;
		$sql .= sprintf( "'%s' , " , ${ $alias_mb . "_kana" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_mb . "_point" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_mb . "_total_point" } ) ;
		$sql .= sprintf( "1 " ) ;
		$sql .= sprintf( " ) " ) ;

		$record = $this -> obMember -> executeSQL( $sql ) ;
		if ( $record )
		{
			$this -> obMember -> closeRecord( $record ) ;
			$arParam[ $alias_mb . "_memberid" ] = $this -> obMember -> getLastInsertedID() ;
			$result = true ;
		}
		return $result ;
	}

	function	tempCartInsert( &$arParam )
	{
		// ローカル変数へ展開する
		$keys = array_keys( $arParam ) ;
		for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
			${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

		$alias		= $this -> alias ;
		$result		= false ;

		$sql  = "" ;
		$sql .= sprintf( "INSERT INTO cart_data ( " ) ;
		$sql .= sprintf( "sessionid , " ) ;
		$sql .= sprintf( "memberid , " ) ;
		$sql .= sprintf( "member_flg , " ) ;
		$sql .= sprintf( "sheetno , " ) ;
		$sql .= sprintf( "settlement , " ) ;
		$sql .= sprintf( "orderway , " ) ;
		$sql .= sprintf( "used_point , " ) ;
		$sql .= sprintf( "append_point , " ) ;
		$sql .= sprintf( "limit_point , " ) ;
		$sql .= sprintf( "delivery_time , " ) ;
		$sql .= sprintf( "shipping , " ) ;
		$sql .= sprintf( "state_trans , " ) ;
		$sql .= sprintf( "billing_status , " ) ;
		$sql .= sprintf( "shipped_status , " ) ;
		$sql .= sprintf( "print_status , " ) ;
		$sql .= sprintf( "status " ) ;
		$sql .= sprintf( " ) VALUES ( " ) ;
		$sql .= sprintf( "'%s' , " , ${ $alias . "_sessionid" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_memberid" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_member_flg" } ) ;
		$sql .= sprintf( "'%s' , " , ${ $alias . "_sheetno" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_settlement" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_orderway" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_used_point" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_append_point" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_limit_point" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_delivery_time" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_shipping" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_state_trans" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_billing_status" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_shipped_status" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias . "_print_status" } ) ;
		$sql .= sprintf( "1 " ) ;
		$sql .= sprintf( " ) " ) ;

		$record = $this -> executeSQL( $sql ) ;
		if ( $record )
		{
			$this -> closeRecord( $record ) ;
			$arParam[ $alias . "_cartid" ] = $this -> getLastInsertedID() ;
			$result = true ;
		}
		return $result ;
	}

	function	tempCartItemInsert( &$arParam )
	{
		// ローカル変数へ展開する
		$keys = array_keys( $arParam ) ;
		for ( $i = 0 ; $i < count( $keys ) ; $i ++ )
			${ $keys[ $i ] } = $arParam[ $keys[ $i ] ] ;

		$obCartItem		= $this -> obCartItem ;
		$alias_ci		= $obCartItem -> alias ;
		$result			= false ;

		$sql  = "" ;
		$sql .= sprintf( "INSERT INTO cartitem_data ( " ) ;
		$sql .= sprintf( "cartid , " ) ;
		$sql .= sprintf( "merchandiseid , " ) ;
		$sql .= sprintf( "number , " ) ;
		$sql .= sprintf( "wrapping , " ) ;
		$sql .= sprintf( "decoration , " ) ;
		$sql .= sprintf( "package , " ) ;
		$sql .= sprintf( "coolpack , " ) ;
		$sql .= sprintf( "deco_used , " ) ;
		$sql .= sprintf( "status " ) ;
		$sql .= sprintf( " ) VALUES ( " ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_ci . "_cartid" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_ci . "_merchandiseid" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_ci . "_number" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_ci . "_wrapping" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_ci . "_decoration" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_ci . "_package" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_ci . "_coolpack" } ) ;
		$sql .= sprintf( "'%d' , " , ${ $alias_ci . "_deco_used" } ) ;
		$sql .= sprintf( "1 " ) ;
		$sql .= sprintf( " ) " ) ;

		$record = $obCartItem -> executeSQL( $sql ) ;
		if ( $record )
		{
			$obCartItem -> closeRecord( $record ) ;
			$arParam[ $alias_ci . "_cartitemid" ] = $obCartItem -> getLastInsertedID() ;
			$result = true ;
		}
		return $result ;
	}

