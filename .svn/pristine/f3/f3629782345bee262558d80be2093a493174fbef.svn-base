	/** Error reporting */
	if ( defined( "DEF_ERROR_LEVEL" ) == false )
		define(	"DEF_ERROR_LEVEL" , E_ALL ^ E_STRICT ) ;

	error_reporting( DEF_ERROR_LEVEL ) ;

	date_default_timezone_set( "Asia/Tokyo" ) ;

	if( !isset( $DOCUMENT_ROOT ) )
		$DOCUMENT_ROOT = $_SERVER[ "DOCUMENT_ROOT" ] ;

	// 標準のINCLUDE指定
	$root = rtrim( $DOCUMENT_ROOT , "/" ) ;
	if ( ( $pos = strrpos( $root , "/" ) ) !== false )
		$root = substr( $root , 0 , $pos ) ;

	if ( defined( "SITE_INCLUDE_DIR" ) == false )
		define(	"SITE_INCLUDE_DIR"		,	realpath( $root . "/conf" ) ) ;

	if( realpath( $DOCUMENT_ROOT . "../lib" ) )
		define(	"WEBAPP_INCLUDE_DIR"	,	realpath( $DOCUMENT_ROOT . "../lib" ) ) ;
	else
		define(	"WEBAPP_INCLUDE_DIR"	,	realpath( dirname( __FILE__ ) . "/../lib" ) ) ;

	$lib_path  = "" ;

	if ( defined( "EXTENSION_SITE_INCLUDE_DIR" ) == true )
		$lib_path .= sprintf( "%s:" , EXTENSION_SITE_INCLUDE_DIR ) ;

	$lib_path .= sprintf( "%s:" , SITE_INCLUDE_DIR ) ;
	$lib_path .= sprintf( "%s:" , WEBAPP_INCLUDE_DIR ) ;
	$lib_path .= sprintf( "%s" , ini_get( "include_path" ) ) ;
	ini_set( "include_path" , $lib_path ) ;

