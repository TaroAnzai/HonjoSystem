require_once 'HTTP/Request2.php';
require_once 'XML/Parser2.php';

if (!defined('SERVICES_YAHOO_WEATHER_BASEURL')) {
	define('SERVICES_YAHOO_WEATHER_BASEURL',
		   'http://rss.weather.yahoo.co.jp/rss/');
}

/**
 * Class for accessing and retrieving information
 * from Yahoo's Weather Web Service
 *
 * @package Services_Yahoo
 * @access	public
 * @version Release: @package_version@
 * @uses	PEAR
 * @uses	HTTP_Request
 * @uses	XML_Unserializer
 */
class Services_Yahoo_Weather
{

	var $_baseurl = SERVICES_YAHOO_WEATHER_BASEURL;

	var $_lasturl = null;


	function Services_Yahoo_Weather()
	{
	}

	function getApiVersion()
	{
		return '0.1.0';
	}

	function getLastUrl()
	{
		return $this->_lasturl;
	}

	/**
	 * Retrieves weather and forecast information around the city
	 *
	 * Example:
	 * <code>
	 * <?php
	 * $lwws = new Services_Yahoo_Weather();
	 * $result = $lwws->get('“Œ‹ž', 'days');
	 * ?>
	 * </code>
	 *
	 * @access public
	 * @param  mixed  $city City name or id
	 * @param  string $type	days | warn
	 * @return array The array of information returned by the query
	 */
	function get($city, $type='days')
	{
		$params = array();
		$city_id = $this->getCityIdByCityName($city);
		if (PEAR::isError($city_id)) return $city_id;
		$params['city'] = $city_id;
		$params['type'] = $type;
		return $this->_sendRequest($params);
	}

