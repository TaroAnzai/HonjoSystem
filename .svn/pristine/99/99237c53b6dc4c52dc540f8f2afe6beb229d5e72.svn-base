		if (is_int( $name ) && in_array( $name , $arWeather ) ) return $name ;
		return isset( $arWeather[ $name ]) ? $arWeather[ $name ] : PEAR::raiseError('Invalid Weather Icon' ) ;
	}
	
	function _sendRequest($params)
	{
		$this->_errors = array();

		$url = $this->_baseurl . $params['type'] . '/' . $params['city'] . '.xml';
		$this->_lasturl = $url;

		$http = new HTTP_Request2( $url ) ;
		$http->sendRequest();

		if ($http->getResponseCode() != 200){
			return PEAR::raiseError('Yahoo returned invalid HTTP response code ' . $http->getResponseCode());
		}
		$result = $http->getResponseBody();

//		$xml = new XML_Unserializer();
//		$xml->setOption(XML_UNSERIALIZER_OPTION_ATTRIBUTES_PARSE, true);
//		$xml->unserialize($result, false);
		return "" ; //$xml->getUnserializedData();
	}

