	function getWeatherIcon($name)
	{
		static	$arWeather ;
		if ( !isset( $arWeather ) )
		{
			$arWeather = array(
				"°‚ê"		=> "sun" ,
				"°ŽžX“Ü"	=> "sun_clouds_st" ,
