				"“ÜŽžXá"	=> "clouds_snow_st" ,
				"“ÜŒã°"	=> "clouds_sun_af" ,
				"“ÜŒã‰J"	=> "clouds_rain_af" ,
				"“ÜŒãá"	=> "clouds_snow_af" ,
				"‰J"		=> "rain" ,
				"‰JŽžX°"	=> "rain_sun_st" ,
				"‰JŽžX“Ü"	=> "rain_clouds_st" ,
				"‰JŽžXá"	=> "rain_snow_st" ,
				"‰JŒã°"	=> "rain_sun_af" ,
				"‰JŒã“Ü"	=> "rain_clouds_af" ,
				"‰JŒãá"	=> "rain_snow_af" ,
				"–\•—‰J"	=> "rainstorm" ,
				"á"		=> "snow" ,
				"áŽžX°"	=> "snow_sun_st" ,
				"áŽžX“Ü"	=> "snow_clouds_st" ,
