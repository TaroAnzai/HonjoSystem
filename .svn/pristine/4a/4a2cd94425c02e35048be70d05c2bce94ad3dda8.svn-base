define( "DEF_CORP_GROUP_SELF"			,	99			) ;	// 自社情報
define( "DEF_CORP_GROUPPARENTID_PARENT"	,	-99			) ;	// 親情報 検索用

define( "NUMBER_PER_CORP"			,	5	) ;	// 行数／ページ

// 法人格
