define( "DEF_CORP_LEVEL_FREE"			,	$_FUNC ++	) ;	// 無料会員
define( "DEF_CORP_LEVEL_PAY"			,	$_FUNC ++	) ;	// 有料会員
define( "DEF_CORP_LEVEL_WEB"			,	$_FUNC ++	) ;	// Web会員
define( "DEF_CORP_LEVEL_DEMO"			,	99			) ;	// DEMO会員
define( "DEF_CORP_LEVEL_NON_LABEL"	,	"非会員"	) ;	// 非会員

global	$arCorpLevel ;
$arCorpLevel = array(
	DEF_CORP_LEVEL_NON	=> "非会員" ,
	DEF_CORP_LEVEL_FREE	=> "無料会員" ,
	DEF_CORP_LEVEL_PAY	=> "有料会員" ,
	DEF_CORP_LEVEL_WEB	=> "Web会員" ,
