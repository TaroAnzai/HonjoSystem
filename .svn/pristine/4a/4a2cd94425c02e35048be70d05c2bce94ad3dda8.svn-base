// 法人格 位置
$_FUNC = 1 ;
define( "DEF_POSITION_NONE"		,	$_FUNC ++ ) ;
define( "DEF_POSITION_BEFORE"	,	$_FUNC ++ ) ;
define( "DEF_POSITION_AFTER"	,	$_FUNC ++ ) ;

global $arCustomerPosition ;
$arCustomerPosition = array(
	DEF_POSITION_NONE	=>	"表示なし" ,
	DEF_POSITION_BEFORE	=>	"前" ,
	DEF_POSITION_AFTER	=>	"後" ,
) ;

// 会員レベル（共通）
$_FUNC = 0 ;
