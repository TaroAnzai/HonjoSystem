		$sql .= sprintf( "birthday = '%s' , "		, $birthday ) ;
		$sql .= sprintf( "gender = '%d' , "			, $gender ) ;
		$sql .= sprintf( "email = '%s' , "			, mb_addslashes( $email ) ) ;
		$sql .= sprintf( "state = '%d' , "			, $state ) ;
		$sql .= sprintf( "city = '%s' , "			, mb_addslashes( $city ) ) ;
		$sql .= sprintf( "addr1 = '%s' , "			, mb_addslashes( $addr1 ) ) ;
		$sql .= sprintf( "addr2 = '%s' , "			, mb_addslashes( $addr2 ) ) ;
		$sql .= sprintf( "zip = '%s' , "			, mb_addslashes( $zip ) ) ;
		$sql .= sprintf( "tel = '%s' , "			, mb_addslashes( $tel ) ) ;
